   "w": 232,
   "h": 86,
   "kind": "svt_w",
   "title": "1 · Resting ECG",
   "lines": [
    "may show Wolff-Parkinson-White (WPW)"
   ]
  },
  {
   "id": "svt_ex_1_0",
   "x": 1321,
   "y": 660,
   "w": 232,
   "h": 106,
   "kind": "svt_w",
   "title": "2 · CAPTURE it: ECG during symptoms",
   "lines": [
    "Holter 24–48 h, or a 3–8 week monitor"
   ]
  },
  {
   "id": "inn_next_0_0",
