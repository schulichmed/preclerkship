  {
   "id": "msk_next_0_0",
   "x": 561,
   "y": 806,
   "w": 232,
   "h": 150,
   "kind": "ok",
   "title": "Non-cardiac causes",
   "lines": [
    "• musculoskeletal: precordial catch, slipping rib",
    "• asthma",
    "• reflux, anxiety"
   ]
  },
  {
   "id": "car_next_0_0",
   "x": 805,
   "y": 806,
   "w": 232,
   "h": 150,
   "kind": "bad",
   "title": "SYNCOPE is most worrying",
   "lines": [
    "• inflammation: pericarditis, myocarditis",
    "• demand: cardiomyopathy, outflow obstruction",
    "• coronary anomaly, aortic dissection"
   ]
  },
  {
   "id": "sin_next_0_0",
   "x": 1077,
   "y": 806,
   "w": 232,
   "h": 150,
