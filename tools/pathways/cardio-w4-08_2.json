 "nodes": [
  {
   "id": "root",
   "x": 419,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "A child with a MURMUR, CHEST PAIN or PALPITATIONS: BENIGN, or the HEART?",
   "lines": [
    "infants: work of breathing with feeds, sweating with feeds, poor growth, cyanosis · older: syncope, exercise intolerance",
    "exam: perfusion, heaves or thrills, radial vs femoral pulses, extra sounds, liver size"
   ]
  },
  {
   "id": "g_mur",
   "x": 45,
   "y": 138,
   "w": 476,
   "h": 60,
   "kind": "plain",
   "title": "MURMUR: most are INNOCENT",
   "lines": [
    "congenital heart disease (CHD) in only ~1% of children"
   ]
  },
  {
   "id": "g_cp",
   "x": 561,
   "y": 138,
   "w": 476,
   "h": 60,
   "kind": "plain",
   "title": "CHEST PAIN: most are BENIGN",
   "lines": [
    "normal children do not have heart attacks"
   ]
  },
  {
   "id": "g_pal",
   "x": 1077,
   "y": 138,
   "w": 476,
   "h": 60,
   "kind": "plain",
   "title": "PALPITATIONS: fast? irregular? hard?",
   "lines": [
    "SYNCOPE rather than palpitations → think ventricular tachycardia (VT)"
   ]
  },
  {
   "id": "inn_head_0_0",
   "x": 45,
   "y": 278,
   "w": 232,
   "h": 78,
   "kind": "inn_h",
   "title": "Innocent murmur",
   "lines": [
    "blood ejected from a NORMAL heart"
   ]
  },
  {
   "id": "pat_head_0_0",
   "x": 289,
   "y": 278,
   "w": 232,
   "h": 78,
   "kind": "pat_h",
   "title": "Pathologic murmur",
   "lines": [
    "may be congenital heart disease"
   ]
  },
  {
   "id": "msk_head_0_0",
   "x": 561,
   "y": 278,
   "w": 232,
   "h": 78,
   "kind": "msk_h",
   "title": "Benign chest pain",
   "lines": [
    "costochondritis commonest"
   ]
  },
  {
   "id": "car_head_0_0",
   "x": 805,
   "y": 278,
   "w": 232,
   "h": 78,
   "kind": "car_h",
   "title": "Cardiac chest pain",
   "lines": [
    "rare, but do not miss it"
   ]
  },
  {
   "id": "sin_head_0_0",
   "x": 1077,
   "y": 278,
   "w": 232,
   "h": 78,
   "kind": "sin_h",
   "title": "Sinus tachycardia",
   "lines": [
    "or awareness of a normal rhythm"
   ]
  },
  {
   "id": "svt_head_0_0",
   "x": 1321,
   "y": 278,
   "w": 232,
   "h": 78,
   "kind": "svt_h",
   "title": "Supraventricular tachycardia (SVT)",
   "lines": []
  },
  {
   "id": "inn_hx_0_0",
   "x": 45,
   "y": 396,
   "w": 232,
   "h": 116,
   "kind": "inn_t",
   "title": "No cardiac symptoms",
   "lines": [
    "• louder with high output: fever, infection"
   ]
  },
  {
   "id": "pat_hx_0_0",
   "x": 289,
   "y": 396,
   "w": 232,
   "h": 116,
   "kind": "pat_t",
   "title": "± cardiac symptoms",
   "lines": [
    "• or a FAMILY history"
   ]
  },
  {
   "id": "msk_hx_0_0",
   "x": 561,
   "y": 396,
   "w": 232,
   "h": 116,
   "kind": "msk_t",
   "title": "Random, even AT REST",
   "lines": [
    "• worse breathing in or moving",
    "• eased by rest, distraction, time"
   ]
  },
  {
   "id": "car_hx_0_0",
   "x": 805,
   "y": 396,
   "w": 232,
   "h": 116,
   "kind": "car_t",
   "title": "With EXERCISE, and only exercise",
   "lines": [
    "• predictable by exertion",
    "• eased by rest ONLY"
   ]
  },
  {
   "id": "sin_hx_0_0",
   "x": 1077,
   "y": 396,
   "w": 232,
   "h": 116,
   "kind": "sin_t",
   "title": "SLOW onset and offset (> 10–30 s)",
   "lines": [
    "• < 150–180 bpm at rest",
    "• presyncope or dyspnea come FIRST"
   ]
  },
  {
   "id": "svt_hx_0_0",
   "x": 1321,
   "y": 396,
   "w": 232,
   "h": 116,
   "kind": "svt_t",
   "title": "ABRUPT onset and offset (1–5 s)",
   "lines": [
    "• > 200 bpm, too fast to count",
    "• presyncope, chest pain, dyspnea FOLLOW"
   ]
  },
  {
   "id": "inn_ex_0_0",
   "x": 45,
   "y": 552,
   "w": 232,
   "h": 123,
   "kind": "inn_w",
   "title": "Sounds like",
   "lines": [
    "• mid-systolic (venous hum: continuous)",
    "• grade 1–3, NEVER a thrill",
    "• soft, MUSICAL, vibratory"
   ]
  },
  {
   "id": "inn_ex_1_0",
   "x": 45,
   "y": 697,
   "w": 232,
   "h": 69,
   "kind": "inn_w",
   "title": "LOUDER lying down",
   "lines": [
    "~venous hum: GOES when supine"
   ]
  },
  {
   "id": "pat_ex_0_0",
   "x": 289,
   "y": 552,
   "w": 232,
   "h": 114,
   "kind": "pat_w",
   "title": "Sounds like",
   "lines": [
    "• holosystolic, DIASTOLIC or continuous",
    "• grade 1 up to 6",
    "• HARSH, rarely musical"
   ]
  },
  {
   "id": "pat_ex_1_0",
   "x": 289,
   "y": 688,
   "w": 232,
   "h": 78,
   "kind": "pat_w",
   "title": "Associated findings",
   "lines": [
    "extra heart sounds, abnormal palpation"
   ]
  },
  {
   "id": "msk_ex_0_0",
   "x": 561,
   "y": 552,
   "w": 232,
   "h": 214,
   "kind": "msk_w",
   "title": "Reproducible",
   "lines": [
    "• DISCRETE spot, often sharp",
    "• normal heart exam"
   ]
  },
  {
   "id": "car_ex_0_0",
   "x": 805,
   "y": 552,
   "w": 232,
   "h": 214,
   "kind": "car_w",
   "title": "NOT reproducible",
   "lines": [
    "• vague, crushing, squeezing",
    "• ± murmur or extra sounds"
   ]
  },
  {
   "id": "sin_ex_0_0",
   "x": 1077,
   "y": 552,
   "w": 232,
   "h": 96,
   "kind": "sin_w",
   "title": "1 · Resting ECG normal",
   "lines": []
  },
