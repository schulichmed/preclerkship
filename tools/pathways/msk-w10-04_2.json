 "nodes": [
  {
   "id": "root",
   "x": 126,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "ONE hot, red, swollen joint for under 6 weeks: INFECTION until proven otherwise",
   "lines": [
    "IF THE JOINT IS RED, ASPIRATE IT → the 3 C's: cell count (hours) · culture + Gram stain (24–48 h) · crystals (hours)",
    "differential: infection · infection · infection · gout · pseudogout (rarely reactive or psoriatic arthritis)"
   ]
  },
  {
   "id": "g_inf",
   "x": 45,
   "y": 138,
   "w": 290,
   "h": 80,
   "kind": "plain",
   "title": "NO crystals, organisms seen or grown",
   "lines": [
    "a MEDICAL EMERGENCY"
   ]
  },
  {
   "id": "g_cry",
   "x": 375,
   "y": 138,
   "w": 592,
   "h": 80,
   "kind": "plain",
   "title": "CRYSTALS under polarized light",
   "lines": [
    "both can look exactly like an infected joint, fever included"
   ]
  },
  {
   "id": "sep_head_0_0",
   "x": 45,
   "y": 298,
   "w": 290,
   "h": 96,
   "kind": "sep_h",
   "title": "Septic arthritis",
   "lines": [
    "Staphylococcus 60%+ · streptococcus 20%",
    "gram-negatives 15% (immunocompromised, elderly, intravenous (IV) drug use)"
   ]
  },
  {
   "id": "gout_head_0_0",
   "x": 375,
   "y": 298,
   "w": 290,
   "h": 96,
   "kind": "gout_h",
   "title": "Gout",
   "lines": [
    "monosodium urate (uric acid) crystals"
   ]
  },
  {
   "id": "cppd_head_0_0",
   "x": 677,
   "y": 298,
   "w": 290,
   "h": 96,
   "kind": "cppd_h",
   "title": "Pseudogout",
   "lines": [
    "calcium pyrophosphate (CPP) crystals"
   ]
  },
  {
   "id": "sep_clue_0_0",
   "x": 45,
   "y": 434,
   "w": 290,
   "h": 87,
   "kind": "sep_t",
   "title": "Fever, unwell, can't bear weight",
   "lines": [
    "red flags: fever · pain · range of motion ↓"
   ]
  },
  {
   "id": "sep_clue_1_0",
   "x": 45,
   "y": 543,
   "w": 290,
   "h": 141,
   "kind": "sep_w",
   "title": "HIGH risk",
   "lines": [
    "• prosthetic joint or recent joint surgery",
    "• immunosuppressed (diabetes, methotrexate, prednisone, biologics)",
    "• IV drugs, alcohol, very young or old"
   ]
  },
  {
   "id": "gout_clue_0_0",
   "x": 375,
   "y": 434,
   "w": 290,
   "h": 96,
   "kind": "gout_t",
   "title": "Peaks in HOURS, exquisitely painful",
   "lines": [
    "• can't stand the bedsheet touching it",
    "• big toe (1st metatarsophalangeal joint) in 50%"
   ]
  },
  {
   "id": "gout_clue_1_0",
   "x": 375,
   "y": 552,
   "w": 290,
   "h": 132,
   "kind": "gout_w",
   "title": "Who and why",
   "lines": [
    "• men 35–50 · women after menopause",
    "• diuretics, alcohol, kidney impairment",
    "• SMARTS: surgery, mechanical injury, alcohol, recent illness, travel, starting or stopping allopurinol"
   ]
  },
  {
   "id": "cppd_clue_0_0",
   "x": 677,
   "y": 434,
   "w": 290,
   "h": 115,
   "kind": "cppd_t",
   "title": "Less intense, SLOWER to peak, lasts longer",
   "lines": [
    "days to a few weeks untreated"
   ]
  },
  {
   "id": "cppd_clue_1_0",
   "x": 677,
   "y": 571,
   "w": 290,
   "h": 113,
   "kind": "cppd_w",
   "title": "Who",
   "lines": [
    "• older people, often with osteoarthritis",
    "• KNEE most common"
   ]
  },
  {
   "id": "sep_inv_0_0",
   "x": 45,
   "y": 724,
   "w": 290,
   "h": 96,
   "kind": "sep_t",
   "title": "1 · Aspirate: cells HIGH",
   "lines": [
    "• over 50 000 points to infection",
    "• Gram stain: e.g. Gram-positive cocci in clusters"
   ]
  },
  {
   "id": "sep_inv_1_0",
   "x": 45,
   "y": 842,
   "w": 290,
   "h": 96,
   "kind": "sep_w",
   "title": "2 · Bloods",
   "lines": [
    "• blood cultures",
    "• blood count, electrolytes, creatinine, C-reactive protein"
   ]
  },
  {
   "id": "gout_inv_0_0",
   "x": 375,
   "y": 724,
   "w": 290,
   "h": 87,
   "kind": "gout_t",
   "title": "1 · NEEDLE-shaped, NEGATIVELY birefringent",
   "lines": [
    "culture: no growth"
   ]
  },
  {
   "id": "gout_inv_1_0",
   "x": 375,
   "y": 833,
   "w": 290,
   "h": 105,
   "kind": "gout_w",
   "title": "2 · Uric acid may be NORMAL in an attack",
   "lines": [
    "• high uric acid alone ≠ gout: don't treat it",
    "• creatinine, fasting glucose, lipids"
   ]
  },
  {
   "id": "cppd_inv_0_0",
   "x": 677,
   "y": 724,
   "w": 290,
   "h": 97,
   "kind": "cppd_t",
   "title": "1 · RHOMBOID, intracellular, POSITIVELY birefringent",
   "lines": [
    "culture: no growth"
   ]
  },
  {
   "id": "cppd_inv_1_0",
   "x": 677,
   "y": 843,
   "w": 290,
   "h": 95,
   "kind": "cppd_w",
   "title": "2 · Chondrocalcinosis on X-ray",
   "lines": [
    "CPP in cartilage: an X-ray finding, not the attack"
   ]
  },
  {
   "id": "sep_tx_0_0",
   "x": 45,
   "y": 978,
   "w": 290,
   "h": 107,
   "kind": "bad",
   "title": "1 · ADMIT + urgent incision and drainage (I&D)",
   "lines": [
    "a closed space: drain it, repeat until clean"
   ]
  },
  {
   "id": "sep_tx_1_0",
   "x": 45,
   "y": 1107,
   "w": 290,
   "h": 141,
   "kind": "ok",
   "title": "2 · Empiric IV antibiotics",
   "lines": [
    "• cefazolin 2 g IV every 8 h",
    "• methicillin-resistant S. aureus (MRSA) risk: vancomycin + ceftriaxone",
    "• 4–6 weeks in all"
   ]
  },
  {
   "id": "gout_tx_0_0",
   "x": 375,
   "y": 978,
   "w": 290,
   "h": 132,
   "kind": "ok",
   "title": "1 · Settle the attack",
   "lines": [
    "• steroid injected into the joint",
    "• indomethacin 50 mg three times daily",
    "• or colchicine 0.6 mg every 8 h",
    "• or prednisone 30 mg, down 5 mg every 2 days"
   ]
  },
  {
   "id": "gout_tx_1_0",
   "x": 375,
   "y": 1132,
   "w": 290,
   "h": 116,
   "kind": "warn",
   "title": "2 · Allopurinol: NEVER during an attack",
   "lines": [
    "• recurrent attacks, tophi · lifelong",
    "• cover with an anti-inflammatory (NSAID) or colchicine"
   ]
  },
  {
   "id": "cppd_tx_0_0",
   "x": 677,
   "y": 978,
   "w": 290,
   "h": 142,
   "kind": "ok",
   "title": "Settle the attack",
   "lines": [
    "• steroid injected into the joint",
    "• indomethacin 50 mg three times daily",
    "• or the prednisone taper"
   ]
  },
  {
   "id": "cppd_tx_1_0",
   "x": 677,
   "y": 1142,
   "w": 290,
   "h": 106,
   "kind": "cppd_w",
   "title": "Rest, ice, elevation, hydration",
   "lines": [
    "no allopurinol: that is for urate"
   ]
  }
 ],
