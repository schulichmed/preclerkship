 "panels": [
  {
   "x": 45,
   "y": 1282,
   "w": 454,
   "title": "Septic or gout? (older patient)",
   "items": [
    "septic: febrile · high white count · positive culture or Gram stain",
    "gout: may be febrile · joint fluid 20 000–50 000 · urate crystals on microscopy"
   ],
   "cols": 1
  },
  {
   "x": 513,
   "y": 1282,
   "w": 454,
   "title": "Gout: after the attack",
   "items": [
    "recurrence 60% in 1 year · 80% in 2 · 90% in 5",
    "less meat and seafood, less alcohol; vegetables and low-fat dairy are good"
   ],
   "cols": 1
  }
 ]
