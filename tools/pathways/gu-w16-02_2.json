   ]
  },
  {
   "id": "sm_clue_0_0",
   "x": 297,
   "y": 496,
   "w": 240,
   "h": 214,
   "kind": "sm_t",
   "title": "Passes on its own",
   "lines": [
    "• < 4 mm: 90%",
    "• 4–8 mm: 50%"
   ]
  },
