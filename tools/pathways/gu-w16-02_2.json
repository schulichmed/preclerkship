   "title": "PREVENT the next stone: everyone",
   "lines": [
    "• drink MORE",
    "• keep NORMAL dietary calcium: low calcium ↑ oxalate",
    "• less salt + protein, more fruit + vegetables"
   ]
  },
  {
   "id": "span0_next_0_1",
   "x": 422.0,
   "y": 1032,
   "w": 367.0,
   "h": 114,
   "kind": "info",
   "title": "FIND a cause, then treat it",
   "lines": [
    "• hyperparathyroidism → treat the cause",
    "• malabsorption → more calcium, less oxalate",
    "• renal tubular acidosis → potassium citrate",
    "• topiramate → stop it"
   ]
  }
