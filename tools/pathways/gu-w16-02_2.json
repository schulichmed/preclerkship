   "id": "lg_clue_0_0",
   "x": 549,
   "y": 496,
   "w": 240,
   "h": 214,
   "kind": "lg_t",
   "title": "Surgery if",
   "lines": [
    "• > 8 mm: < 10% pass",
    "• pain despite analgesia",
    "• renal failure: solitary kidney, poor function",
    "• job: pilot, bus driver"
   ]
  },
