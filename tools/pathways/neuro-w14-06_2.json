   ]
  },
  {
   "id": "mig_head_0_0",
   "x": 1233,
   "y": 540,
   "w": 220,
   "h": 150,
   "kind": "mig_h",
   "title": "Migraine",
   "lines": [
    "prodrome (2-48 h) · aura (25-30%, 5-60 min) · headache · postdrome (24-48 h)",
    "trigeminovascular · CGRP release",
    "3rd most prevalent, 7th most disabling"
   ]
  },
  {
   "id": "tth_head_0_0",
   "x": 1465,
   "y": 540,
   "w": 220,
   "h": 150,
   "kind": "tth_h",
   "title": "Tension-type",
   "lines": [
    "the most prevalent (38% a year)"
   ]
  },
  {
   "id": "clu_head_0_0",
   "x": 1697,
   "y": 540,
   "w": 220,
   "h": 150,
   "kind": "clu_h",
   "title": "Cluster",
   "lines": [
    "0.1% · men 3:1 · ~30 · 85% smokers · alcohol",
    "lasts ~15 years · \"suicide headache\""
   ]
  },
  {
   "id": "sah_clue_0_0",
   "x": 45,
   "y": 730,
   "w": 220,
   "h": 224,
   "kind": "sah_t",
   "title": "THUNDERCLAP",
   "lines": [
    "• worst ever, peaks in seconds",
    "• vomiting, photophobia, stiff neck",
    "case: 52 y lifting groceries · BP 185/100 · stiff neck, alert, no focal signs"
   ]
  },
  {
   "id": "men_clue_0_0",
   "x": 277,
   "y": 730,
   "w": 220,
   "h": 224,
   "kind": "men_t",
   "title": "Fever + stiff neck",
   "lines": [
    "• photophobia",
    "• confused, hard to wake",
    "• Kernig: knee extension hurts neck or back",
    "• Brudzinski: neck flexion flexes hips + knees",
    "case: 21 y student, 1 day · T 39.4, HR 124 · drowsy, 1-step commands"
   ]
  },
  {
   "id": "gca_clue_0_0",
   "x": 509,
   "y": 730,
   "w": 220,
   "h": 224,
   "kind": "gca_t",
   "title": "NEW temporal headache",
   "lines": [
    "• scalp tenderness · jaw claudication",
    "• transient vision loss",
    "• polymyalgic symptoms · limb claudication",
    "case: 74 y, 2 weeks left temporal · hurts to brush hair, chewing · 2 episodes transient left vision loss · tender thick temporal artery"
   ]
  },
  {
   "id": "tum_clue_0_0",
   "x": 741,
   "y": 730,
   "w": 220,
   "h": 224,
   "kind": "tum_t",
   "title": "PROGRESSIVE, worse on waking",
   "lines": [
    "• vomiting · worse with cough, position",
    "• personality change, seizure, focal deficit",
    "case: 58 y, 2 months · forgetful, first seizure · left pronator drift, BOTH discs swollen"
   ]
  },
  {
   "id": "iih_clue_0_0",
   "x": 973,
   "y": 730,
   "w": 220,
   "h": 224,
   "kind": "iih_t",
   "title": "Worse LYING flat, coughing",
   "lines": [
    "• whooshing (pulsatile) tinnitus",
    "• vision greys out for seconds",
    "• double vision (6th nerve)",
    "case: 27 y, BMI 37, gained 15 kg · 6 weeks daily headache · papilledema, acuity normal"
   ]
  },
  {
   "id": "mig_clue_0_0",
   "x": 1233,
   "y": 730,
   "w": 220,
   "h": 224,
   "kind": "mig_t",
   "title": "ONE side, PULSATING",
   "lines": [
    "• 4-72 h · moderate-severe",
    "• worse with activity",
    "• nausea · light AND sound sensitivity",
    "• aura: spreading, fully reversible · visual (zigzags), sensory, language",
    "case: 4 h + photophobia + nausea → migraine, not tension"
   ]
  },
  {
   "id": "tth_clue_0_0",
   "x": 1465,
   "y": 730,
   "w": 220,
   "h": 224,
   "kind": "tth_t",
   "title": "BOTH sides, PRESSING",
   "lines": [
    "• 30 min-7 days · mild-moderate",
    "• 10+ episodes, or 3+ months (chronic)",
    "• not worse with activity"
   ]
  },
  {
   "id": "clu_clue_0_0",
   "x": 1697,
   "y": 730,
   "w": 220,
   "h": 224,
   "kind": "clu_t",
   "title": "STRICTLY one side, at the eye",
   "lines": [
    "• severe · 15-180 min · every other day to 8 a day",
    "• same-side tearing, red eye, runny nose, ptosis",
    "• RESTLESS, paces (migraine lies still) · same time of day or year",
    "• also miosis, sweating, eyelid edema"
   ]
  },
  {
   "id": "sah_inv_0_0",
   "x": 45,
   "y": 994,
   "w": 220,
   "h": 152,
   "kind": "sah_w",
   "title": "Urgent NON-CONTRAST CT",
   "lines": [
    "• sensitivity 98% day 0 · 76% day 2 · 50% at 1 week · 30% at 2 weeks",
    "• negative → LP for xanthochromia"
   ]
  },
  {
   "id": "men_inv_0_0",
   "x": 277,
   "y": 994,
   "w": 220,
   "h": 152,
   "kind": "men_w",
   "title": "Blood cultures · LP if safe",
   "lines": [
    "image first if signs of raised pressure"
   ]
  },
  {
   "id": "gca_inv_0_0",
   "x": 509,
   "y": 994,
   "w": 220,
   "h": 152,
   "kind": "gca_w",
   "title": "ESR + CRP",
   "lines": [
    "• temporal artery biopsy or ultrasound",
    "• can be normal: patchy"
   ]
  },
  {
   "id": "tum_inv_0_0",
   "x": 741,
   "y": 994,
   "w": 220,
   "h": 152,
   "kind": "tum_w",
   "title": "Urgent MRI with contrast",
   "lines": [
    "• (CT if no MRI) · papilledema = raised pressure",
    "• CT chest, abdomen, pelvis: primary or secondary?"
   ]
  },
  {
   "id": "iih_inv_0_0",
   "x": 973,
   "y": 994,
   "w": 220,
   "h": 152,
   "kind": "iih_w",
   "title": "MRI + MR venogram FIRST",
   "lines": [
    "• excludes a mass or venous sinus thrombosis",
    "• MRI: empty sella, flat back of globe, venous sinus stenosis",
    "• then LP: opening pressure over 250 mm H2O"
   ]
  },
  {
   "id": "mig_inv_0_0",
   "x": 1233,
   "y": 994,
   "w": 220,
   "h": 152,
   "kind": "mig_w",
   "title": "5-4-3-2-1",
   "lines": [
    "5 attacks · 4-72 h (4 hours to 3 days) · 2 of 4 features · 1 of nausea or light + sound"
   ]
  },
  {
   "id": "tth_inv_0_0",
   "x": 1465,
   "y": 994,
   "w": 220,
   "h": 152,
   "kind": "tth_w",
   "title": "NO nausea or vomiting",
   "lines": [
    "at most one of light or sound sensitivity"
   ]
  },
  {
   "id": "clu_inv_0_0",
   "x": 1697,
   "y": 994,
   "w": 220,
   "h": 152,
   "kind": "clu_w",
   "title": "A trigeminal autonomic cephalalgia",
   "lines": [
    "the hypothalamus drives it → circadian, circannual rhythm"
   ]
  },
  {
   "id": "sah_tx_0_0",
   "x": 45,
   "y": 1186,
   "w": 220,
   "h": 852,
   "kind": "bad",
   "title": "Secure the aneurysm",
   "lines": [
    "see the STROKE chart",
    "untreated, it re-bleeds: 15% in 24 h, 40% in a month"
   ]
  },
  {
   "id": "men_tx_0_0",
   "x": 277,
   "y": 1186,
   "w": 220,
   "h": 852,
   "kind": "bad",
   "title": "IV antibiotics NOW",
   "lines": [
    "• ceftriaxone + vancomycin",
    "• ± ampicillin: elderly, immunocompromised",
    "• ± acyclovir: HSV",
    "• never wait for imaging or LP"
   ]
  },
  {
   "id": "gca_tx_0_0",
   "x": 509,
   "y": 1186,
   "w": 220,
   "h": 852,
   "kind": "bad",
   "title": "HIGH-DOSE steroids TODAY",
   "lines": [
    "don't wait for the biopsy · untreated → permanent vision loss · then taper"
   ]
  },
  {
   "id": "tum_tx_0_0",
   "x": 741,
   "y": 1186,
   "w": 220,
   "h": 852,
   "kind": "warn",
   "title": "Usual remedies fail",
   "lines": [
    "the headache does not respond"
   ]
  },
  {
   "id": "iih_tx_0_0",
   "x": 973,
   "y": 1186,
   "w": 220,
   "h": 852,
   "kind": "ok",
   "title": "Weight loss + acetazolamide",
   "lines": [
    "• topiramate · shunt, optic nerve sheath fenestration",
    "• close eye follow-up"
   ]
  },
  {
   "id": "mig_tx_0_0",
   "x": 1233,
   "y": 1186,
   "w": 220,
   "h": 78,
   "kind": "ok",
   "title": "ACUTE: treat EARLY",
   "lines": [
    "• NSAID ± triptan ± antiemetic",
    "• under 2-3 days a week"
   ]
  },
  {
   "id": "mig_tx_1_0",
   "x": 1233,
   "y": 1286,
   "w": 220,
   "h": 98,
   "kind": "ok",
   "title": "TRIPTAN: 5-HT1B/1D agonist",
   "lines": [
    "• at onset, repeat in 2-24 h",
    "• chest, jaw tightness, flushing"
   ]
  },
  {
   "id": "mig_tx_2_0",
   "x": 1233,
   "y": 1406,
   "w": 220,
   "h": 114,
   "kind": "bad",
   "title": "NO triptan",
   "lines": [
    "• coronary or cerebrovascular disease",
    "• uncontrolled BP, Raynaud's",
    "• peripheral vascular disease"
   ]
  },
  {
   "id": "mig_tx_3_0",
   "x": 1233,
   "y": 1542,
   "w": 220,
   "h": 78,
   "kind": "bad",
   "title": "NO NSAID",
   "lines": [
    "• GI bleed, ulcer, bleeding risk",
    "• renal impairment, pregnancy"
   ]
  },
  {
   "id": "mig_tx_4_0",
   "x": 1233,
   "y": 1642,
   "w": 220,
   "h": 114,
   "kind": "ok",
   "title": "Antiemetic",
   "lines": [
    "• metoclopramide, prochlorperazine",
    "• promethazine",
    "• ondansetron, antihistamines"
   ]
  },
  {
   "id": "mig_tx_5_0",
   "x": 1233,
   "y": 1778,
   "w": 220,
   "h": 260,
   "kind": "warn",
   "title": "PREVENT if over 4 a month or disabling",
   "lines": [
    "• or acute drugs fail, not tolerated, overuse risk",
    "• first: beta-blocker or amitriptyline",
    "• high BMI: topiramate (weight loss)",
    "• chronic: onabotulinumtoxinA every 12 weeks, ~50% respond",
    "• CGRP inhibitors · magnesium, riboflavin",
    "• SEEDS: Sleep, Exercise, Eat, Diary, Stress"
   ]
  },
  {
   "id": "tth_tx_0_0",
