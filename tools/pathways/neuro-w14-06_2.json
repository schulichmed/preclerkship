 "nodes": [
  {
   "id": "root",
   "x": 601,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Headache: rule OUT a secondary cause while you name the primary one",
   "lines": [
    "history of the pain: NILDOCAAFIAT · Nature, Intensity, Location, Duration, Onset, Contributing, Aggravating, Alleviating, Frequency, Impact, Attribute, Treatment tried",
    "SNOOP4 red flags: Systemic (fever, weight loss) · Neurological deficits · Older onset (over 50) · Onset sudden (thunderclap) · Papilledema · Positional · Precipitated by Valsalva · Progressive or a new pattern",
    "positional: worse LYING → raised pressure, mass · worse UPRIGHT → intracranial HYPOTENSION",
    "examine: vital signs · fundi (papilledema) · pupils, eye movements, visual fields · neurological exam · body habitus · neck · scalp · jaw joint"
   ]
  },
  {
   "id": "g_sec",
   "x": 45,
   "y": 228,
   "w": 1148,
   "h": 60,
   "kind": "plain",
   "title": "SECONDARY: a red flag",
   "lines": [
    "can be life-threatening"
   ]
  },
  {
   "id": "g_pri",
   "x": 1233,
   "y": 228,
   "w": 684,
   "h": 60,
   "kind": "plain",
   "title": "PRIMARY: no red flag",
   "lines": [
    "name it by its International Classification of Headache Disorders (ICHD-3) features"
   ]
  },
  {
   "id": "p_sec",
   "x": 45,
   "y": 328,
   "w": 1148,
   "h": 132,
   "kind": "info",
   "title": "Secondary causes to EXCLUDE",
   "lines": [
    "• vascular: stroke, ICH, SAH, venous thrombosis, PRES, RCVS, dissection, vasculitis",
    "• inflammatory: giant cell arteritis, idiopathic intracranial hypertension",
    "• trauma: after dural puncture, concussion · drugs: medication overuse",
    "• tumour: meningioma, schwannoma, pituitary apoplexy, choriocarcinoma",
    "• infection: meningitis, encephalitis, systemic"
   ]
  },
  {
   "id": "p_pri",
   "x": 1233,
   "y": 328,
   "w": 684,
   "h": 132,
   "kind": "info",
   "title": "Beware MEDICATION OVERUSE headache",
   "lines": [
    "• triptans 10+ days, simple analgesics 15+ days a month, for over 3 months",
    "• → 15+ headache days a month in a primary headache",
    "• usually resolves once stopped",
    "• frequent acute use → start PREVENTION"
   ]
  },
