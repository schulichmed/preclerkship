   "lines": []
  },
  {
   "id": "p_lump",
   "x": 45,
   "y": 240,
   "w": 666,
   "h": 114,
   "kind": "info",
   "title": "When you investigate",
   "lines": [
    "• IMAGE BY AGE: < 35 ULTRASOUND (breast too dense, risk too low for a mammogram; MRI if high risk), > 35 MAMMOGRAM ± ultrasound",
    "• then SAMPLE: fine needle aspiration → core biopsy → excision"
   ]
  },
  {
   "id": "p_pain",
   "x": 751,
   "y": 240,
   "w": 666,
   "h": 114,
   "kind": "info",
   "title": "Exam: a mass or suspicious finding?",
   "lines": [
    "• YES → the LUMP route",
    "• NO → is the pain CYCLICAL?"
   ]
  },
  {
   "id": "p_dis",
   "x": 1457,
   "y": 240,
   "w": 666,
   "h": 114,
   "kind": "info",
   "title": "Compress the areola",
   "lines": [
    "• colour, consistency, volume, which duct",
    "• normal in lactation"
   ]
  },
  {
   "id": "p_scr",
   "x": 2163,
   "y": 240,
   "w": 214,
   "h": 114,
   "kind": "info",
   "title": "Mammogram by RISK",
   "lines": [
    "• usual risk, 50–74: every 2 years",
    "• 40–49: not routinely",
    "• HIGH risk: YEARLY (see the panel)"
   ]
  },
  {
   "id": "ben_head_0_0",
   "x": 45,
   "y": 434,
   "w": 214,
   "h": 98,
   "kind": "ben_h",
   "title": "Benign lump",
   "lines": [
    "fibroglandular tissue · cyst · FIBROADENOMA · fibrocystic change"
   ]
  },
  {
   "id": "fn_head_0_0",
   "x": 271,
   "y": 434,
   "w": 214,
   "h": 98,
   "kind": "fn_h",
   "title": "Fat necrosis",
   "lines": [
    "BENIGN, but closely MIMICS cancer"
   ]
  },
  {
   "id": "ca_head_0_0",
   "x": 497,
   "y": 434,
   "w": 214,
   "h": 98,
   "kind": "ca_h",
   "title": "Invasive carcinoma",
   "lines": [
    "malignant cells invade the stroma"
   ]
  },
  {
   "id": "cyc_head_0_0",
   "x": 751,
   "y": 434,
   "w": 214,
   "h": 98,
   "kind": "cyc_h",
   "title": "Cyclical pain",
   "lines": [
    "hormonal: ducts (estrogen), stroma (progesterone)"
   ]
  },
  {
   "id": "mas_head_0_0",
   "x": 977,
   "y": 434,
   "w": 214,
   "h": 98,
   "kind": "mas_h",
   "title": "Mastitis",
   "lines": [
    "also non-cyclical: medicines, Cooper's ligament stretch, extramammary"
   ]
  },
  {
   "id": "ic_head_0_0",
   "x": 1203,
   "y": 434,
   "w": 214,
   "h": 98,
   "kind": "ic_h",
   "title": "Inflammatory carcinoma",
   "lines": [
    "looks like MASTITIS, but it is CANCER",
    "T4 disease"
   ]
  },
  {
   "id": "gal_head_0_0",
   "x": 1457,
   "y": 434,
   "w": 214,
   "h": 98,
   "kind": "gal_h",
   "title": "Galactorrhea",
   "lines": [
    "physiological: not pregnancy or lactation",
    "not from a breast lesion"
   ]
  },
  {
   "id": "pap_head_0_0",
   "x": 1683,
   "y": 434,
   "w": 214,
   "h": 98,
   "kind": "pap_h",
   "title": "Pathological: PAPILLOMA",
   "lines": [
    "the commonest · also duct ectasia, fibrocystic change, CANCER"
   ]
  },
  {
   "id": "pg_head_0_0",
   "x": 1909,
   "y": 434,
   "w": 214,
   "h": 98,
   "kind": "pg_h",
   "title": "Paget's disease of the nipple",
   "lines": [
    "ALWAYS an underlying CANCER: DCIS or invasive"
   ]
  },
  {
   "id": "cis_head_0_0",
   "x": 2163,
   "y": 434,
   "w": 214,
   "h": 98,
   "kind": "cis_h",
   "title": "Carcinoma IN SITU",
   "lines": [
    "ductal (DCIS) or lobular (LCIS)",
    "intact myoepithelial layer: NOT invaded"
   ]
  },
  {
   "id": "ben_clue_0_0",
   "x": 45,
   "y": 572,
   "w": 214,
   "h": 152,
   "kind": "ben_t",
   "title": "SMOOTH",
   "lines": [
    "• fibroadenoma: 20s–30s, discrete, MOBILE, rubbery",
    "• fibrocystic: lumpy, changes with her CYCLE"
   ]
  },
  {
   "id": "fn_clue_0_0",
   "x": 271,
   "y": 572,
   "w": 214,
   "h": 152,
   "kind": "fn_t",
   "title": "Firm, IRREGULAR mass",
   "lines": [
    "• ± red skin, retraction, dimpling",
    "• often superficial",
    "• may follow TRAUMA"
   ]
  },
  {
   "id": "ca_clue_0_0",
   "x": 497,
   "y": 572,
   "w": 214,
   "h": 152,
   "kind": "ca_t",
   "title": "SINGLE · HARD · FIXED",
   "lines": [
    "• irregular border",
    "• > 2 cm",
    "• skin change, peau d'orange, nipple retraction: LATE"
   ]
  },
  {
   "id": "cyc_clue_0_0",
   "x": 751,
   "y": 572,
   "w": 214,
   "h": 152,
   "kind": "cyc_t",
   "title": "Phasic with her periods",
   "lines": [
    "luteal phase: day 14 to menstruation"
   ]
  },
  {
   "id": "mas_clue_0_0",
   "x": 977,
   "y": 572,
   "w": 214,
   "h": 152,
   "kind": "mas_t",
   "title": "Tense, HOT, painful breast",
   "lines": [
    "• ± fever, tender axillary nodes",
    "• mostly LACTATING: fissures, engorgement"
   ]
  },
  {
   "id": "ic_clue_0_0",
   "x": 1203,
   "y": 572,
   "w": 214,
   "h": 152,
   "kind": "ic_t",
   "title": "Diffuse red, swollen breast",
   "lines": [
    "• resembles acute mastitis",
    "• often PEAU D'ORANGE",
    "• peau d'orange WITHOUT the mastitis look is NOT inflammatory carcinoma"
   ]
  },
  {
   "id": "gal_clue_0_0",
   "x": 1457,
   "y": 572,
   "w": 214,
   "h": 152,
   "kind": "gal_t",
   "title": "Usually BILATERAL · MULTIPLE ducts",
   "lines": [
    "• only on compression",
    "• clear, yellow, grey, brown or green"
   ]
  },
  {
   "id": "pap_clue_0_0",
   "x": 1683,
   "y": 572,
   "w": 214,
   "h": 152,
   "kind": "pap_t",
   "title": "UNILATERAL · SINGLE duct · SPONTANEOUS",
   "lines": [
    "• BLOODY or serous",
    "• with a mass",
    "• over 50"
   ]
  },
  {
   "id": "pg_clue_0_0",
   "x": 1909,
   "y": 572,
   "w": 214,
   "h": 152,
   "kind": "pg_t",
   "title": "Red, scaly, ECZEMA-like nipple + areola",
   "lines": [
    "• erosion, ulceration",
    "• a palpable mass → usually INVASIVE"
   ]
  },
  {
   "id": "cis_clue_0_0",
   "x": 2163,
   "y": 572,
   "w": 214,
   "h": 65,
   "kind": "cis_t",
   "title": "DCIS: CALCIFICATIONS",
   "lines": [
    "on a mammogram"
   ]
  },
  {
   "id": "cis_clue_1_0",
   "x": 2163,
   "y": 659,
   "w": 214,
   "h": 65,
   "kind": "cis_t",
   "title": "LCIS: INCIDENTAL",
   "lines": [
    "on a biopsy for something else"
   ]
  },
  {
   "id": "ben_inv_0_0",
   "x": 45,
   "y": 764,
   "w": 214,
