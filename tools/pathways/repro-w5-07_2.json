   "x": 541,
   "y": 138,
   "w": 456,
   "h": 42,
   "kind": "plain",
   "title": "BREAST PAIN",
   "lines": []
  },
  {
   "id": "g_dis",
   "x": 1037,
   "y": 138,
   "w": 456,
   "h": 42,
   "kind": "plain",
   "title": "NIPPLE DISCHARGE",
   "lines": []
  },
  {
   "id": "g_scr",
   "x": 1533,
   "y": 138,
   "w": 222,
   "h": 42,
   "kind": "plain",
   "title": "SCREENING: no symptoms",
   "lines": []
  },
  {
   "id": "p_lump",
   "x": 45,
   "y": 220,
   "w": 456,
   "h": 114,
   "kind": "info",
   "title": "When you investigate",
   "lines": [
    "IMAGE BY AGE: < 35 ULTRASOUND (breast too dense, risk too low for a mammogram; MRI if high risk) · > 35 MAMMOGRAM ± ultrasound",
    "then SAMPLE: fine needle aspiration → core biopsy → excision"
   ]
  },
  {
   "id": "p_pain",
   "x": 541,
   "y": 220,
   "w": 456,
   "h": 114,
   "kind": "info",
   "title": "Exam: a mass or suspicious finding?",
   "lines": [
    "YES → the LUMP route",
    "NO → is the pain CYCLICAL?"
   ]
  },
  {
   "id": "p_dis",
   "x": 1037,
   "y": 220,
   "w": 456,
   "h": 114,
   "kind": "info",
   "title": "Compress the areola",
   "lines": [
    "colour, consistency, volume, which duct",
    "normal in lactation"
   ]
  },
  {
   "id": "p_scr",
   "x": 1533,
   "y": 220,
   "w": 222,
   "h": 114,
   "kind": "info",
   "title": "Mammogram by RISK",
   "lines": [
    "usual risk, 50–74: every 2 years",
    "40–49: not routinely",
    "HIGH risk: YEARLY (see the panel)"
   ]
  },
  {
   "id": "ben_head_0_0",
   "x": 45,
   "y": 414,
   "w": 222,
   "h": 96,
   "kind": "ben_h",
   "title": "Benign lump",
   "lines": [
    "fibroglandular tissue · cyst · FIBROADENOMA · fibrocystic change"
   ]
  },
  {
   "id": "ca_head_0_0",
   "x": 279,
   "y": 414,
   "w": 222,
   "h": 96,
   "kind": "ca_h",
   "title": "Invasive carcinoma",
   "lines": [
    "malignant cells invade the stroma"
   ]
  },
  {
   "id": "cyc_head_0_0",
   "x": 541,
   "y": 414,
   "w": 222,
   "h": 96,
   "kind": "cyc_h",
   "title": "Cyclical pain",
   "lines": [
    "hormonal: ducts (estrogen), stroma (progesterone)"
   ]
  },
  {
   "id": "mas_head_0_0",
   "x": 775,
   "y": 414,
   "w": 222,
   "h": 96,
   "kind": "mas_h",
   "title": "Mastitis",
   "lines": [
    "also non-cyclical: medicines, Cooper's ligament stretch, extramammary"
   ]
  },
  {
   "id": "gal_head_0_0",
   "x": 1037,
   "y": 414,
   "w": 222,
   "h": 96,
   "kind": "gal_h",
   "title": "Galactorrhea",
   "lines": [
    "physiological: not pregnancy or lactation",
    "not from a breast lesion"
   ]
  },
  {
   "id": "pap_head_0_0",
   "x": 1271,
   "y": 414,
   "w": 222,
   "h": 96,
   "kind": "pap_h",
   "title": "Pathological: PAPILLOMA",
   "lines": [
    "the commonest · also duct ectasia, fibrocystic change, CANCER"
   ]
  },
  {
   "id": "cis_head_0_0",
   "x": 1533,
   "y": 414,
   "w": 222,
   "h": 96,
   "kind": "cis_h",
   "title": "Carcinoma IN SITU",
   "lines": [
    "ductal (DCIS) or lobular (LCIS)",
    "intact myoepithelial layer: NOT invaded"
   ]
  },
  {
   "id": "ben_clue_0_0",
   "x": 45,
   "y": 550,
   "w": 222,
   "h": 196,
   "kind": "ben_t",
   "title": "SMOOTH",
   "lines": [
    "fibroadenoma: 20s–30s, discrete, MOBILE, rubbery",
    "fibrocystic: lumpy, changes with her CYCLE"
   ]
  },
  {
   "id": "ca_clue_0_0",
   "x": 279,
   "y": 550,
   "w": 222,
   "h": 96,
   "kind": "ca_t",
   "title": "SINGLE · HARD · FIXED",
   "lines": [
    "irregular border · > 2 cm",
    "skin change, peau d'orange, nipple retraction: LATE"
   ]
  },
  {
   "id": "ca_clue_1_0",
   "x": 279,
   "y": 668,
   "w": 222,
   "h": 78,
   "kind": "ca_w",
   "title": "Mimic: FAT NECROSIS",
   "lines": [
    "firm, irregular, skin dimpling · after TRAUMA"
   ]
  },
  {
   "id": "cyc_clue_0_0",
   "x": 541,
   "y": 550,
   "w": 222,
   "h": 196,
   "kind": "cyc_t",
   "title": "Phasic with her periods",
   "lines": [
    "luteal phase: day 14 to menstruation"
   ]
  },
  {
   "id": "mas_clue_0_0",
   "x": 775,
   "y": 550,
   "w": 222,
   "h": 196,
   "kind": "mas_t",
   "title": "Tense, HOT, painful breast",
   "lines": [
    "± fever, tender axillary nodes",
    "mostly LACTATING: fissures, engorgement"
   ]
  },
  {
   "id": "gal_clue_0_0",
   "x": 1037,
   "y": 550,
   "w": 222,
   "h": 196,
   "kind": "gal_t",
   "title": "Usually BILATERAL · MULTIPLE ducts",
   "lines": [
    "only on compression · clear, yellow, grey, brown or green"
   ]
  },
  {
   "id": "pap_clue_0_0",
   "x": 1271,
   "y": 550,
   "w": 222,
   "h": 196,
   "kind": "pap_t",
   "title": "UNILATERAL · SINGLE duct · SPONTANEOUS",
   "lines": [
    "BLOODY or serous · with a mass · over 50"
   ]
  },
  {
   "id": "cis_clue_0_0",
   "x": 1533,
   "y": 550,
   "w": 222,
   "h": 87,
   "kind": "cis_t",
   "title": "DCIS: CALCIFICATIONS",
   "lines": [
    "on a mammogram"
   ]
  },
  {
   "id": "cis_clue_1_0",
   "x": 1533,
   "y": 659,
   "w": 222,
   "h": 87,
   "kind": "cis_t",
   "title": "LCIS: INCIDENTAL",
   "lines": [
    "on a biopsy for something else"
   ]
  },
  {
   "id": "ben_inv_0_0",
   "x": 45,
   "y": 786,
   "w": 222,
   "h": 118,
   "kind": "ben_w",
   "title": "1 · Pre-menopausal: recheck after her NEXT PERIOD",
   "lines": []
  },
  {
   "id": "ben_inv_1_0",
   "x": 45,
   "y": 926,
   "w": 222,
   "h": 98,
   "kind": "ben_w",
   "title": "2 · Not resolved → image by age, sample",
   "lines": []
  },
  {
   "id": "ca_inv_0_0",
   "x": 279,
   "y": 786,
   "w": 222,
   "h": 107,
   "kind": "bad",
   "title": "1 · Investigate NOW",
   "lines": [
    "also if post-menopausal or high risk"
   ]
  },
  {
   "id": "ca_inv_1_0",
   "x": 279,
   "y": 915,
   "w": 222,
   "h": 109,
   "kind": "ca_w",
   "title": "2 · Image by age, then BIOPSY",
   "lines": [
    "fat necrosis is biopsied too"
   ]
  },
  {
   "id": "cyc_inv_0_0",
   "x": 541,
   "y": 786,
   "w": 222,
   "h": 108,
   "kind": "ok",
   "title": "< 35 + normal exam: NO tests",
   "lines": []
  },
  {
   "id": "cyc_inv_1_0",
   "x": 541,
   "y": 916,
   "w": 222,
   "h": 108,
   "kind": "cyc_w",
   "title": "Older: more likely real pathology",
   "lines": []
  },
  {
   "id": "mas_inv_0_0",
   "x": 775,
   "y": 786,
   "w": 222,
   "h": 80,
   "kind": "mas_w",
   "title": "1 · Antibiotics fail → ultrasound",
   "lines": [
    "ABSCESS?"
   ]
  },
  {
   "id": "mas_inv_1_0",
   "x": 775,
   "y": 888,
   "w": 222,
   "h": 136,
   "kind": "bad",
   "title": "2 · Not lactating or persistent: rule out CANCER",
   "lines": [
    "mammogram, biopsy · inflammatory carcinoma mimics mastitis"
   ]
  },
  {
   "id": "gal_inv_0_0",
   "x": 1037,
   "y": 786,
   "w": 222,
   "h": 238,
   "kind": "gal_w",
   "title": "Look for the cause",
   "lines": [
    "pituitary: HYPERPROLACTINEMIA · dopamine-suppressing drugs (methyldopa)",
    "nipple stimulation · hypothyroid, kidney disease, cirrhosis"
   ]
  },
  {
   "id": "pap_inv_0_0",
   "x": 1271,
   "y": 786,
   "w": 222,
   "h": 108,
   "kind": "bad",
   "title": "1 · Inspect the nipple: PAGET'S?",
   "lines": [
    "eczema-like nipple = an underlying carcinoma"
   ]
  },
  {
   "id": "pap_inv_1_0",
   "x": 1271,
   "y": 916,
   "w": 222,
   "h": 108,
   "kind": "pap_w",
   "title": "2 · Periareolar ultrasound + mammogram",
   "lines": [
    "galactogram maps the duct, but is NOT diagnostic"
   ]
  },
  {
   "id": "cis_inv_0_0",
   "x": 1533,
   "y": 786,
   "w": 222,
   "h": 108,
   "kind": "cis_w",
   "title": "DCIS: a PRECURSOR",
   "lines": [
    "of invasive cancer"
   ]
  },
  {
   "id": "cis_inv_1_0",
   "x": 1533,
   "y": 916,
   "w": 222,
   "h": 108,
   "kind": "cis_w",
   "title": "LCIS: a RISK FACTOR",
   "lines": [
    "a non-obligate precursor"
   ]
  },
  {
   "id": "ben_tx_0_0",
   "x": 45,
   "y": 1064,
   "w": 222,
   "h": 87,
   "kind": "ok",
   "title": "Resolved: follow",
   "lines": []
  },
  {
   "id": "ben_tx_1_0",
   "x": 45,
   "y": 1173,
   "w": 222,
   "h": 125,
   "kind": "ok",
   "title": "Benign biopsy: the report sets her risk",
   "lines": [
    "see the panel"
   ]
  },
  {
   "id": "ca_tx_0_0",
   "x": 279,
   "y": 1064,
   "w": 222,
   "h": 132,
   "kind": "ok",
   "title": "Receptors pick the drug",
   "lines": [
    "estrogen / progesterone receptor (ER/PR) POSITIVE → tamoxifen or an aromatase inhibitor",
    "HER2/neu overexpressed → trastuzumab"
   ]
  },
  {
   "id": "ca_tx_1_0",
   "x": 279,
   "y": 1218,
   "w": 222,
   "h": 80,
   "kind": "warn",
   "title": "Axillary NODES: the key prognostic factor",
   "lines": [
    "if no distant metastases"
   ]
  },
  {
   "id": "cyc_tx_0_0",
   "x": 541,
   "y": 1064,
   "w": 222,
   "h": 78,
   "kind": "ok",
   "title": "1 · Stop an offending pill",
   "lines": [
    "birth control pill or hormone replacement therapy (HRT)"
   ]
  },
  {
   "id": "cyc_tx_1_0",
   "x": 541,
   "y": 1164,
   "w": 222,
   "h": 134,
   "kind": "ok",
   "title": "2 · SEVERE and > 7 days: treat",
   "lines": [
    "supportive bra · compresses · nonsteroidal anti-inflammatories (NSAIDs), acetaminophen · tamoxifen"
   ]
  },
  {
   "id": "mas_tx_0_0",
   "x": 775,
   "y": 1064,
   "w": 222,
   "h": 124,
   "kind": "ok",
   "title": "1 · Antibiotics",
   "lines": [
    "lactating: KEEP breastfeeding, empty the breast",
    "not lactating: imaging OK → repeat in 3 months"
   ]
  },
  {
   "id": "mas_tx_1_0",
   "x": 775,
   "y": 1210,
   "w": 222,
   "h": 88,
   "kind": "bad",
   "title": "2 · Abscess",
   "lines": [
    "ultrasound-guided aspiration, or incision + drainage"
   ]
  },
  {
   "id": "gal_tx_0_0",
   "x": 1037,
   "y": 1064,
