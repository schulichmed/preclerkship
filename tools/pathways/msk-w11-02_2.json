 "panels": [
  {
   "x": 45,
   "y": 1727,
   "w": 620,
   "title": "Synovial fluid: aspirate to decide",
   "items": [
    "normal: clear · thick · white cells < 200 · neutrophils < 25%",
    "non-inflammatory: yellow, transparent · thick · < 2000 · < 25%",
    "inflammatory: yellow, cloudy · moderate · > 2000 · > 50% · crystals possible",
    "infectious: yellow-green, cloudy · thin · > 2000 · > 75% · Gram stain and culture POSITIVE"
   ],
   "cols": 1
  },
  {
   "x": 680,
   "y": 1727,
   "w": 620,
   "title": "Acute (6 weeks or less) or chronic?",
   "items": [
    "acute: infectious and post-infectious (incl. viral) · crystals · rheumatic fever · drug reaction (serum sickness) · EARLY autoimmune",
    "chronic: rheumatoid · connective tissue disease · seronegative · palindromic · vasculitis · polyarticular JIA · Still's · sarcoidosis",
    "many acute forms become chronic if autoimmune"
   ],
   "cols": 1
  },
  {
   "x": 1314,
   "y": 1727,
   "w": 620,
   "title": "Tests for everyone (safety + inflammation)",
   "items": [
    "blood count: anemia of chronic disease, platelets ↑ (inflammation), low counts (autoimmune)",
    "creatinine and liver enzymes (drug clearance) · C-reactive protein (sedimentation rate not routine)",
    "don't order ANA and RF reflexively: think of the differential first"
   ],
   "cols": 1
  },
  {
   "x": 1948,
   "y": 1727,
   "w": 620,
   "title": "X-ray: who erodes?",
   "items": [
    "erodes: rheumatoid, psoriatic and other spondyloarthritis, gout, septic",
    "does NOT erode: lupus, Sjögren's",
    "little help when acute: damage takes years"
   ],
   "cols": 1
  }
 ]
