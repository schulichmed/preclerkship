   "id": "dna_means_0_0",
   "x": 321,
   "y": 588,
   "w": 236,
   "h": 168,
   "kind": "dna_w",
   "title": "Very SPECIFIC for SLE",
   "lines": [
    "positive in only ~50%",
    "tracks renal SLE + activity",
    "may turn negative with treatment"
   ]
  },
  {
   "id": "ena_means_0_0",
   "x": 597,
   "y": 588,
   "w": 236,
   "h": 168,
   "kind": "ena_w",
   "title": "Antibody → disease",
   "lines": [
    "• Ro: SLE photosensitive rash; baby: heart block",
    "• Ro + La: Sjögren's",
    "• Sm: fairly specific for SLE",
    "• RNP: mixed CTD + SLE",
    "• Scl-70: scleroderma + lung disease",
    "• Jo1: polymyositis + lung disease"
   ]
  },
  {
   "id": "cpl_means_0_0",
   "x": 873,
   "y": 588,
   "w": 236,
   "h": 168,
   "kind": "cpl_w",
   "title": "LOW",
   "lines": [
    "active SLE, esp. lupus nephritis (used up)",
    "or an inherited deficiency"
   ]
  },
  {
   "id": "ana_dont_0_0",
   "x": 45,
