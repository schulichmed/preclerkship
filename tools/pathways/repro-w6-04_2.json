   ]
  },
  {
   "id": "s3_do_0_0",
   "x": 817,
   "y": 672,
   "w": 236,
   "h": 116,
   "kind": "ok",
   "title": "Active management, every birth",
   "lines": [
    "• uterotonic: oxytocin or ergot",
    "• gentle cord traction",
    "• fundal massage"
   ]
  },
  {
   "id": "s4_do_0_0",
   "x": 1065,
   "y": 672,
   "w": 236,
   "h": 116,
   "kind": "ok",
   "title": "Baby",
   "lines": [
