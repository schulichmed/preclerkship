   "y": 562,
   "w": 236,
   "h": 106,
   "kind": "fhr_t",
   "title": "Decelerations",
   "lines": [
    "• early: head compression",
    "• variable: cord compression",
    "• late: ↓ flow through the placenta"
   ]
  },
