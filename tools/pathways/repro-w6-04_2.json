   "x": 45,
   "y": 552,
   "w": 236,
   "h": 116,
   "kind": "s1_w",
   "title": "Contractions + fetal heart rate (FHR)",
   "lines": [
    "• palpate contractions every 30 min",
    "• low risk: FHR intermittently every 15 min"
   ]
  },
  {
   "id": "fhr_watch_0_0",
   "x": 293,
   "y": 416,
   "w": 236,
   "h": 124,
   "kind": "fhr_w",
   "title": "Who needs it",
   "lines": [
    "• preeclampsia, bleeding, atypical FHR",
    "• oxytocin induction or augmentation",
    "• vaginal birth after cesarean"
   ]
  },
