   "id": "s1_watch_0_0",
   "x": 45,
   "y": 398,
   "w": 236,
   "h": 96,
   "kind": "s1_w",
   "title": "Cervix every 2–3 h",
   "lines": [
    "dilation, effacement, station",
    "~sooner for symptoms or a heart rate change"
   ]
  },
  {
   "id": "s1_watch_1_0",
   "x": 45,
   "y": 516,
   "w": 236,
   "h": 116,
   "kind": "s1_w",
   "title": "Contractions + fetal heart rate (FHR)",
   "lines": [
    "• palpate contractions every 30 min",
    "• low risk: FHR intermittently every 15 min"
   ]
  },
  {
   "id": "fhr_watch_0_0",
   "x": 293,
   "y": 398,
   "w": 236,
   "h": 115,
   "kind": "fhr_w",
   "title": "Who needs it",
   "lines": [
    "• preeclampsia, bleeding, atypical FHR",
    "• oxytocin induction or augmentation",
    "• vaginal birth after cesarean"
   ]
  },
  {
   "id": "fhr_watch_1_0",
   "x": 293,
   "y": 535,
   "w": 236,
   "h": 97,
   "kind": "fhr_t",
   "title": "Decelerations",
   "lines": [
    "• early: head compression",
    "• variable: cord compression",
    "• late: ↓ flow through the placenta"
   ]
  },
  {
   "id": "s2_watch_0_0",
   "x": 541,
   "y": 398,
   "w": 236,
   "h": 106,
   "kind": "s2_w",
   "title": "Station (descent)",
   "lines": [
    "0 = ischial spines, then +1 to +5 cm"
   ]
  },
  {
   "id": "s2_watch_1_0",
   "x": 541,
   "y": 526,
   "w": 236,
   "h": 106,
   "kind": "s2_w",
   "title": "FHR every 5 min",
   "lines": [
    "or continuous"
   ]
  },
  {
   "id": "s3_watch_0_0",
   "x": 817,
   "y": 398,
   "w": 236,
   "h": 234,
   "kind": "s3_w",
   "title": "Signs of separation",
   "lines": [
    "• uterus firm, globular: the EARLIEST",
    "• gush of blood, uterus rises",
    "• cord lengthens"
   ]
  },
  {
   "id": "s4_watch_0_0",
   "x": 1065,
   "y": 398,
   "w": 236,
   "h": 234,
   "kind": "s4_w",
   "title": "Maternal vitals",
   "lines": [
    "up to 500 mL autotransfused back to her → ↑ cardiac work"
   ]
  },
  {
   "id": "s1_do_0_0",
   "x": 45,
   "y": 672,
   "w": 236,
   "h": 116,
   "kind": "ok",
   "title": "Pain from T10–T12",
   "lines": [
    "• epidural: the most common",
    "• spinal, nitrous oxide, patient-controlled analgesia"
   ]
  },
  {
   "id": "fhr_do_0_0",
   "x": 293,
   "y": 672,
   "w": 236,
   "h": 116,
   "kind": "fhr_w",
   "title": "Read the tracing",
   "lines": [
    "• normal: continue",
    "• atypical: resuscitate, find the cause",
    "• abnormal: resuscitate, deliver promptly"
   ]
  },
  {
   "id": "s2_do_0_0",
   "x": 541,
   "y": 672,
   "w": 236,
   "h": 116,
   "kind": "ok",
   "title": "Pain from S2–S4",
   "lines": [
