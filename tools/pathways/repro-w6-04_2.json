 "panels": [
  {
   "x": 45,
   "y": 1114,
   "w": 409,
   "title": "Lie · presentation · position (vaginal exam)",
   "items": [
    "lie (long axis vs mother's): LONGITUDINAL 99% · transverse or oblique 1%",
    "presentation (part foremost in the canal): vertex 95% · breech 4%",
    "breech: FRANK 70% (thighs flexed, knees extended) → vaginal OK · complete (thighs + knees flexed) · FOOTLING (feet below buttocks) → NOT vaginal, unless the second twin",
    "position: occiput, sacrum or chin vs left or right, anterior or posterior · LEFT OCCIPUT ANTERIOR most common",
    "occiput ANTERIOR: biparietal diameter (9.5 cm, narrowest) first, easier · occiput POSTERIOR: widest part first, very long pushing"
   ],
   "cols": 1
  },
  {
   "x": 468,
   "y": 1114,
   "w": 409,
   "title": "Leopold maneuvers (+ vaginal exam, ultrasound)",
   "items": [
    "1 · fundus: consistency, shape, mobility (head or bottom up there?)",
    "2 · both sides: which side is the fetal BACK on?",
    "3 · part at the pelvic inlet + its mobility: engaged or not?",
    "4 · attitude: feel the brow, head flexed or extended?"
   ],
   "cols": 1
  },
  {
   "x": 892,
   "y": 1114,
   "w": 409,
   "title": "2nd stage: the cardinal movements",
   "items": [
    "engagement → descent → flexion → internal rotation → extension → external rotation (restitution) → expulsion",
    "expulsion: ANTERIOR shoulder under the pubis first, then posterior",
    "pelvis: gynecoid + android do best · platypelloid + anthropoid (narrow or flat) inhibit the movements"
   ],
   "cols": 1
  }
 ]
