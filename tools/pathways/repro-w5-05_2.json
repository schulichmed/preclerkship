 "nodes": [
  {
   "id": "root",
   "x": 506,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Abnormal uterine bleeding (AUB): divide by AGE first",
   "lines": [
    "any change in frequency, duration or amount of flow, or bleeding between cycles",
    "every one: is she STABLE? vitals first · β-hCG (pregnant: see the FIRST-TRIMESTER BLEEDING chart)"
   ]
  },
  {
   "id": "g_rep",
   "x": 45,
   "y": 138,
   "w": 456,
   "h": 78,
   "kind": "plain",
   "title": "REPRODUCTIVE AGE: does the EXAM find a lesion?",
   "lines": [
    "treat the cause; otherwise regulate the bleeding: medicines → minimally invasive (embolization, ablation) → hysterectomy"
   ]
  },
  {
   "id": "g_age",
   "x": 541,
   "y": 138,
   "w": 456,
   "h": 78,
   "kind": "plain",
   "title": "ADOLESCENCE + PERIMENOPAUSE",
   "lines": [
    "both: more ANOVULATION"
   ]
  },
  {
   "id": "g_pmb",
   "x": 1037,
   "y": 138,
   "w": 690,
   "h": 78,
   "kind": "plain",
   "title": "POST-MENOPAUSAL: any bleeding after 12 months without menses",
   "lines": [
    "ENDOMETRIAL CARCINOMA MUST BE EXCLUDED"
   ]
  },
  {
   "id": "p_pmb",
   "x": 1037,
   "y": 256,
   "w": 690,
   "h": 114,
   "kind": "info",
   "title": "Work up in order",
   "lines": [
    "1 · Exam with a SPECULUM: a negative Pap test does not end it",
    "2 · Transvaginal ultrasound: endometrium < 5 mm is normal",
    "3 · ENDOMETRIAL BIOPSY if > 5 mm, or bleeding recurs · HYSTEROSCOPY for a focal lesion or a failed biopsy",
    "the biopsy report picks the column ↓"
   ]
  },
