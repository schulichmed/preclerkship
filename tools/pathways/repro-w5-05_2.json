   "title": "Endometrial carcinoma",
   "lines": [
    "#1 gynecologic malignancy",
    "4th cancer in women · 90% present with BLEEDING · 72% stage 1"
   ]
  },
  {
   "id": "pa_clue_0_0",
   "x": 45,
   "y": 694,
   "w": 222,
   "h": 270,
   "kind": "pa_t",
   "title": "The exam finds it",
   "lines": [
    "• mass at the os",
    "• ENLARGED uterus (fibroid, adenomyosis)",
    "• FIXED (cancer)"
   ]
  },
  {
   "id": "co_clue_0_0",
   "x": 279,
   "y": 694,
   "w": 222,
   "h": 134,
   "kind": "co_t",
   "title": "ANOVULATION: the major cause",
   "lines": [
    "• stress, weight, exercise",
    "• thyroid, prolactin",
    "• polycystic ovary syndrome (PCOS)"
   ]
  },
  {
   "id": "co_clue_1_0",
   "x": 279,
   "y": 850,
   "w": 222,
   "h": 114,
   "kind": "co_w",
   "title": "Look for",
   "lines": [
    "• bruising, petechiae",
    "• galactorrhea, hirsutism, thyroid signs",
    "• hormones she takes"
   ]
  },
  {
   "id": "ad_clue_0_0",
   "x": 541,
   "y": 694,
   "w": 222,
   "h": 270,
   "kind": "ad_t",
   "title": "Think",
   "lines": [
    "• COAGULOPATHY: menarche can unmask von Willebrand",
    "• eating disorder, ++ exercise",
    "• pregnancy"
   ]
  },
  {
   "id": "pe_clue_0_0",
   "x": 775,
   "y": 694,
   "w": 222,
   "h": 270,
   "kind": "pe_t",
   "title": "Can be severe",
   "lines": [
    "ask about her cycles: one arrest had a hemoglobin of 38"
   ]
  },
  {
   "id": "at_clue_0_0",
   "x": 1037,
   "y": 694,
   "w": 222,
   "h": 270,
   "kind": "at_t",
   "title": "Exam",
   "lines": [
    "thin, pale, dry epithelium · lost labial fullness · narrow introitus · lost urethral meatal turgor"
   ]
  },
  {
   "id": "hy_clue_0_0",
   "x": 1271,
   "y": 694,
   "w": 222,
   "h": 270,
   "kind": "hy_t",
   "title": "UNOPPOSED ESTROGEN",
   "lines": [
    "• obesity",
    "• PCOS",
    "• estrogen-only HRT",
    "• tamoxifen",
    "• also: estrogen-secreting tumour (granulosa) · nulliparity, infertility, early menarche, late menopause",
    "• HRT: PMB in 63% in first 6 cycles · estrogen alone → hyperplasia 10% at 1 yr, 50% at 2"
   ]
  },
  {
   "id": "ca_clue_0_0",
   "x": 1505,
   "y": 694,
   "w": 222,
   "h": 270,
   "kind": "ca_t",
   "title": "Type 1 (90%) or type 2",
   "lines": [
    "• 1: endometrioid, estrogen-driven, hyperplasia precursor · BETTER prognosis",
    "• 2 (10%): serous, older, atrophic background · POORER",
    "• Lynch: 40–70% lifetime risk, often the SENTINEL cancer"
   ]
  },
