   ]
  },
  {
   "id": "hgg_tx_0_0",
   "x": 345,
   "y": 1242,
   "w": 260,
   "h": 168,
   "kind": "bad",
   "title": "TREAT IMMEDIATELY",
   "lines": [
    "1 · maximal safe resection (deep → stereotactic biopsy)",
    "2 · radiation, 15-30 treatments",
    "3 · temozolomide (oral) during and 6-12 months after",
    "~ resecting all visible tumour helps, but NOT curative"
   ]
  },
  {
   "id": "hgg_tx_1_0",
   "x": 345,
   "y": 1432,
   "w": 260,
   "h": 150,
   "kind": "hgg_w",
   "title": "Glioblastoma survival",
   "lines": [
    "• radiation alone: 10-12 months · 2-year 10%",
    "• + temozolomide: 14-15 months · 2-year 26%",
    "• surgery + both: 18 months · 2-year 40%",
    "~ worse with age, poor performance status"
   ]
  },
  {
   "id": "hgg_tx_2_0",
   "x": 345,
   "y": 1604,
   "w": 260,
   "h": 132,
   "kind": "warn",
   "title": "Radiation side effects",
   "lines": [
    "• early: neuro worsening, hair loss, dermatitis, otitis externa, fatigue",
    "• late: cognitive decline, focal necrosis, radiation vasculitis (stroke), second cancer"
   ]
  },
  {
