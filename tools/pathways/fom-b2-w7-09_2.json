 "nodes": [
  {
   "id": "root",
   "x": 351,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "WEAKNESS: WHERE is the lesion, and how FAST did it come?",
   "lines": [
    "describe → LOCALIZE (upper or lower motor neuron, then the pattern) → differential by TEMPO → plan tests",
    "cerebellum and basal ganglia do NOT cause weakness: incoordination, parkinsonism or extra movements instead"
   ]
  },
  {
   "id": "g_umn",
   "x": 45,
   "y": 138,
   "w": 440,
   "h": 78,
   "kind": "plain",
   "title": "UPPER motor neuron (UMN): CENTRAL",
   "lines": [
    "brisk reflexes · Babinski (extensor plantar) · spasticity · NO atrophy, NO fasciculations"
   ]
  },
  {
   "id": "g_lmn",
   "x": 525,
   "y": 138,
   "w": 892,
   "h": 78,
   "kind": "plain",
   "title": "LOWER motor neuron (LMN): PERIPHERAL",
   "lines": [
    "reflexes ↓ or absent · plantar flexor or absent · normal tone · ATROPHY · fasciculations possible"
   ]
  },
  {
   "id": "br_head_0_0",
   "x": 45,
   "y": 296,
   "w": 214,
   "h": 114,
   "kind": "br_h",
   "title": "Brain",
   "lines": [
