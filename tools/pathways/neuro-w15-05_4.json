   "kind": "tox_w",
   "title": "case: 2, unsteady + slow for 2 hours",
   "lines": [
    "somnolent · sibling's carbamazepine within reach → poison control"
   ]
  },
  {
   "id": "pi_pres_0_0",
   "x": 272,
   "y": 506,
   "w": 215,
   "h": 179,
   "kind": "pi_t",
   "title": "Viral illness 1-4 weeks before",
   "lines": [
    "• varicella, mono, respiratory or gut virus",
    "• ABRUPT, worse over 1-2 days, better over weeks",
    "• well, afebrile · no headache"
   ]
  },
  {
   "id": "pi_pres_1_0",
   "x": 272,
   "y": 707,
   "w": 215,
   "h": 105,
   "kind": "pi_w",
   "title": "case: 3, 'drunk' for 2 days",
   "lines": [
    "afebrile, well · daycare viruses within a month · wide-based gait"
   ]
  },
  {
   "id": "tum_pres_0_0",
   "x": 499,
   "y": 506,
   "w": 215,
   "h": 152,
   "kind": "tum_t",
   "title": "PROGRESSIVE over weeks",
   "lines": [
