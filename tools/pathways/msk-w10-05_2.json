   "kind": "cel_t",
   "title": "DORSAL hand, wrist to knuckles",
   "lines": [
    "IRREGULAR margins"
   ]
  },
  {
   "id": "deep_clue_0_0",
   "x": 289,
   "y": 434,
   "w": 232,
   "h": 133,
   "kind": "deep_t",
   "title": "Where is the pus?",
   "lines": [
    "• nail fold: PARONYCHIA (S. aureus)",
    "• fingertip pulp: FELON",
    "• flexor tendon sheath: TENOSYNOVITIS"
   ]
  },
  {
   "id": "deep_clue_1_0",
   "x": 289,
   "y": 589,
   "w": 232,
   "h": 115,
   "kind": "deep_w",
   "title": "Bite over a joint",
   "lines": [
    "• cat, finger joints: Pasteurella multocida",
    "• human, fist fight, knuckle: Eikenella corrodens"
   ]
  },
  {
   "id": "oth_clue_0_0",
   "x": 561,
   "y": 434,
   "w": 232,
   "h": 169,
   "kind": "oth_t",
   "title": "Ask: partners, ticks, travel",
   "lines": [
    "• young, multiple partners: GONOCOCCAL",
    "• disseminated: tenosynovitis + pustular rash + polyarthralgia",
    "• endemic country: TUBERCULOSIS"
   ]
  },
  {
   "id": "oth_clue_1_0",
   "x": 561,
   "y": 625,
   "w": 232,
   "h": 79,
   "kind": "bad",
   "title": "SEVERAL joints, bacterial",
   "lines": [
    "THINK ENDOCARDITIS"
   ]
  },
  {
   "id": "om_clue_0_0",
   "x": 833,
   "y": 434,
   "w": 232,
   "h": 133,
   "kind": "om_t",
   "title": "Vertebral: severe back pain",
   "lines": [
    "• often afebrile · people who inject drugs",
    "• check strength, reflexes, anal tone"
   ]
  },
  {
   "id": "om_clue_1_0",
   "x": 833,
   "y": 589,
   "w": 232,
   "h": 115,
   "kind": "om_w",
   "title": "Child under 12: metaphysis",
   "lines": [
    "S. aureus always · Salmonella in sickle cell · Kingella"
   ]
  },
  {
   "id": "dfi_clue_0_0",
   "x": 1077,
   "y": 434,
   "w": 232,
   "h": 134,
   "kind": "dfi_t",
   "title": "A wound is NOT always infected",
   "lines": [
    "• swab any wound and bacteria grow",
    "• smelly? probe to bone? blood supply?"
   ]
  },
  {
   "id": "dfi_clue_1_0",
   "x": 1077,
   "y": 590,
   "w": 232,
   "h": 114,
   "kind": "dfi_w",
   "title": "Grade",
   "lines": [
    "• mild: skin only",
    "• moderate: over 2 cm or deeper",
    "• severe: + systemic inflammatory response"
   ]
  },
  {
   "id": "cel_inv_0_0",
   "x": 45,
   "y": 744,
   "w": 232,
   "h": 180,
   "kind": "cel_w",
   "title": "Clinical",
   "lines": [
    "no pus, no closed space"
   ]
  },
  {
   "id": "deep_inv_0_0",
   "x": 289,
   "y": 744,
   "w": 232,
   "h": 180,
   "kind": "deep_t",
   "title": "Kanavel's 4 signs = tenosynovitis",
   "lines": [
    "• whole finger swollen",
    "• held flexed · tender along the sheath",
    "• intense pain on extension"
   ]
  },
  {
   "id": "oth_inv_0_0",
   "x": 561,
   "y": 744,
   "w": 232,
   "h": 180,
   "kind": "oth_w",
   "title": "Match the test to the bug",
   "lines": [
    "• gonococcus: urine, rectal, throat nucleic acid test or culture + blood culture (joint fluid + in only 50%)",
    "• Lyme: serology · tuberculosis: joint fluid for acid-fast bacilli"
   ]
  },
  {
   "id": "om_inv_0_0",
   "x": 833,
   "y": 744,
   "w": 232,
   "h": 43,
   "kind": "om_t",
   "title": "1 · Blood cultures",
   "lines": []
  },
  {
   "id": "om_inv_1_0",
   "x": 833,
   "y": 809,
   "w": 232,
   "h": 115,
   "kind": "om_t",
   "title": "2 · MRI = most sensitive",
   "lines": [
    "• X-ray, CT not sensitive enough",
    "• tagged white cell scan takes 2 days",
    "• don't repeat if improving"
   ]
  },
  {
   "id": "dfi_inv_0_0",
   "x": 1077,
   "y": 744,
   "w": 232,
   "h": 98,
   "kind": "dfi_w",
   "title": "1 · Bloods; swab only a good deep specimen",
   "lines": [
    "blood count, electrolytes, creatinine, C-reactive protein"
   ]
  },
  {
   "id": "dfi_inv_1_0",
   "x": 1077,
   "y": 864,
   "w": 232,
   "h": 60,
   "kind": "dfi_w",
   "title": "2 · X-ray first → MRI",
   "lines": [
    "for osteomyelitis under the ulcer"
   ]
  },
  {
   "id": "cel_tx_0_0",
   "x": 45,
   "y": 964,
   "w": 232,
   "h": 350,
   "kind": "ok",
   "title": "Antibiotics",
   "lines": [
    "+ rest, elevation"
   ]
  },
  {
   "id": "deep_tx_0_0",
   "x": 289,
   "y": 964,
   "w": 232,
   "h": 350,
   "kind": "bad",
   "title": "Incision and drainage",
   "lines": [
    "+ wound care + antibiotics (bites: broad-spectrum)"
   ]
  },
  {
   "id": "oth_tx_0_0",
   "x": 561,
   "y": 964,
   "w": 232,
   "h": 350,
   "kind": "ok",
   "title": "Bug-specific",
   "lines": [
    "• gonococcal: ceftriaxone 10–14 days",
    "• Lyme: IV ceftriaxone 28 days",
    "• tuberculosis: RIPE four-drug therapy, 9 months–1 year"
   ]
  },
  {
   "id": "om_tx_0_0",
   "x": 833,
   "y": 964,
   "w": 232,
   "h": 165,
   "kind": "bad",
   "title": "Cord compressed or epidural abscess",
   "lines": [
    "→ neurosurgery"
   ]
  },
  {
   "id": "om_tx_1_0",
   "x": 833,
   "y": 1151,
   "w": 232,
   "h": 163,
   "kind": "ok",
   "title": "IV vancomycin + ceftriaxone",
   "lines": [
    "• 6 weeks (vertebral)",
    "• debride dead bone if needed"
   ]
  },
  {
   "id": "dfi_tx_0_0",
   "x": 1077,
   "y": 964,
   "w": 232,
   "h": 78,
   "kind": "ok",
   "title": "Mild, one bug (staph, strep)",
   "lines": [
    "cefazolin (or cephalexin, doxycycline, amoxicillin-clavulanate)"
   ]
  },
  {
   "id": "dfi_tx_1_0",
   "x": 1077,
   "y": 1064,
   "w": 232,
   "h": 96,
   "kind": "warn",
   "title": "Chronic: polymicrobial",
   "lines": [
    "amoxicillin-clavulanate · Pseudomonas → piperacillin-tazobactam"
   ]
  },
  {
   "id": "dfi_tx_2_0",
   "x": 1077,
   "y": 1182,
   "w": 232,
   "h": 132,
   "kind": "bad",
   "title": "Severe",
   "lines": [
    "• exclude necrotizing fasciitis",
    "• piperacillin-tazobactam ± vancomycin",
    "• offload, debride, call ortho or vascular"
   ]
  }
