 "nodes": [
  {
   "id": "root",
   "x": 193,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "GI bleed: RESUSCITATE first, then UPPER or LOWER (the ligament of Treitz)?",
   "lines": [
    "airway (intubate if needed) · 2 large-bore IVs · fluids · transfuse",
    "correct coagulopathy: fresh frozen plasma, platelets, vitamin K, Octaplex · STOP anticoagulants and antiplatelets",
    "NO visible blood (OCCULT: positive fecal occult blood or iron deficiency anemia) → rule out colorectal and other cancers"
   ]
  },
  {
   "id": "g_up",
   "x": 45,
   "y": 156,
   "w": 508,
   "h": 132,
   "kind": "plain",
   "title": "UPPER: HEMATEMESIS or MELENA",
   "lines": [
    "• ↑ urea : creatinine, or fresh blood up a nasogastric tube",
    "• HIGHER MORTALITY: age > 60, shock, heart disease or cirrhosis, fresh red blood, bleeding that persists or starts in hospital",
    "• urgent esophagogastroduodenoscopy (EGD) AFTER resuscitation: finds AND treats"
   ]
  },
  {
   "id": "g_lo",
   "x": 593,
   "y": 156,
   "w": 508,
   "h": 132,
   "kind": "plain",
   "title": "LOWER: HEMATOCHEZIA · is the patient STABLE?",
   "lines": [
    "• #1 diverticulosis (usually stops), hemorrhoids, fissure",
    "• inflammatory bowel disease, cancer, ischemic or infectious colitis, radiation, post-polypectomy"
   ]
  },
  {
   "id": "nv_head_0_0",
   "x": 45,
   "y": 368,
   "w": 248,
   "h": 78,
   "kind": "nv_h",
   "title": "Non-variceal upper bleed",
   "lines": [
    "ulcer, gastritis, esophagitis, Mallory-Weiss tear, cancer"
   ]
  },
  {
   "id": "va_head_0_0",
   "x": 305,
   "y": 368,
   "w": 248,
   "h": 78,
   "kind": "va_h",
   "title": "Variceal upper bleed",
   "lines": [
    "portal hypertension: esophageal or gastric varices"
   ]
  },
  {
   "id": "ls_head_0_0",
