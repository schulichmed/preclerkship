   ]
  },
  {
   "id": "blues_clue_0_0",
   "x": 45,
   "y": 416,
   "w": 240,
   "h": 216,
   "kind": "blues_t",
   "title": "Onset day 3–10",
   "lines": [
    "• weepy, labile mood",
    "• insomnia, poor concentration",
    "• anxious, irritable"
   ]
  },
  {
   "id": "ppd_clue_0_0",
   "x": 297,
   "y": 416,
   "w": 240,
   "h": 134,
   "kind": "ppd_t",
   "title": "Blues > 2 weeks, or SEVERE in the first 2",
   "lines": [
    "• low mood, anhedonia, guilt, sleep, energy, appetite",
    "• severe: poor bonding, suicidal or homicidal ideas"
   ]
  },
  {
   "id": "ppd_clue_1_0",
   "x": 297,
   "y": 572,
   "w": 240,
   "h": 60,
   "kind": "ppd_w",
   "title": "Highest risk",
   "lines": [
    "previous depression: 30% recur"
   ]
  },
  {
   "id": "psy_clue_0_0",
   "x": 549,
   "y": 416,
   "w": 240,
   "h": 216,
   "kind": "psy_t",
   "title": "Cannot tell real from unreal",
   "lines": []
  },
