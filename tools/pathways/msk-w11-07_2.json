   "y": 246,
   "w": 250,
   "h": 42,
   "kind": "plain",
   "title": "A cause is found",
   "lines": []
  },
  {
   "id": "gca_head_0_0",
   "x": 45,
   "y": 368,
   "w": 250,
   "h": 168,
   "kind": "gca_h",
   "title": "Giant cell arteritis (GCA)",
   "lines": [
    "large vessel · the most common vasculitis",
    "only over 50 (most over 70)",
    "lifetime risk 1% women, 0.5% men · Northern European"
   ]
  },
  {
   "id": "anca_head_0_0",
   "x": 335,
   "y": 368,
   "w": 250,
   "h": 168,
   "kind": "anca_h",
   "title": "ANCA-associated vasculitis",
   "lines": [
    "anti-neutrophil cytoplasmic antibody · small vessel",
    "granulomatosis with polyangiitis (GPA)",
    "microscopic (MPA) · eosinophilic (EGPA)",
    "rare · FATAL untreated · relapses common"
   ]
  },
  {
   "id": "lcv_head_0_0",
   "x": 625,
   "y": 368,
   "w": 250,
   "h": 168,
   "kind": "lcv_h",
   "title": "Cutaneous leukocytoclastic vasculitis",
   "lines": [
    "small vessel · alone or part of another type"
   ]
  },
  {
   "id": "sec_head_0_0",
   "x": 915,
   "y": 368,
   "w": 250,
   "h": 168,
   "kind": "sec_h",
   "title": "Secondary vasculitis",
   "lines": [
    "an identifiable underlying cause"
   ]
  },
  {
   "id": "gca_pres_0_0",
   "x": 45,
   "y": 576,
   "w": 250,
   "h": 114,
   "kind": "gca_t",
   "title": "Cranial (temporal artery)",
   "lines": [
    "• NEW temporal headache",
    "• scalp tender: hurts to brush the hair",
    "• jaw claudication · tongue claudication",
    "• diplopia · vision loss · stroke"
   ]
  },
  {
   "id": "gca_pres_1_0",
   "x": 45,
   "y": 712,
   "w": 250,
   "h": 96,
   "kind": "bad",
   "title": "Vision loss in 15-20%",
   "lines": [
    "• transient first: amaurosis fugax",
    "• untreated: both eyes, days to months",
    "• acute painless loss is PERMANENT"
   ]
  },
  {
   "id": "gca_pres_2_0",
   "x": 45,
   "y": 830,
   "w": 250,
   "h": 132,
   "kind": "gca_w",
   "title": "Systemic",
   "lines": [
    "• polymyalgia symptoms: see BODY PAIN",
    "• fatigue, fever, weight loss",
    "• limb claudication · Raynaud's · chest pain · arthritis"
   ]
  },
  {
   "id": "anca_pres_0_0",
   "x": 335,
   "y": 576,
   "w": 250,
   "h": 209,
   "kind": "anca_t",
   "title": "Sinonasal · lung · kidney",
   "lines": [
    "• bloody crusty nose, sinus pain · saddle nose (GPA)",
    "• dyspnea: nodules, severe adult-onset asthma, PE",
    "• lung hemorrhage (hemoptysis)",
    "• creatinine ↑, blood + protein in urine"
   ]
  },
  {
   "id": "anca_pres_1_0",
   "x": 335,
   "y": 807,
   "w": 250,
   "h": 155,
   "kind": "anca_w",
   "title": "Also",
   "lines": [
    "• eye mass (diplopia) · arthritis",
    "• mononeuritis multiplex · purpura, urticarial vasculitis"
   ]
  },
  {
   "id": "lcv_pres_0_0",
   "x": 625,
   "y": 576,
   "w": 250,
   "h": 200,
   "kind": "lcv_t",
   "title": "Painful NON-blanching purpura",
   "lines": [
    "• legs · ankles painful, swollen",
    "• unwell, fatigued for weeks",
    "• ± urticarial vasculitis, ulcers"
   ]
  },
  {
   "id": "lcv_pres_1_0",
   "x": 625,
   "y": 798,
   "w": 250,
   "h": 164,
   "kind": "lcv_w",
   "title": "Other cause of purpura?",
   "lines": [
    "coagulopathy"
   ]
  },
  {
   "id": "sec_pres_0_0",
   "x": 915,
   "y": 576,
   "w": 250,
   "h": 163,
   "kind": "sec_t",
   "title": "Infection (most important)",
   "lines": [
    "• viral: hepatitis B or C, HIV, COVID-19",
    "• bacterial: pneumococcus, mycobacteria, Staph aureus",
    "• fungal: causes or mimics"
   ]
  },
  {
   "id": "sec_pres_1_0",
   "x": 915,
   "y": 761,
   "w": 250,
   "h": 201,
   "kind": "sec_w",
   "title": "Drugs · cancer · connective tissue",
   "lines": [
    "• antibiotics, antihypertensives, thionamides",
    "• allergy · cocaine (levamisole)",
    "• blood cancers, paraneoplastic",
    "• lupus, rheumatoid arthritis, Sjögren's"
   ]
  },
  {
   "id": "gca_inv_0_0",
   "x": 45,
   "y": 1002,
   "w": 250,
   "h": 135,
   "kind": "gca_t",
   "title": "Exam",
   "lines": [
    "• tender temples · rope-like temporal artery",
    "• optic disc swelling",
    "• pulselessness, bruits, blood pressure difference"
   ]
  },
  {
   "id": "gca_inv_1_0",
   "x": 45,
   "y": 1159,
   "w": 250,
   "h": 117,
   "kind": "gca_t",
   "title": "1 · ESR + CRP immediately",
   "lines": [
    "both normal → GCA highly unlikely (< 2%)",
    "case: Hb 99 · ESR 70 · CRP 50 · WBC, platelets normal"
   ]
  },
  {
   "id": "gca_inv_2_0",
   "x": 45,
   "y": 1298,
   "w": 250,
   "h": 173,
   "kind": "gca_w",
   "title": "2 · Temporal artery biopsy in 1-2 weeks",
   "lines": [
    "• transmural inflammation + giant cells: 100% specific",
    "• negative in 50-70% (skip lesions)",
    "• or Doppler 'halo sign' (wall edema): specificity > 85%, absent in ~30%, specialty centres only"
   ]
  },
  {
   "id": "anca_inv_0_0",
   "x": 335,
   "y": 1002,
   "w": 250,
   "h": 60,
   "kind": "anca_t",
   "title": "1 · Rule out infection",
   "lines": [
    "cultures, hepatitis, HIV"
   ]
  },
  {
   "id": "anca_inv_1_0",
   "x": 335,
   "y": 1084,
   "w": 250,
   "h": 134,
   "kind": "anca_w",
   "title": "2 · ANCA ONLY if small vessel suspected",
   "lines": [
    "• cytoplasmic (anti-PR3) → GPA",
    "• perinuclear (anti-MPO) → MPA, EGPA",
    "• ELISA (PR3, MPO) more specific"
   ]
  },
  {
   "id": "anca_inv_2_0",
   "x": 335,
   "y": 1240,
   "w": 250,
   "h": 114,
   "kind": "bad",
   "title": "ANCA pitfalls",
   "lines": [
    "• false +: endocarditis, cancer, drugs, cocaine",
    "• negative in 30% GPA, 50-60% MPA/EGPA"
   ]
  },
  {
   "id": "anca_inv_3_0",
   "x": 335,
   "y": 1376,
   "w": 250,
   "h": 96,
   "kind": "anca_w",
   "title": "3 · Biopsy the involved organ",
   "lines": [
    "• first-line in single-organ disease",
    "• else: orbit, sinus, lung nodule, node, kidney, sural nerve"
   ]
  },
  {
   "id": "lcv_inv_0_0",
   "x": 625,
   "y": 1002,
   "w": 250,
   "h": 125,
   "kind": "lcv_t",
   "title": "1 · Platelets + clotting times (INR, PTT)",
   "lines": [
    "rule out a coagulopathy"
   ]
  },
  {
   "id": "lcv_inv_1_0",
   "x": 625,
   "y": 1149,
   "w": 250,
   "h": 159,
   "kind": "lcv_w",
   "title": "2 · Skin biopsy",
   "lines": [
    "• purpura: punch biopsy in primary care",
    "• histopathology, immunofluorescence, cultures",
    "• ulcer: deep excision by a surgeon"
   ]
  },
  {
   "id": "lcv_inv_2_0",
   "x": 625,
   "y": 1330,
   "w": 250,
   "h": 143,
   "kind": "warn",
   "title": "NOT for non-severe purpura < 4-6 weeks",
   "lines": [
    "usually resolves: viral or hypersensitivity"
   ]
  },
  {
   "id": "sec_inv_0_0",
   "x": 915,
   "y": 1002,
   "w": 250,
   "h": 251,
   "kind": "sec_t",
   "title": "Rule out infection",
   "lines": [
    "• white cells · liver enzymes",
    "• blood, urine, sputum cultures (fungal, acid-fast)",
    "• hepatitis B + C, HIV, syphilis (VDRL)",
    "• cryoglobulins ↑, complement ↓ (hepatitis C)"
   ]
  },
  {
   "id": "sec_inv_1_0",
   "x": 915,
   "y": 1275,
   "w": 250,
   "h": 197,
   "kind": "sec_w",
   "title": "Rule out cancer",
   "lines": [
    "• age-appropriate screening",
    "• serum protein electrophoresis (myeloma)"
   ]
  },
  {
   "id": "gca_tx_0_0",
   "x": 45,
   "y": 1512,
   "w": 250,
   "h": 159,
   "kind": "bad",
   "title": "1 · Prednisone 1 mg/kg (max 60 mg) TODAY",
   "lines": [
    "after blood is drawn · NEVER wait for results"
   ]
  },
  {
   "id": "gca_tx_1_0",
   "x": 45,
   "y": 1693,
   "w": 250,
   "h": 141,
   "kind": "bad",
   "title": "Vision loss or stroke → emergency",
   "lines": [
    "urgent ophthalmology or neurology"
   ]
  },
  {
   "id": "gca_tx_2_0",
   "x": 45,
   "y": 1856,
   "w": 250,
   "h": 157,
   "kind": "ok",
   "title": "2 · Protect + refer",
   "lines": [
    "• proton pump inhibitor",
    "• calcium, vitamin D, bisphosphonate",
    "• rheumatology"
   ]
  },
  {
   "id": "anca_tx_0_0",
   "x": 335,
   "y": 1512,
   "w": 250,
   "h": 140,
   "kind": "bad",
   "title": "Unstable, lung bleed, renal failure → ADMIT",
   "lines": []
  },
  {
   "id": "anca_tx_1_0",
   "x": 335,
   "y": 1674,
   "w": 250,
   "h": 176,
   "kind": "warn",
   "title": "Active urine sediment, normal creatinine",
   "lines": [
    "→ urgent nephrology (rapidly progressive glomerulonephritis)"
   ]
  },
  {
   "id": "anca_tx_2_0",
   "x": 335,
   "y": 1872,
   "w": 250,
   "h": 140,
   "kind": "ok",
   "title": "All others → urgent rheumatology",
   "lines": []
  },
  {
   "id": "lcv_tx_0_0",
   "x": 625,
   "y": 1512,
   "w": 250,
   "h": 80,
   "kind": "bad",
   "title": "Acetaminophen does NOT treat it",
   "lines": [
    "no evidence for cannabinoids"
   ]
  },
  {
   "id": "lcv_tx_1_0",
   "x": 625,
   "y": 1614,
   "w": 250,
   "h": 60,
   "kind": "ok",
   "title": "1 · Topical corticosteroid",
   "lines": [
    "non-severe skin disease"
   ]
  },
  {
   "id": "lcv_tx_2_0",
   "x": 625,
   "y": 1696,
   "w": 250,
   "h": 60,
   "kind": "ok",
   "title": "2 · NSAID or colchicine",
   "lines": [
    "colchicine 0.6 mg twice daily · diarrhea"
   ]
  },
  {
   "id": "lcv_tx_3_0",
   "x": 625,
   "y": 1778,
   "w": 250,
   "h": 114,
   "kind": "warn",
   "title": "3 · Oral prednisone",
   "lines": [
    "only if severe, other agents failed, infection excluded",
    "30 mg for 1 week, then ↓ 5 mg every 5 days"
   ]
  },
  {
   "id": "lcv_tx_4_0",
   "x": 625,
   "y": 1914,
   "w": 250,
   "h": 98,
   "kind": "warn",
   "title": "Methotrexate: too SLOW for acute",
   "lines": [
    "non-resolving, scarring or severe disease"
   ]
  },
  {
   "id": "sec_tx_0_0",
   "x": 915,
   "y": 1512,
   "w": 250,
   "h": 238,
   "kind": "ok",
   "title": "Treat the cause",
   "lines": [
    "hepatitis C → antivirals first"
   ]
  },
  {
   "id": "sec_tx_1_0",
   "x": 915,
   "y": 1772,
   "w": 250,
   "h": 240,
   "kind": "bad",
   "title": "Steroids can WORSEN an infection",
   "lines": []
  }
 ],
