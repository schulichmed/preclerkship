 "nodes": [
  {
   "id": "root",
   "x": 225,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Suspect PRIMARY vasculitis: chronically unwell + several organs + NO infection or cancer",
   "lines": [
    "everyone: CBC · creatinine · liver enzymes · ESR, CRP · urinalysis · chest X-ray",
    "LARGE: giant cell · MEDIUM: PAN, Kawasaki · SMALL: ANCA, cryoglobulin, IgA, cutaneous"
   ]
  },
  {
   "id": "g0",
   "x": 45,
   "y": 138,
   "w": 250,
   "h": 134,
   "kind": "plain",
   "title": "ESR + CRP **HIGH** · over 50",
   "lines": [
    "• both normal → GCA **< 2%**",
    "• Hb ↓ · platelets ↑",
    "• ANCA **−**",
    "• confirm: **temporal artery biopsy**"
   ],
   "em": "#b5600f"
  },
  {
   "id": "g1",
   "x": 335,
   "y": 138,
   "w": 250,
   "h": 134,
   "kind": "plain",
   "title": "**ANCA +** · c-ANCA (PR3) or p-ANCA (MPO)",
   "lines": [
    "• urine: **blood + protein**",
    "• creatinine ↑",
    "• false +: endocarditis, cocaine",
    "• confirm: **biopsy the organ**"
   ],
   "em": "#6a4aa8"
  },
  {
   "id": "g2",
   "x": 625,
   "y": 138,
   "w": 250,
   "h": 134,
   "kind": "plain",
   "title": "Platelets, INR, PTT **NORMAL**",
   "lines": [
    "• not a coagulopathy",
    "• ANCA **−**",
    "• confirm: **skin punch biopsy**"
   ],
   "em": "#1f6f8b"
  },
  {
   "id": "g3",
   "x": 915,
   "y": 138,
   "w": 250,
   "h": 134,
   "kind": "plain",
   "title": "Cultures or serology **POSITIVE**",
   "lines": [
    "• hepatitis B, C · HIV · syphilis",
    "• cryoglobulins ↑ · C3, C4 ↓",
    "• SPEP (myeloma)"
   ],
   "em": "#46607a"
  },
  {
   "id": "gca_head_0_0",
   "x": 45,
   "y": 352,
   "w": 250,
   "h": 80,
   "kind": "gca_h",
   "title": "Giant cell arteritis (GCA)",
   "lines": [
    "over 50 · large vessel · the most common"
   ]
  },
  {
   "id": "anca_head_0_0",
   "x": 335,
   "y": 352,
   "w": 250,
   "h": 80,
   "kind": "anca_h",
   "title": "ANCA-associated vasculitis",
   "lines": [
    "small vessel · GPA, MPA, EGPA · fatal untreated"
   ]
  },
  {
   "id": "lcv_head_0_0",
   "x": 625,
   "y": 352,
   "w": 250,
   "h": 80,
   "kind": "lcv_h",
   "title": "Cutaneous leukocytoclastic vasculitis",
   "lines": [
    "small vessel, skin"
   ]
  },
  {
   "id": "sec_head_0_0",
   "x": 915,
   "y": 352,
   "w": 250,
   "h": 80,
   "kind": "sec_h",
   "title": "Secondary vasculitis",
   "lines": [
    "infection, drugs, cancer, CTD"
   ]
  },
  {
   "id": "gca_pres_0_0",
   "x": 45,
   "y": 472,
   "w": 250,
   "h": 114,
   "kind": "gca_t",
   "title": "Cranial (temporal artery)",
   "lines": [
    "• NEW temporal headache",
    "• scalp tender: hurts to brush the hair",
    "• jaw claudication · tongue claudication",
    "• diplopia · vision loss · stroke"
   ]
  },
  {
   "id": "gca_pres_1_0",
   "x": 45,
   "y": 608,
   "w": 250,
   "h": 96,
   "kind": "bad",
   "title": "Vision loss in 15-20%",
   "lines": [
    "• transient first: amaurosis fugax",
    "• untreated: both eyes, days to months",
    "• acute painless loss is PERMANENT"
   ]
  },
  {
   "id": "gca_pres_2_0",
   "x": 45,
   "y": 726,
   "w": 250,
   "h": 132,
   "kind": "gca_w",
   "title": "Systemic",
   "lines": [
    "• polymyalgia symptoms: see BODY PAIN",
    "• fatigue, fever, weight loss",
    "• limb claudication · Raynaud's · chest pain · arthritis"
   ]
  },
  {
   "id": "gca_pres_3_0",
   "x": 45,
   "y": 880,
   "w": 250,
   "h": 150,
   "kind": "gca_w",
   "title": "Mimics",
   "lines": [
    "• sinusitis · dental infection · temporomandibular arthritis",
    "• cranial neuropathy · intracranial tumour · glaucoma",
    "• severe hypertension · migraine, cluster · meningitis"
   ]
  },
  {
   "id": "anca_pres_0_0",
   "x": 335,
   "y": 472,
   "w": 250,
   "h": 295,
   "kind": "anca_t",
   "title": "Sinonasal · lung · kidney",
   "lines": [
    "• bloody crusty nose, sinus pain · saddle nose (GPA)",
    "• dyspnea: nodules, severe adult-onset asthma, PE",
    "• lung hemorrhage (hemoptysis)",
    "• creatinine ↑, blood + protein in urine"
   ]
  },
  {
   "id": "anca_pres_1_0",
   "x": 335,
   "y": 789,
   "w": 250,
   "h": 241,
   "kind": "anca_w",
   "title": "Also",
   "lines": [
    "• eye mass (diplopia) · arthritis",
    "• mononeuritis multiplex · purpura, urticarial vasculitis"
   ]
  },
  {
   "id": "lcv_pres_0_0",
   "x": 625,
   "y": 472,
   "w": 250,
   "h": 286,
   "kind": "lcv_t",
   "title": "Painful NON-blanching purpura",
   "lines": [
    "• legs · ankles painful, swollen",
    "• unwell, fatigued for weeks",
    "• ± urticarial vasculitis, ulcers"
   ]
  },
  {
   "id": "lcv_pres_1_0",
   "x": 625,
   "y": 780,
   "w": 250,
   "h": 250,
   "kind": "lcv_w",
   "title": "Other cause of purpura?",
   "lines": [
    "coagulopathy"
   ]
  },
  {
   "id": "sec_pres_0_0",
   "x": 915,
   "y": 472,
   "w": 250,
   "h": 249,
   "kind": "sec_t",
   "title": "Infection (most important)",
   "lines": [
    "• viral: hepatitis B or C, HIV, COVID-19",
    "• bacterial: pneumococcus, mycobacteria, Staph aureus",
    "• fungal: causes or mimics"
   ]
  },
  {
   "id": "sec_pres_1_0",
   "x": 915,
   "y": 743,
   "w": 250,
   "h": 287,
   "kind": "sec_w",
   "title": "Drugs · cancer · connective tissue",
   "lines": [
    "• antibiotics, antihypertensives, thionamides",
    "• allergy · cocaine (levamisole)",
    "• blood cancers, paraneoplastic",
    "• lupus, rheumatoid arthritis, Sjögren's"
   ]
  },
  {
   "id": "gca_tx_0_0",
   "x": 45,
   "y": 1070,
   "w": 250,
   "h": 159,
   "kind": "bad",
   "title": "1 · Prednisone 1 mg/kg (max 60 mg) TODAY",
   "lines": [
    "after blood is drawn · NEVER wait for results"
   ]
  },
  {
   "id": "gca_tx_1_0",
   "x": 45,
   "y": 1251,
   "w": 250,
   "h": 141,
   "kind": "bad",
   "title": "Vision loss or stroke → emergency",
   "lines": [
    "urgent ophthalmology or neurology"
   ]
  },
  {
   "id": "gca_tx_2_0",
   "x": 45,
   "y": 1414,
   "w": 250,
   "h": 157,
   "kind": "ok",
   "title": "2 · Protect + refer",
   "lines": [
    "• proton pump inhibitor",
    "• calcium, vitamin D, bisphosphonate",
    "• rheumatology"
   ]
  },
  {
   "id": "anca_tx_0_0",
   "x": 335,
   "y": 1070,
   "w": 250,
   "h": 140,
   "kind": "bad",
   "title": "Unstable, lung bleed, renal failure → ADMIT",
   "lines": []
  },
  {
   "id": "anca_tx_1_0",
   "x": 335,
   "y": 1232,
   "w": 250,
   "h": 176,
   "kind": "warn",
   "title": "Active urine sediment, normal creatinine",
   "lines": [
    "→ urgent nephrology (rapidly progressive glomerulonephritis)"
   ]
  },
  {
   "id": "anca_tx_2_0",
   "x": 335,
   "y": 1430,
   "w": 250,
   "h": 140,
   "kind": "ok",
   "title": "All others → urgent rheumatology",
   "lines": []
  },
  {
   "id": "lcv_tx_0_0",
   "x": 625,
   "y": 1070,
   "w": 250,
   "h": 80,
   "kind": "bad",
   "title": "Acetaminophen does NOT treat it",
   "lines": [
    "no evidence for cannabinoids"
   ]
  },
  {
   "id": "lcv_tx_1_0",
   "x": 625,
   "y": 1172,
   "w": 250,
   "h": 60,
   "kind": "ok",
   "title": "1 · Topical corticosteroid",
   "lines": [
    "non-severe skin disease"
   ]
  },
  {
   "id": "lcv_tx_2_0",
   "x": 625,
   "y": 1254,
   "w": 250,
   "h": 60,
   "kind": "ok",
   "title": "2 · NSAID or colchicine",
   "lines": [
    "colchicine 0.6 mg twice daily · diarrhea"
   ]
  },
  {
   "id": "lcv_tx_3_0",
   "x": 625,
   "y": 1336,
   "w": 250,
   "h": 114,
   "kind": "warn",
   "title": "3 · Oral prednisone",
   "lines": [
    "only if severe, other agents failed, infection excluded",
    "30 mg for 1 week, then ↓ 5 mg every 5 days"
   ]
  },
  {
   "id": "lcv_tx_4_0",
   "x": 625,
   "y": 1472,
   "w": 250,
   "h": 98,
   "kind": "warn",
   "title": "Methotrexate: too SLOW for acute",
   "lines": [
    "non-resolving, scarring or severe disease"
   ]
  },
  {
   "id": "sec_tx_0_0",
   "x": 915,
   "y": 1070,
   "w": 250,
   "h": 238,
   "kind": "ok",
   "title": "Treat the cause",
   "lines": [
    "hepatitis C → antivirals first"
   ]
  },
  {
   "id": "sec_tx_1_0",
   "x": 915,
   "y": 1330,
   "w": 250,
   "h": 240,
   "kind": "bad",
   "title": "Steroids can WORSEN an infection",
   "lines": []
  }
