 "nodes": [
  {
   "id": "root",
   "x": 457,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Numbness and tingling: WHERE is the lesion?",
   "lines": [
    "first: CENTRAL or PERIPHERAL?",
    "characterize a neuropathy: sensory, motor or autonomic · acute (days-6 weeks), subacute (to 6 months) or chronic · its pattern · axonal or demyelinating (EMG)",
    "pattern (root, plexus excluded): length-dependent polyneuropathy · mononeuropathy · mononeuritis multiplex",
    "cord vs nerve, acute: a TRUNCAL SENSORY LEVEL settles it"
   ]
  },
  {
   "id": "g_cns",
   "x": 45,
   "y": 192,
   "w": 436,
   "h": 60,
   "kind": "plain",
   "title": "CENTRAL",
   "lines": [
    "cortex · subcortical · brainstem · spinal cord"
   ]
  },
  {
   "id": "g_pns",
   "x": 521,
   "y": 192,
   "w": 1108,
   "h": 60,
   "kind": "plain",
   "title": "PERIPHERAL",
   "lines": [
    "dorsal root ganglion · root · one nerve · many nerves"
   ]
  },
  {
   "id": "thal_head_0_0",
   "x": 45,
   "y": 332,
   "w": 212,
   "h": 150,
   "kind": "thal_h",
   "title": "Brain: thalamus",
   "lines": [
    "e.g. a thalamic hemorrhage"
   ]
  },
  {
   "id": "cord_head_0_0",
   "x": 269,
   "y": 332,
   "w": 212,
   "h": 150,
   "kind": "cord_h",
   "title": "Spinal cord",
   "lines": [
    "e.g. MS myelitis"
   ]
  },
  {
   "id": "neu_head_0_0",
   "x": 521,
   "y": 332,
   "w": 212,
   "h": 150,
   "kind": "neu_h",
   "title": "Neuronopathy",
   "lines": [
    "the CELL BODY is hit"
   ]
  },
  {
   "id": "root_head_0_0",
   "x": 745,
   "y": 332,
   "w": 212,
   "h": 150,
   "kind": "root_h",
   "title": "Root (radiculopathy)",
   "lines": [
    "e.g. S1 after lifting"
   ]
  },
  {
   "id": "mono_head_0_0",
   "x": 969,
   "y": 332,
   "w": 212,
   "h": 150,
   "kind": "mono_h",
   "title": "Mononeuropathy",
   "lines": [
    "e.g. carpal tunnel (median nerve)"
   ]
  },
  {
   "id": "poly_head_0_0",
   "x": 1193,
   "y": 332,
   "w": 212,
   "h": 150,
   "kind": "poly_h",
   "title": "Length-dependent polyneuropathy",
   "lines": [
    "DIABETES: the most common cause in Canada"
   ]
  },
  {
   "id": "gbs_head_0_0",
   "x": 1417,
   "y": 332,
   "w": 212,
   "h": 150,
   "kind": "gbs_h",
   "title": "Guillain-Barré syndrome",
   "lines": [
    "acute inflammatory demyelinating polyneuropathy (AIDP)",
    "autoimmune, antibody: ANTIGEN MIMICRY after infection"
   ]
  },
  {
   "id": "thal_clue_0_0",
   "x": 45,
   "y": 522,
   "w": 212,
   "h": 186,
   "kind": "thal_t",
   "title": "The OPPOSITE side",
   "lines": [
    "• a clumsy hand",
    "• burning pain",
    "case: 78 y, LEFT thalamic bleed → right hand clumsy, right-sided burning"
   ]
  },
  {
   "id": "cord_clue_0_0",
   "x": 269,
   "y": 522,
   "w": 212,
   "h": 186,
   "kind": "cord_t",
   "title": "Below a level on the trunk",
   "lines": [
    "• tingling from mid-chest down",
    "• bladder urgency",
    "case: 41 y, 3 weeks: worse over 10 days, levels off, improves · 2 y ago left arm + face numb for 2 months"
   ]
  },
  {
   "id": "neu_clue_0_0",
   "x": 521,
   "y": 522,
   "w": 212,
   "h": 186,
   "kind": "neu_t",
   "title": "Which cell body?",
   "lines": [
    "• ALS, polio, West Nile",
    "• sensory: paraneoplastic, Sjögren's",
    "• sensory: B6, cisplatin"
   ]
  },
  {
   "id": "root_clue_0_0",
   "x": 745,
   "y": 522,
   "w": 212,
   "h": 186,
   "kind": "root_t",
   "title": "Back pain down one leg",
   "lines": [
    "• SHOOTING pain",
    "• S1: little toe and sole",
    "case: 52 y nurse, lifted a patient · back pain down the left leg · pinprick, temperature lost on little toe + sole"
   ]
  },
  {
   "id": "mono_clue_0_0",
   "x": 969,
   "y": 522,
   "w": 212,
   "h": 186,
   "kind": "mono_t",
   "title": "One nerve's territory",
   "lines": [
    "• hands: intermittent, NOCTURNAL",
    "• relieved by shaking the hands",
    "case: 29 y office worker, 6 months · cousin has MS, worried"
   ]
  },
  {
   "id": "poly_clue_0_0",
   "x": 1193,
   "y": 522,
   "w": 212,
   "h": 186,
   "kind": "poly_t",
   "title": "Distal, symmetric, years",
   "lines": [
    "• painful, BURNING feet (stocking-glove)",
    "• autonomic: postural light-headedness, urinary hesitancy, constipation",
    "case: 78 y, type 2 diabetes · years of burning feet, poor sleep · no weakness"
   ]
  },
  {
   "id": "gbs_clue_0_0",
   "x": 1417,
   "y": 522,
   "w": 212,
   "h": 186,
   "kind": "gbs_t",
   "title": "ASCENDING over DAYS",
   "lines": [
    "• after an infection (a cold)",
    "• toes → knees, then fingertips → legs give out",
    "case: 26 y, cold 3 weeks ago · 3 days tingling toes, soles · weak all 4 limbs, proximal + distal"
   ]
  },
  {
   "id": "thal_inv_0_0",
   "x": 45,
   "y": 748,
   "w": 212,
   "h": 206,
   "kind": "thal_w",
   "title": "Not neglect or atrophy",
   "lines": [
    "neglect = cortex · atrophy = nerve"
   ]
  },
  {
   "id": "cord_inv_0_0",
   "x": 269,
   "y": 748,
   "w": 212,
   "h": 206,
   "kind": "cord_w",
   "title": "A TRUNCAL SENSORY LEVEL",
   "lines": [
    "• BRISK reflexes below it",
    "• Babinski signs · Romberg can be positive",
    "• case: pin level at T6, brisk legs",
    "• stocking loss + ↓ reflexes would be SURPRISING"
   ]
  },
  {
   "id": "root_inv_0_0",
   "x": 745,
   "y": 748,
   "w": 212,
   "h": 206,
   "kind": "root_w",
   "title": "One root's pattern",
   "lines": [
    "• S1: ABSENT ankle (Achilles) reflex"
   ]
  },
  {
   "id": "mono_inv_0_0",
   "x": 969,
   "y": 748,
   "w": 212,
   "h": 206,
   "kind": "mono_w",
   "title": "Exam can be NORMAL",
   "lines": [
    "it is not MS"
   ]
  },
  {
   "id": "poly_inv_0_0",
   "x": 1193,
   "y": 748,
   "w": 212,
   "h": 206,
   "kind": "poly_w",
   "title": "Axonal, sensorimotor",
   "lines": [
    "large and small fibres · distal dying back · often painful",
    "other causes: infection (HIV, leprosy) · drugs · metabolic (uremia, thyroid) · autoimmune · hereditary · idiopathic"
   ]
  },
  {
   "id": "gbs_inv_0_0",
   "x": 1417,
   "y": 748,
   "w": 212,
   "h": 206,
   "kind": "gbs_w",
   "title": "WEAKNESS >> sensory loss",
   "lines": [
    "• AREFLEXIA, down-going toes",
    "• EMG: demyelinating (some axonal)",
    "• vibration mildly ↓ · pinprick normal",
    "• NOT muscle or cord: paresthesias + lost reflexes = NERVE"
   ]
  },
  {
   "id": "thal_tx_0_0",
   "x": 45,
   "y": 994,
   "w": 212,
   "h": 132,
   "kind": "warn",
   "title": "Expect it as he recovers",
   "lines": [
    "central pain: see the NEUROPATHIC PAIN chart"
   ]
  },
  {
   "id": "cord_tx_0_0",
   "x": 269,
   "y": 994,
   "w": 212,
   "h": 132,
   "kind": "warn",
   "title": "MRI of the cord",
   "lines": [
    "suspect MS? brain AND spinal cord, within 6 weeks"
   ]
  },
  {
   "id": "root_tx_0_0",
   "x": 745,
   "y": 994,
   "w": 212,
   "h": 132,
   "kind": "warn",
   "title": "Not a diabetic neuropathy",
   "lines": [
    "shooting leg pain is a root, even in a diabetic"
   ]
  },
  {
   "id": "mono_tx_0_0",
   "x": 969,
   "y": 994,
   "w": 212,
   "h": 132,
   "kind": "ok",
   "title": "Reassure · no imaging",
   "lines": [
    "nocturnal wrist splints"
   ]
  },
  {
   "id": "poly_tx_0_0",
   "x": 1193,
   "y": 994,
   "w": 212,
   "h": 132,
   "kind": "ok",
   "title": "Treat the PAIN",
   "lines": [
    "an analgesic or an antidepressant for neuropathic pain · best for quality of life"
   ]
  },
  {
   "id": "gbs_tx_0_0",
   "x": 1417,
   "y": 994,
   "w": 212,
   "h": 132,
   "kind": "bad",
   "title": "IVIG · a neurologist",
   "lines": [
    "• IVIG shortens the course · slow recovery, weeks to months",
    "• can reach the cranial nerves and breathing muscles → intubation"
   ]
  },
  {
   "id": "poly_path_0_0",
   "x": 1193,
   "y": 1166,
   "w": 212,
   "h": 388,
   "kind": "poly_w",
   "title": "DYING BACK",
   "lines": [
    "• distal → proximal",
    "• diabetes, renal failure",
    "• vincristine, cisplatin, metronidazole",
    "• lead, arsenic, mercury, acrylamide"
   ]
  },
  {
   "id": "gbs_path_0_0",
   "x": 1417,
   "y": 1166,
   "w": 212,
   "h": 388,
   "kind": "gbs_w",
   "title": "DEMYELINATION",
   "lines": [
    "• GBS, CIDP, diphtheria, hereditary",
    "• remyelinates in up to 12 weeks"
   ]
  },
  {
   "id": "span0_path_0_0",
   "x": 745.0,
   "y": 1166,
   "w": 213.0,
   "h": 114,
   "kind": "plain",
   "title": "FUNCTIONAL BLOCK",
   "lines": [
    "• reversible channel failure",
    "• lidocaine, cold, brief compression"
   ]
  },
  {
   "id": "span0_path_0_1",
   "x": 968.0,
   "y": 1166,
   "w": 213.0,
   "h": 114,
   "kind": "plain",
   "title": "WALLERIAN",
   "lines": [
    "• axon breaks down distal to an injury",
    "• regrows 1-2 mm/day, months to years"
   ]
  },
  {
   "id": "span0_path_1_0",
   "x": 745.0,
   "y": 1302,
   "w": 213.0,
   "h": 134,
   "kind": "warn",
   "title": "After trauma: NEURAPRAXIA",
   "lines": [
    "• block + demyelination, axon intact",
    "• full recovery, weeks to 3 months"
   ]
  },
  {
   "id": "span0_path_1_1",
   "x": 968.0,
   "y": 1302,
   "w": 213.0,
   "h": 134,
   "kind": "warn",
   "title": "AXONOTMESIS",
   "lines": [
    "• Wallerian; Schwann cells + endoneurium kept (crush)",
    "• 3-12 months, may be incomplete"
   ]
  },
  {
   "id": "span0_path_2_0",
   "x": 745,
   "y": 1458,
   "w": 436,
   "h": 96,
   "kind": "bad",
   "title": "NEUROTMESIS",
   "lines": [
    "• axon + connective tissue cut",
    "• limited regrowth",
    "• SURGICAL repair"
   ]
  }
 ],
