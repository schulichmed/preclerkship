   ]
  },
  {
   "id": "g_fl",
   "x": 745,
   "y": 138,
   "w": 660,
   "h": 60,
   "kind": "plain",
   "title": "INFLUENZA: shortens symptoms by only ~1 DAY",
   "lines": [
    "reasonable to try in the VERY sick · pick by route"
   ]
  },
