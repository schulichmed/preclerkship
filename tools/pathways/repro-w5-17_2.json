   "h": 145,
   "kind": "ok",
   "title": "Already hypothyroid → DOUBLE levothyroxine Saturday + Sunday",
   "lines": []
  },
  {
   "id": "end_tx_1_0",
   "x": 787,
   "y": 1549,
   "w": 226,
   "h": 143,
   "kind": "ok",
   "title": "TIGHTER sugar targets than usual",
   "lines": [
    "hyperglycemia is a teratogen"
   ]
  },
  {
   "id": "gi_tx_0_0",
   "x": 1025,
   "y": 1382,
   "w": 226,
   "h": 310,
   "kind": "warn",
   "title": "Don't measure lipids",
   "lines": [
    "an isolated rise needs no treatment"
   ]
  },
  {
   "id": "ane_tx_0_0",
   "x": 1291,
   "y": 1382,
   "w": 226,
   "h": 144,
   "kind": "ok",
   "title": "1 · Oral iron, daily or every other day",
   "lines": [
    "• with vitamin C, away from calcium, dairy, coffee, tea",
    "• 2 weeks: hemoglobin ↑ ≥ 1 g/dL → continue"
   ]
  },
  {
   "id": "ane_tx_1_0",
   "x": 1291,
   "y": 1548,
   "w": 226,
   "h": 144,
   "kind": "ok",
   "title": "2 · IV iron sucrose (NOT 1st trimester)",
   "lines": [
    "• oral fails or not tolerated",
    "• hemoglobin < 100",
    "• 3rd trimester or delivery close",
    "• 300 mg weekly × 3 doses"
   ]
  },
  {
   "id": "plt_tx_0_0",
   "x": 1529,
   "y": 1382,
   "w": 226,
   "h": 51,
   "kind": "ok",
   "title": "Gestational: nothing",
   "lines": []
  },
  {
   "id": "plt_tx_1_0",
   "x": 1529,
   "y": 1455,
   "w": 226,
   "h": 237,
   "kind": "ok",
   "title": "ITP: prednisone (NOT dexamethasone) · IV immunoglobulin if late 3rd trimester",
   "lines": [
    "• dexamethasone crosses the placenta",
    "• immunoglobulin works in days, prednisone 1–2 weeks",
    "• baby: low platelets 5–10% → platelets at birth, no difficult instrumental delivery"
   ]
  }
