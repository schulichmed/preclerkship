 "nodes": [
  {
   "id": "root",
   "x": 520,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "A finding in a pregnant patient: NORMAL pregnancy, or PATHOLOGY?",
   "lines": [
    "progesterone relaxes smooth muscle + drives breathing · estrogen raises binding proteins · human chorionic gonadotropin (hCG) peaks at 8–12 weeks"
   ]
  },
  {
   "id": "g_vit",
   "x": 45,
   "y": 138,
   "w": 464,
   "h": 78,
   "kind": "plain",
   "title": "Vital signs + breathing",
   "lines": [
    "symptoms do NOT separate normal from disease"
   ]
  },
  {
   "id": "g_lab",
   "x": 549,
   "y": 138,
   "w": 702,
   "h": 78,
   "kind": "plain",
   "title": "Bloodwork + urine with a shifted normal",
   "lines": [
    "a 'normal' lab value can be abnormal in pregnancy"
   ]
  },
  {
   "id": "g_cbc",
   "x": 1291,
   "y": 138,
   "w": 464,
   "h": 78,
   "kind": "plain",
   "title": "Blood count: DILUTION + POOLING, or disease?",
   "lines": [
    "anemia and low platelets are near universal · white cells ↑ (neutrophilia) is normal too"
   ]
  },
  {
   "id": "car_head_0_0",
   "x": 45,
   "y": 296,
   "w": 226,
   "h": 96,
   "kind": "car_h",
   "title": "Cardiac",
   "lines": [
    "vascular resistance ↓ · cardiac output ↑ 40%, max at 20–28 weeks, mostly stroke volume"
   ]
  },
  {
   "id": "res_head_0_0",
   "x": 283,
   "y": 296,
   "w": 226,
   "h": 96,
   "kind": "res_h",
   "title": "Respiratory + immune",
   "lines": [
    "progesterone ↑ ventilation · cell-mediated immunity ↓"
   ]
  },
  {
   "id": "ren_head_0_0",
   "x": 549,
   "y": 296,
   "w": 226,
   "h": 96,
   "kind": "ren_h",
   "title": "Renal",
   "lines": [
    "renal blood flow ↑ 60–80% → filtration ↑"
   ]
  },
  {
   "id": "end_head_0_0",
   "x": 787,
   "y": 296,
   "w": 226,
   "h": 96,
   "kind": "end_h",
   "title": "Thyroid + sugar",
   "lines": [
    "hCG acts like thyroid stimulating hormone (TSH)"
   ]
  },
  {
   "id": "gi_head_0_0",
   "x": 1025,
   "y": 296,
   "w": 226,
   "h": 96,
   "kind": "gi_h",
   "title": "Gastrointestinal",
   "lines": [
    "progesterone slows the whole gut"
   ]
  },
  {
   "id": "ane_head_0_0",
   "x": 1291,
   "y": 296,
   "w": 226,
   "h": 96,
   "kind": "ane_h",
   "title": "Anemia",
   "lines": [
    "plasma ↑ 30–50% > red cells ↑ 20–30%"
   ]
  },
  {
   "id": "plt_head_0_0",
   "x": 1529,
   "y": 296,
   "w": 226,
   "h": 96,
   "kind": "plt_h",
   "title": "Low platelets",
   "lines": [
    "fall in EVERY pregnancy: spleen + placenta pooling, dilution"
   ]
  },
  {
   "id": "car_norm_0_0",
   "x": 45,
   "y": 432,
   "w": 226,
   "h": 103,
   "kind": "car_t",
   "title": "Blood pressure ↓",
   "lines": [
    "lowest at 22–24 weeks"
   ]
  },
  {
   "id": "car_norm_1_0",
   "x": 45,
   "y": 557,
   "w": 226,
   "h": 121,
   "kind": "car_t",
   "title": "Heart rate ↑ ~10",
   "lines": [
    "median 82 at 12 weeks → 91 at 34 weeks"
   ]
  },
  {
   "id": "car_norm_2_0",
   "x": 45,
   "y": 700,
   "w": 226,
   "h": 121,
   "kind": "car_w",
   "title": "Palpitations common",
   "lines": [
    "more aware of a bigger plasma volume"
   ]
  },
  {
   "id": "res_norm_0_0",
   "x": 283,
   "y": 432,
   "w": 226,
   "h": 78,
   "kind": "res_t",
   "title": "Dyspnea in 60–75%",
   "lines": [
    "from the 1st trimester, levels off in the 3rd"
   ]
  },
  {
   "id": "res_norm_1_0",
   "x": 283,
   "y": 532,
   "w": 226,
   "h": 206,
   "kind": "res_t",
   "title": "Rate UNCHANGED, tidal volume ↑",
   "lines": [
    "• compensated respiratory alkalosis: pH normal, bicarbonate slightly ↓",
    "• lung capacity, functional residual capacity ↓ · oxygen use ↑ 15–20%",
    "• diaphragm up 4 cm · nasal congestion, epistaxis"
   ]
  },
  {
   "id": "res_norm_2_0",
   "x": 283,
   "y": 760,
   "w": 226,
   "h": 62,
   "kind": "res_w",
   "title": "Oxygen saturation stays NORMAL",
   "lines": []
  },
  {
   "id": "ren_norm_0_0",
   "x": 549,
   "y": 432,
   "w": 226,
   "h": 78,
   "kind": "ren_t",
   "title": "Creatinine FALLS",
   "lines": []
  },
  {
   "id": "ren_norm_1_0",
   "x": 549,
   "y": 532,
   "w": 226,
   "h": 152,
   "kind": "ren_t",
   "title": "Proteinuria up to 30 mg/mmol",
   "lines": [
    "urine protein-to-creatinine ratio (uPCR), or 300 mg/day on a 24-hour urine"
   ]
  },
  {
   "id": "ren_norm_2_0",
   "x": 549,
   "y": 706,
   "w": 226,
   "h": 116,
   "kind": "ren_w",
   "title": "Right > left hydronephrosis · glucosuria",
   "lines": [
    "frequency + nocturia"
   ]
  },
  {
   "id": "end_norm_0_0",
   "x": 787,
   "y": 432,
   "w": 226,
   "h": 116,
   "kind": "end_t",
   "title": "TOTAL T4 ↑, FREE T4 steady",
   "lines": [
    "estrogen ↑ thyroid binding globulin"
   ]
  },
  {
   "id": "end_norm_1_0",
   "x": 787,
   "y": 570,
   "w": 226,
   "h": 114,
   "kind": "end_t",
   "title": "1st trimester: TSH slightly ↓",
   "lines": [
    "the hCG peak acts on the TSH receptor"
   ]
  },
  {
   "id": "end_norm_2_0",
   "x": 787,
   "y": 706,
   "w": 226,
   "h": 116,
   "kind": "end_w",
   "title": "Very high hCG (hyperemesis): TSH quite ↓",
   "lines": [
    "transient → OBSERVE, don't treat"
   ]
  },
  {
   "id": "gi_norm_0_0",
   "x": 1025,
   "y": 432,
   "w": 226,
   "h": 127,
   "kind": "gi_t",
   "title": "Constipation · bloating",
   "lines": [
    "• reflux in over half",
    "• nausea + vomiting in most"
   ]
  },
  {
   "id": "gi_norm_1_0",
   "x": 1025,
   "y": 581,
   "w": 226,
   "h": 109,
   "kind": "gi_t",
   "title": "Alkaline phosphatase ↑",
   "lines": [
    "made by the placenta, not the liver"
   ]
  },
  {
   "id": "gi_norm_2_0",
   "x": 1025,
   "y": 712,
   "w": 226,
   "h": 109,
   "kind": "gi_w",
   "title": "Lipids ↑",
   "lines": [
    "triglycerides + LDL"
   ]
  },
  {
   "id": "ane_norm_0_0",
   "x": 1291,
   "y": 432,
   "w": 226,
   "h": 184,
   "kind": "ane_t",
   "title": "DILUTION: the commonest cause",
   "lines": [
    "anemia = hemoglobin < 110 (1st trimester), < 105 (2nd + 3rd)"
   ]
  },
  {
   "id": "ane_norm_1_0",
   "x": 1291,
   "y": 638,
   "w": 226,
   "h": 184,
   "kind": "ane_w",
   "title": "Screen: 1st trimester + 24–28 weeks",
   "lines": [
    "symptoms are common in pregnancy anyway"
   ]
  },
  {
   "id": "plt_norm_0_0",
   "x": 1529,
   "y": 432,
   "w": 226,
   "h": 221,
   "kind": "plt_t",
   "title": "Gestational thrombocytopenia",
   "lines": [
    "• starts mid-to-late 2nd trimester",
    "• rarely < 100,000",
    "• baby unaffected",
    "• 75% of low platelets in pregnancy"
   ]
  },
  {
   "id": "plt_norm_1_0",
   "x": 1529,
   "y": 675,
   "w": 226,
   "h": 147,
   "kind": "plt_w",
   "title": "No test proves it",
   "lines": [
    "a diagnosis of EXCLUSION"
   ]
  },
  {
   "id": "car_flag_0_0",
   "x": 45,
   "y": 862,
   "w": 226,
   "h": 209,
   "kind": "bad",
   "title": "Resting heart rate > 110",
   "lines": [
    "the upper limit is still ~110: don't write tachycardia off"
   ]
  },
  {
   "id": "car_flag_1_0",
   "x": 45,
   "y": 1093,
   "w": 226,
   "h": 249,
   "kind": "bad",
   "title": "Palpitations: supraventricular tachycardia",
   "lines": [
    "pregnancy can bring its first presentation"
   ]
  },
  {
   "id": "res_flag_0_0",
   "x": 283,
   "y": 862,
   "w": 226,
   "h": 108,
   "kind": "bad",
   "title": "LOW oxygen saturation",
   "lines": []
  },
  {
   "id": "res_flag_1_0",
   "x": 283,
   "y": 992,
   "w": 226,
   "h": 184,
   "kind": "bad",
   "title": "Dyspnea from a pulmonary embolism (PE) or pneumonia",
   "lines": [
    "hard to tell from dyspnea of pregnancy"
   ]
  },
  {
   "id": "res_flag_2_0",
   "x": 283,
   "y": 1198,
   "w": 226,
   "h": 144,
   "kind": "bad",
   "title": "Influenza is MORE severe",
   "lines": [
