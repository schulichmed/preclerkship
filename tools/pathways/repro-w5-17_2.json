   ]
  },
  {
   "id": "ren_flag_0_0",
   "x": 549,
   "y": 862,
   "w": 226,
   "h": 221,
   "kind": "bad",
   "title": "Creatinine in the 80s or above",
   "lines": [
    "the lab may still call it 'normal'"
   ]
  },
  {
   "id": "ren_flag_1_0",
   "x": 549,
   "y": 1105,
   "w": 226,
   "h": 237,
   "kind": "bad",
   "title": "uPCR > 30",
   "lines": [
    "a clue to preeclampsia: see the HYPERTENSION IN PREGNANCY chart"
   ]
  },
  {
   "id": "end_flag_0_0",
   "x": 787,
   "y": 862,
   "w": 226,
   "h": 238,
   "kind": "bad",
   "title": "Graves disease",
   "lines": [
    "vs gestational transient thyrotoxicosis"
   ]
  },
  {
   "id": "end_flag_1_0",
   "x": 787,
   "y": 1122,
   "w": 226,
   "h": 220,
   "kind": "bad",
   "title": "Gestational diabetes",
   "lines": [
    "insulin resistance tips her over"
   ]
  },
  {
   "id": "gi_flag_0_0",
   "x": 1025,
   "y": 862,
   "w": 226,
   "h": 480,
   "kind": "bad",
   "title": "Gallstones",
   "lines": [
    "more common in pregnancy"
   ]
  },
  {
   "id": "ane_flag_0_0",
   "x": 1291,
   "y": 862,
   "w": 226,
   "h": 188,
   "kind": "ane_t",
   "title": "1 · Ferritin < 30 → IRON deficiency",
   "lines": [
    "• or transferrin saturation < 20% if inflamed",
    "• the commonest disease: 30%+ of pregnancies",
    "• → low birth weight, preterm delivery, postpartum hemorrhage",
    "• pica, restless legs"
   ]
  },
  {
   "id": "ane_flag_1_0",
   "x": 1291,
   "y": 1072,
   "w": 226,
   "h": 134,
   "kind": "ane_w",
   "title": "2 · VERY low mean cell volume",
   "lines": [
    "• → hemoglobinopathy screen (thalassemia)",
    "• → hematology + test the PARTNER"
   ]
  },
  {
   "id": "ane_flag_2_0",
   "x": 1291,
   "y": 1228,
   "w": 226,
   "h": 114,
   "kind": "ane_w",
   "title": "3 · Macrocytic → B12 level",
   "lines": [
    "• → B12 1000–2000 mcg by mouth daily",
    "• folate: not tested, folic acid 400–800 mcg for all"
   ]
  },
  {
   "id": "plt_flag_0_0",
   "x": 1529,
   "y": 862,
   "w": 226,
   "h": 159,
   "kind": "bad",
   "title": "< 100,000 or EARLY onset → immune thrombocytopenia (ITP)",
   "lines": [
    "• bleeding with past procedures",
    "• not normal post partum",
    "• work-up: hepatitis C, H. pylori, TSH, INR/PTT, ANA"
   ]
  },
  {
   "id": "plt_flag_1_0",
   "x": 1529,
   "y": 1043,
   "w": 226,
   "h": 139,
   "kind": "bad",
   "title": "+ hypertension → preeclampsia or HELLP",
   "lines": [
    "• hemolysis, elevated liver enzymes, low platelets",
    "• normotensive in 15%: check EVERYONE"
   ]
  },
  {
   "id": "plt_flag_2_0",
   "x": 1529,
   "y": 1204,
   "w": 226,
   "h": 139,
   "kind": "bad",
   "title": "+ anemia + renal impairment: CAN'T MISS",
   "lines": [
    "• disseminated intravascular coagulation",
    "• thrombotic thrombocytopenic purpura"
   ]
  },
  {
   "id": "car_tx_0_0",
   "x": 45,
   "y": 1382,
   "w": 226,
   "h": 310,
   "kind": "warn",
   "title": "IV fluid: judicious + monitored",
   "lines": [
    "oncotic pressure ↓ → pulmonary edema risk ↑"
   ]
  },
  {
   "id": "res_tx_0_0",
   "x": 283,
   "y": 1382,
   "w": 226,
   "h": 154,
   "kind": "warn",
   "title": "LOWER threshold to look for PE or deep vein thrombosis",
   "lines": [
    "• pregnancy is PRO-THROMBOTIC",
    "• D-dimer ↑ in every pregnancy: alone it proves nothing"
   ]
  },
  {
   "id": "res_tx_1_0",
   "x": 283,
   "y": 1558,
   "w": 226,
   "h": 134,
   "kind": "ok",
   "title": "Flu shot + oseltamivir: SAFE",
   "lines": [
    "• EXCEPT the nasal flu vaccine: live",
    "• vaccines in pregnancy: ANTENATAL CARE chart"
   ]
  },
  {
   "id": "ren_tx_0_0",
   "x": 549,
   "y": 1382,
   "w": 226,
   "h": 310,
   "kind": "warn",
   "title": "Glucosuria is NOT a diabetes screen",
   "lines": []
  },
  {
