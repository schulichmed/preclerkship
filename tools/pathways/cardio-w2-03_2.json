   "kind": "dark",
   "title": "Pericardial disease: is the problem PAIN, FLUID or a STIFF pericardium?",
   "lines": [
    "fluid and stiffness both stop the heart FILLING in diastole",
    "how FAST it changes decides how sick the patient is"
   ]
  },
  {
   "id": "g_pain",
   "x": 45,
   "y": 138,
   "w": 232,
   "h": 60,
   "kind": "plain",
   "title": "PAIN: inflammation",
   "lines": [
    "viral is the most common cause"
   ]
  },
  {
   "id": "g_fluid",
   "x": 317,
   "y": 138,
   "w": 476,
   "h": 60,
   "kind": "plain",
   "title": "FLUID: is filling impaired?",
   "lines": [
    "fast fluid: symptoms at 200–300 mL · slow: up to 2 L before symptoms"
   ]
  },
  {
   "id": "g_stiff",
   "x": 833,
   "y": 138,
   "w": 232,
   "h": 60,
   "kind": "plain",
   "title": "STIFF: fibrous, calcified",
   "lines": [
    "a late result of pericarditis"
   ]
  },
  {
   "id": "pc_head_0_0",
   "x": 45,
   "y": 278,
   "w": 232,
   "h": 114,
   "kind": "pc_h",
   "title": "Acute pericarditis",
   "lines": [
    "inflamed pericardium",
    "viral, autoimmune, uremia, cancer, after a myocardial infarction or surgery"
   ]
  },
  {
   "id": "ef_head_0_0",
   "x": 317,
   "y": 278,
   "w": 232,
   "h": 114,
   "kind": "ef_h",
   "title": "Pericardial effusion",
   "lines": [
    "extra fluid (normal 50 mL)",
    "same causes as pericarditis"
   ]
  },
  {
   "id": "tp_head_0_0",
   "x": 561,
   "y": 278,
   "w": 232,
   "h": 114,
   "kind": "tp_h",
   "title": "Cardiac tamponade",
   "lines": [
    "fluid stops the heart FILLING",
    "an EMERGENCY, at any volume"
   ]
  },
  {
   "id": "cp_head_0_0",
   "x": 833,
   "y": 278,
   "w": 232,
   "h": 114,
   "kind": "cp_h",
   "title": "Constrictive pericarditis",
   "lines": [
    "thick, rigid: the chambers cannot fill",
    "after pericarditis, heart surgery, radiation, TB"
   ]
  },
  {
   "id": "pc_pres_0_0",
   "x": 45,
   "y": 432,
   "w": 232,
   "h": 133,
   "kind": "pc_t",
   "title": "SHARP, pleuritic chest pain",
   "lines": [
    "• worse lying flat",
    "• better sitting up, leaning FORWARD",
    "• ± fever"
   ]
  },
  {
   "id": "pc_pres_1_0",
   "x": 45,
   "y": 587,
   "w": 232,
   "h": 97,
   "kind": "pc_w",
   "title": "Pericardial friction RUB",
   "lines": [
    "triphasic, scratchy, can come and go"
   ]
  },
  {
   "id": "ef_pres_0_0",
   "x": 317,
   "y": 432,
   "w": 232,
   "h": 106,
   "kind": "ef_t",
   "title": "Small or moderate: NO signs",
   "lines": [
    "~found on echo or a big heart on X-ray"
   ]
  },
  {
   "id": "ef_pres_1_0",
   "x": 317,
   "y": 560,
   "w": 232,
   "h": 124,
   "kind": "ef_w",
   "title": "Large",
   "lines": [
    "• Ewart's sign: dull below the left scapula",
    "• dyspnea, hiccups, dysphagia"
   ]
  },
  {
   "id": "tp_pres_0_0",
   "x": 561,
   "y": 432,
   "w": 232,
   "h": 132,
   "kind": "bad",
   "title": "BECK'S TRIAD",
   "lines": [
    "• LOW blood pressure",
    "• HIGH jugular venous pressure (JVP)",
    "• MUFFLED heart sounds"
   ]
  },
  {
   "id": "tp_pres_1_0",
   "x": 561,
   "y": 586,
   "w": 232,
   "h": 98,
   "kind": "tp_w",
   "title": "Pulsus paradoxus > 10–12 mmHg",
   "lines": [
    "• dyspnea, presyncope, tachycardia"
   ]
  },
  {
   "id": "cp_pres_0_0",
   "x": 833,
   "y": 432,
   "w": 232,
   "h": 116,
   "kind": "cp_t",
   "title": "Heart failure, mostly RIGHT-sided",
   "lines": [
    "• edema, ascites, big liver",
    "• exertional dyspnea, orthopnea",
    "~needs a high index of suspicion"
   ]
  },
  {
   "id": "cp_pres_1_0",
   "x": 833,
   "y": 570,
   "w": 232,
   "h": 114,
   "kind": "cp_w",
   "title": "Exam",
   "lines": [
    "• KUSSMAUL's sign: JVP rises on inspiration",
    "• pericardial KNOCK in early diastole"
   ]
  },
  {
   "id": "pc_inv_0_0",
   "x": 45,
   "y": 724,
   "w": 232,
   "h": 128,
   "kind": "pc_t",
   "title": "1 · Diagnose: ANY 2 of 4",
   "lines": [
    "• pleuritic pain",
    "• rub",
    "• effusion on echo"
   ]
  },
  {
   "id": "pc_inv_1_0",
   "x": 45,
   "y": 874,
   "w": 232,
   "h": 164,
   "kind": "pc_w",
   "title": "2 · The 4th: ECG",
   "lines": [
    "• WIDESPREAD concave ST elevation",
    "• PR depression",
    "~supportive: inflammatory markers ↑, CT or MRI"
   ]
  },
  {
   "id": "ef_inv_0_0",
   "x": 317,
   "y": 724,
   "w": 232,
   "h": 138,
   "kind": "ef_t",
   "title": "1 · Echo: how big? compressing?",
   "lines": []
  },
  {
   "id": "ef_inv_1_0",
   "x": 317,
   "y": 884,
   "w": 232,
   "h": 154,
   "kind": "ef_w",
   "title": "2 · ECG + chest X-ray",
   "lines": [
    "• LOW voltage QRS",
    "• 'water bottle' heart if very large"
   ]
  },
  {
   "id": "tp_inv_0_0",
   "x": 561,
   "y": 724,
   "w": 232,
   "h": 154,
   "kind": "tp_t",
   "title": "1 · Bedside echo",
   "lines": [
    "• large effusion",
    "• swinging heart, chamber compression"
   ]
  },
  {
   "id": "tp_inv_1_0",
   "x": 561,
   "y": 900,
   "w": 232,
   "h": 138,
   "kind": "tp_w",
   "title": "2 · ECG: ELECTRICAL ALTERNANS",
   "lines": [
    "QRS height alternates beat to beat"
   ]
  },
  {
   "id": "cp_inv_0_0",
   "x": 833,
   "y": 724,
   "w": 232,
   "h": 96,
   "kind": "cp_t",
   "title": "1 · Echo",
   "lines": [
    "• NORMAL systolic function",
    "• septal bounce, plethoric inferior vena cava"
   ]
  },
  {
   "id": "cp_inv_1_0",
   "x": 833,
   "y": 842,
   "w": 232,
   "h": 78,
   "kind": "cp_w",
   "title": "2 · CT or MRI",
   "lines": [
    "thick, calcified, enhancing pericardium"
   ]
  },
  {
   "id": "cp_inv_2_0",
   "x": 833,
   "y": 942,
   "w": 232,
   "h": 96,
   "kind": "cp_w",
   "title": "3 · Catheterization",
   "lines": [
    "• EQUAL pressures in all 4 chambers",
    "• 'square root' sign"
   ]
  },
  {
   "id": "pc_tx_0_0",
   "x": 45,
   "y": 1078,
   "w": 232,
   "h": 100,
   "kind": "ok",
   "title": "1 · High-dose anti-inflammatory (NSAID) 1–2 weeks",
   "lines": [
    "+ proton pump inhibitor (PPI)"
   ]
  },
  {
   "id": "pc_tx_1_0",
   "x": 45,
   "y": 1200,
   "w": 232,
   "h": 78,
   "kind": "ok",
   "title": "2 · COLCHICINE 3 months",
   "lines": [
    "• fewer recurrences",
    "• no exercise for 3 months"
   ]
  },
  {
   "id": "pc_tx_2_0",
   "x": 45,
   "y": 1300,
   "w": 232,
   "h": 114,
   "kind": "warn",
   "title": "Autoimmune or refractory",
   "lines": [
    "• steroid taper",
    "• anakinra, IV immunoglobulin, azathioprine",
    "• pericardiectomy"
   ]
  },
  {
   "id": "ef_tx_0_0",
   "x": 317,
   "y": 1078,
   "w": 232,
   "h": 61,
   "kind": "ok",
   "title": "Treat the cause",
   "lines": []
  },
  {
   "id": "ef_tx_1_0",
   "x": 317,
   "y": 1161,
   "w": 232,
   "h": 115,
   "kind": "warn",
   "title": "DRAIN to diagnose",
   "lines": [
    "• large + cancer or infection suspected",
    "• purulent fluid suspected"
   ]
  },
  {
   "id": "ef_tx_2_0",
   "x": 317,
   "y": 1298,
   "w": 232,
   "h": 115,
   "kind": "ef_w",
   "title": "Send the fluid",
   "lines": [
    "• cytology: cancer",
    "• culture, acid-fast stain: tuberculosis (TB)"
   ]
  },
  {
   "id": "tp_tx_0_0",
   "x": 561,
   "y": 1078,
   "w": 232,
   "h": 148,
   "kind": "warn",
   "title": "1 · IV fluids or pressors",
   "lines": [
