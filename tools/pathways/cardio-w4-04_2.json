 "nodes": [
  {
   "id": "root",
   "x": 293,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Breathless, edematous, tired: is it HEART FAILURE (HF), and is the patient UNSTABLE now?",
   "lines": [
    "a syndrome: typical symptoms + structural heart disease · the ejection fraction (EF) is not needed to diagnose it",
    "1 · natriuretic peptide (BNP): LOW rules HF out  →  2 · ECG: normal makes reduced EF very unlikely  →  3 · ECHO, the gold standard: EF"
   ]
  },
  {
   "id": "g_ac",
   "x": 45,
   "y": 156,
   "w": 732,
   "h": 114,
   "kind": "plain",
   "title": "ACUTE decompensated: is it WET (congested)? is it COLD (hypoperfused)?",
   "lines": [
    "WARM + DRY: adjust the oral therapy · look for the trigger: infection, anemia, thyroid, ischemia"
   ]
  },
  {
   "id": "g_ch",
   "x": 817,
   "y": 156,
   "w": 484,
   "h": 114,
   "kind": "plain",
   "title": "CHRONIC: what is the EF on echo?",
   "lines": [
    "the EF picks the treatment",
    "New York Heart Association (NYHA) class: I no symptoms · II mild",
    "III comfortable only at rest · IV symptoms at rest",
    "every drug: start LOW, double every 2–4 weeks, check K+ and creatinine"
   ]
  },
  {
   "id": "ww_head_0_0",
   "x": 45,
   "y": 350,
   "w": 236,
   "h": 116,
   "kind": "ww_h",
   "title": "WARM + WET",
   "lines": [
    "congested, still perfused"
   ]
  },
  {
   "id": "cw_head_0_0",
   "x": 293,
   "y": 350,
   "w": 236,
   "h": 116,
   "kind": "cw_h",
   "title": "COLD + WET",
   "lines": [
    "WORST prognosis",
    "cardiogenic shock"
   ]
  },
  {
   "id": "cd_head_0_0",
   "x": 541,
   "y": 350,
   "w": 236,
   "h": 116,
   "kind": "cd_h",
   "title": "COLD + DRY",
   "lines": [
    "hypoperfused, NOT congested"
   ]
  },
  {
   "id": "rf_head_0_0",
   "x": 817,
   "y": 350,
   "w": 236,
   "h": 116,
   "kind": "rf_h",
   "title": "HF with REDUCED EF (HFrEF)",
   "lines": [
    "DILATED, thin left ventricle (LV) that cannot PUMP",
    "drugs with proven mortality benefit"
   ]
  },
  {
   "id": "pf_head_0_0",
   "x": 1065,
   "y": 350,
   "w": 236,
   "h": 116,
   "kind": "pf_h",
   "title": "HF with PRESERVED EF (HFpEF)",
   "lines": [
    "THICK, stiff LV that cannot FILL",
    "mid-range EF 41–49% sits here"
   ]
  },
  {
   "id": "ww_clue_0_0",
   "x": 45,
   "y": 506,
   "w": 236,
   "h": 132,
   "kind": "ww_t",
   "title": "Congestion",
   "lines": [
    "• orthopnea, paroxysmal nocturnal dyspnea",
    "• crackles, S3, raised jugular venous pressure",
    "• edema, ascites, big liver"
   ]
  },
  {
   "id": "cw_clue_0_0",
   "x": 293,
   "y": 506,
   "w": 236,
   "h": 132,
   "kind": "cw_t",
   "title": "Congested AND hypoperfused",
   "lines": [
    "• cold, sweaty limbs",
    "• low urine output, confusion",
    "• NARROW pulse pressure"
   ]
  },
  {
   "id": "cd_clue_0_0",
   "x": 541,
   "y": 506,
   "w": 236,
   "h": 132,
   "kind": "cd_t",
   "title": "Poor perfusion, clear lungs",
   "lines": [
    "• cold extremities",
    "• dizziness, low urine output"
   ]
  },
  {
   "id": "rf_clue_0_0",
   "x": 817,
   "y": 506,
   "w": 236,
   "h": 132,
   "kind": "rf_t",
   "title": "Find the cause",
   "lines": [
    "• ISCHEMIC most often: angiogram if unclear",
    "• dilated cardiomyopathy, valve disease, hypertension"
   ]
  },
  {
   "id": "pf_clue_0_0",
   "x": 1065,
   "y": 506,
   "w": 236,
   "h": 132,
   "kind": "pf_t",
   "title": "Pressure overload",
   "lines": [
    "• hypertension, left ventricular hypertrophy",
    "• aortic stenosis",
    "• constrictive pericarditis"
   ]
  },
  {
   "id": "ww_tx_0_0",
   "x": 45,
   "y": 678,
   "w": 236,
   "h": 252,
   "kind": "ok",
   "title": "1 · IV loop diuretic + oxygen",
   "lines": [
    "furosemide, + vasodilators"
   ]
  },
  {
   "id": "ww_tx_1_0",
   "x": 45,
   "y": 952,
   "w": 236,
   "h": 252,
   "kind": "warn",
   "title": "2 · Diuretic-resistant",
   "lines": [
    "ultrafiltration"
   ]
  },
  {
   "id": "cw_tx_0_0",
   "x": 293.0,
   "y": 678,
   "w": 113.0,
   "h": 289,
   "kind": "bad",
   "title": "Systolic BP < 90",
   "lines": [
    "• inotrope ± vasopressor",
    "• diuretics",
    "• mechanical support"
   ]
  },
  {
   "id": "cw_tx_0_1",
   "x": 416.0,
   "y": 678,
   "w": 113.0,
   "h": 289,
   "kind": "warn",
   "title": "Systolic BP > 90",
   "lines": [
    "• vasodilators",
    "• diuretics",
    "• inotropes if refractory"
   ]
  },
  {
   "id": "cw_tx_1_0",
   "x": 293,
   "y": 989,
   "w": 236,
   "h": 215,
   "kind": "bad",
   "title": "No response",
   "lines": [
    "inotropes → balloon pump → LV assist device or transplant"
   ]
  },
  {
   "id": "cd_tx_0_0",
   "x": 541,
   "y": 678,
   "w": 236,
   "h": 242,
   "kind": "ok",
   "title": "1 · Fluid challenge",
   "lines": []
  },
  {
   "id": "cd_tx_1_0",
   "x": 541,
   "y": 942,
   "w": 236,
   "h": 262,
   "kind": "warn",
   "title": "2 · Still hypoperfused → inotropes",
   "lines": []
  },
  {
   "id": "rf_tx_0_0",
   "x": 817,
   "y": 678,
   "w": 236,
   "h": 114,
   "kind": "ok",
   "title": "1 · Diuretic + TRIPLE therapy",
   "lines": [
    "• ACE inhibitor (angiotensin receptor blocker if intolerant)",
    "• beta blocker (not in asthma)",
    "• mineralocorticoid antagonist (MRA)"
   ]
  },
  {
   "id": "rf_tx_1_0",
   "x": 817,
   "y": 814,
   "w": 236,
   "h": 170,
   "kind": "ok",
   "title": "2 · Still symptomatic (NYHA II–IV)",
   "lines": [
    "• ACE inhibitor → sacubitril-valsartan (ARNI)",
    "• + ivabradine if sinus rhythm, heart rate > 70",
    "• + SGLT2 inhibitor (flozin): now if diabetic"
   ]
  },
  {
   "id": "rf_tx_2_0",
   "x": 817,
   "y": 1006,
   "w": 236,
   "h": 98,
   "kind": "warn",
   "title": "3 · EF ≤ 35% → defibrillator (ICD)",
   "lines": [
    "+ resynchronization (CRT) for left bundle branch block"
   ]
  },
  {
   "id": "rf_tx_3_0",
   "x": 817,
   "y": 1126,
   "w": 236,
   "h": 78,
   "kind": "bad",
   "title": "NYHA IV",
   "lines": [
    "hydralazine + nitrates, advanced HF referral, palliative care"
   ]
  },
  {
   "id": "pf_tx_0_0",
   "x": 1065,
   "y": 678,
   "w": 236,
   "h": 234,
   "kind": "ok",
   "title": "1 · Diuretics for congestion",
   "lines": [
    "the ONLY proven therapy"
   ]
  },
  {
   "id": "pf_tx_1_0",
   "x": 1065,
   "y": 934,
   "w": 236,
   "h": 270,
   "kind": "ok",
   "title": "2 · Treat the risk factors",
   "lines": [
    "• blood pressure, heart rate, diabetes",
    "~candesartan or spironolactone may help"
   ]
  }
 ],
