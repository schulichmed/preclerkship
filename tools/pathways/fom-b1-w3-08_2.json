   "kind": "mot_w",
   "title": "Cerebral palsy?",
   "lines": [
    "• presents with delayed motor milestones",
    "• examine tone and asymmetry: quality matters"
   ]
  },
  {
   "id": "spl_do_0_0",
   "x": 293,
   "y": 586,
   "w": 236,
   "h": 168,
   "kind": "spl_w",
   "title": "HEARING TEST: always",
   "lines": [
    "• hearing loss, neglect, brain injury",
    "• developmental language disorder",
    "• part of autism or a global delay"
   ]
  },
  {
   "id": "soc_do_0_0",
   "x": 541,
   "y": 586,
   "w": 236,
   "h": 168,
   "kind": "soc_w",
   "title": "Autism spectrum disorder?",
   "lines": [
    "• little symbolic play, ritualistic behaviour",
    "• echolalia can make language look better than it is"
   ]
  },
  {
   "id": "gdd_do_0_0",
   "x": 817,
   "y": 586,
   "w": 236,
   "h": 168,
   "kind": "gdd_w",
   "title": "Find the cause",
   "lines": [
    "1 · History + physical: finds it in about 1 in 3",
    "2 · Chromosomal microarray: FIRST-tier (also autism, intellectual disability)",
    "3 · Developmental paediatrician or paediatric neurologist"
   ]
  },
  {
   "id": "reg_do_0_0",
   "x": 1093,
   "y": 586,
   "w": 236,
   "h": 168,
   "kind": "reg_w",
   "title": "Evaluate further",
   "lines": [
    "may be AUTISM"
   ]
  },
