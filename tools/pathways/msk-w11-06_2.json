 "nodes": [
  {
   "id": "root",
   "x": 335,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Several organs, often Raynaud's: ANA first, then the antibody names it",
   "lines": [
    "ANA NEGATIVE → CTD unlikely · POSITIVE alone proves nothing (up to 30% of healthy people)",
    "everyone: CBC · ESR, CRP · creatinine · urinalysis"
   ]
  },
  {
   "id": "g0",
   "x": 45,
   "y": 138,
   "w": 236,
   "h": 152,
   "kind": "plain",
   "title": "ANA + · **anti-dsDNA** or **anti-Sm**",
   "lines": [
    "• C3, C4 **↓** in a flare",
    "• WBC, platelets **↓**",
    "• hemolysis",
    "• ESR **↑** · CRP often **normal**",
    "• urine: **blood + protein**"
   ],
   "em": "#6a4aa8"
  },
  {
   "id": "g1",
   "x": 321,
   "y": 138,
   "w": 236,
   "h": 152,
   "kind": "plain",
   "title": "**Anticardiolipin · lupus anticoagulant**",
   "lines": [
    "• **PERSISTENT** on repeat",
    "• platelets **↓**",
    "• PTT **falsely ↑**",
    "• **false-positive** VDRL"
   ],
   "em": "#46607a"
  },
  {
   "id": "g2",
   "x": 597,
   "y": 138,
   "w": 236,
   "h": 152,
   "kind": "plain",
   "title": "ANA + · **anti-Ro, anti-La**",
   "lines": [
    "• RF **+** in 90%",
    "• ESR **VERY high** (IgG ↑)",
    "• anemia · WBC **↓**"
   ],
   "em": "#1f6f8b"
  },
  {
   "id": "g3",
   "x": 873,
   "y": 138,
   "w": 236,
   "h": 152,
   "kind": "plain",
   "title": "**CK HIGH** · **anti-Jo-1**",
   "lines": [
    "• ANA + in 80%",
    "• ESR ↑ in half",
    "• rule out **statins, steroids**",
    "• and **thyroid, K, phosphate**"
   ],
   "em": "#b5600f"
  },
  {
   "id": "g4",
   "x": 1149,
   "y": 138,
   "w": 236,
   "h": 152,
   "kind": "plain",
   "title": "ANA + (nucleolar) · **centromere** or **Scl-70**",
   "lines": [
    "• anticentromere → **LIMITED**",
    "• Scl-70 → **diffuse**, lung fibrosis",
    "• RNA pol III → **renal crisis**"
   ],
   "em": "#1f5f9e"
  },
  {
   "id": "sle_head_0_0",
   "x": 45,
   "y": 370,
   "w": 236,
   "h": 80,
   "kind": "sle_h",
   "title": "Systemic lupus erythematosus (SLE)",
   "lines": [
    "1 in 1000 · women 9:1 · young"
   ]
  },
  {
   "id": "aps_head_0_0",
   "x": 321,
   "y": 370,
   "w": 236,
   "h": 80,
   "kind": "aps_h",
   "title": "Antiphospholipid syndrome (APS)",
   "lines": [
    "half with SLE · or primary"
   ]
  },
  {
   "id": "sjo_head_0_0",
   "x": 597,
   "y": 370,
   "w": 236,
   "h": 80,
   "kind": "sjo_h",
   "title": "Sjögren's syndrome",
   "lines": [
    "lymphocytes in exocrine glands"
   ]
  },
  {
   "id": "myo_head_0_0",
   "x": 873,
   "y": 370,
   "w": 236,
   "h": 80,
   "kind": "myo_h",
   "title": "Inflammatory myositis",
   "lines": [
    "proximal weakness, usually PAINLESS"
   ]
  },
  {
   "id": "ssc_head_0_0",
   "x": 1149,
   "y": 370,
   "w": 236,
   "h": 80,
   "kind": "ssc_h",
   "title": "Systemic sclerosis (scleroderma)",
   "lines": [
    "highest mortality"
   ]
  },
  {
   "id": "sle_pres_0_0",
   "x": 45,
   "y": 490,
   "w": 236,
   "h": 260,
   "kind": "sle_t",
   "title": "Rash in the sun, ulcers, organs",
   "lines": [
    "• malar rash (spares the nasolabial folds), discoid (SCARS), photosensitive",
    "• mouth or nose ulcers · non-erosive arthritis",
    "~ Raynaud's, hair loss common",
    "• malar vs rosacea: rosacea does NOT spare the folds",
    "• classify: ANA ≥ 1:80, then ≥ 10 points (see the LUPUS CLASSIFICATION chart)"
   ]
  },
  {
   "id": "sle_pres_1_0",
   "x": 45,
   "y": 772,
   "w": 236,
   "h": 132,
   "kind": "sle_w",
   "title": "Organs",
   "lines": [
    "• pleurisy, pericarditis · nephritis (class IV diffuse proliferative worst)",
    "• seizure, psychosis · counts ↓ (autoantibodies)",
    "• livedo reticularis, vasculitic rash"
   ]
  },
  {
   "id": "aps_pres_0_0",
   "x": 321,
   "y": 490,
   "w": 236,
   "h": 414,
   "kind": "aps_t",
   "title": "RECURRENT clots or pregnancy loss",
   "lines": [
    "• venous (deep vein thrombosis) or arterial",
    "• livedo reticularis (lacy, flat, comes and goes) · platelets ↓",
    "• catastrophic: 'thrombotic storm', many organs"
   ]
  },
  {
   "id": "sjo_pres_0_0",
   "x": 597,
   "y": 490,
   "w": 236,
   "h": 205,
   "kind": "sjo_t",
   "title": "Dry eyes + dry mouth (sicca)",
   "lines": [
    "• gritty eyes, worse through the day",
    "• dry food hard to swallow, taste, speech, bad breath",
    "• dental caries · parotid, submandibular swelling"
   ]
  },
  {
   "id": "sjo_pres_1_0",
   "x": 597,
   "y": 717,
   "w": 236,
   "h": 187,
   "kind": "sjo_w",
   "title": "Beyond the glands",
   "lines": [
    "• Raynaud's · purpura on the shins (leukocytoclastic vasculitis)",
    "• arthritis · neuropathy · rarely lung disease"
   ]
  },
  {
   "id": "myo_pres_0_0",
   "x": 873,
   "y": 490,
   "w": 236,
   "h": 250,
   "kind": "myo_t",
   "title": "Dermatomyositis",
   "lines": [
    "• children, older adults · may be cancer",
    "• heliotrope · Gottron's papules (raised) or sign (flat)",
    "• V-neck, cape, photosensitive · dilated nail-fold capillaries",
    "• mechanic's hands · livedo · calcinosis"
   ]
  },
  {
   "id": "myo_pres_1_0",
   "x": 873,
   "y": 762,
   "w": 236,
   "h": 142,
   "kind": "myo_w",
   "title": "Polymyositis",
   "lines": [
    "any age · NO rash · not cancer-linked"
   ]
  },
  {
   "id": "ssc_pres_0_0",
   "x": 1149,
   "y": 490,
   "w": 236,
   "h": 206,
   "kind": "ssc_t",
   "title": "Fibrosis + vessels + autoimmunity",
   "lines": [
    "• Raynaud's, reflux in nearly all · many dysphagia",
    "• tight fingers (sclerodactyly) · digital ulcers: half ever",
    "case: retrosternal dysphagia, tight hands, arms, face, basal crackles, nucleolar ANA, Scl-70"
   ]
  },
  {
   "id": "ssc_pres_1_0",
   "x": 1149,
   "y": 718,
   "w": 236,
   "h": 186,
   "kind": "ssc_w",
   "title": "Limited or diffuse",
   "lines": [
    "• LIMITED: below elbows, knees (fingers, face) · old CREST · anticentromere 50% · rarely kidney, heart",
    "• DIFFUSE: + upper arms, thighs, trunk · nucleolar ANA 50%, Scl-70 30% · higher mortality"
   ]
  },
  {
   "id": "sle_tx_0_0",
   "x": 45,
   "y": 944,
   "w": 236,
   "h": 98,
   "kind": "ok",
   "title": "Hydroxychloroquine for EVERY patient",
   "lines": [
    "the anchor: skin, joints, fewer MAJOR flares"
   ]
  },
  {
   "id": "sle_tx_1_0",
   "x": 45,
   "y": 1064,
   "w": 236,
   "h": 168,
   "kind": "sle_w",
   "title": "Every patient",
   "lines": [
    "• sun avoidance, SPF 30 · education, rest, physio, OT",
    "• cardiovascular risk (50× events): smoking, blood pressure, lipids, diabetes",
    "~ die of cardiovascular events, infection, SLE, drug harm"
   ]
  },
  {
   "id": "sle_tx_2_0",
   "x": 45,
   "y": 1254,
   "w": 236,
   "h": 96,
   "kind": "ok",
   "title": "Minor organ (skin, joints)",
   "lines": [
    "• topical or low-dose steroid",
    "• anti-inflammatories (NSAIDs) · methotrexate"
   ]
  },
  {
   "id": "sle_tx_3_0",
   "x": 45,
   "y": 1372,
   "w": 236,
   "h": 172,
   "kind": "bad",
   "title": "Major organ → high-dose steroid + immune suppressant",
   "lines": [
    "mycophenolate, azathioprine, cyclophosphamide · belimumab (B cells)",
    "~ steroid harm: avascular necrosis, osteoporosis, glucose"
   ]
  },
  {
   "id": "aps_tx_0_0",
   "x": 321,
   "y": 944,
   "w": 236,
   "h": 128,
   "kind": "ok",
   "title": "Antibody, no event",
   "lines": [
    "nothing or aspirin (ASA) 81 mg"
   ]
  },
  {
   "id": "aps_tx_1_0",
   "x": 321,
   "y": 1094,
   "w": 236,
   "h": 130,
   "kind": "ok",
   "title": "Thrombosis → long-term warfarin",
   "lines": []
  },
  {
   "id": "aps_tx_2_0",
   "x": 321,
   "y": 1246,
   "w": 236,
   "h": 110,
   "kind": "ok",
   "title": "Fetal loss → ASA + heparin",
   "lines": []
  },
  {
   "id": "aps_tx_3_0",
   "x": 321,
   "y": 1378,
   "w": 236,
   "h": 166,
   "kind": "bad",
   "title": "Catastrophic → IV heparin + IV steroids",
   "lines": [
    "± plasmapheresis or IV immunoglobulin"
   ]
  },
  {
   "id": "sjo_tx_0_0",
   "x": 597,
   "y": 944,
   "w": 236,
   "h": 600,
   "kind": "bad",
   "title": "Watch: B-cell lymphoma (MALT)",
   "lines": [
    "the higher risk"
   ]
  },
  {
   "id": "myo_tx_0_0",
   "x": 873,
   "y": 944,
   "w": 236,
   "h": 271,
   "kind": "ok",
   "title": "High-dose steroids",
   "lines": [
    "then steroid-sparing: azathioprine, methotrexate, cyclophosphamide, IVIG, rituximab",
    "prevent steroid osteoporosis"
   ]
  },
  {
   "id": "myo_tx_1_0",
   "x": 873,
   "y": 1237,
   "w": 236,
   "h": 307,
   "kind": "bad",
   "title": "Danger",
   "lines": [
    "• swallowing (aspiration) · heart (arrhythmia) · lung or diaphragm",
    "• lung disease: treat aggressively",
    "• cancer (older, dermatomyositis): ovary, stomach, lung, cervix adenocarcinoma"
   ]
  },
  {
   "id": "ssc_tx_0_0",
   "x": 1149,
   "y": 944,
   "w": 236,
   "h": 179,
   "kind": "ok",
   "title": "Raynaud's",
   "lines": [
    "• avoid cold · stop smoking",
    "• nifedipine (calcium channel blocker)",
    "• then PDE5 inhibitor, topical nitrate, IV iloprost"
   ]
  },
  {
   "id": "ssc_tx_1_0",
   "x": 1149,
   "y": 1145,
   "w": 236,
   "h": 181,
   "kind": "bad",
   "title": "Renal crisis: blood pressure ↑, hemolysis, kidneys fail",
   "lines": [
    "→ ACE inhibitor; > 80% die if missed · ± dialysis",
    "early progressing diffuse · may be the FIRST sign"
   ]
  },
  {
   "id": "ssc_tx_2_0",
   "x": 1149,
   "y": 1348,
   "w": 236,
   "h": 197,
   "kind": "ok",
   "title": "Treat the organ involved",
   "lines": [
    "methotrexate softens skin in early diffuse",
    "severe early diffuse: stem cell transplant",
    "deaths: lung fibrosis, pulmonary hypertension, heart"
   ]
  }
 ],
