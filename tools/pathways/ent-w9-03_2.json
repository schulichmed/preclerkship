 "nodes": [
  {
   "id": "root",
   "x": 354,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Thyroid nodule: is it CANCER? Check thyroid-stimulating hormone (TSH) FIRST",
   "lines": [
    "most are benign: hyperplasia, cyst, Hashimoto thyroiditis, adenoma",
    "CANCER clues: child, male, 1st-degree relative, neck radiation · RAPID growth",
    "dysphagia, hoarseness, stridor · a firm or FIXED mass, suspicious nodes"
   ]
  },
  {
   "id": "g_lo",
   "x": 45,
   "y": 156,
   "w": 215,
   "h": 78,
   "kind": "plain",
   "title": "TSH LOW",
   "lines": [
    "→ radioactive iodine uptake scan",
    "COLD → ultrasound"
   ]
  },
  {
   "id": "g_us",
   "x": 300,
   "y": 156,
   "w": 1123,
   "h": 78,
   "kind": "plain",
   "title": "TSH normal or HIGH, or a COLD nodule → ULTRASOUND",
   "lines": [
    "American College of Radiology (ACR) TI-RADS: composition, echogenicity, shape, margin, echogenic foci"
   ]
  },
  {
   "id": "t_us",
   "x": 300,
   "y": 274,
   "w": 1123,
   "h": 114,
   "kind": "plain",
   "title": "TI-RADS level sets the size for fine needle aspiration (FNA), then Bethesda cytology",
   "lines": [
    "• TR1–2 (benign, not suspicious): NO FNA",
    "• TR3: FNA if ≥ 2.5 cm · follow if ≥ 1.5 cm",
    "• TR4: FNA if ≥ 1.5 cm · follow if ≥ 1 cm",
    "• TR5: FNA if ≥ 1 cm · follow if ≥ 0.5 cm"
   ]
  },
  {
