   "kind": "dr_w",
   "title": "Left uncorrected",
   "lines": [
    "• crooked: forearm rotation restricted",
    "• short: ulnar impaction syndrome",
    "• step > 1 mm: radiocarpal arthritis → fusion"
   ]
  },
  {
   "id": "sc_cause_0_0",
   "x": 357,
   "y": 634,
   "w": 300,
   "h": 150,
   "kind": "sc_w",
   "title": "Retrograde blood flow",
   "lines": [
    "• a missed fracture → nonunion",
    "• osteonecrosis",
    "• late arthrosis"
   ]
  },
  {
   "id": "cts_cause_0_0",
   "x": 697.0,
   "y": 634,
   "w": 145.0,
   "h": 150,
   "kind": "cts_w",
   "title": "Less space",
   "lines": [
    "• fracture, ganglia",
    "• flexor tenosynovitis",
    "• rheumatologic inflammation",
    "• pregnancy, acromegaly"
   ]
  },
  {
