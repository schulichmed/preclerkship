   ]
  },
  {
   "id": "dr_inv_0_0",
   "x": 45,
   "y": 824,
   "w": 300,
   "h": 142,
   "kind": "dr_t",
   "title": "X-ray: 3 questions",
   "lines": [
    "• CROOKED? normal 12° palmar tilt on the lateral",
    "• SHORT? ulnar variance > neutral (compare sides)",
    "• SMOOTH? a step > 1 mm"
   ]
  },
  {
   "id": "sc_inv_0_0",
   "x": 357,
   "y": 824,
   "w": 300,
   "h": 60,
   "kind": "sc_t",
   "title": "1 · X-ray",
   "lines": [
    "usually sufficient"
   ]
  },
  {
   "id": "sc_inv_1_0",
   "x": 357,
   "y": 906,
   "w": 300,
   "h": 60,
   "kind": "sc_t",
   "title": "2 · X-ray NORMAL → be SUSPICIOUS",
   "lines": [
    "treat it as fractured + CT or MRI"
   ]
  },
