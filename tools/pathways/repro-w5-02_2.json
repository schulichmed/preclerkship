 "nodes": [
  {
   "id": "root",
   "x": 527,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Dilation and curettage (D&C): learn each complication by the STEP that causes it",
   "lines": [
    "vacuum aspiration of a pregnancy < 14 weeks: first-trimester loss (incomplete, inevitable, missed) or therapeutic abortion",
    "local anesthesia (cervical block ± conscious sedation) or general"
   ]
  },
  {
   "id": "g_bef",
   "x": 45,
   "y": 138,
   "w": 548,
   "h": 42,
   "kind": "plain",
   "title": "BEFORE: prepare and numb the cervix",
   "lines": []
  },
  {
   "id": "g_dur",
   "x": 633,
   "y": 138,
   "w": 548,
   "h": 42,
   "kind": "plain",
   "title": "DURING: dilate and evacuate",
   "lines": []
  },
  {
   "id": "g_aft",
   "x": 1221,
   "y": 138,
   "w": 548,
   "h": 42,
   "kind": "plain",
   "title": "AFTER: is something still in the uterus?",
   "lines": []
  },
  {
   "id": "prep_head_0_0",
   "x": 45,
   "y": 260,
   "w": 268,
   "h": 114,
   "kind": "prep_h",
   "title": "1 · Prepare the cervix",
   "lines": [
    "misoprostol 1–12 h before, or laminaria, Dilapan in the internal os 24 h before",
    "may be skipped if the cervix is already open"
   ]
  },
  {
   "id": "block_head_0_0",
   "x": 325,
   "y": 260,
   "w": 268,
   "h": 114,
   "kind": "block_h",
   "title": "2 · Bimanual exam, then paracervical block",
   "lines": [
    "exam confirms gestation, gestational age",
    "block: lidocaine ± epinephrine"
   ]
  },
  {
   "id": "dil_head_0_0",
   "x": 633,
   "y": 260,
   "w": 268,
   "h": 114,
   "kind": "dil_h",
   "title": "3 · Mechanical dilation",
   "lines": [
    "Hegar dilators, only if preparation was inadequate",
    "dilate (mm) = weeks of gestation"
   ]
  },
  {
   "id": "cur_head_0_0",
   "x": 913,
   "y": 260,
   "w": 268,
   "h": 114,
   "kind": "cur_h",
   "title": "4 · Suction curettage",
   "lines": [
    "rigid cannula on electric suction: remove ALL products",
    "sharp curettage unnecessary in most cases"
   ]
  },
  {
   "id": "aft_head_0_0",
   "x": 1221,
   "y": 260,
   "w": 268,
   "h": 114,
   "kind": "aft_h",
   "title": "5 · After the evacuation",
   "lines": [
    "blood or tissue left behind"
   ]
  },
  {
   "id": "ash_head_0_0",
   "x": 1501,
   "y": 260,
   "w": 268,
   "h": 114,
   "kind": "ash_h",
   "title": "Repeat curettage",
   "lines": [
    "for retained products, or retained placenta post partum"
   ]
  },
  {
   "id": "prep_risk_0_0",
   "x": 45,
   "y": 414,
   "w": 268,
   "h": 114,
   "kind": "prep_t",
   "title": "INFECTION",
   "lines": [
    "prophylaxis depends on the indication"
   ]
  },
  {
   "id": "block_risk_0_0",
   "x": 325,
   "y": 414,
   "w": 268,
   "h": 114,
   "kind": "block_t",
   "title": "Cervical SHOCK",
   "lines": [
    "a vasovagal reaction during the block"
   ]
  },
  {
   "id": "dil_risk_0_0",
   "x": 633,
   "y": 414,
   "w": 268,
   "h": 114,
   "kind": "dil_t",
   "title": "Cervical TRAUMA",
   "lines": [
    "lacerations from the tenaculum or instruments"
   ]
  },
  {
   "id": "cur_risk_0_0",
   "x": 913.0,
   "y": 414,
   "w": 129.0,
   "h": 114,
   "kind": "cur_t",
   "title": "Perforation",
   "lines": [
    "• during dilatation or suction",
    "• rarely visceral injury"
   ]
  },
  {
   "id": "cur_risk_0_1",
   "x": 1052.0,
   "y": 414,
   "w": 129.0,
   "h": 114,
   "kind": "cur_t",
   "title": "Hemorrhage",
   "lines": [
    "atony, low implantation, larger gestation"
   ]
  },
  {
   "id": "aft_risk_0_0",
   "x": 1221.0,
   "y": 414,
   "w": 129.0,
   "h": 114,
   "kind": "aft_t",
   "title": "Hematometra",
   "lines": [
    "blood fills the cavity (post-abortal syndrome)"
   ]
  },
  {
   "id": "aft_risk_0_1",
   "x": 1360.0,
   "y": 414,
   "w": 129.0,
   "h": 114,
   "kind": "aft_t",
   "title": "Retained products",
   "lines": [
    "remain after evacuation"
   ]
  },
  {
   "id": "ash_risk_0_0",
   "x": 1501,
   "y": 414,
   "w": 268,
   "h": 114,
   "kind": "ash_t",
   "title": "ASHERMAN'S syndrome",
   "lines": [
    "• adhesions in the endometrial cavity → secondary amenorrhea",
    "• risk rises with each repeat procedure"
   ]
  },
  {
   "id": "prep_do_0_0",
   "x": 45.0,
   "y": 568,
   "w": 129.0,
   "h": 98,
   "kind": "ok",
   "title": "Therapeutic abortion",
   "lines": [
    "antibiotic PROPHYLAXIS"
   ]
  },
  {
   "id": "prep_do_0_1",
   "x": 184.0,
   "y": 568,
   "w": 129.0,
   "h": 98,
   "kind": "prep_w",
   "title": "Missed abortion, loss",
   "lines": [
    "NO prophylaxis"
   ]
  },
  {
   "id": "block_do_0_0",
   "x": 325,
   "y": 568,
   "w": 268,
   "h": 98,
   "kind": "ok",
   "title": "Self-limited",
   "lines": [
    "usually over in a few minutes"
   ]
  },
  {
   "id": "dil_do_0_0",
   "x": 633,
   "y": 568,
   "w": 268,
   "h": 98,
   "kind": "ok",
   "title": "Skip it when you can",
   "lines": [
    "no mechanical dilation: ↓ discomfort, ↓ infection"
   ]
  },
  {
   "id": "cur_do_0_0",
   "x": 913.0,
   "y": 568,
   "w": 129.0,
   "h": 98,
