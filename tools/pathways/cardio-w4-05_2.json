   ]
  },
  {
   "id": "oo_then_0_0",
   "x": 45,
   "y": 788,
   "w": 214,
   "h": 62,
   "kind": "bad",
   "title": "Either one → HYPERTENSION",
   "lines": []
  },
  {
   "id": "oo_then_1_0",
   "x": 45,
   "y": 872,
   "w": 214,
   "h": 80,
   "kind": "ok",
   "title": "Both below → WHITE COAT",
   "lines": [
    "confirm: ABPM, or repeat HBPM"
   ]
  },
  {
   "id": "of_then_0_0",
   "x": 271,
   "y": 788,
   "w": 214,
   "h": 71,
   "kind": "bad",
   "title": "3 · Visits 4–5: ≥ 140/90",
   "lines": [
    "→ HYPERTENSION"
   ]
  },
  {
   "id": "of_then_1_0",
   "x": 271,
   "y": 881,
   "w": 214,
   "h": 71,
   "kind": "ok",
   "title": "< 140/90 → none",
   "lines": [
    "recheck yearly"
   ]
  },
  {
   "id": "dr_then_0_0",
   "x": 525,
   "y": 788,
   "w": 214,
   "h": 164,
   "kind": "ok",
   "title": "MODIFIABLE aggravating factors",
   "lines": [
    "ask about each one"
   ]
  },
  {
   "id": "os_then_0_0",
   "x": 751,
   "y": 788,
   "w": 214,
   "h": 164,
   "kind": "warn",
   "title": "Catecholamines ↑?",
   "lines": [
    "OSA MIMICS pheochromocytoma biochemically"
   ]
  },
  {
   "id": "pa_then_0_0",
   "x": 977,
   "y": 788,
   "w": 214,
   "h": 164,
   "kind": "warn",
   "title": "Consider it even with a NORMAL K+",
   "lines": []
  },
  {
   "id": "kd_then_0_0",
   "x": 1203,
   "y": 788,
   "w": 214,
   "h": 164,
   "kind": "ok",
   "title": "Urinalysis is cause AND consequence",
   "lines": [
    "or albumin:creatinine ratio · often forgotten"
   ]
  },
  {
