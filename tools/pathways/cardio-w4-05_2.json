   ]
  },
  {
   "id": "kd_look_1_0",
   "x": 1203,
   "y": 670,
   "w": 214,
   "h": 78,
   "kind": "kd_t",
   "title": "Renal artery stenosis",
   "lines": [
    "think of it with atherosclerosis"
   ]
  },
  {
   "id": "en_look_0_0",
   "x": 1429,
   "y": 570,
   "w": 214,
   "h": 69,
   "kind": "en_t",
   "title": "Thyroid or parathyroid",
   "lines": [
    "TSH, serum Ca2+"
   ]
  },
  {
   "id": "en_look_1_0",
   "x": 1429,
   "y": 661,
   "w": 214,
   "h": 87,
   "kind": "en_t",
   "title": "Rarer",
   "lines": [
