   "y": 432,
   "w": 214,
   "h": 98,
   "kind": "en_h",
   "title": "Other endocrine",
   "lines": [
    "rare"
   ]
  },
  {
   "id": "oo_look_0_0",
   "x": 45,
   "y": 570,
   "w": 214,
   "h": 178,
   "kind": "oo_w",
   "title": "Visit 2, within 1 MONTH",
   "lines": [
    "• daytime ABPM or HBPM ≥ 135/85",
    "• or 24-hour ABPM ≥ 130/80"
   ]
  },
  {
   "id": "of_look_0_0",
   "x": 271,
   "y": 570,
   "w": 214,
   "h": 78,
   "kind": "of_w",
   "title": "1 · Visit 2",
   "lines": [
    "≥ 140 systolic or ≥ 90 diastolic → visit 3"
   ]
  },
  {
   "id": "of_look_1_0",
   "x": 271,
   "y": 670,
   "w": 214,
   "h": 78,
   "kind": "of_w",
   "title": "2 · Visit 3",
   "lines": [
    "• ≥ 160/100 → HYPERTENSION",
    "• < 160/100 → visits 4–5"
   ]
  },
  {
   "id": "dr_look_0_0",
   "x": 525,
   "y": 570,
   "w": 214,
   "h": 178,
   "kind": "dr_t",
   "title": "History",
   "lines": [
    "• salt, alcohol, stimulants (prescribed, over the counter, street)",
    "• NSAIDs, steroids, estrogen, cyclosporine, decongestants",
    "• drug withdrawal, pain"
   ]
  },
  {
   "id": "os_look_0_0",
   "x": 751,
   "y": 570,
   "w": 214,
   "h": 178,
   "kind": "os_t",
   "title": "↑ aldosterone and norepinephrine",
   "lines": []
  },
  {
   "id": "pa_look_0_0",
   "x": 977,
   "y": 570,
   "w": 214,
   "h": 178,
   "kind": "pa_t",
   "title": "LOW serum K+",
   "lines": [
    "on the baseline chemistry"
   ]
  },
  {
   "id": "kd_look_0_0",
   "x": 1203,
   "y": 570,
   "w": 214,
   "h": 78,
   "kind": "kd_t",
   "title": "Intrinsic kidney disease",
   "lines": [
