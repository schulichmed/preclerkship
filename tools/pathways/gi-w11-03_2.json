 "nodes": [
  {
   "id": "root",
   "x": 273,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Diarrhea (> 3 a day or > 200 g a day): ACUTE (< 4 weeks) or CHRONIC (> 4 weeks)?",
   "lines": [
    "ask: onset · blood · how often, day and night · oil droplets (steatorrhea) · travel, antibiotics, hospital, sick contacts, food and water",
    "small bowel: LARGE volume, not urgent, infrequent · colon: SMALL volume, URGENT, frequent"
   ]
  },
  {
   "id": "g_ac",
   "x": 45,
   "y": 156,
   "w": 708,
   "h": 96,
   "kind": "plain",
   "title": "ACUTE: usually INFECTIOUS · is there BLOOD + FEVER?",
   "lines": [
    "every one: ORAL REHYDRATION first (balanced electrolyte solution) · most need NO antibiotics",
    "ADMIT if severe systemic signs, can't keep up by mouth, infant, elderly or immunocompromised",
    "complete blood count, electrolytes, urea, creatinine · blood cultures if febrile · abdominal X-ray if severe"
   ]
  },
  {
   "id": "g_ch",
   "x": 793,
   "y": 156,
   "w": 468,
   "h": 96,
   "kind": "plain",
   "title": "CHRONIC: usually NOT infectious · is it BLOODY?",
   "lines": [
    "BLOODY → inflammatory bowel disease (IBD): see the INFLAMMATORY BOWEL DISEASE chart",
    "rapid transit (irritable bowel syndrome) · microscopic colitis"
   ]
  },
  {
   "id": "t_gap",
   "x": 793,
   "y": 292,
   "w": 468,
   "h": 96,
   "kind": "plain",
   "title": "NON-bloody: stool osmotic gap = 290 − 2(Na + K)",
   "lines": [
    "• > 50 → OSMOTIC: malabsorption, laxatives",
    "• < 50 → SECRETORY: neuroendocrine tumour (Zollinger-Ellison), villous adenoma"
   ]
  },
  {
   "id": "wat_head_0_0",
   "x": 45,
   "y": 468,
   "w": 228,
   "h": 78,
   "kind": "wat_h",
   "title": "Non-inflammatory",
   "lines": [
    "enterotoxin, SMALL bowel",
    "main danger: DEHYDRATION"
   ]
  },
  {
   "id": "inf_head_0_0",
   "x": 285,
   "y": 468,
   "w": 228,
   "h": 78,
