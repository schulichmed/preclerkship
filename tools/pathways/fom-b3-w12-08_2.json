  },
  {
   "id": "cure_what_0_0",
   "x": 45,
   "y": 378,
   "w": 236,
   "h": 232,
   "kind": "cure_t",
   "title": "Definitive or ADJUVANT",
   "lines": [
    "• definitive: e.g. breast, prostate, lung, head and neck, lymphoma",
    "• adjuvant: kill microscopic disease left after surgery or chemo"
   ]
  },
  {
   "id": "pal_what_0_0",
   "x": 293,
   "y": 378,
   "w": 236,
   "h": 232,
   "kind": "bad",
   "title": "URGENT",
   "lines": [
    "• spinal cord compression",
    "• superior vena cava (SVC) syndrome",
    "• bronchial or esophageal obstruction · gastrointestinal or gynecologic bleeding"
   ]
  },
  {
   "id": "acu_what_0_0",
   "x": 569,
   "y": 378,
   "w": 236,
   "h": 232,
   "kind": "acu_t",
   "title": "In the field",
   "lines": [
    "• fatigue (any site)",
    "• skin redness, hair loss",
    "• chest: esophagitis, cough · pelvis: diarrhea, urinary frequency"
   ]
  },
  {
   "id": "sub_what_0_0",
   "x": 817,
   "y": 378,
   "w": 236,
   "h": 78,
   "kind": "sub_t",
   "title": "PNEUMONITIS",
   "lines": [
    "6–12 weeks after mediastinal radiation: fever, cough, dyspnea"
   ]
  },
  {
   "id": "sub_what_1_0",
   "x": 817,
   "y": 478,
   "w": 236,
   "h": 132,
   "kind": "sub_w",
   "title": "Also",
   "lines": [
    "• myelosuppression (large pelvic field)",
    "• pericarditis",
    "• Lhermitte sign: tingling into the limbs on neck flexion"
   ]
  },
  {
   "id": "late_what_0_0",
   "x": 1065,
   "y": 378,
   "w": 236,
   "h": 60,
   "kind": "late_t",
   "title": "HYPOTHYROIDISM",
   "lines": [
    "thyroid in the field"
   ]
  },
  {
   "id": "late_what_1_0",
   "x": 1065,
   "y": 460,
   "w": 236,
   "h": 150,
   "kind": "late_w",
   "title": "Also",
   "lines": [
    "• shingles in the irradiated dermatomes",
    "• infertility: sterile if > 2 Gy to the ovaries",
    "• second cancers: large fields, > 40 Gy, older techniques"
   ]
  },
  {
   "id": "cure_do_0_0",
   "x": 45,
   "y": 650,
   "w": 236,
   "h": 168,
   "kind": "ok",
   "title": "Pick the delivery",
   "lines": [
    "• external beam: 5 days a week, 1–10 weeks",
    "• brachytherapy: isotope beside a gynecologic or prostate tumour",
    "• stereotactic ablative radiotherapy (SABR): very high dose in 1–5 treatments"
   ]
  },
  {
   "id": "pal_do_0_0",
   "x": 293,
   "y": 650,
   "w": 236,
   "h": 168,
   "kind": "ok",
   "title": "Radiate to SHRINK it",
   "lines": [
    "relieves pain and neurologic symptoms"
   ]
  },
  {
   "id": "acu_do_0_0",
   "x": 569,
   "y": 650,
   "w": 236,
   "h": 168,
   "kind": "warn",
   "title": "Expect them WORST near the END of the course",
   "lines": [
    "fatigue may become chronic"
   ]
  },
  {
   "id": "sub_do_0_0",
   "x": 817,
