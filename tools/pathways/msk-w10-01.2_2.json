   "title": "Plantar fasciitis",
   "lines": [
    "age 40-60, F > M",
    "plantar fascia overworked: chronic insertional inflammation"
   ]
  },
  {
   "id": "tp_head_0_0",
   "x": 779,
   "y": 262,
   "w": 214,
   "h": 152,
   "kind": "tp_h",
   "title": "Tibialis posterior dysfunction",
   "lines": [
    "tendon hypovascular below the medial malleolus",
    "risk: trauma, steroids, inflammatory arthritis, obesity, diabetes"
   ]
  },
  {
   "id": "bun_head_0_0",
   "x": 1033,
   "y": 262,
   "w": 214,
   "h": 152,
   "kind": "bun_h",
   "title": "Bunion (hallux valgus)",
   "lines": [
    "footwear (F > M) · metatarsus varus"
   ]
  },
  {
   "id": "mor_head_0_0",
   "x": 1259,
   "y": 262,
   "w": 214,
   "h": 152,
   "kind": "mor_h",
   "title": "Morton's neuroma",
   "lines": [
    "common digital nerve fibrosis, usually 3rd-4th metatarsal space"
   ]
  },
  {
   "id": "dm_head_0_0",
   "x": 1513,
   "y": 262,
   "w": 214,
   "h": 152,
   "kind": "dm_h",
   "title": "Diabetic foot",
   "lines": [
    "neuropathy + poor blood flow",
    "ulcer in 15% of people with diabetes"
   ]
  },
  {
   "id": "spr_pres_0_0",
   "x": 45,
   "y": 454,
   "w": 214,
   "h": 170,
   "kind": "spr_t",
   "title": "Swelling · bruising · pain over the ligament",
   "lines": [
    "• anterior talofibular (ATFL) > calcaneofibular > posterior talofibular",
    "• anterior drawer test: ATFL",
    "• partial to full tear · all three torn → dislocation"
   ]
  },
  {
   "id": "ach_pres_0_0",
   "x": 299,
   "y": 454,
   "w": 214,
   "h": 170,
   "kind": "ach_t",
   "title": "Pain at or just above the calcaneal insertion",
   "lines": [
    "• tender",
    "• worse with passive dorsiflexion"
   ]
  },
  {
   "id": "pf_pres_0_0",
   "x": 525,
   "y": 454,
   "w": 214,
   "h": 170,
   "kind": "pf_t",
   "title": "Anteromedial heel pain on the FIRST morning steps",
   "lines": [
    "• and with ongoing activity"
   ]
  },
  {
   "id": "tp_pres_0_0",
   "x": 779,
   "y": 454,
   "w": 214,
   "h": 170,
   "kind": "tp_t",
   "title": "Medial ankle pain ± swelling",
   "lines": [
    "• mild, then significant weakness",
    "• flat foot: FLEXIBLE, then RIGID (dropped talus)"
   ]
  },
  {
   "id": "bun_pres_0_0",
   "x": 1033,
   "y": 454,
   "w": 214,
   "h": 170,
   "kind": "bun_t",
   "title": "Pain at the medial first metatarsophalangeal joint",
   "lines": [
    "• tops of toes in a tight shoe",
    "• other toes overwork at toe-off",
    "• secondary toe deformities"
   ]
  },
  {
   "id": "mor_pres_0_0",
   "x": 1259,
   "y": 454,
   "w": 214,
   "h": 170,
   "kind": "mor_t",
   "title": "Burning dysesthesia",
   "lines": [
    "• middle-aged, F > M",
    "• high heels, narrow toe box"
   ]
  },
  {
   "id": "dm_pres_0_0",
   "x": 1513,
   "y": 454,
   "w": 214,
   "h": 170,
   "kind": "dm_t",
   "title": "Cannot feel injuries",
   "lines": [
    "• less sweat → dry skin · callus",
    "• intrinsic atrophy → arch, shape change",
    "• Charcot (neuropathic) joint"
   ]
  },
  {
   "id": "spr_inv_0_0",
   "x": 45,
   "y": 664,
   "w": 214,
   "h": 150,
   "kind": "spr_t",
   "title": "Ottawa rules: X-ray if ANY",
   "lines": [
    "• bone tenderness: back 6 cm or tip of either malleolus, navicular, 5th metatarsal base",
    "• cannot bear weight at once AND in the emergency department"
   ]
  },
  {
   "id": "spr_inv_1_0",
   "x": 45,
   "y": 836,
   "w": 214,
   "h": 242,
   "kind": "bad",
   "title": "X-ray: a sprain that is a FRACTURE",
   "lines": [
    "• unimalleolar: non-operative if the talus is stable",
    "• bimalleolar (forceful EVERSION): usually surgery",
    "• trimalleolar: unstable → surgery",
    "• Maisonneuve (forceful external rotation): interosseous ligament torn ± medial malleolus avulsion or deltoid rupture → surgery"
   ]
  },
  {
   "id": "ach_inv_0_0",
   "x": 299,
   "y": 664,
   "w": 214,
   "h": 132,
   "kind": "ach_w",
   "title": "Clinical",
   "lines": []
  },
  {
   "id": "ach_inv_1_0",
   "x": 299,
   "y": 818,
   "w": 214,
   "h": 260,
   "kind": "bad",
   "title": "RUPTURE: active people in their 30s-40s",
   "lines": [
    "surgery vs cast or boot: decide WITH the patient",
    "surgery: slightly fewer re-ruptures but infection, wound problems, scarring, sural nerve injury"
   ]
  },
  {
   "id": "pf_inv_0_0",
   "x": 525,
   "y": 664,
   "w": 214,
   "h": 414,
   "kind": "pf_w",
   "title": "Exam",
   "lines": [
    "• tender",
    "• worse with passive dorsiflexion",
    "• tight Achilles"
   ]
  },
  {
   "id": "tp_inv_0_0",
   "x": 779,
   "y": 664,
   "w": 214,
   "h": 414,
   "kind": "tp_w",
   "title": "\"Too many toes\" sign",
   "lines": [
    "is the flat foot flexible or rigid?"
   ]
  },
  {
   "id": "bun_inv_0_0",
   "x": 1033,
   "y": 664,
   "w": 214,
   "h": 414,
   "kind": "bun_w",
   "title": "Is it still FLEXIBLE?",
   "lines": [
    "positioning works only if it is"
   ]
  },
  {
   "id": "mor_inv_0_0",
   "x": 1259,
   "y": 664,
   "w": 214,
   "h": 414,
   "kind": "mor_w",
   "title": "Squeeze or press reproduces it",
   "lines": [
    "sensory findings only, NO motor"
   ]
  },
  {
   "id": "dm_inv_0_0",
   "x": 1513,
   "y": 664,
   "w": 214,
   "h": 142,
   "kind": "dm_w",
   "title": "Monofilament sensation test",
   "lines": []
  },
  {
   "id": "dm_inv_1_0",
   "x": 1513,
   "y": 828,
   "w": 214,
   "h": 250,
   "kind": "dm_w",
   "title": "Pulses: dorsalis pedis + posterior tibial",
   "lines": [
    "• both sides together: SYMMETRY",
    "• diminished → arterial disease",
    "• occlusion: pain, pallor, paresthesia, paralysis, pulselessness"
   ]
  },
  {
   "id": "spr_tx_0_0",
   "x": 45,
   "y": 1118,
   "w": 214,
   "h": 206,
   "kind": "ok",
   "title": "1 · Rest, ice, compression, elevation (RICE)",
   "lines": [
    "• brief immobilization only if needed",
    "• EARLY mobilization, strengthening, proprioception",
    "• NSAIDs, analgesics · bracing or taping: pros and cons",
    "• education: most improve · avoid recurrence"
   ]
  },
  {
   "id": "spr_tx_1_0",
   "x": 45,
   "y": 1346,
   "w": 214,
   "h": 62,
   "kind": "warn",
   "title": "Ongoing instability → ligament reconstruction",
   "lines": []
  },
  {
   "id": "ach_tx_0_0",
   "x": 299,
   "y": 1118,
   "w": 214,
   "h": 290,
   "kind": "ok",
   "title": "Activity change · footwear that does not press",
   "lines": [
    "• heel wedge, cautiously",
    "• physio: stretching, ECCENTRIC strengthening, friction massage, shockwave",
    "• NSAIDs topical or oral · ? topical nitrites",
    "• intervention or surgery rare"
   ]
  },
  {
   "id": "pf_tx_0_0",
   "x": 525,
   "y": 1118,
   "w": 214,
   "h": 197,
   "kind": "ok",
   "title": "Heel pad · arch-support shoes · weight loss",
   "lines": [
    "• heel lift or wedge: careful long term",
    "• fascia stretching · strengthen arch stabilizers: tibialis posterior, intrinsics",
    "• night splints · oral NSAIDs (rarely injected)"
   ]
  },
  {
   "id": "pf_tx_1_0",
   "x": 525,
   "y": 1337,
   "w": 214,
   "h": 71,
   "kind": "warn",
   "title": "Surgical release: very, very rarely",
   "lines": []
  },
  {
   "id": "tp_tx_0_0",
   "x": 779,
   "y": 1118,
   "w": 214,
   "h": 180,
   "kind": "ok",
   "title": "RICE · physio for the arch stabilizers · orthosis",
   "lines": [
    "• orthosis: foot or ankle-foot · corrective vs accommodative",
    "• NSAIDs if needed · modify risk factors"
   ]
  },
  {
   "id": "tp_tx_1_0",
   "x": 779,
   "y": 1320,
   "w": 214,
   "h": 88,
   "kind": "warn",
   "title": "Surgery by severity",
   "lines": []
  },
  {
   "id": "bun_tx_0_0",
   "x": 1033,
   "y": 1118,
   "w": 214,
   "h": 171,
   "kind": "ok",
   "title": "Treat EARLY and often to avoid surgery",
   "lines": [
    "• wider toe box · positioning if flexible",
    "• no real drug (topical NSAID?)"
   ]
  },
  {
   "id": "bun_tx_1_0",
   "x": 1033,
   "y": 1311,
   "w": 214,
   "h": 97,
   "kind": "warn",
   "title": "Surgical realignment",
