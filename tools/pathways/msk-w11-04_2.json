   "x": 751,
   "y": 1260,
   "w": 214,
   "h": 156,
   "kind": "warn",
   "title": "Older: closed reduction + spica cast",
   "lines": [
    "or open reduction ± osteotomy"
   ]
  },
  {
   "id": "club_tx_0_0",
   "x": 977,
