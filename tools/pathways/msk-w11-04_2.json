 "nodes": [
  {
   "id": "root",
   "x": 464,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "A child's bone or joint problem: an INJURY, or a DEVELOPMENTAL problem?",
   "lines": [
    "children's bone is porous and pliable, the periosteum thick, and the growth plate (physis) the weak point: a child FRACTURES where an adult sprains"
   ]
  },
  {
   "id": "g_inj",
   "x": 45,
   "y": 138,
   "w": 666,
   "h": 60,
   "kind": "plain",
   "title": "INJURY",
   "lines": [
    "falls from low heights · sport · pedestrian struck · infant or toddler: NON-ACCIDENTAL injury"
   ]
  },
  {
   "id": "g_dev",
   "x": 751,
   "y": 138,
   "w": 892,
   "h": 60,
   "kind": "plain",
   "title": "DEVELOPMENTAL",
   "lines": [
    "screen, then treat early; do not overtreat normal variants"
   ]
  },
  {
   "id": "frac_head_0_0",
   "x": 45,
   "y": 278,
   "w": 214,
   "h": 98,
   "kind": "frac_h",
   "title": "Fractures of pliable bone",
   "lines": [
    "buckle · greenstick · plastic deformation"
   ]
  },
  {
   "id": "sh_head_0_0",
   "x": 271,
   "y": 278,
   "w": 214,
   "h": 98,
   "kind": "sh_h",
   "title": "Growth plate: Salter-Harris",
   "lines": [
    "risk: growth ARREST → leg length or angular deformity"
   ]
  },
  {
   "id": "apo_head_0_0",
   "x": 497,
   "y": 278,
   "w": 214,
   "h": 98,
   "kind": "apo_h",
   "title": "Apophysis",
   "lines": [
    "tendon insertion: pulled by fast growth + tight muscle"
   ]
  },
  {
   "id": "ddh_head_0_0",
   "x": 751,
   "y": 278,
   "w": 214,
   "h": 98,
   "kind": "ddh_h",
   "title": "Developmental dysplasia of the hip",
   "lines": [
    "shallow acetabulum → subluxation or dislocation"
   ]
  },
  {
   "id": "club_head_0_0",
   "x": 977,
   "y": 278,
   "w": 214,
   "h": 98,
   "kind": "club_h",
   "title": "Clubfoot",
   "lines": [
    "ankle plantarflexed · heel and forefoot in varus"
   ]
  },
  {
   "id": "leg_head_0_0",
   "x": 1203,
   "y": 278,
   "w": 214,
   "h": 98,
   "kind": "leg_h",
   "title": "Leg shape",
   "lines": [
    "in-toeing · out-toeing · bow legs · knock knees"
   ]
  },
  {
   "id": "sco_head_0_0",
   "x": 1429,
   "y": 278,
   "w": 214,
   "h": 98,
   "kind": "sco_h",
   "title": "Scoliosis",
   "lines": [
    "lateral curve + rotation · idiopathic: adolescent, F > M"
   ]
  },
  {
   "id": "frac_pres_0_0",
   "x": 45,
   "y": 416,
   "w": 214,
   "h": 272,
   "kind": "frac_t",
   "title": "Bone bends or buckles",
   "lines": [
    "less ligament injury or dislocation than adults"
   ]
  },
  {
   "id": "sh_pres_0_0",
   "x": 271,
   "y": 416,
   "w": 214,
   "h": 272,
   "kind": "sh_t",
   "title": "A 'sprain' in a child",
   "lines": [
    "sprains are rare in kids: think Salter-Harris I"
   ]
  },
  {
   "id": "apo_pres_0_0",
   "x": 497,
   "y": 416,
   "w": 214,
   "h": 116,
   "kind": "apo_t",
   "title": "SUDDEN burst → AVULSION",
   "lines": [
    "• pelvis",
    "• 5th metatarsal",
    "• medial epicondyle"
   ]
  },
  {
   "id": "apo_pres_1_0",
   "x": 497,
   "y": 554,
   "w": 214,
   "h": 134,
   "kind": "apo_w",
   "title": "GRADUAL → APOPHYSITIS",
   "lines": [
    "• Osgood-Schlatter: tibial tuberosity",
    "• Sinding-Larsen: distal patella",
    "• Sever's: calcaneus"
   ]
  },
  {
   "id": "ddh_pres_0_0",
   "x": 751,
   "y": 416,
   "w": 214,
   "h": 272,
   "kind": "ddh_t",
   "title": "Risk factors",
   "lines": [
    "• first-born · female · breech",
    "• family history · oligohydramnios",
    "• torticollis · clubfoot"
   ]
  },
  {
   "id": "club_pres_0_0",
   "x": 977,
   "y": 416,
   "w": 214,
   "h": 272,
   "kind": "club_t",
   "title": "At birth",
   "lines": [
    "• genetic component",
    "• spina bifida, other syndromes"
   ]
  },
  {
   "id": "leg_pres_0_0",
   "x": 1203,
   "y": 416,
   "w": 214,
   "h": 272,
   "kind": "leg_t",
   "title": "NORMAL for age",
   "lines": [
    "• bow legs (varum): birth to 2",
    "• knock knees (valgum): 3 to 7"
   ]
  },
  {
   "id": "sco_pres_0_0",
   "x": 1429,
   "y": 416,
   "w": 214,
   "h": 272,
   "kind": "sco_t",
   "title": "Rib HUMP, rarely PAIN",
   "lines": [
    "often noticed incidentally"
   ]
  },
  {
   "id": "frac_inv_0_0",
   "x": 45,
   "y": 728,
   "w": 214,
   "h": 155,
   "kind": "frac_w",
   "title": "Remodels WELL if",
   "lines": [
    "• ≥ 2 years of growth left",
    "• metaphyseal",
    "• defect IN the joint's plane"
   ]
  },
  {
   "id": "frac_inv_1_0",
   "x": 45,
   "y": 905,
   "w": 214,
   "h": 155,
   "kind": "frac_w",
   "title": "Remodels POORLY if",
   "lines": [
    "• displaced intra-articular",
    "• mid-shaft angulation or rotation",
    "• defect OUT of plane"
   ]
  },
  {
   "id": "sh_inv_0_0",
   "x": 271,
   "y": 728,
   "w": 214,
   "h": 89,
   "kind": "sh_w",
   "title": "I and II",
   "lines": [
    "• II most common (distal radius)",
    "• stable with closed reduction"
   ]
  },
  {
   "id": "sh_inv_1_0",
   "x": 271,
   "y": 839,
   "w": 214,
   "h": 109,
   "kind": "sh_w",
   "title": "III and IV: INTRA-ARTICULAR",
   "lines": [
    "• need ANATOMIC reduction",
    "• IV: bony bridge risk"
   ]
  },
  {
   "id": "sh_inv_2_0",
   "x": 271,
   "y": 970,
   "w": 214,
   "h": 89,
   "kind": "sh_w",
   "title": "V: compression",
   "lines": [
    "often missed; found late as growth arrest"
   ]
  },
  {
   "id": "apo_inv_0_0",
   "x": 497,
   "y": 728,
   "w": 214,
   "h": 332,
   "kind": "apo_w",
   "title": "Apophysitis: CLINICAL diagnosis",
   "lines": [
    "Osgood-Schlatter: girls 8-14, boys 10-15"
   ]
  },
  {
   "id": "ddh_inv_0_0",
   "x": 751,
   "y": 728,
   "w": 214,
   "h": 164,
   "kind": "ddh_w",
   "title": "Up to 3-6 months",
   "lines": [
    "• Barlow: hip slips OUT (adduct, push back)",
    "• Ortolani: hip slips back IN (abduct, lift)"
   ]
  },
  {
   "id": "ddh_inv_1_0",
   "x": 751,
   "y": 914,
   "w": 214,
   "h": 146,
   "kind": "ddh_w",
   "title": "After that: unreliable",
   "lines": [
    "• limited ABDUCTION",
    "• Galeazzi: leg length difference",
    "• painless waddling limp"
   ]
  },
  {
   "id": "club_inv_0_0",
   "x": 977,
   "y": 728,
   "w": 214,
   "h": 332,
   "kind": "club_w",
   "title": "Untreated",
   "lines": [
    "progressive deformity and stiffness; walking and footwear suffer"
   ]
  },
  {
   "id": "leg_inv_0_0",
   "x": 1203,
   "y": 728,
   "w": 214,
   "h": 332,
   "kind": "bad",
   "title": "Warning signs",
   "lines": [
    "• asymmetric · progressive varum · short stature",
    "• persists beyond 7-8 years",
    "• bone or nutritional disease"
   ]
  },
  {
   "id": "sco_inv_0_0",
   "x": 1429,
   "y": 728,
   "w": 214,
   "h": 114,
   "kind": "sco_w",
   "title": "Adams forward bend",
   "lines": [
    "• rib prominence on the convex side",
    "• full neuro exam, skin over the spine"
   ]
  },
  {
   "id": "sco_inv_1_0",
   "x": 1429,
   "y": 864,
   "w": 214,
   "h": 78,
   "kind": "sco_w",
   "title": "X-ray",
   "lines": [
    "location · levels · direction · degrees"
   ]
  },
  {
   "id": "sco_inv_2_0",
   "x": 1429,
   "y": 964,
   "w": 214,
   "h": 96,
   "kind": "sco_w",
   "title": "Progresses if",
   "lines": [
    "• pre-menarchal (young)",
    "• large or double curve",
    "• thoracic"
   ]
  },
  {
   "id": "frac_tx_0_0",
   "x": 45,
   "y": 1100,
   "w": 214,
   "h": 146,
   "kind": "ok",
   "title": "Closed reduction → cast",
   "lines": [
    "hematoma block or conscious sedation"
   ]
  },
  {
   "id": "frac_tx_1_0",
   "x": 45,
   "y": 1268,
   "w": 214,
   "h": 148,
   "kind": "warn",
   "title": "ALWAYS post-reduction films",
   "lines": [
    "then timely follow-up"
   ]
  },
  {
   "id": "sh_tx_0_0",
   "x": 271,
   "y": 1100,
   "w": 214,
   "h": 316,
   "kind": "bad",
   "title": "EVERY growth plate injury is serious",
   "lines": [
    "• follow ≥ 1 year (preferably 2)",
    "• warn the family"
   ]
  },
  {
   "id": "apo_tx_0_0",
   "x": 497,
   "y": 1100,
   "w": 214,
   "h": 316,
   "kind": "ok",
   "title": "Usually non-surgical",
   "lines": [
    "• apophysitis: rest, ice, compression, elevation; activity as tolerated; anti-inflammatories as needed",
    "• settles within 2 years"
   ]
  },
  {
   "id": "ddh_tx_0_0",
   "x": 751,
   "y": 1100,
   "w": 214,
   "h": 138,
   "kind": "ok",
   "title": "Up to 6 months: Pavlik harness",
   "lines": []
  },
  {
