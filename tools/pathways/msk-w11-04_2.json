   "title": "ONE joint, over 6 weeks, worse with ACTIVITY: think OA",
   "lines": [
    "a CLINICAL diagnosis · the X-ray STAGES it, it does not diagnose it",
    "first set aside mechanical knee pain (no arthritis)"
   ]
  },
  {
   "id": "g_dx",
   "x": 45,
   "y": 138,
   "w": 484,
   "h": 60,
   "kind": "plain",
   "title": "IS IT OA?",
   "lines": [
    "knee > hip > ankle, shoulder"
   ]
  },
  {
   "id": "g_tx",
   "x": 569,
   "y": 138,
   "w": 732,
   "h": 60,
   "kind": "plain",
   "title": "TREAT IT: what stage, what can be fixed?",
   "lines": [
    "nothing saves the joint: treat life WITH it"
   ]
  },
  {
   "id": "red_head_0_0",
   "x": 45,
   "y": 278,
   "w": 236,
   "h": 98,
   "kind": "red_h",
   "title": "Red flag → NOT OA",
   "lines": [
    "think something else"
   ]
  },
  {
   "id": "oa_head_0_0",
   "x": 293,
   "y": 278,
   "w": 236,
   "h": 98,
   "kind": "oa_h",
   "title": "Osteoarthritis",
   "lines": [
    "most common joint disorder",
    "joint FAILURE, not wear and tear"
   ]
  },
  {
   "id": "bio_head_0_0",
   "x": 569,
   "y": 278,
   "w": 236,
   "h": 98,
   "kind": "bio_h",
   "title": "Every stage: biomechanics + education",
   "lines": [
    "alignment · overuse · weakness · gait"
   ]
  },
  {
   "id": "med_head_0_0",
   "x": 817,
   "y": 278,
   "w": 236,
   "h": 98,
   "kind": "med_h",
   "title": "Medicines: symptoms only",
   "lines": [
    "less pain, better function"
   ]
  },
  {
   "id": "surg_head_0_0",
   "x": 1065,
   "y": 278,
   "w": 236,
   "h": 98,
   "kind": "surg_h",
   "title": "Surgery: END STAGE only",
   "lines": [
    "unacceptable symptoms despite all of the rest"
   ]
  },
  {
   "id": "red_clue_0_0",
   "x": 45,
   "y": 416,
   "w": 236,
   "h": 260,
   "kind": "bad",
   "title": "Any ONE of these",
   "lines": [
    "• warm joint: infection, crystals",
    "• autoimmune arthritis",
    "• tumour · fracture · osteonecrosis",
    "• Charcot (diabetes)"
   ]
  },
  {
   "id": "red_clue_1_0",
   "x": 45,
   "y": 698,
   "w": 236,
   "h": 206,
   "kind": "red_w",
   "title": "Widespread pain",
   "lines": [
    "not OA: look elsewhere"
   ]
  },
  {
   "id": "oa_clue_0_0",
   "x": 293,
   "y": 416,
   "w": 236,
   "h": 134,
   "kind": "oa_t",
   "title": "Pain or stiffness with ACTIVITY",
   "lines": [
    "• morning stiffness < 30 min",
    "• COOL effusion",
    "• crepitus · Heberden's, Bouchard's nodes"
   ]
  },
  {
   "id": "oa_clue_1_0",
   "x": 293,
   "y": 572,
   "w": 236,
   "h": 96,
   "kind": "oa_w",
   "title": "Risk",
   "lines": [
    "• obesity · age · female · weakness",
    "• old injury or fracture: starts YOUNG",
    "• ankle: > 50% after a fracture"
   ]
  },
  {
   "id": "oa_clue_2_0",
   "x": 293,
   "y": 690,
   "w": 236,
   "h": 96,
   "kind": "oa_w",
   "title": "Hip",
   "lines": [
    "• groin pain, the 'C' sign · socks hard",
    "• INTERNAL rotation lost first",
    "• X-ray, NOT MRI"
   ]
  },
  {
   "id": "oa_clue_3_0",
   "x": 293,
   "y": 808,
   "w": 236,
   "h": 96,
   "kind": "oa_w",
   "title": "Shoulder · elbow · AC",
   "lines": [
    "• shoulder: passive LOST, cuff intact",
    "• elbow: locking, post-traumatic",
    "• AC: gradual, no injury"
   ]
  },
  {
   "id": "bio_clue_0_0",
   "x": 569,
   "y": 416,
   "w": 236,
   "h": 488,
   "kind": "ok",
   "title": "ACTIVE therapy",
   "lines": [
    "• exercise physio ≥ 3 months (GLA:D)",
    "• 150 min of activity a week",
    "• lose 5% of body weight"
   ]
  },
  {
   "id": "med_clue_0_0",
   "x": 817,
   "y": 416,
   "w": 236,
   "h": 488,
   "kind": "ok",
   "title": "Evidence-based",
   "lines": [
    "• TOPICAL NSAID first",
    "• oral NSAID if the kidneys allow",
    "• refractory: steroid injection → duloxetine"
   ]
  },
  {
   "id": "surg_clue_0_0",
   "x": 1065,
   "y": 416,
   "w": 236,
   "h": 488,
   "kind": "ok",
   "title": "Joint replacement",
   "lines": [
    "• bone on bone on X-ray",
    "• refer to orthopedics"
   ]
  },
  {
   "id": "red_tx_0_0",
   "x": 45,
   "y": 944,
   "w": 236,
   "h": 178,
   "kind": "red_w",
   "title": "Work up that cause",
   "lines": [
    "MRI, bone scan only if in DOUBT"
   ]
  },
  {
   "id": "oa_tx_0_0",
   "x": 293,
   "y": 944,
   "w": 236,
   "h": 178,
   "kind": "oa_t",
   "title": "X-ray: Kellgren-Lawrence grade",
   "lines": [
    "• 1-2 early · 3-4 late",
    "• ASYMMETRIC narrowing, osteophytes"
   ]
  },
  {
   "id": "bio_tx_0_0",
   "x": 569,
   "y": 944,
   "w": 236,
   "h": 78,
   "kind": "bio_w",
   "title": "Also",
   "lines": [
    "• walking aid, insoles, brace",
    "• OT: joint protection"
   ]
  },
  {
   "id": "bio_tx_1_0",
   "x": 569,
   "y": 1044,
   "w": 236,
   "h": 78,
   "kind": "bad",
   "title": "PASSIVE therapy: NO",
   "lines": [
    "ultrasound, TENS, laser, acupuncture"
   ]
  },
  {
   "id": "med_tx_0_0",
   "x": 817,
   "y": 944,
   "w": 236,
   "h": 78,
   "kind": "warn",
   "title": "Weak or unproven",
   "lines": [
    "• acetaminophen · glucosamine",
    "• hyaluronic acid, PRP, stem cells"
   ]
  },
  {
   "id": "med_tx_1_0",
   "x": 817,
   "y": 1044,
   "w": 236,
   "h": 78,
   "kind": "bad",
   "title": "AVOID",
   "lines": [
    "• opioids (tramadol at most)",
    "• capsaicin, chondroitin"
   ]
  },
  {
   "id": "surg_tx_0_0",
   "x": 1065,
   "y": 944,
   "w": 236,
   "h": 178,
   "kind": "bad",
   "title": "NO knee arthroscopy",
   "lines": [
    "no meaningful benefit"
   ]
  }
