   "kind": "to_t",
   "title": "SUDDEN, SHARP, one-sided",
   "lines": [
    "• after VIGOROUS activity: intercourse, golf, exercise",
    "• vomiting",
    "• may collapse"
   ]
  },
  {
   "id": "to_pres_1_0",
   "x": 45,
   "y": 1071,
   "w": 212,
