 "nodes": [
  {
   "id": "root",
   "x": 457,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Pelvic pain: ACUTE (find the life- or limb-threat first) or CHRONIC (≥ 6 MONTHS)?",
   "lines": [
    "history + physical exam come first: the most important part of any approach",
    "acute labs: CBC · QUANTITATIVE β-hCG · urinalysis + culture · vaginal/cervical cultures · ultrasound · group and screen",
    "chronic = below the umbilicus, ≥ 6 months, disabling or needing treatment · up to 50% have experienced abuse or trauma",
    "chronic: 10% of gyn referrals · 40% of laparoscopies, 20% of benign hysterectomies · pain NOT proportional to tissue damage"
   ]
  },
  {
   "id": "g_ac",
   "x": 45,
   "y": 174,
   "w": 436,
   "h": 204,
   "kind": "plain",
   "title": "ACUTE: work it up in this order",
   "lines": [
    "1 · quantitative β-hCG: POSITIVE → ECTOPIC (FIRST-TRIMESTER BLEEDING chart)",
    "~case: β-hCG 2345 · Hb 82 · shoulder-tip pain, tenesmus, lightheaded → ruptured ectopic",
    "2 · FEVER + white count ↑ → PID (SEXUALLY TRANSMITTED INFECTIONS chart)",
    "~case: 17 y, fever, foul discharge, dyspareunia · WBC 22 · chandelier sign",
    "3 · neither: CBC hemoglobin + ULTRASOUND decide ↓"
   ]
  },
  {
   "id": "g_ch",
   "x": 521,
   "y": 174,
   "w": 1108,
   "h": 204,
   "kind": "plain",
   "title": "CHRONIC: is it CYCLIC with a NORMAL exam?",
   "lines": [
    "YES → functional (primary) · NO, or an exam/imaging finding → STRUCTURAL (secondary), more common with AGE"
   ]
  },
  {
   "id": "t_ac",
   "x": 45,
   "y": 418,
   "w": 436,
   "h": 132,
   "kind": "plain",
   "title": "β-hCG < 1 · afebrile: is the hemoglobin STABLE?",
   "lines": [
    "• group and screen",
    "• repeat the CBC if bleeding may be ongoing"
   ]
  },
  {
   "id": "t_pr",
   "x": 521,
   "y": 418,
   "w": 212,
   "h": 132,
   "kind": "plain",
   "title": "YES: PRIMARY",
   "lines": [
    "late teens, 20s, then declines"
   ]
  },
  {
   "id": "t_st",
   "x": 745,
   "y": 418,
   "w": 884,
   "h": 132,
   "kind": "plain",
   "title": "NO: STRUCTURAL · the EXAM points the way",
   "lines": [
    "• NODULAR, FIXED → endometriosis",
    "• BOGGY, tender, enlarged → adenomyosis",
    "• ENLARGED, MOBILE, mass → fibroid",
    "• MASS at the os → polyp",
    "~• always send removed tissue to pathology"
   ]
  },
  {
   "id": "to_head_0_0",
   "x": 45,
   "y": 630,
   "w": 212,
   "h": 132,
   "kind": "to_h",
   "title": "Ovarian torsion",
   "lines": [
    "ovary ± tube twists on IP + utero-ovarian ligaments · any age",
    "SURGICAL EMERGENCY: save the ovary"
   ]
  },
  {
   "id": "cy_head_0_0",
   "x": 269,
   "y": 630,
   "w": 212,
   "h": 132,
   "kind": "cy_h",
   "title": "Ruptured hemorrhagic ovarian cyst",
   "lines": [
    "UNCOMMON: most ruptures bleed little"
   ]
  },
  {
   "id": "dy_head_0_0",
   "x": 521,
   "y": 630,
   "w": 212,
   "h": 132,
   "kind": "dy_h",
   "title": "Primary dysmenorrhea",
   "lines": [
    "painful menses, NO structural cause"
   ]
  },
  {
   "id": "en_head_0_0",
   "x": 745,
   "y": 630,
   "w": 212,
   "h": 132,
   "kind": "en_h",
   "title": "Endometriosis",
   "lines": [
    "endometrial tissue OUTSIDE the uterus",
    "ovaries #1 · uterine ligaments #2",
    "1–7% · 7% of 1st-degree relatives · 5–33% of infertile"
   ]
  },
  {
   "id": "ad_head_0_0",
   "x": 969,
   "y": 630,
   "w": 212,
   "h": 132,
   "kind": "ad_h",
   "title": "Adenomyosis",
   "lines": [
    "endometrium DEEP in the myometrium",
    "PAROUS · 40s–50s",
    "5–70% of women"
   ]
  },
  {
   "id": "le_head_0_0",
   "x": 1193,
   "y": 630,
   "w": 212,
   "h": 132,
   "kind": "le_h",
   "title": "Leiomyoma (fibroid)",
   "lines": [
    "benign smooth-muscle NEOPLASM",
    "NOT pre-malignant",
    "50% of women > 40 on imaging"
   ]
  },
  {
   "id": "po_head_0_0",
   "x": 1417,
   "y": 630,
   "w": 212,
   "h": 132,
   "kind": "po_h",
   "title": "Endometrial polyp",
   "lines": [
    "benign, HORMONE-dependent overgrowth of endometrium",
    "linked to estrogen, TAMOXIFEN · common > 40"
   ]
  },
  {
