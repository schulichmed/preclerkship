 "nodes": [
  {
   "id": "root",
   "x": 457,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Pelvic pain: ACUTE (find the life- or limb-threat first) or CHRONIC (≥ 6 MONTHS)?",
   "lines": [
    "history + physical exam come first: the most important part of any approach",
    "chronic = below the umbilicus, ≥ 6 months, disabling or needing treatment · up to 50% have experienced abuse or trauma"
   ]
  },
  {
   "id": "g_ac",
   "x": 45,
   "y": 138,
   "w": 436,
   "h": 132,
   "kind": "plain",
   "title": "ACUTE: work it up in this order",
   "lines": [
    "1 · quantitative β-hCG: POSITIVE → ECTOPIC (FIRST-TRIMESTER BLEEDING chart)",
    "2 · FEVER + white count ↑ → PID (SEXUALLY TRANSMITTED INFECTIONS chart)",
    "3 · neither: CBC hemoglobin + ULTRASOUND decide ↓"
   ]
  },
  {
   "id": "g_ch",
   "x": 521,
   "y": 138,
   "w": 1108,
   "h": 132,
   "kind": "plain",
   "title": "CHRONIC: is it CYCLIC with a NORMAL exam?",
   "lines": [
    "YES → functional (primary) · NO, or an exam/imaging finding → STRUCTURAL (secondary), more common with AGE"
   ]
  },
  {
   "id": "t_ac",
   "x": 45,
   "y": 310,
   "w": 436,
   "h": 78,
   "kind": "plain",
   "title": "β-hCG < 1 · afebrile: is the hemoglobin STABLE?",
   "lines": [
    "group and screen · repeat the CBC if bleeding may be ongoing"
   ]
  },
  {
   "id": "t_pr",
   "x": 521,
   "y": 310,
   "w": 212,
   "h": 78,
   "kind": "plain",
   "title": "YES: PRIMARY",
   "lines": [
    "late teens, 20s, then declines"
   ]
  },
  {
   "id": "t_st",
   "x": 745,
   "y": 310,
   "w": 884,
   "h": 78,
   "kind": "plain",
   "title": "NO: STRUCTURAL · the EXAM points the way",
   "lines": [
    "NODULAR, FIXED → endometriosis · BOGGY, tender, enlarged → adenomyosis · ENLARGED, MOBILE, mass → fibroid · MASS at the os → polyp",
    "~always send removed tissue to pathology"
   ]
  },
  {
   "id": "to_head_0_0",
   "x": 45,
   "y": 468,
   "w": 212,
   "h": 114,
   "kind": "to_h",
   "title": "Ovarian torsion",
   "lines": [
    "ovary ± tube twists on its ligaments",
    "SURGICAL EMERGENCY: save the ovary"
   ]
  },
  {
