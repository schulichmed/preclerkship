   ]
  },
  {
   "id": "dy_head_0_0",
   "x": 521,
   "y": 468,
   "w": 212,
   "h": 114,
   "kind": "dy_h",
   "title": "Primary dysmenorrhea",
   "lines": [
    "painful menses, NO structural cause"
   ]
  },
  {
