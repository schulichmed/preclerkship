   "x": 1417,
   "y": 802,
   "w": 212,
   "h": 238,
   "kind": "po_t",
   "title": "Bleeding BETWEEN periods",
   "lines": [
    "• daily spotting",
    "• infertility",
    "• PAIN only if it protrudes through the os"
   ]
  },
  {
   "id": "po_pres_1_0",
   "x": 1417,
   "y": 1062,
   "w": 212,
   "h": 218,
   "kind": "po_w",
   "title": "Exam",
   "lines": [
