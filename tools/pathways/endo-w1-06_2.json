  {
   "id": "dka_tx_0_0",
   "x": 45,
   "y": 1086,
   "w": 214,
   "h": 86,
   "kind": "bad",
   "title": "1 · ABCs · NORMAL SALINE",
   "lines": [
    "many litres"
   ]
  },
  {
   "id": "dka_tx_1_0",
   "x": 45,
   "y": 1194,
   "w": 214,
   "h": 102,
   "kind": "ok",
   "title": "2 · IV insulin: ALWAYS",
   "lines": [
    "• glucose 12–14 → ADD dextrose",
    "• keep going until the gap closes"
   ]
  },
  {
   "id": "dka_tx_2_0",
   "x": 45,
   "y": 1318,
   "w": 214,
   "h": 122,
   "kind": "bad",
   "title": "3 · Watch POTASSIUM: insulin drops it",
   "lines": [
    "• replace IV · arrhythmias kill",
    "• every 1–2 h: electrolytes, pH, alertness"
   ]
  },
  {
   "id": "hhs_tx_0_0",
   "x": 271,
   "y": 1086,
   "w": 214,
   "h": 165,
   "kind": "ok",
