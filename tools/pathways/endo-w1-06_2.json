   "lines": [
    "• bigger deficit: ~9 L vs ~6 L",
    "• insulin almost always"
   ]
  },
  {
   "id": "hhs_tx_1_0",
   "x": 271,
   "y": 1273,
   "w": 214,
   "h": 167,
   "kind": "warn",
