   ]
  },
  {
   "id": "hypo_tx_0_0",
   "x": 497,
   "y": 1086,
   "w": 214,
   "h": 156,
   "kind": "ok",
   "title": "1 · EARLY: 15 g fast sugar",
   "lines": [
    "• glucose tablets, juice",
    "• gel: absorbed through the cheek"
   ]
  },
  {
   "id": "hypo_tx_1_0",
   "x": 497,
   "y": 1264,
   "w": 214,
   "h": 176,
   "kind": "bad",
   "title": "2 · LATE: someone else treats it",
   "lines": [
