   "x": 1457,
   "y": 398,
   "w": 214,
   "h": 116,
   "kind": "mac_h",
   "title": "Heart attack · stroke · peripheral vascular disease",
   "lines": [
    "fatty acids → atherosclerosis"
   ]
  },
  {
   "id": "dka_pres_0_0",
   "x": 45,
   "y": 554,
   "w": 214,
   "h": 97,
   "kind": "dka_t",
   "title": "Vomiting, abdominal PAIN",
   "lines": [
    "• fast deep (Kussmaul) breathing",
    "• acetone breath",
    "• dehydrated, low blood pressure"
   ]
  },
  {
   "id": "dka_pres_1_0",
   "x": 45,
   "y": 673,
   "w": 214,
   "h": 133,
   "kind": "dka_w",
   "title": "Why now?",
   "lines": [
    "• new type 1, missed or rationed insulin",
    "• steroids, sodium-glucose cotransporter 2 (SGLT2) inhibitors, cocaine"
   ]
  },
  {
   "id": "hhs_pres_0_0",
   "x": 271,
   "y": 554,
   "w": 214,
   "h": 115,
   "kind": "hhs_t",
   "title": "Lethargy → obtundation",
   "lines": [
    "• NO pain, NO vomiting",
    "• NO Kussmaul, NO acetone",
    "• very dehydrated"
   ]
  },
  {
   "id": "hhs_pres_1_0",
   "x": 271,
   "y": 691,
   "w": 214,
   "h": 115,
   "kind": "hhs_w",
   "title": "Why now?",
   "lines": [
    "• illness: gastroenteritis, sepsis, heart attack, stroke",
    "• steroids, missed doses"
   ]
  },
  {
   "id": "hypo_pres_0_0",
   "x": 497,
   "y": 554,
   "w": 214,
   "h": 115,
   "kind": "hypo_t",
   "title": "EARLY: adrenaline surge",
   "lines": [
    "• shaky, sweaty, anxious",
    "• hungry, pale"
   ]
  },
  {
   "id": "hypo_pres_1_0",
   "x": 497,
   "y": 691,
   "w": 214,
   "h": 115,
   "kind": "bad",
   "title": "LATE: the brain is starved",
   "lines": [
    "• confused, drowsy",
    "• seizures, coma"
   ]
  },
  {
   "id": "ret_pres_0_0",
   "x": 751,
   "y": 554,
   "w": 214,
   "h": 252,
   "kind": "ret_t",
   "title": "Stage on the retina",
   "lines": [
    "• background: dots, microaneurysms",
    "• pre-proliferative: cotton wool, exudates, macular edema",
    "• PROLIFERATIVE: new fragile vessels"
   ]
  },
  {
   "id": "neph_pres_0_0",
   "x": 977,
   "y": 554,
   "w": 214,
   "h": 252,
   "kind": "neph_t",
   "title": "Silent: albumin leaks first",
   "lines": [
    "• microalbuminuria",
    "• then falling kidney function"
   ]
  },
  {
   "id": "neur_pres_0_0",
   "x": 1203,
   "y": 554,
   "w": 214,
   "h": 116,
   "kind": "neur_t",
   "title": "Numb, tingling, burning feet",
   "lines": [
    "• glove and stocking",
    "• proprioception lost EARLY",
    "• pain wakes them at night"
   ]
  },
  {
   "id": "neur_pres_1_0",
   "x": 1203,
   "y": 692,
   "w": 214,
   "h": 114,
   "kind": "neur_w",
   "title": "Other kinds",
   "lines": [
    "• autonomic: gastroparesis, erectile dysfunction",
    "• cranial: 3rd nerve palsy",
    "• amyotrophy: proximal wasting"
   ]
  },
  {
   "id": "mac_pres_0_0",
   "x": 1457,
   "y": 554,
   "w": 214,
   "h": 252,
   "kind": "mac_t",
   "title": "Ask EVERY visit",
   "lines": [
    "• chest pain",
    "• calf pain walking: feel BOTH legs' pulses",
    "• stroke or transient ischemic attack"
   ]
  },
  {
   "id": "dka_inv_0_0",
   "x": 45,
   "y": 846,
   "w": 214,
   "h": 97,
   "kind": "dka_t",
   "title": "1 · Venous gas + ketones",
   "lines": [
    "• pH ≤ 7.3, bicarbonate < 18",
    "• anion gap > 12: follow it",
    "• glucose usually > 15"
   ]
  },
  {
   "id": "dka_inv_1_0",
   "x": 45,
   "y": 965,
   "w": 214,
   "h": 81,
   "kind": "dka_w",
   "title": "2 · Potassium normal or LOW",
   "lines": [
    "the body's store is EMPTY"
   ]
  },
  {
   "id": "hhs_inv_0_0",
   "x": 271,
   "y": 846,
   "w": 214,
   "h": 98,
   "kind": "hhs_t",
   "title": "1 · Glucose > 30 · osmolality > 320",
   "lines": [
    "• pH > 7.3, bicarbonate > 15",
    "• ketones none or trace, gap < 12"
   ]
  },
  {
   "id": "hhs_inv_1_0",
   "x": 271,
   "y": 966,
   "w": 214,
   "h": 80,
   "kind": "hhs_w",
   "title": "2 · Potassium usually normal",
   "lines": [
    "HIGH if the kidneys fail"
   ]
  },
  {
   "id": "hypo_inv_0_0",
   "x": 497,
   "y": 846,
   "w": 214,
   "h": 200,
   "kind": "hypo_w",
   "title": "Find the cause",
   "lines": [
    "• exercise without adjusting insulin",
    "• skipped meal"
   ]
  },
  {
   "id": "ret_inv_0_0",
   "x": 751,
   "y": 846,
   "w": 214,
   "h": 200,
   "kind": "ret_w",
   "title": "Eye exam EVERY YEAR",
   "lines": [
    "optometrist, from diagnosis"
   ]
  },
  {
   "id": "neph_inv_0_0",
   "x": 977,
   "y": 846,
   "w": 214,
   "h": 200,
   "kind": "neph_w",
   "title": "Kidney function",
   "lines": [
    "with every A1c, ~every 3 months"
   ]
  },
  {
   "id": "neur_inv_0_0",
   "x": 1203,
   "y": 846,
   "w": 214,
   "h": 200,
   "kind": "neur_w",
   "title": "Foot exam EVERY visit",
   "lines": [
    "• calluses, ulcers, pedal pulses",
    "~sensation testing + daily self-checks: see the FOOT AND ANKLE PAIN chart"
   ]
  },
  {
   "id": "mac_inv_0_0",
   "x": 1457,
   "y": 846,
   "w": 214,
   "h": 98,
   "kind": "mac_w",
   "title": "Blood pressure ≤ 130/80",
   "lines": [
    "home or pharmacy readings"
   ]
  },
