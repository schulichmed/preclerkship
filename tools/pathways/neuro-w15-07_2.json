   "h": 114,
   "kind": "plain",
   "title": "RED FLAGS: vision threatening",
   "lines": [
    "URGENT referral to ophthalmology",
    "• cornea: ulcer, keratitis",
    "• anterior chamber: uveitis, acute angle closure",
    "• scleritis · trauma · orbital cellulitis"
   ]
  },
