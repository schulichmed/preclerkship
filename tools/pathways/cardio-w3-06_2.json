   ]
  },
  {
   "id": "ci_inv_1_0",
   "x": 1341,
   "y": 652,
   "w": 236,
   "h": 62,
   "kind": "ci_w",
   "title": "2 · CT angiogram or angiography",
   "lines": []
  },
  {
   "id": "cr_tx_0_0",
   "x": 45,
   "y": 754,
   "w": 236,
   "h": 336,
   "kind": "ok",
   "title": "Prescribe by F.I.T.T.",
   "lines": [
    "• Frequency: aerobic 3–5×/week",
    "• Intensity: 40–80% of heart-rate reserve",
    "• Time: 20–40 min · Type: aerobic + resistance"
   ]
  },
  {
   "id": "sp_tx_0_0",
   "x": 293,
   "y": 754,
   "w": 236,
   "h": 114,
   "kind": "ok",
   "title": "ALL: ACE inhibitor + statin",
   "lines": [
    "• ACE inhibitor: most benefit with hypertension, diabetes, EF < 40%, kidney disease",
    "• not tolerated (cough) → ARB"
   ]
  },
  {
   "id": "sp_tx_1_0",
   "x": 293,
   "y": 890,
   "w": 236,
   "h": 80,
   "kind": "ok",
   "title": "Beta blocker ONLY if EF < 40%",
   "lines": [
    "with or without heart failure"
   ]
  },
  {
   "id": "sp_tx_2_0",
   "x": 293,
   "y": 992,
   "w": 236,
   "h": 98,
   "kind": "warn",
   "title": "Calcium channel blockers, ivabradine",
   "lines": [
    "anti-anginal ONLY: no secondary-prevention benefit"
   ]
  },
  {
   "id": "cl_tx_0_0",
   "x": 1093,
   "y": 754,
   "w": 236,
   "h": 193,
   "kind": "ok",
   "title": "ABCDES",
   "lines": [
    "• Antiplatelet, BP, Cholesterol (statin), Diabetes",
    "• Exercise: grows collaterals",
    "• SMOKING cessation: the most important"
   ]
  },
  {
   "id": "cl_tx_1_0",
   "x": 1093,
   "y": 969,
   "w": 236,
   "h": 121,
   "kind": "warn",
   "title": "DISABLING claudication",
   "lines": [
    "revascularize? controversial"
   ]
  },
  {
   "id": "ci_tx_0_0",
   "x": 1341,
   "y": 754,
   "w": 236,
   "h": 165,
   "kind": "ok",
   "title": "REVASCULARIZE",
   "lines": [
    "• open bypass: durable, needs a vein",
    "• endovascular: less invasive, more re-interventions"
   ]
  },
  {
   "id": "ci_tx_1_0",
   "x": 1341,
   "y": 941,
   "w": 236,
   "h": 149,
   "kind": "bad",
   "title": "Saving the limb would threaten LIFE",
   "lines": [
    "→ AMPUTATION"
   ]
  },
  {
   "id": "span0_tx_0_0",
   "x": 569,
   "y": 754,
   "w": 484,
   "h": 109,
   "kind": "bad",
   "title": "1 · HEPARIN now",
   "lines": [
    "• 5000 U bolus, then 1000 U/h: aPTT 2–3×",
    "• oxygen, IV fluids + urine output, analgesia"
   ]
  },
  {
   "id": "span0_tx_1_0",
   "x": 569,
   "y": 885,
   "w": 484,
   "h": 91,
   "kind": "ok",
   "title": "2 · REVASCULARIZE",
   "lines": [
    "endovascular (thrombolysis, stent) or open (embolectomy, bypass)"
   ]
  },
  {
   "id": "span0_tx_2_0",
   "x": 569,
   "y": 998,
   "w": 484,
   "h": 91,
   "kind": "bad",
   "title": "3 · Reperfused: COMPARTMENT syndrome?",
   "lines": [
    "→ FASCIOTOMY, a surgical emergency · watch the kidneys"
   ]
  }
