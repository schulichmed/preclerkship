   "kind": "dark",
   "title": "Is it attention deficit hyperactivity disorder (ADHD), and which presentation?",
   "lines": [
    "assess: parent AND child interviews across settings · SNAP-IV rating scale · psychological tests",
    "judge against what is NORMAL for the child's age: a yes/no checklist alone is not enough"
   ]
  },
  {
   "id": "g_yes",
   "x": 45,
   "y": 138,
   "w": 744,
   "h": 60,
   "kind": "plain",
   "title": "ADHD only if ALL of these hold",
   "lines": [
    "symptoms ≥ 6 months · several before age 12 · in 2+ settings (home, school, friends) · clear impairment of functioning"
   ]
  },
