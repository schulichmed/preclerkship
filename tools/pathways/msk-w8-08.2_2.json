   "title": "Surgery",
   "lines": [
    "displaced, or proximal pole"
   ]
  },
  {
   "id": "drc_inv_0_0",
   "x": 45,
   "y": 514,
   "w": 250,
   "h": 96,
   "kind": "drc_w",
   "title": "1 · Adequate analgesia",
   "lines": [
    "• hematoma block (1% lidocaine)",
    "• regional anaesthesia",
    "• conscious sedation"
   ]
  },
  {
   "id": "drc_inv_1_0",
   "x": 45,
   "y": 632,
   "w": 250,
   "h": 78,
   "kind": "drc_w",
   "title": "2 · Reduce",
   "lines": [
    "traction → INCREASE the deformity (unlocks the fragments) → correct it"
   ]
  },
  {
   "id": "dro_inv_0_0",
   "x": 307,
   "y": 514,
   "w": 250,
   "h": 196,
   "kind": "dro_w",
   "title": "Left uncorrected",
   "lines": [
    "• crooked: radio-ulnar joint motion altered, rotation restricted",
    "• short: ulnar impaction syndrome"
   ]
  },
  {
   "id": "scc_inv_0_0",
