  {
   "id": "root",
   "x": 197,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Fall on an outstretched hand (FOOSH): which bone, and does it need SURGERY?",
   "lines": [
    "treatment is dictated by age and activity level, and by how displaced the fracture is"
   ]
  },
  {
   "id": "g_dr",
   "x": 45,
   "y": 120,
   "w": 512,
   "h": 78,
   "kind": "plain",
   "title": "DISTAL RADIUS: very common",
   "lines": [
    "localized pain · poor function if the anatomy is not restored"
   ]
  },
  {
   "id": "g_sc",
   "x": 597,
   "y": 120,
   "w": 512,
   "h": 78,
   "kind": "plain",
   "title": "SCAPHOID: young people",
   "lines": [
    "swelling + localized tenderness",
    "retrograde blood flow → nonunion, osteonecrosis, late arthrosis"
   ]
  },
  {
   "id": "p_dr",
   "x": 45,
   "y": 238,
   "w": 512,
   "h": 96,
   "kind": "info",
   "title": "X-ray: 3 questions",
   "lines": [
    "• CROOKED? normal 12° palmar tilt on the lateral",
    "• SHORT? more than neutral ulnar variance (compare the other side)",
    "• SMOOTH? a step > 1 mm → post-traumatic arthrosis"
   ]
  },
  {
   "id": "p_sc",
   "x": 597,
   "y": 238,
   "w": 512,
   "h": 96,
   "kind": "info",
   "title": "Be SUSPICIOUS",
   "lines": [
    "• X-ray usually sufficient",
    "• X-ray NORMAL → treat as fractured + CT or MRI"
   ]
  },
  {
   "id": "drc_head_0_0",
   "x": 45,
   "y": 414,
   "w": 250,
   "h": 60,
   "kind": "drc_h",
   "title": "CLOSED reduction + cast",
   "lines": [
    "forgiving at the extremes of age"
   ]
  },
  {
   "id": "dro_head_0_0",
   "x": 307,
   "y": 414,
   "w": 250,
   "h": 60,
   "kind": "dro_h",
   "title": "SURGICAL reduction",
   "lines": [
    "still crooked, short or not smooth"
   ]
  },
  {
   "id": "scc_head_0_0",
   "x": 597,
   "y": 414,
   "w": 250,
   "h": 60,
   "kind": "scc_h",
   "title": "Cast",
   "lines": [
