 "nodes": [
  {
   "id": "root",
   "x": 298,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "A medicine in pregnancy or breastfeeding: is it worth it?",
   "lines": [
    "most drugs reach the baby, and most are still safe · always weigh the risk of the UNTREATED disease",
    "the risk depends on the drug, the dose, the timing and her disease"
   ]
  },
  {
   "id": "g_preg",
   "x": 45,
   "y": 138,
   "w": 488,
   "h": 60,
   "kind": "plain",
   "title": "PREGNANT: the placenta is NOT a barrier",
   "lines": [
    "timing of exposure: see the ANTENATAL CARE chart"
   ]
  },
  {
   "id": "g_bf",
   "x": 573,
   "y": 138,
   "w": 738,
   "h": 60,
   "kind": "plain",
   "title": "BREASTFEEDING: how much reaches the baby, and can the baby clear it?",
   "lines": [
    "most drugs cross into milk, in minute amounts"
   ]
  },
  {
   "id": "safe_head_0_0",
   "x": 45,
   "y": 278,
   "w": 238,
   "h": 80,
   "kind": "safe_h",
   "title": "Most drugs: probably safe",
   "lines": [
    "baseline major malformation risk 2–4%, with or without a drug"
   ]
  },
  {
   "id": "terat_head_0_0",
   "x": 295,
   "y": 278,
   "w": 238,
   "h": 80,
   "kind": "terat_h",
   "title": "Major teratogen",
   "lines": [
    "even these harm only a fraction of exposed babies"
   ]
  },
  {
   "id": "rid_head_0_0",
   "x": 573,
   "y": 278,
   "w": 238,
   "h": 80,
   "kind": "rid_h",
   "title": "Usually SAFE",
   "lines": [
    "most medications are not contraindicated"
   ]
  },
  {
   "id": "ci_head_0_0",
   "x": 823,
   "y": 278,
   "w": 238,
   "h": 80,
   "kind": "ci_h",
   "title": "Contraindicated",
   "lines": [
    "a short list"
   ]
  },
  {
   "id": "soc_head_0_0",
   "x": 1073,
   "y": 278,
   "w": 238,
   "h": 80,
   "kind": "soc_h",
   "title": "Alcohol, tobacco, cannabis, coffee",
   "lines": [
    "not contraindicated, except as below"
   ]
  },
  {
   "id": "safe_clue_0_0",
   "x": 45,
   "y": 398,
   "w": 238,
   "h": 286,
   "kind": "safe_t",
   "title": "Untreated disease harms too",
   "lines": [
    "• asthma, epilepsy",
    "• depression, psychosis",
    "• infections"
   ]
  },
  {
   "id": "terat_clue_0_0",
   "x": 295,
   "y": 398,
   "w": 238,
   "h": 132,
   "kind": "bad",
   "title": "Biggest risk",
   "lines": [
    "• isotretinoin > 30%, thalidomide ~30%",
    "• valproate > 15% + cognitive problems",
    "• mycophenolate ~6%"
   ]
  },
  {
   "id": "terat_clue_1_0",
   "x": 295,
   "y": 552,
   "w": 238,
   "h": 132,
   "kind": "terat_w",
   "title": "Also",
   "lines": [
    "• carbamazepine: neural tube defect 1%",
    "• lithium: Ebstein's anomaly",
    "• warfarin, angiotensin-converting enzyme (ACE) inhibitors"
   ]
  },
  {
   "id": "rid_clue_0_0",
   "x": 573,
   "y": 398,
   "w": 238,
   "h": 286,
   "kind": "rid_t",
   "title": "Gets INTO milk if",
   "lines": [
    "• high maternal blood level, fat-soluble",
    "• not protein-bound",
    "• small: > 500 daltons stays out (insulin, heparin)"
   ]
  },
  {
   "id": "ci_clue_0_0",
   "x": 823,
   "y": 398,
   "w": 238,
   "h": 286,
   "kind": "bad",
   "title": "Avoid",
   "lines": [
    "• atenolol (renally cleared beta-blocker)",
    "• cancer drugs, radioactive iodine",
    "• cocaine, heroin"
   ]
  },
  {
   "id": "soc_clue_0_0",
   "x": 1073,
   "y": 398,
   "w": 238,
   "h": 286,
   "kind": "soc_t",
   "title": "Alcohol does NOT increase milk",
   "lines": [
    "keep it minimal"
   ]
  },
  {
   "id": "safe_inv_0_0",
   "x": 45,
   "y": 724,
   "w": 238,
   "h": 200,
   "kind": "safe_w",
   "title": "A malformation is > 99 in 100 times NOT a drug",
   "lines": [
    "put her risk in perspective: fear harms too"
   ]
  },
  {
   "id": "terat_inv_0_0",
   "x": 295,
   "y": 724,
   "w": 238,
   "h": 200,
   "kind": "terat_w",
   "title": "Uncertain or overstated",
   "lines": [
    "• selective serotonin reuptake inhibitors (SSRIs): ~1%, uncertain",
    "• statins: probably a myth"
   ]
  },
  {
   "id": "rid_inv_0_0",
   "x": 573,
   "y": 724,
   "w": 238,
   "h": 98,
   "kind": "rid_t",
   "title": "1 · Relative infant dose (RID) < 10% = safe",
   "lines": [
    "baby's dose from milk ÷ mother's dose per kg (fluoxetine 1.2%)"
   ]
  },
  {
   "id": "rid_inv_1_0",
   "x": 573,
   "y": 844,
   "w": 238,
   "h": 80,
   "kind": "rid_w",
   "title": "2 · Can the baby absorb and clear it?",
   "lines": [
    "slow clearance → it accumulates"
   ]
  },
  {
   "id": "ci_inv_0_0",
   "x": 823,
   "y": 724,
   "w": 238,
   "h": 80,
   "kind": "ci_t",
   "title": "Why atenolol: RID ~20%",
   "lines": [
    "newborn kidneys clear it slowly in week 1: slow heart, cyanosis"
   ]
  },
  {
   "id": "ci_inv_1_0",
   "x": 823,
   "y": 826,
   "w": 238,
   "h": 98,
   "kind": "ci_w",
   "title": "Problematic, not forbidden",
   "lines": [
    "• lithium, amiodarone, phenobarbital",
    "• ethosuximide, ergotamine, bromocriptine"
   ]
  },
  {
   "id": "soc_inv_0_0",
   "x": 1073,
   "y": 724,
   "w": 238,
   "h": 98,
   "kind": "soc_w",
   "title": "Alcohol limit",
   "lines": [
    "• ≤ 0.5 g/kg (< 2 beers or 1 glass of wine)",
    "• wait ≥ 2 h before feeding"
   ]
  },
  {
   "id": "soc_inv_1_0",
   "x": 1073,
   "y": 844,
   "w": 238,
   "h": 80,
   "kind": "soc_w",
   "title": "Tobacco",
   "lines": [
    "risk is infection and sudden infant death, not the milk: not near the baby"
   ]
  },
  {
   "id": "safe_tx_0_0",
   "x": 45,
   "y": 964,
   "w": 238,
   "h": 80,
   "kind": "ok",
   "title": "Treat: do NOT deny an effective drug",
   "lines": [
    "fewest drugs, as little as needed"
   ]
  },
  {
   "id": "safe_tx_1_0",
   "x": 45,
   "y": 1066,
   "w": 238,
   "h": 78,
   "kind": "warn",
   "title": "Careful with NEWER drugs",
   "lines": [
    "fetal harm often found years after release"
   ]
  },
  {
   "id": "terat_tx_0_0",
   "x": 295,
   "y": 964,
   "w": 238,
   "h": 70,
   "kind": "ok",
   "title": "1 · Planning: switch FIRST",
   "lines": [
    "e.g. mycophenolate → azathioprine"
   ]
  },
  {
   "id": "terat_tx_1_0",
