 "nodes": [
  {
   "id": "root",
   "x": 211,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "COLD despite therapy: is it ADVANCED heart failure (HF), and which option FITS?",
   "lines": [
    "I NEED HELP: Inotropes · New York Heart Association (NYHA) III–IV or high B-type natriuretic peptide (BNP)",
    "End-organ dysfunction · ejection fraction (EF) < 20% · Defibrillator shocks · ≥ 2 HF Hospitalizations in 12 months",
    "Edema or escalating diuretics · Low systolic BP < 90 · Prognostic drugs cut back",
    "→ refer to an advanced HF centre: being referred is NOT being listed"
   ]
  },
  {
   "id": "g_adv",
   "x": 45,
   "y": 174,
   "w": 512,
   "h": 78,
   "kind": "plain",
   "title": "WANTS advanced therapy: is it ADVANCED enough?",
   "lines": [
    "severe symptoms + cardiopulmonary exercise testing + invasive hemodynamics",
    "not advanced enough → keep up medical therapy (see the HEART FAILURE chart)"
   ]
  },
  {
   "id": "g_ino",
   "x": 597,
   "y": 174,
   "w": 250,
   "h": 78,
   "kind": "plain",
   "title": "Needs FLOW now",
   "lines": [
    "prognostic drugs no longer help"
   ]
  },
  {
   "id": "g_pal",
   "x": 887,
   "y": 174,
   "w": 250,
   "h": 78,
   "kind": "plain",
   "title": "Does NOT want advanced options",
   "lines": []
  },
  {
   "id": "t_ci",
   "x": 45,
   "y": 292,
   "w": 512,
   "h": 114,
   "kind": "plain",
   "title": "Any CONTRAINDICATION to transplant?",
   "lines": [
    "• major comorbidity: cancer in 5 years, lung, kidney or liver disease",
    "• psychosocial or immunologic issues",
    "• surgical (prior sternotomy)",
    "• age"
   ]
  },
  {
   "id": "tx_head_0_0",
   "x": 45,
   "y": 486,
   "w": 250,
   "h": 78,
   "kind": "tx_h",
   "title": "Heart transplant",
   "lines": [
    "orthotopic: donor heart in place of the recipient's"
   ]
  },
  {
   "id": "vad_head_0_0",
   "x": 307,
   "y": 486,
   "w": 250,
   "h": 78,
   "kind": "vad_h",
   "title": "Ventricular assist device (VAD)",
   "lines": [
    "a pump: ventricle → arterial circulation"
   ]
  },
  {
   "id": "ino_head_0_0",
   "x": 597,
   "y": 486,
   "w": 250,
   "h": 78,
   "kind": "ino_h",
   "title": "Inotropes",
   "lines": [
    "dobutamine, milrinone, dopamine"
   ]
  },
  {
   "id": "pal_head_0_0",
   "x": 887,
   "y": 486,
   "w": 250,
   "h": 78,
   "kind": "pal_h",
   "title": "Palliative care",
   "lines": [
    "NO therapy cures HF, not even transplant"
   ]
  },
  {
   "id": "tx_who_0_0",
   "x": 45,
   "y": 604,
   "w": 250,
   "h": 114,
   "kind": "tx_t",
   "title": "Wants it + advanced enough + NO contraindication",
   "lines": [
    "few patients qualify: donors are scarce"
   ]
  },
  {
   "id": "vad_who_0_0",
   "x": 307,
   "y": 604,
   "w": 250,
   "h": 114,
   "kind": "vad_t",
   "title": "DESTINATION therapy",
   "lines": [
    "• not a transplant candidate, but a VAD candidate",
    "• or a BRIDGE to transplant or a decision"
   ]
  },
  {
   "id": "ino_who_0_0",
   "x": 597,
   "y": 604,
   "w": 250,
   "h": 114,
   "kind": "ino_t",
   "title": "Cold patient",
   "lines": [
    "• BRIDGE to transplant or VAD",
    "• or for symptoms (palliation)"
   ]
  },
  {
   "id": "pal_who_0_0",
   "x": 887,
   "y": 604,
   "w": 250,
   "h": 114,
   "kind": "pal_t",
   "title": "Start EARLY",
   "lines": [
    "the HF course is unpredictable, so it is often too late"
   ]
  },
  {
   "id": "tx_tx_0_0",
   "x": 45,
   "y": 758,
   "w": 250,
   "h": 60,
   "kind": "ok",
   "title": "1 · Listed",
   "lines": [
    "bridge with a VAD or inotropes"
   ]
  },
