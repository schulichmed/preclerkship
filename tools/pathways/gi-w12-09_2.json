   "id": "cn_pres_0_0",
   "x": 833,
   "y": 514,
   "w": 232,
   "h": 134,
   "kind": "cn_t",
   "title": "A pancreatic CYST",
   "lines": [
    "may turn malignant"
   ]
  },
