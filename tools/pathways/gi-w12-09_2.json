   "kind": "ap_t",
   "title": "SUDDEN sharp epigastric pain to the BACK",
   "lines": [
    "• better LEANING FORWARD",
    "• after a big meal or a binge",
    "• nausea, vomiting"
   ]
  },
  {
   "id": "cp_pres_0_0",
   "x": 317,
   "y": 514,
   "w": 232,
   "h": 134,
   "kind": "cp_t",
   "title": "Persistent deep pain",
   "lines": [
    "• worse with FAT and ALCOHOL",
    "• STEATORRHEA, weight loss",
    "• diabetes when severe"
   ]
  },
  {
   "id": "pc_pres_0_0",
   "x": 589,
   "y": 514,
   "w": 232,
   "h": 134,
   "kind": "pc_t",
   "title": "Pain, vomiting, jaundice",
   "lines": [
    "recurrent pancreatitis"
   ]
  },
