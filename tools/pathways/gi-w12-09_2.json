   "id": "ca_tx_0_0",
   "x": 1077,
   "y": 1090,
   "w": 232,
   "h": 112,
   "kind": "ok",
   "title": "1 · EARLY, no spread → SURGERY + chemotherapy",
   "lines": [
    "• head: Whipple",
    "• tail: distal pancreatectomy"
   ]
  },
  {
   "id": "ca_tx_1_0",
   "x": 1077,
   "y": 1224,
   "w": 232,
   "h": 166,
   "kind": "warn",
   "title": "2 · Usually incurable → PALLIATE",
   "lines": [
    "• bile duct: ERCP stent or percutaneous drain",
    "• gastric outlet: duodenal stent or gastrojejunostomy",
    "• pain: celiac plexus block"
   ]
  }
