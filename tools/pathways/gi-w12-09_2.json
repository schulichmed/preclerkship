   "id": "ca_pres_0_0",
   "x": 1077,
   "y": 514,
   "w": 232,
   "h": 134,
   "kind": "ca_t",
   "title": "PAINLESS JAUNDICE + weight loss",
   "lines": [
    "• pain to the mid-back",
    "• migratory thrombophlebitis (Trousseau)",
    "• new diabetes"
   ]
  },
