   ]
  },
  {
   "id": "ap_tx_2_0",
   "x": 45,
   "y": 1304,
   "w": 232,
   "h": 85,
   "kind": "ok",
   "title": "3 · Gallstone: ERCP, then cholecystectomy",
   "lines": [
    "ERCP itself: 5% pancreatitis risk"
   ]
  },
  {
   "id": "cp_tx_0_0",
   "x": 317,
   "y": 1090,
   "w": 232,
   "h": 85,
   "kind": "ok",
