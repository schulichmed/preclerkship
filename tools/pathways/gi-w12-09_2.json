   "x": 589,
   "y": 1090,
   "w": 232,
   "h": 62,
   "kind": "ok",
   "title": "No symptoms → conservative",
   "lines": []
  },
  {
   "id": "pc_tx_1_0",
   "x": 589,
   "y": 1174,
   "w": 232,
   "h": 98,
   "kind": "warn",
   "title": "Symptoms or complications → DRAIN",
   "lines": [
    "endoscopic, percutaneous or surgical"
   ]
  },
  {
   "id": "pc_tx_2_0",
   "x": 589,
   "y": 1294,
   "w": 232,
   "h": 96,
   "kind": "bad",
   "title": "Complications",
   "lines": [
    "• infection",
    "• hemorrhage",
    "• rupture"
