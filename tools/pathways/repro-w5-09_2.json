   "title": "Risk",
   "lines": [
    "• previous ectopic",
    "• tubal surgery or sterilization",
    "• IUD",
    "• in vitro fertilization",
    "~• moderate: past STI or PID, smoking, DES, pelvic surgery",
    "~• low: infertility, > 40, first sex < 18, appendectomy"
   ]
  },
  {
