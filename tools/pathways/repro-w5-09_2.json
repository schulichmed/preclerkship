   "h": 342,
   "kind": "mol_t",
   "title": "Bleeding · complete: uterus LARGE for dates",
   "lines": [
    "• partial: SMALL for dates, few symptoms",
    "• complete: hyperemesis 25%",
    "• complete: early pre-eclampsia 25%",
    "• hyperthyroid (complete)"
   ]
  },
