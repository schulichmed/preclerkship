   "title": "1 · Ultrasound",
   "lines": [
    "fetal heart present: still viable"
   ]
  },
  {
   "id": "opn_inv_0_0",
   "x": 271,
   "y": 886,
   "w": 214,
   "h": 160,
   "kind": "opn_w",
   "title": "1 · Speculum",
   "lines": [
    "tissue at the os"
   ]
  },
  {
   "id": "opn_inv_1_0",
   "x": 271,
   "y": 1068,
   "w": 214,
   "h": 160,
   "kind": "opn_w",
   "title": "2 · Ultrasound",
   "lines": [
    "retained products? (incomplete)"
   ]
  },
  {
   "id": "mis_inv_0_0",
   "x": 497,
   "y": 886,
   "w": 214,
   "h": 188,
   "kind": "mis_t",
   "title": "1 · DIAGNOSTIC of non-viability",
   "lines": [
    "• crown-rump length > 7 mm, no heartbeat",
    "• mean sac diameter ≥ 25 mm, no embryo",
    "• no embryo + heart ≥ 2 wk after a sac WITHOUT yolk sac, or ≥ 11 days after one WITH"
   ]
  },
  {
   "id": "mis_inv_1_0",
   "x": 497,
   "y": 1096,
   "w": 214,
   "h": 132,
   "kind": "mis_w",
   "title": "Below those: SUSPICIOUS",
   "lines": [
    "• CRL < 7 mm, no heart · sac 16–24 mm, no embryo",
    "• no embryo ≥ 6 wk after LMP · yolk sac > 7 mm",
    "→ rescan before calling it"
   ]
  },
  {
   "id": "mol_inv_0_0",
   "x": 751,
   "y": 886,
   "w": 214,
   "h": 142,
   "kind": "mol_t",
   "title": "1 · β-hCG MARKEDLY ↑",
   "lines": [
    "partial: low to normal"
   ]
  },
  {
   "id": "mol_inv_1_0",
   "x": 751,
   "y": 1050,
   "w": 214,
   "h": 178,
   "kind": "mol_w",
   "title": "2 · Ultrasound",
   "lines": [
    "• complete: 'snow storm', no fetus",
    "• partial: cysts WITH a fetus"
   ]
  },
  {
   "id": "pul_inv_0_0",
   "x": 1005,
   "y": 886,
   "w": 214,
   "h": 133,
   "kind": "pul_t",
   "title": "1 · Repeat β-hCG in 48 h",
   "lines": [
    "ONE value never settles it"
   ]
  },
  {
   "id": "pul_inv_1_0",
   "x": 1005,
   "y": 1041,
   "w": 214,
   "h": 187,
   "kind": "pul_w",
   "title": "2 · Discriminatory zone",
   "lines": [
    "transvaginal: a sac SHOULD be seen above ~1500 (99% by 3150) · transabdominal ~5000–6500"
   ]
  },
  {
   "id": "ect_inv_0_0",
   "x": 1231,
   "y": 886,
   "w": 214,
   "h": 187,
   "kind": "ect_t",
   "title": "1 · β-hCG above the zone + EMPTY uterus",
   "lines": [
    "• adnexal mass",
    "• 'ring of fire'",
    "• free fluid"
   ]
  },
  {
   "id": "ect_inv_1_0",
   "x": 1231,
   "y": 1095,
   "w": 214,
   "h": 133,
   "kind": "bad",
   "title": "A normal β-hCG rise does NOT exclude it",
   "lines": []
  },
  {
   "id": "thr_tx_0_0",
   "x": 45,
   "y": 1268,
   "w": 214,
   "h": 452,
   "kind": "ok",
   "title": "Expectant",
   "lines": [
    "• treat bacterial vaginosis if found",
    "~• 43% still go on to miscarry",
    "~• later: preterm birth, IUGR, PPROM, abruption, previa"
   ]
  },
  {
   "id": "thr_tx_1_0",
   "x": 45,
   "y": 1742,
   "w": 214,
   "h": 380,
   "kind": "bad",
   "title": "NO progesterone",
   "lines": []
  },
  {
   "id": "opn_tx_0_0",
   "x": 271,
   "y": 1268,
   "w": 214,
   "h": 372,
   "kind": "ok",
   "title": "1 · Remove tissue at the os",
   "lines": [
    "then expectant (91% complete), medical or surgical"
   ]
  },
  {
   "id": "opn_tx_1_0",
   "x": 271,
   "y": 1662,
   "w": 214,
   "h": 460,
   "kind": "bad",
   "title": "FEVER: septic",
   "lines": [
    "• IV broad-spectrum antibiotics + dilation and curettage (D&C)",
    "• 1–2% of incomplete or threatened · sepsis, ARDS, AKI, DIC",
    "• Clostridium sordellii, perfringens, group A strep: toxic shock"
   ]
  },
  {
   "id": "mis_tx_0_0",
   "x": 497,
   "y": 1268,
   "w": 214,
   "h": 854,
   "kind": "ok",
   "title": "Expectant (76%), medical or surgical",
   "lines": [
    "her choice: see the panel"
   ]
  },
  {
   "id": "mol_tx_0_0",
   "x": 751,
   "y": 1268,
   "w": 214,
   "h": 389,
   "kind": "ok",
   "title": "1 · Suction curettage",
   "lines": [
    "then serial β-hCG to baseline",
    "complete: 80% cured, 15% invade or persist, 2–3% choriocarcinoma · partial: 5–10% persist"
   ]
  },
  {
   "id": "mol_tx_1_0",
   "x": 751,
   "y": 1679,
   "w": 214,
   "h": 443,
   "kind": "bad",
   "title": "β-hCG stays HIGH",
   "lines": [
    "• invasive mole or CHORIOCARCINOMA → chemotherapy",
    "• chorio: no villi, hemorrhagic · after mole 50%, miscarriage 25%, normal pregnancy 25%",
    "• LUNG mets in > 90% · 80% 5-yr survival"
   ]
  },
  {
   "id": "pul_tx_0_0",
   "x": 1005,
   "y": 1268,
   "w": 214,
   "h": 281,
   "kind": "ok",
   "title": "Rises ≥ 53% in 48 h",
   "lines": [
    "likely viable intrauterine pregnancy → rescan",
    "~85% of viable rise ≥ 66% · doubling 1.4–2.1 days"
   ]
  },
  {
   "id": "pul_tx_1_0",
   "x": 1005,
   "y": 1571,
   "w": 214,
   "h": 281,
   "kind": "warn",
   "title": "Falls",
   "lines": [
    "• failing pregnancy → follow to < 5",
    "~• a slow fall can still be an ectopic"
   ]
  },
  {
   "id": "pul_tx_2_0",
   "x": 1005,
   "y": 1874,
   "w": 214,
   "h": 247,
   "kind": "bad",
   "title": "Above the zone, uterus EMPTY",
   "lines": [
    "no tissue passed → ECTOPIC"
   ]
  },
  {
   "id": "ect_tx_0_0",
   "x": 1231,
   "y": 1268,
   "w": 214,
   "h": 152,
   "kind": "bad",
   "title": "1 · UNSTABLE or ruptured → SURGERY",
   "lines": [
    "salpingectomy or salpingostomy",
    "• also: same tube before, known tubal disease, cannot follow up",
    "~case: β-hCG 8962, heart in an adnexal mass, hemoperitoneum"
   ]
  },
  {
   "id": "ect_tx_1_0",
   "x": 1231,
   "y": 1442,
   "w": 214,
   "h": 260,
   "kind": "ok",
   "title": "2 · Stable, unruptured → METHOTREXATE",
   "lines": [
    "• 50 mg/m² IM once",
    "• β-hCG must fall 15% from day 4 → 7, else repeat",
    "• 15–20% need a 2nd dose · < 5000: 92% success",
    "• contraception 3–6 months after",
    "~• GI, stomatitis, transaminitis, alopecia, pneumonitis, marrow suppression",
    "~case: fell only 14% → ruptured 10 days later → salpingectomy"
   ]
  },
  {
   "id": "ect_tx_2_0",
   "x": 1231,
   "y": 1724,
   "w": 214,
   "h": 244,
   "kind": "bad",
   "title": "NO methotrexate if ANY of these → SURGERY instead",
   "lines": [
    "• β-hCG > 5000",
    "• fetal heart activity",
    "• an intrauterine pregnancy",
    "• breastfeeding",
    "• immunodeficiency, liver disease or alcohol, blood dyscrasia, lung disease, peptic ulcer, renal dysfunction",
    "~• relative: mass > 3.5 cm"
   ]
  },
  {
   "id": "ect_tx_3_0",
   "x": 1231,
   "y": 1990,
   "w": 214,
   "h": 132,
   "kind": "ok",
   "title": "3 · Expectant",
   "lines": [
    "• β-hCG falling AND < 200",
    "• mass < 3.5 cm",
    "• no symptoms",
    "~• resolves 50–70%, likelier if β-hCG < 1000"
   ]
  }
 ],
