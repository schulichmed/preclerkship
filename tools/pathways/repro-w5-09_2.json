   "title": "2 · Ultrasound",
   "lines": [
    "retained products? (incomplete)"
   ]
  },
  {
   "id": "mis_inv_0_0",
   "x": 497,
   "y": 724,
   "w": 214,
   "h": 134,
   "kind": "mis_t",
   "title": "1 · DIAGNOSTIC of non-viability",
   "lines": [
    "• crown-rump length > 7 mm, no heartbeat",
    "• mean sac diameter ≥ 25 mm, no embryo"
   ]
  },
  {
   "id": "mis_inv_1_0",
   "x": 497,
   "y": 880,
   "w": 214,
   "h": 60,
   "kind": "mis_w",
   "title": "Below those: SUSPICIOUS",
   "lines": [
    "→ rescan before calling it"
   ]
  },
  {
   "id": "mol_inv_0_0",
   "x": 751,
   "y": 724,
   "w": 214,
   "h": 79,
   "kind": "mol_t",
   "title": "1 · β-hCG MARKEDLY ↑",
   "lines": [
    "partial: low to normal"
   ]
  },
  {
   "id": "mol_inv_1_0",
   "x": 751,
   "y": 825,
   "w": 214,
   "h": 115,
   "kind": "mol_w",
   "title": "2 · Ultrasound",
   "lines": [
    "• complete: 'snow storm', no fetus",
    "• partial: cysts WITH a fetus"
   ]
  },
  {
   "id": "pul_inv_0_0",
   "x": 1005,
   "y": 724,
   "w": 214,
   "h": 79,
   "kind": "pul_t",
   "title": "1 · Repeat β-hCG in 48 h",
   "lines": [
    "ONE value never settles it"
   ]
  },
  {
   "id": "pul_inv_1_0",
   "x": 1005,
   "y": 825,
   "w": 214,
   "h": 115,
   "kind": "pul_w",
   "title": "2 · Discriminatory zone",
   "lines": [
    "above ~1500–3000 a sac SHOULD be seen on transvaginal ultrasound"
   ]
  },
  {
   "id": "ect_inv_0_0",
   "x": 1231,
   "y": 724,
   "w": 214,
   "h": 124,
   "kind": "ect_t",
   "title": "1 · β-hCG above the zone + EMPTY uterus",
   "lines": [
    "• adnexal mass",
    "• 'ring of fire'",
    "• free fluid"
   ]
  },
  {
   "id": "ect_inv_1_0",
   "x": 1231,
   "y": 870,
   "w": 214,
   "h": 70,
   "kind": "bad",
   "title": "A normal β-hCG rise does NOT exclude it",
   "lines": []
  },
  {
   "id": "thr_tx_0_0",
   "x": 45,
   "y": 980,
   "w": 214,
   "h": 263,
   "kind": "ok",
   "title": "Expectant",
   "lines": [
    "• treat bacterial vaginosis if found",
    "~• 43% still go on to miscarry"
   ]
  },
  {
   "id": "thr_tx_1_0",
   "x": 45,
   "y": 1265,
   "w": 214,
   "h": 227,
   "kind": "bad",
   "title": "NO progesterone",
   "lines": []
  },
  {
   "id": "opn_tx_0_0",
   "x": 271,
   "y": 980,
   "w": 214,
   "h": 255,
   "kind": "ok",
   "title": "1 · Remove tissue at the os",
   "lines": [
    "then expectant (91% complete), medical or surgical"
   ]
  },
  {
   "id": "opn_tx_1_0",
   "x": 271,
   "y": 1257,
   "w": 214,
   "h": 235,
   "kind": "bad",
   "title": "FEVER: septic",
   "lines": [
    "IV broad-spectrum antibiotics + dilation and curettage (D&C)"
   ]
  },
  {
   "id": "mis_tx_0_0",
   "x": 497,
   "y": 980,
   "w": 214,
   "h": 512,
   "kind": "ok",
   "title": "Expectant (76%), medical or surgical",
   "lines": [
    "her choice: see the panel"
   ]
  },
  {
   "id": "mol_tx_0_0",
   "x": 751,
   "y": 980,
   "w": 214,
   "h": 227,
   "kind": "ok",
   "title": "1 · Suction curettage",
   "lines": [
    "then serial β-hCG to baseline"
   ]
  },
  {
   "id": "mol_tx_1_0",
   "x": 751,
   "y": 1229,
   "w": 214,
   "h": 263,
   "kind": "bad",
   "title": "β-hCG stays HIGH",
   "lines": [
    "invasive mole or CHORIOCARCINOMA (lungs first) → chemotherapy"
   ]
  },
  {
   "id": "pul_tx_0_0",
   "x": 1005,
   "y": 980,
   "w": 214,
   "h": 143,
   "kind": "ok",
   "title": "Rises ≥ 53% in 48 h",
   "lines": [
    "likely viable intrauterine pregnancy → rescan"
   ]
  },
  {
   "id": "pul_tx_1_0",
   "x": 1005,
   "y": 1145,
   "w": 214,
   "h": 179,
   "kind": "warn",
   "title": "Falls",
   "lines": [
    "• failing pregnancy → follow to < 5",
    "~• a slow fall can still be an ectopic"
   ]
  },
  {
   "id": "pul_tx_2_0",
   "x": 1005,
   "y": 1346,
   "w": 214,
   "h": 145,
   "kind": "bad",
   "title": "Above the zone, uterus EMPTY",
   "lines": [
    "no tissue passed → ECTOPIC"
   ]
  },
  {
   "id": "ect_tx_0_0",
   "x": 1231,
   "y": 980,
   "w": 214,
   "h": 80,
   "kind": "bad",
   "title": "1 · UNSTABLE or ruptured → SURGERY",
   "lines": [
    "salpingectomy or salpingostomy"
   ]
  },
  {
   "id": "ect_tx_1_0",
   "x": 1231,
   "y": 1082,
   "w": 214,
   "h": 116,
   "kind": "ok",
   "title": "2 · Stable, unruptured → METHOTREXATE",
   "lines": [
    "• 50 mg/m² IM once",
    "• β-hCG must fall 15% from day 4 → 7, else repeat"
   ]
  },
  {
   "id": "ect_tx_2_0",
   "x": 1231,
   "y": 1220,
   "w": 214,
   "h": 154,
   "kind": "bad",
   "title": "NO methotrexate if ANY of these → SURGERY instead",
   "lines": [
    "• β-hCG > 5000",
    "• fetal heart activity",
    "• an intrauterine pregnancy",
    "• breastfeeding"
   ]
  },
  {
   "id": "ect_tx_3_0",
   "x": 1231,
   "y": 1396,
   "w": 214,
   "h": 96,
   "kind": "ok",
   "title": "3 · Expectant",
   "lines": [
    "• β-hCG falling AND < 200",
    "• mass < 3.5 cm",
    "• no symptoms"
   ]
  }
