 "nodes": [
  {
   "id": "root",
   "x": 365,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Bleeding in early pregnancy: is it IN the uterus, and is it VIABLE?",
   "lines": [
    "every one: vitals · complete blood count · group and screen · quantitative beta-hCG (β-hCG) · transvaginal ultrasound",
    "Rh NEGATIVE + bleeding → Rh immunoglobulin · send any tissue passed to pathology",
    "miscarriage = loss < 20 wk · 8–20% of pregnancies · 80% before 12 wk · location confirmed by gestational sac + YOLK SAC"
   ]
  },
  {
   "id": "g_sa",
   "x": 45,
   "y": 156,
   "w": 666,
   "h": 78,
   "kind": "plain",
   "title": "Pregnancy IN the uterus: MISCARRIAGE",
   "lines": [
    "the CERVIX (open or closed) and the FETAL HEART decide the type"
   ]
  },
  {
   "id": "g_gtd",
   "x": 751,
   "y": 156,
   "w": 214,
   "h": 78,
   "kind": "plain",
   "title": "'Snow storm' or cysts",
   "lines": [
    "abnormal trophoblast"
   ]
  },
  {
   "id": "g_out",
   "x": 1005,
   "y": 156,
   "w": 440,
   "h": 78,
   "kind": "plain",
   "title": "NOTHING in the uterus: β-hCG decides",
   "lines": [
    "pain + bleeding + positive β-hCG = ECTOPIC until proven otherwise (an IUD too)"
   ]
  },
  {
