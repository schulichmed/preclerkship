   "kind": "pul_t",
   "title": "Bleeding ± pain",
   "lines": [
    "could still be viable, failing or ectopic"
   ]
  },
  {
   "id": "ect_pres_0_0",
   "x": 1231,
   "y": 504,
   "w": 214,
   "h": 134,
   "kind": "ect_t",
   "title": "Pain + amenorrhea + bleeding",
   "lines": [
    "unstable: shoulder-tip pain, lightheaded, orthostatic",
    "• adnexal mass, cervical motion tenderness, bulging fornix"
   ]
  },
  {
   "id": "ect_pres_1_0",
   "x": 1231,
   "y": 660,
   "w": 214,
