 "nodes": [
  {
   "id": "root",
   "x": 259,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Thyroid nodule: which one earns a NEEDLE, and which result earns SURGERY?",
   "lines": [
    "most are benign · not always thyroid: parathyroid, lymph node, skin, soft tissue",
    "cancer risk: child · male · first-degree family history · neck radiation · firm or fixed · suspicious nodes",
    "URGENT: rapid growth · stridor · progressive dysphagia · large, fixed, firm mass"
   ]
  },
  {
   "id": "g_all",
   "x": 45,
   "y": 156,
   "w": 1188,
   "h": 60,
   "kind": "plain",
   "title": "1 · Thyroid-stimulating hormone (TSH) FIRST: is it LOW?",
   "lines": [
    "LOW → radioactive iodine (RAI) scan: HOT = benign (see the THYROID FUNCTION chart) · COLD → ultrasound like the rest"
   ]
  },
  {
   "id": "p_work",
   "x": 45,
   "y": 256,
   "w": 1188,
   "h": 96,
   "kind": "info",
   "title": "Normal or high TSH: work up in order",
   "lines": [
    "2 · Ultrasound + TI-RADS (Thyroid Imaging Reporting and Data System): fine needle aspiration (FNA) if TR5 ≥ 1 cm · TR4 ≥ 1.5 cm · TR3 ≥ 2.5 cm",
    "• smaller: repeat ultrasound for up to 5 years, stop if stable · TR1–2: nothing",
    "3 · FNA: the Bethesda category picks the column ↓ · never a core or open biopsy for a nodule (seeding, bleeding)"
   ]
  },
  {
   "id": "t_ben",
   "x": 45,
   "y": 392,
   "w": 228,
   "h": 60,
   "kind": "plain",
   "title": "BENIGN (II)",
   "lines": [
    "malignancy risk 2–7%"
   ]
  },
  {
   "id": "t_ind",
   "x": 285,
   "y": 392,
   "w": 228,
   "h": 60,
   "kind": "plain",
   "title": "INDETERMINATE (I, III, IV)",
   "lines": [
    "malignancy risk 5–34%"
   ]
  },
  {
   "id": "t_mal",
   "x": 525,
   "y": 392,
   "w": 708,
   "h": 60,
   "kind": "plain",
   "title": "SUSPICIOUS or MALIGNANT (V, VI): SURGERY",
   "lines": [
    "established or suspected cancer > 1 cm: hemithyroidectomy if low risk, total if high · node dissection if nodes"
   ]
  },
  {
   "id": "ben_head_0_0",
   "x": 45,
   "y": 532,
   "w": 228,
   "h": 116,
   "kind": "ben_h",
   "title": "Benign nodule",
   "lines": [
    "multinodular goitre, cyst, Hashimoto: no atypia"
   ]
  },
  {
   "id": "fol_head_0_0",
   "x": 285,
   "y": 532,
   "w": 228,
   "h": 116,
   "kind": "fol_h",
   "title": "Follicular neoplasm",
   "lines": [
    "adenoma or follicular carcinoma: microfollicles, scant colloid"
   ]
  },
  {
   "id": "pap_head_0_0",
   "x": 525,
   "y": 532,
   "w": 228,
   "h": 116,
   "kind": "pap_h",
   "title": "Papillary carcinoma",
   "lines": [
    "85–90% · nuclear grooves, clearing, inclusions: DIAGNOSTIC on FNA"
   ]
  },
  {
   "id": "med_head_0_0",
   "x": 765,
   "y": 532,
   "w": 228,
   "h": 116,
   "kind": "med_h",
   "title": "Medullary carcinoma",
   "lines": [
    "C cells · nests, not papillae · amyloid = calcitonin"
   ]
  },
  {
   "id": "ana_head_0_0",
   "x": 1005,
   "y": 532,
   "w": 228,
   "h": 116,
   "kind": "ana_h",
   "title": "Anaplastic carcinoma or lymphoma",
   "lines": [
    "sheets of cells, no follicles: a differentiated cancer that progressed"
   ]
  },
  {
   "id": "ben_clue_0_0",
   "x": 45,
   "y": 688,
   "w": 228,
   "h": 134,
   "kind": "ben_t",
   "title": "Colloid + sheets of follicular cells",
   "lines": [
    "• goitre: many nodules, usually euthyroid",
    "• cyst: clear fluid, gone after aspiration"
   ]
  },
  {
   "id": "fol_clue_0_0",
   "x": 285,
   "y": 688,
   "w": 228,
   "h": 134,
   "kind": "fol_t",
   "title": "FNA CAN'T tell them apart",
   "lines": [
    "same nuclei: only INVASION of capsule or vessels decides, on the resected nodule"
   ]
  },
  {
   "id": "pap_clue_0_0",
   "x": 525,
   "y": 688,
   "w": 228,
   "h": 134,
   "kind": "pap_t",
   "title": "Mostly women 40–60, often multifocal",
   "lines": [
    "a neck node may be the first sign: spreads by LYMPH"
   ]
  },
  {
   "id": "med_clue_0_0",
   "x": 765,
   "y": 688,
   "w": 228,
   "h": 134,
   "kind": "med_t",
   "title": "25% hereditary: RET point mutation",
   "lines": [
    "multiple endocrine neoplasia (MEN) 2A, 2B"
   ]
  },
  {
   "id": "ana_clue_0_0",
   "x": 1005,
   "y": 688,
   "w": 228,
   "h": 134,
   "kind": "bad",
   "title": "URGENT: rapidly growing, older",
   "lines": [
    "• short of breath: airway narrowing",
    "• can't swallow · pain · lung, bone metastases"
   ]
  },
  {
   "id": "ben_inv_0_0",
   "x": 45,
   "y": 862,
   "w": 228,
   "h": 202,
   "kind": "ben_w",
   "title": "Read it against the ultrasound",
   "lines": [
    "• TR3: clinical follow-up",
    "• TR4: ultrasound surveillance ± repeat FNA",
    "• TR5: REPEAT the FNA"
   ]
  },
  {
   "id": "fol_inv_0_0",
   "x": 285,
   "y": 862,
   "w": 228,
   "h": 82,
   "kind": "fol_w",
   "title": "Non-diagnostic (I) or atypia (III)",
   "lines": [
    "→ REPEAT the FNA"
   ]
  },
  {
   "id": "fol_inv_1_0",
   "x": 285,
   "y": 966,
   "w": 228,
   "h": 98,
   "kind": "fol_w",
   "title": "Weigh the rest",
   "lines": [
    "• risk factors, ultrasound, size, life expectancy",
    "• molecular testing: costly, scarce"
   ]
  },
  {
   "id": "pap_inv_0_0",
   "x": 525,
   "y": 862,
   "w": 228,
   "h": 202,
   "kind": "pap_w",
   "title": "Small, low risk: may WATCH",
   "lines": [
    "• < 2 cm, no extension, no nodes",
    "• ultrasound every 6–12 months",
    "• grows > 3 mm → surgery"
   ]
  },
  {
   "id": "med_inv_0_0",
   "x": 765,
   "y": 862,
   "w": 228,
   "h": 202,
   "kind": "bad",
   "title": "BEFORE surgery: look for MEN 2",
   "lines": [
    "• pheochromocytoma ~50%",
    "• hyperparathyroidism 10–25% (2A)",
    "• RET positive: test the family"
   ]
  },
  {
   "id": "ana_inv_0_0",
   "x": 1005,
   "y": 862,
   "w": 228,
   "h": 82,
   "kind": "ana_t",
   "title": "1 · Neck ultrasound + computed tomography (CT) for metastases",
   "lines": []
  },
  {
   "id": "ana_inv_1_0",
   "x": 1005,
   "y": 966,
   "w": 228,
   "h": 98,
   "kind": "ana_t",
   "title": "2 · CORE biopsy + flow cytometry",
   "lines": [
    "marker panel needs tissue · ask for a rush"
   ]
  },
  {
   "id": "ben_tx_0_0",
   "x": 45,
   "y": 1104,
   "w": 228,
   "h": 134,
   "kind": "ok",
   "title": "Surgery only if",
   "lines": [
    "• symptomatic: compressive or disfiguring",
    "• worrisome or growing on ultrasound"
   ]
  },
  {
   "id": "fol_tx_0_0",
   "x": 285,
   "y": 1104,
   "w": 228,
   "h": 134,
   "kind": "ok",
   "title": "Hemithyroidectomy",
   "lines": [
    "• adenoma: cured, no recurrence",
    "• carcinoma: spreads by BLOOD"
   ]
  },
  {
   "id": "pap_tx_0_0",
   "x": 525,
   "y": 1104,
   "w": 228,
   "h": 134,
   "kind": "ok",
   "title": "Surgery, then RAI by recurrence risk",
   "lines": [
    "• low: not routine (< 1 cm: no)",
    "• intermediate: generally favoured",
    "• high (gross extension, incomplete, metastases): yes"
   ]
  },
  {
   "id": "med_tx_0_0",
   "x": 765,
   "y": 1104,
   "w": 228,
   "h": 134,
   "kind": "ok",
   "title": "Surgery",
   "lines": [
    "• follow serum CALCITONIN for recurrence",
    "~metastasizes often, poorer prognosis"
   ]
  },
  {
   "id": "ana_tx_0_0",
   "x": 1005,
   "y": 1104,
   "w": 228,
   "h": 134,
   "kind": "bad",
   "title": "Rarely resectable, no iodine uptake",
   "lines": [
    "• external beam radiotherapy",
    "• BRAF mutation → targeted therapy"
   ]
  }
 ],
