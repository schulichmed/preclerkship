  },
  {
   "id": "rad_cause_0_0",
   "x": 923,
   "y": 956,
   "w": 158,
   "h": 206,
   "kind": "rad_w",
   "title": "Disc herniation",
   "lines": [
    "• cervical: hits the LOWER root (C5-6 → C6)",
    "• lumbar: hits the TRAVERSING root (L5-S1 → S1)",
    "→ discectomy"
   ]
  },
