  {
   "id": "ant_tract_0_0",
   "x": 45,
   "y": 432,
   "w": 158,
   "h": 240,
   "kind": "ant_t",
   "title": "Anterior 2/3 LOST",
   "lines": [
    "• **corticospinal** → paralysis",
    "• **spinothalamic** → pain, temp",
    "• descending autonomic → BP, bladder, bowel",
    "• dorsal columns SPARED → vibration, position"
   ]
  },
  {
   "id": "post_tract_0_0",
   "x": 215,
   "y": 432,
   "w": 158,
   "h": 240,
   "kind": "post_t",
   "title": "Dorsal columns LOST",
   "lines": [
    "• **gracilis + cuneatus** → vibration, position, 2-point",
    "• corticospinal, spinothalamic SPARED",
    "~ B12 also hits lateral corticospinal: subacute COMBINED"
   ]
  },
  {
   "id": "cent_tract_0_0",
   "x": 385,
   "y": 432,
   "w": 158,
   "h": 240,
   "kind": "cent_t",
   "title": "Centre outward",
   "lines": [
    "• **crossing spinothalamic** fibres (anterior commissure) → cape pain, temp",
    "• **medial corticospinal** (arm fibres) → hands > legs",
    "• dorsal columns SPARED"
   ]
  },
  {
   "id": "bs_tract_0_0",
   "x": 555,
   "y": 432,
   "w": 158,
   "h": 240,
   "kind": "bs_t",
   "title": "Half the cord",
   "lines": [
    "• **corticospinal** → SAME side paralysis (crossed at pyramids)",
    "• **dorsal columns** → SAME side vibration, position (cross in medulla)",
    "• **spinothalamic** → OPPOSITE side pain, temp (crossed at entry)"
   ]
  },
  {
   "id": "ce_tract_0_0",
   "x": 753,
   "y": 432,
   "w": 158,
   "h": 240,
   "kind": "ce_t",
   "title": "No tracts: roots",
   "lines": [
    "• lumbosacral roots → LMN legs",
    "• **S2-S4** → saddle, bladder, bowel"
   ]
  },
  {
   "id": "rad_tract_0_0",
   "x": 923,
   "y": 432,
   "w": 158,
   "h": 240,
   "kind": "rad_t",
   "title": "No tracts: one root",
   "lines": [
    "• dorsal root → its dermatome",
    "• ventral root → its myotome, reflex"
   ]
  },
  {
   "id": "ant_pres_0_0",
   "x": 45,
   "y": 712,
   "w": 158,
   "h": 448,
   "kind": "ant_t",
   "title": "Motor + pain LOST",
   "lines": [
    "• paralysis below the level",
    "• pain, temperature lost AT + below",
    "• vibration, position, 2-point SPARED",
    "• orthostatic hypotension",
    "• bladder, bowel, sexual"
   ]
  },
  {
   "id": "post_pres_0_0",
   "x": 215,
   "y": 712,
   "w": 158,
   "h": 448,
   "kind": "post_t",
   "title": "Vibration + position LOST",
   "lines": [
    "• motor NORMAL",
    "• weak only if compression is severe"
   ]
  },
  {
   "id": "cent_pres_0_0",
   "x": 385,
   "y": 712,
   "w": 158,
   "h": 448,
   "kind": "cent_t",
   "title": "HANDS worst",
   "lines": [
    "• strength returns up the arm",
    "• 'cape-like' (suspended) pain, temperature loss",
    "• dissociated sensory loss",
    "• light touch, dorsal columns spared"
   ]
  },
  {
   "id": "bs_pres_0_0",
   "x": 555,
   "y": 712,
   "w": 158,
   "h": 448,
   "kind": "bs_t",
   "title": "Split by side",
   "lines": [
    "• SAME side below: paralysis, vibration, position lost",
    "• OPPOSITE side below: pain, temperature lost",
    "• opposite strength kept"
   ]
  },
  {
   "id": "ce_pres_0_0",
   "x": 753,
   "y": 712,
   "w": 158,
   "h": 448,
   "kind": "ce_t",
   "title": "Both legs",
   "lines": [
    "• bilateral leg pain, paresthesia",
    "• LMN paraparesis",
    "• saddle anesthesia",
    "• bowel, bladder control lost"
   ]
  },
  {
   "id": "rad_pres_0_0",
   "x": 923,
   "y": 712,
   "w": 158,
   "h": 150,
   "kind": "rad_t",
   "title": "One root",
   "lines": [
    "• radicular pain",
    "• numbness in its DERMATOME",
    "• LMN weakness in its MYOTOME",
    "• its reflex ↓"
   ]
  },
  {
   "id": "rad_pres_1_0",
   "x": 923,
   "y": 884,
   "w": 158,
   "h": 276,
   "kind": "rad_w",
   "title": "Cases",
   "lines": [
    "• right C6: wakes with neck pain, can't lift toolbox, thumb 'wooden' · biceps, brachioradialis 4/5 + reflexes ↓ · outer arm, radial forearm numb",
    "• right S1: back pain down the back of the leg to the sole · weak plantar flexion, ankle reflex ↓ · sole numb · straight leg raise +"
   ]
  },
  {
   "id": "ant_cause_0_0",
   "x": 45,
   "y": 1200,
   "w": 158,
   "h": 206,
   "kind": "ant_w",
   "title": "Anterior spinal artery occluded",
   "lines": [
    "• atherosclerosis",
    "• aortic aneurysm, dissection, thrombosis, surgery",
    "• compression: disc, tumour, osteophyte, kyphoscoliosis",
    "• stab wound"
   ]
  },
  {
   "id": "post_cause_0_0",
   "x": 215,
   "y": 1200,
   "w": 158,
   "h": 206,
   "kind": "post_w",
   "title": "Causes",
   "lines": [
    "• vitamin B12 deficiency",
    "• syphilis (tabes dorsalis)",
    "• posterior extrinsic mass",
    "• spinal cord tumour surgery"
   ]
  },
  {
   "id": "cent_cause_0_0",
   "x": 385,
   "y": 1200,
   "w": 158,
   "h": 206,
   "kind": "cent_w",
   "title": "Causes",
   "lines": [
    "• hyperextension trauma",
    "• syrinx",
    "• intrinsic tumour",
    "• multiple sclerosis"
   ]
  },
  {
   "id": "bs_cause_0_0",
   "x": 555,
   "y": 1200,
   "w": 158,
   "h": 206,
   "kind": "bs_w",
   "title": "Causes",
   "lines": [
    "• trauma",
    "• a process inside the cord"
   ]
  },
  {
   "id": "ce_cause_0_0",
   "x": 753,
   "y": 1200,
   "w": 158,
   "h": 206,
   "kind": "ce_w",
   "title": "Not the cord itself",
   "lines": [
    "the roots below the conus (cord ends ~L1/L2)"
   ]
  },
  {
   "id": "rad_cause_0_0",
   "x": 923,
   "y": 1200,
   "w": 158,
   "h": 206,
   "kind": "rad_w",
   "title": "Disc herniation",
   "lines": [
    "• cervical: hits the LOWER root (C5-6 → C6)",
    "• lumbar: hits the TRAVERSING root (L5-S1 → S1)",
    "→ discectomy"
   ]
  }
