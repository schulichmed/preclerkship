   "kind": "ant_t",
   "title": "Motor + pain LOST",
   "lines": [
    "• paralysis below the level",
    "• pain, temperature lost AT + below",
    "• vibration, position, 2-point SPARED",
    "• orthostatic hypotension",
    "• bladder, bowel, sexual"
   ]
  },
  {
   "id": "post_pres_0_0",
   "x": 215,
   "y": 468,
   "w": 158,
   "h": 448,
   "kind": "post_t",
   "title": "Vibration + position LOST",
   "lines": [
    "• motor NORMAL",
    "• weak only if compression is severe"
   ]
  },
  {
   "id": "cent_pres_0_0",
   "x": 385,
   "y": 468,
   "w": 158,
   "h": 448,
   "kind": "cent_t",
   "title": "HANDS worst",
   "lines": [
    "• strength returns up the arm",
    "• 'cape-like' (suspended) pain, temperature loss",
    "• dissociated sensory loss",
    "• light touch, dorsal columns spared"
   ]
  },
  {
   "id": "bs_pres_0_0",
   "x": 555,
   "y": 468,
   "w": 158,
   "h": 448,
   "kind": "bs_t",
   "title": "Split by side",
   "lines": [
    "• SAME side below: paralysis, vibration, position lost",
    "• OPPOSITE side below: pain, temperature lost",
    "• opposite strength kept"
   ]
  },
  {
   "id": "ce_pres_0_0",
   "x": 753,
   "y": 468,
   "w": 158,
   "h": 448,
   "kind": "ce_t",
   "title": "Both legs",
   "lines": [
    "• bilateral leg pain, paresthesia",
    "• LMN paraparesis",
    "• saddle anesthesia",
    "• bowel, bladder control lost"
   ]
  },
  {
   "id": "rad_pres_0_0",
   "x": 923,
   "y": 468,
   "w": 158,
   "h": 150,
   "kind": "rad_t",
   "title": "One root",
   "lines": [
    "• radicular pain",
    "• numbness in its DERMATOME",
    "• LMN weakness in its MYOTOME",
    "• its reflex ↓"
   ]
  },
  {
   "id": "rad_pres_1_0",
   "x": 923,
   "y": 640,
   "w": 158,
   "h": 276,
   "kind": "rad_w",
   "title": "Cases",
   "lines": [
    "• right C6: wakes with neck pain, can't lift toolbox, thumb 'wooden' · biceps, brachioradialis 4/5 + reflexes ↓ · outer arm, radial forearm numb",
    "• right S1: back pain down the back of the leg to the sole · weak plantar flexion, ankle reflex ↓ · sole numb · straight leg raise +"
   ]
  },
  {
