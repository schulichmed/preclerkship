   "id": "as_head_0_0",
   "x": 45,
   "y": 354,
   "w": 300,
   "h": 132,
   "kind": "as_h",
   "title": "Ankylosing spondylitis",
   "lines": [
    "the prototype · HLA-B27 in > 90% (white patients)",
    "but 8% of white people carry HLA-B27",
    "HLA-B27+ = 50-100× the risk · prevalence 0.1-1.4%"
   ]
  },
  {
   "id": "psa_head_0_0",
   "x": 385,
   "y": 354,
   "w": 300,
   "h": 132,
   "kind": "psa_h",
   "title": "Psoriatic arthritis",
   "lines": [
    "5-7% of people with psoriasis · axial 2%",
    "HLA-B27, B38, B39, DR4",
    "first-degree relatives 50× the risk"
   ]
  },
  {
   "id": "rea_head_0_0",
   "x": 725,
   "y": 354,
   "w": 300,
   "h": 132,
   "kind": "rea_h",
   "title": "Reactive arthritis",
   "lines": [
    "young men, 20-40 · HLA-B27 linked",
    "NOT 'Reiter's syndrome'"
   ]
  },
  {
   "id": "as_pres_0_0",
   "x": 45,
   "y": 526,
   "w": 300,
   "h": 114,
   "kind": "as_t",
   "title": "Starts at the sacroiliac joints, climbs",
   "lines": [
    "• onset < 40, insidious, > 3 months",
    "• stiffness > 60 min, night pain",
    "• BETTER with activity",
    "• can start as a lower-limb oligoarthritis"
   ]
  },
  {
   "id": "as_pres_1_0",
   "x": 45,
   "y": 662,
   "w": 300,
   "h": 96,
   "kind": "as_w",
   "title": "Enthesitis",
   "lines": [
    "• heels: Achilles, plantar fascia",
    "• iliac crests, trochanters, patellae, pubic symphysis, manubriosternal joint, clavicles"
   ]
  },
  {
   "id": "as_pres_2_0",
   "x": 45,
   "y": 780,
   "w": 300,
   "h": 186,
   "kind": "as_w",
   "title": "Beyond the spine: A-N-K-S-P-O-N-D",
   "lines": [
    "• Aortitis, aortic regurgitation, conduction block, pericarditis",
    "• Neuro: atlantoaxial subluxation, cauda equina",
    "• Kidney: amyloid, prostatitis · Nephropathy: IgA",
    "• Spine: neck fracture, stenosis, osteoporosis",
    "• Pulmonary: upper-lobe fibrosis · Ocular: anterior uveitis 25-30%",
    "• Discitis · microscopic colitis 30-60%"
   ]
  },
  {
   "id": "psa_pres_0_0",
   "x": 385,
   "y": 526,
   "w": 300,
   "h": 200,
   "kind": "psa_t",
   "title": "Psoriasis comes first in ⅔",
   "lines": [
    "• arthritis first or together in ⅓",
    "• hidden: scalp, navel, behind ears, perianal, nails"
   ]
  },
  {
   "id": "psa_pres_1_0",
   "x": 385,
   "y": 748,
   "w": 300,
   "h": 218,
   "kind": "psa_w",
   "title": "Patterns",
   "lines": [
    "• asymmetric oligoarthritis (> 50%)",
    "• axial 20-40% · rheumatoid-like 15-25%",
    "• mostly distal finger joints 5-10% · arthritis mutilans 5%"
   ]
  },
  {
   "id": "rea_pres_0_0",
   "x": 725,
   "y": 526,
   "w": 300,
   "h": 209,
   "kind": "rea_t",
   "title": "Trigger 1-3 weeks earlier",
   "lines": [
    "• gut: Salmonella, Shigella, Campylobacter",
    "• genitourinary: Chlamydia trachomatis, other sexual infections"
   ]
  },
  {
   "id": "rea_pres_1_0",
   "x": 725,
   "y": 757,
   "w": 300,
   "h": 209,
   "kind": "rea_w",
   "title": "Can't see, can't pee, can't climb a tree",
   "lines": [
    "• conjunctivitis or uveitis",
    "• urethritis or cervicitis",
    "• large-joint oligoarthritis, sacroiliitis, enthesitis"
   ]
  },
  {
   "id": "as_inv_0_0",
   "x": 45,
   "y": 1006,
   "w": 300,
   "h": 78,
   "kind": "as_t",
   "title": "1 · Spinal mobility",
   "lines": [
    "• modified Schober · chest expansion",
    "• occiput-to-wall, tragus-to-wall"
   ]
  },
  {
   "id": "as_inv_1_0",
   "x": 45,
   "y": 1106,
   "w": 300,
   "h": 116,
   "kind": "as_t",
   "title": "2 · Sacroiliac X-ray + ESR, CRP, HLA-B27",
   "lines": [
    "bilateral, symmetric: iliac-side erosion → sclerosis → fusion",
    "late: 'bamboo spine'"
   ]
  },
  {
   "id": "as_inv_2_0",
   "x": 45,
   "y": 1244,
   "w": 300,
   "h": 78,
   "kind": "as_w",
   "title": "X-ray normal → MRI",
   "lines": [
    "bone marrow edema (dark T1, bright STIR) = non-radiographic axial SpA"
   ]
  },
  {
   "id": "psa_inv_0_0",
   "x": 385,
   "y": 1006,
   "w": 300,
   "h": 103,
   "kind": "psa_t",
   "title": "Nails in 80% (30% in psoriasis alone)",
   "lines": [
    "• pitting, ridging, onycholysis, hyperkeratosis",
    "• oil spots, splinter hemorrhages, red lunula"
   ]
  },
  {
   "id": "psa_inv_1_0",
   "x": 385,
   "y": 1131,
   "w": 300,
   "h": 85,
   "kind": "psa_t",
   "title": "Dactylitis · enthesitis",
   "lines": [
    "• conjunctivitis 20% · uveitis 7% (more if axial)"
   ]
  },
  {
   "id": "psa_inv_2_0",
   "x": 385,
   "y": 1238,
   "w": 300,
   "h": 85,
   "kind": "psa_w",
   "title": "Axial: ASYMMETRIC sacroiliitis",
   "lines": [
    "big non-marginal 'jug-handle' syndesmophytes"
   ]
  },
  {
   "id": "rea_inv_0_0",
   "x": 725,
   "y": 1006,
   "w": 300,
   "h": 156,
   "kind": "rea_t",
   "title": "Psoriasis-like skin",
   "lines": [
    "• keratoderma blennorrhagicum",
    "• circinate balanitis"
   ]
  },
