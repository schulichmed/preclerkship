   "id": "joint_inv_0_0",
   "x": 949,
   "y": 788,
   "w": 214,
   "h": 96,
   "kind": "bad",
   "title": "INTRA-articular",
   "lines": [
    "• reduction must be ANATOMIC",
    "• secondary osteoarthritis · heals slower"
   ]
  },
