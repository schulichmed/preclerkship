   "id": "joint_inv_1_0",
   "x": 949,
   "y": 906,
   "w": 214,
   "h": 96,
   "kind": "ok",
   "title": "EXTRA-articular",
   "lines": [
    "reduction relatively anatomic: bone remodels, especially with weight-bearing"
   ]
  },
  {
   "id": "other_inv_0_0",
   "x": 1175,
   "y": 788,
   "w": 214,
   "h": 214,
   "kind": "bad",
   "title": "PATHOLOGICAL fracture",
   "lines": [
    "• weakened bone, usually TRANSVERSE",
    "• spontaneous or trivial trauma"
   ]
  },
  {
   "id": "heal_inv_0_0",
   "x": 1429,
   "y": 788,
   "w": 214,
   "h": 78,
   "kind": "ok",
   "title": "Healed is a CLINICAL call",
   "lines": [
    "no tenderness, no motion at the site, can bear weight"
   ]
  },
  {
   "id": "heal_inv_1_0",
   "x": 1429,
   "y": 888,
   "w": 214,
   "h": 114,
   "kind": "heal_w",
   "title": "Expected time",
   "lines": [
