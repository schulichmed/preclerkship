 "panels": [
  {
   "x": 45,
   "y": 1928,
   "w": 317,
   "title": "Inflammatory vs mechanical",
   "items": [
    "inflammatory: under 40 · insidious · > 3 months · stiffness > 60 min · night pain · BETTER with activity · sacroiliac tender · lost mobility in all planes · chest expansion ↓ · neuro deficit unlikely",
    "mechanical: any age · acute · < 4 weeks · stiffness < 30 min · no night pain · WORSE with activity · abnormal flexion · normal chest expansion · neuro deficit possible"
   ],
   "cols": 1
  },
  {
   "x": 376,
   "y": 1928,
   "w": 317,
   "title": "Classification",
   "items": [
    "Modified New York (ankylosing spondylitis): X-ray sacroiliitis grade ≥ 2 both sides or 3-4 one side + ≥ 1 clinical: back pain > 3 months, better with exercise, not rest · limited lumbar motion (sagittal + frontal) · limited chest expansion",
    "ASAS axial SpA: back pain ≥ 3 months, onset < 45 → sacroiliitis on imaging (MRI inflammation or definite X-ray) + ≥ 1 SpA feature, OR HLA-B27 + ≥ 2 other SpA features"
   ],
   "cols": 1
  },
  {
   "x": 708,
   "y": 1928,
   "w": 317,
   "title": "Psoriatic vs rheumatoid",
   "items": [
    "rheumatoid factor: < 10% vs 80%",
    "ASYMMETRIC 'ray' vs symmetric 'row' · distal finger joints 30-50% vs uncommon",
    "spine: sacroiliac or any level 35% vs neck, late",
    "dactylitis, enthesitis, skin + nails vs nodules, dry eyes and mouth, vasculitis",
    "X-ray: distal erosions + periostitis vs periarticular osteopenia + wrist erosions"
   ],
   "cols": 1
  }
 ]
}