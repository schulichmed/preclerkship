   ]
  },
  {
   "id": "type_inv_0_0",
   "x": 497,
   "y": 788,
   "w": 214,
   "h": 214,
   "kind": "type_w",
   "title": "Others",
   "lines": [
    "• avulsion: tendon pulls off a fragment",
    "• open"
   ]
  },
  {
   "id": "desc_inv_0_0",
   "x": 723,
   "y": 788,
   "w": 214,
   "h": 214,
   "kind": "desc_w",
   "title": "Length",
   "lines": [
    "• distraction: pulled apart",
    "• impaction: telescoped in",
    "• override: fragments overlap"
   ]
  },
