   "id": "rea_inv_1_0",
   "x": 725,
   "y": 1184,
   "w": 300,
   "h": 138,
   "kind": "bad",
   "title": "NOT an infection of the joint",
   "lines": [
    "that is septic arthritis"
   ]
  },
