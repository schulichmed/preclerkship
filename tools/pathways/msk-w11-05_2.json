   "y": 788,
   "w": 214,
   "h": 214,
   "kind": "view_w",
   "title": "Needs more than one view",
   "lines": [
    "• oblique: seen on one view",
    "• spiral: seen only on multiple views"
   ]
  },
  {
   "id": "loc_inv_0_0",
   "x": 271,
   "y": 788,
   "w": 214,
   "h": 214,
   "kind": "loc_w",
   "title": "Physis = immature skeleton",
   "lines": [
