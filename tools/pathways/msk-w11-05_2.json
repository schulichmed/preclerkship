  },
  {
   "id": "heal_pres_0_0",
   "x": 1429,
   "y": 452,
   "w": 214,
   "h": 296,
   "kind": "heal_t",
   "title": "On x-ray",
   "lines": [
    "• fracture line WIDENS at 10-14 days",
    "• callus from 2 weeks",
    "• union: bridging callus, medullary space back"
   ]
  },
  {
