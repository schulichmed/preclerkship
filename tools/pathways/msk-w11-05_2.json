   "kind": "ok",
   "title": "1 · Conventional DMARDs",
   "lines": [
    "• methotrexate: skin + joints",
    "• sulfasalazine, leflunomide",
    "~ little proof they stop X-ray progression"
   ]
  },
  {
   "id": "psa_tx_1_0",
   "x": 385,
   "y": 1480,
   "w": 300,
   "h": 60,
   "kind": "bad",
   "title": "AVOID hydroxychloroquine",
   "lines": [
    "severe psoriasis flares"
   ]
  },
  {
   "id": "psa_tx_2_0",
   "x": 385,
   "y": 1562,
   "w": 300,
   "h": 78,
   "kind": "ok",
   "title": "2 · Apremilast (PDE4 inhibitor)",
   "lines": [
    "skin + joints · prevents X-ray progression",
    "~ weaker than biologics"
   ]
  },
  {
   "id": "psa_tx_3_0",
   "x": 385,
   "y": 1662,
   "w": 300,
   "h": 96,
   "kind": "ok",
   "title": "3 · TNF inhibitor",
   "lines": [
    "• skin, joints, SPINE",
    "• enthesitis, dactylitis, nails",
    "• prevents X-ray progression"
   ]
  },
  {
   "id": "psa_tx_4_0",
   "x": 385,
