   "id": "ptl_inv_0_0",
   "x": 297,
   "y": 536,
   "w": 240,
   "h": 96,
   "kind": "ptl_w",
   "title": "1 · Cervical exam + fetal heart rate",
   "lines": [
    "repeat: is it progressing?"
   ]
  },
  {
   "id": "pprom_inv_0_0",
   "x": 577,
   "y": 536,
   "w": 240,
   "h": 96,
   "kind": "pprom_w",
