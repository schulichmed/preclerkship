   "kind": "ok",
   "title": "1 · TOCOLYSIS buys ~48 hours",
   "lines": [
    "• nifedipine",
    "• indomethacin",
    "• terbutaline"
   ]
  },
  {
   "id": "ptl_tx_1_0",
   "x": 297,
   "y": 916,
   "w": 240,
   "h": 168,
   "kind": "ok",
   "title": "2 · STEROIDS if < 34 weeks",
   "lines": [
    "• betamethasone 12 mg intramuscular × 2, 24 h apart",
    "• surfactant (type 2 pneumocytes) → ↓ respiratory distress syndrome",
    "• also ↓ intraventricular hemorrhage, necrotizing enterocolitis, perinatal death"
   ]
  },
  {
   "id": "ptl_tx_2_0",
   "x": 297,
   "y": 1106,
   "w": 240,
   "h": 60,
   "kind": "ok",
   "title": "3 · Transfer to a tertiary centre",
   "lines": [
    "the other use of the 48 hours"
   ]
  },
  {
   "id": "pprom_tx_0_0",
   "x": 577,
   "y": 778,
   "w": 240,
   "h": 163,
   "kind": "ok",
   "title": "1 · ANTIBIOTICS prolong the pregnancy",
   "lines": [
    "• < 32 weeks untreated: 50% deliver in 48 h, 75% in 7 days",
    "• antibiotics lengthen latency: longer = better for the baby"
   ]
  },
  {
   "id": "pprom_tx_1_0",
   "x": 577,
   "y": 963,
   "w": 240,
   "h": 91,
   "kind": "ok",
   "title": "2 · Complete the steroid course",
   "lines": []
  },
  {
