  {
   "id": "ptl_tx_0_0",
   "x": 297,
   "y": 672,
   "w": 240,
   "h": 116,
   "kind": "ok",
   "title": "1 · TOCOLYSIS buys ~48 hours",
   "lines": [
    "• nifedipine",
    "• indomethacin",
    "• terbutaline"
   ]
  },
  {
   "id": "ptl_tx_1_0",
   "x": 297,
   "y": 810,
   "w": 240,
   "h": 114,
   "kind": "ok",
   "title": "2 · STEROIDS if < 34 weeks",
   "lines": [
    "• betamethasone 12 mg intramuscular × 2, 24 h apart",
    "• surfactant → ↓ respiratory distress syndrome"
   ]
  },
  {
   "id": "ptl_tx_2_0",
   "x": 297,
   "y": 946,
   "w": 240,
   "h": 60,
   "kind": "ok",
   "title": "3 · Transfer to a tertiary centre",
   "lines": [
    "the other use of the 48 hours"
   ]
  },
  {
   "id": "pprom_tx_0_0",
   "x": 577,
   "y": 672,
   "w": 240,
   "h": 109,
   "kind": "ok",
   "title": "1 · ANTIBIOTICS prolong the pregnancy",
   "lines": [
    "longer = better for the baby"
   ]
  },
  {
   "id": "pprom_tx_1_0",
   "x": 577,
   "y": 803,
   "w": 240,
   "h": 91,
   "kind": "ok",
   "title": "2 · Complete the steroid course",
   "lines": []
  },
