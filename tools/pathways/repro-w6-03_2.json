   "w": 240,
   "h": 91,
   "kind": "warn",
   "title": "Watch for labour, chorioamnionitis",
   "lines": []
  },
  {
   "id": "imm_tx_0_0",
   "x": 857,
   "y": 778,
   "w": 240,
   "h": 201,
   "kind": "ok",
   "title": "1 · MAGNESIUM SULFATE if < 34 weeks",
   "lines": [
    "• intravenous (IV) bolus, then infusion, to the mother",
    "• fetal neuroprotection: ↓ cerebral palsy"
   ]
  },
  {
   "id": "imm_tx_1_0",
   "x": 857,
   "y": 1001,
   "w": 240,
   "h": 165,
   "kind": "ok",
   "title": "2 · IV PENICILLIN if GBS + or unknown",
   "lines": [
    "↓ GBS sepsis in the newborn · penicillin first-line if no allergy"
   ]
  }
