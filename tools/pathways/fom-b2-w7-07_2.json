   "x": 593,
   "y": 396,
   "w": 262,
   "h": 232,
   "kind": "ppp_t",
   "title": "What they can't report reliably",
   "lines": [
    "• urinary tract infection (UTI), retention",
    "• constipation, impaction",
    "• uncontrolled pain, or its medication"
   ]
  },
