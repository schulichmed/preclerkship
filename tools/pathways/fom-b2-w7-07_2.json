   "h": 114,
   "kind": "ims_t",
   "title": "Acute illness",
   "lines": [
    "• infection",
    "• sodium or calcium ↓ or ↑, glucose ↑",
    "• central nervous system event"
   ]
  },
  {
   "id": "ims_look_1_0",
   "x": 319,
   "y": 532,
   "w": 262,
   "h": 96,
