   "y": 932,
   "w": 262,
   "h": 114,
   "kind": "ok",
   "title": "Fix the environment",
   "lines": [
    "• glasses + hearing aids, reorientation",
    "• sleep: less noise and light, ear plugs",
    "• mobilize early, fewest restraints, family at the bedside"
   ]
  },
  {
   "id": "de_tx_2_0",
   "x": 45,
   "y": 1068,
   "w": 262,
   "h": 188,
   "kind": "warn",
   "title": "Drugs for SYMPTOMS: NOT evidence based",
   "lines": [
    "• hyperactive: antipsychotic first; watch the QT; avoid in seizures, Parkinson's, Lewy body dementia",
    "• alcohol withdrawal → a benzodiazepine instead",
    "• anticholinergic toxidrome → physostigmine"
   ]
  },
