  {
   "id": "root",
   "x": 365,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Bradycardia (< 60 bpm): a BATTERY or a WIRING problem? Then: can it KILL, or only cause SYMPTOMS?",
   "lines": [
    "UNSTABLE now: IV atropine or IV isoproterenol, then temporary pacing (transcutaneous pads or a transvenous wire)",
    "the long-term treatment is a permanent PACEMAKER"
   ]
  },
  {
   "id": "g_bat",
   "x": 45,
   "y": 158,
   "w": 214,
   "h": 80,
   "kind": "plain",
   "title": "BATTERY: too few P waves",
   "lines": [
    "sinus node dysfunction"
   ]
  },
  {
   "id": "g_wire",
   "x": 299,
   "y": 158,
   "w": 892,
   "h": 80,
   "kind": "plain",
   "title": "WIRING: P waves WITHOUT a QRS, atrioventricular (AV) block",
   "lines": [
    "the LOWER the block, the worse the prognosis"
   ]
  },
  {
   "id": "g_bbb",
   "x": 1231,
   "y": 158,
   "w": 214,
   "h": 80,
   "kind": "plain",
   "title": "P = QRS, but the QRS is WIDE",
   "lines": [
    "> 120 ms"
   ]
  },
  {
   "id": "snd_head_0_0",
   "x": 45,
   "y": 318,
   "w": 214,
   "h": 98,
   "kind": "snd_h",
   "title": "Sinus node dysfunction",
   "lines": [
    "degenerative, more common with age"
   ]
  },
  {
   "id": "d1_head_0_0",
   "x": 299,
   "y": 318,
   "w": 214,
   "h": 98,
   "kind": "d1_h",
   "title": "1st degree AV block",
   "lines": [
    "a delay, not a true block"
   ]
  },
  {
   "id": "m1_head_0_0",
   "x": 525,
   "y": 318,
   "w": 214,
   "h": 98,
   "kind": "m1_h",
   "title": "2nd degree, Mobitz I (Wenckebach)",
   "lines": [
    "at the AV node; vagal tone, even asleep"
   ]
  },
  {
   "id": "m2_head_0_0",
   "x": 751,
   "y": 318,
   "w": 214,
   "h": 98,
