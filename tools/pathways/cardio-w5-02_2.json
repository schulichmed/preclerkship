   ]
  },
  {
   "id": "d3_head_0_0",
   "x": 977,
   "y": 318,
   "w": 214,
   "h": 98,
   "kind": "d3_h",
   "title": "3rd degree (complete) AV block",
   "lines": [
    "NO P wave conducts"
   ]
  },
  {
   "id": "bb_head_0_0",
   "x": 1231,
   "y": 318,
   "w": 214,
   "h": 98,
   "kind": "bb_h",
   "title": "Bundle branch block (BBB)",
   "lines": [
    "the other bundle still conducts"
   ]
  },
  {
   "id": "snd_ecg_0_0",
   "x": 45,
   "y": 456,
   "w": 214,
   "h": 196,
   "kind": "snd_t",
   "title": "Slow or missing P waves",
   "lines": [
    "• sinus bradycardia, no rise with exercise",
    "• sinus pauses or arrest",
    "• tachy-brady: a pause as atrial fibrillation (AF) stops"
   ]
  },
  {
   "id": "d1_ecg_0_0",
   "x": 299,
   "y": 456,
   "w": 214,
   "h": 196,
   "kind": "d1_t",
   "title": "PR > 200 ms",
   "lines": [
    "every P wave conducts"
   ]
  },
  {
   "id": "m1_ecg_0_0",
   "x": 525,
   "y": 456,
   "w": 214,
   "h": 196,
   "kind": "m1_t",
   "title": "PR LENGTHENS, then a QRS drops",
   "lines": [
    "• group beating",
    "• short PR again after the drop"
   ]
  },
  {
   "id": "m2_ecg_0_0",
   "x": 751,
   "y": 456,
   "w": 214,
   "h": 196,
   "kind": "m2_t",
   "title": "FIXED PR, then a QRS drops",
   "lines": [
    "~2:1 block: cannot tell type I from II"
   ]
  },
  {
   "id": "d3_ecg_0_0",
   "x": 977,
   "y": 456,
   "w": 214,
   "h": 196,
   "kind": "d3_t",
   "title": "AV DISSOCIATION",
   "lines": [
