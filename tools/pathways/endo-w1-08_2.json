   "w": 250,
   "h": 78,
   "kind": "t70_h",
   "title": "A1c ≤ 7.0%",
   "lines": [
    "MOST adults with type 1 (T1DM) or type 2 diabetes"
   ]
  },
  {
   "id": "t85_head_0_0",
   "x": 597,
   "y": 278,
   "w": 250,
   "h": 78,
