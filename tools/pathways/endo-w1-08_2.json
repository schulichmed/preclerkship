   ]
  },
  {
   "id": "t70_tx_0_0",
   "x": 307,
   "y": 732,
   "w": 250,
   "h": 107,
   "kind": "ok",
   "title": "Self-monitored glucose (SMBG) targets",
   "lines": [
    "• fasting 4.0–7.0 mmol/L",
    "• 2 h after a meal 5.0–10.0 mmol/L"
   ]
  },
