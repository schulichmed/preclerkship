 "panels": [
  {
   "x": 45,
   "y": 964,
   "w": 1064,
   "title": "The A1c: the best-validated marker, but it LAGS",
   "items": [
    "mean glucose over the last 8–12 weeks, ~50% from the last 30 days: changes lag behind glucose, so SMBG guides medication changes",
    "misleading with altered red-cell turnover or hemoglobin (iron or B12 deficiency, chronic renal failure, hemoglobinopathies, splenectomy) → follow glucose readings instead"
   ],
   "cols": 1
  }
 ]
