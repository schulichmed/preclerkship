   "w": 250,
   "h": 178,
   "kind": "t70_t",
   "title": "The default",
   "lines": [
    "• long duration, on insulin, complications",
    "• but no severe lows, not frail, not near the end of life"
   ]
  },
  {
   "id": "t85_clue_0_0",
   "x": 597,
   "y": 396,
   "w": 250,
   "h": 78,
   "kind": "t85_t",
   "title": "Severe lows LIKELY",
   "lines": [
    "• recurrent severe lows",
    "• hypoglycemia unawareness"
   ]
  },
