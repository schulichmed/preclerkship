   "title": "Wheezy child: is it ASTHMA? Then confirm it and step up BY AGE",
   "lines": [
    "asthma = variable airflow limitation that REVERSES with bronchodilators and/or steroids"
   ]
  },
  {
   "id": "g_ex",
   "x": 45,
   "y": 120,
   "w": 250,
   "h": 150,
   "kind": "plain",
   "title": "ACUTE ATTACK: exacerbation",
   "lines": []
  },
  {
   "id": "g_red",
   "x": 335,
   "y": 120,
   "w": 250,
   "h": 150,
   "kind": "plain",
   "title": "ANY RED FLAG → think NON-asthma wheeze",
   "lines": []
  },
  {
   "id": "g_ok",
   "x": 625,
   "y": 120,
   "w": 512,
   "h": 150,
   "kind": "plain",
   "title": "NO red flag: AGE decides how to confirm and step up",
   "lines": [
    "• CONTROLLED = ALL: daytime symptoms < 4 days/week, nights < 1/week, reliever < 4 doses/week, normal activity, no missed school, FEV1 or peak flow (PEF) > 90% personal best",
    "• NOT controlled? check FIRST: the diagnosis, inhaler technique (spacer with every metered-dose inhaler), adherence, triggers (SECONDHAND SMOKE), comorbidities (reflux, allergic rhinitis) → THEN step up"
   ]
  },
  {
   "id": "ex_head_0_0",
   "x": 45,
   "y": 350,
   "w": 250,
   "h": 78,
   "kind": "ex_h",
   "title": "Asthma exacerbation",
   "lines": []
  },
  {
   "id": "na_head_0_0",
   "x": 335,
   "y": 350,
   "w": 250,
   "h": 78,
   "kind": "na_h",
   "title": "Not asthma (yet)",
   "lines": [
    "not every wheeze is asthma"
   ]
  },
  {
   "id": "pr_head_0_0",
   "x": 625,
   "y": 350,
   "w": 250,
   "h": 78,
   "kind": "pr_h",
   "title": "Preschool asthma",
   "lines": [
    "cannot do lung function tests: diagnosed WITHOUT spirometry"
   ]
  },
  {
   "id": "sc_head_0_0",
   "x": 887,
   "y": 350,
   "w": 250,
   "h": 78,
   "kind": "sc_h",
   "title": "School-age asthma",
   "lines": [
    "can do lung function tests: needs OBJECTIVE proof"
   ]
  },
  {
   "id": "ex_dx_0_0",
   "x": 45,
   "y": 468,
   "w": 250,
   "h": 318,
   "kind": "ex_t",
   "title": "Monitor",
   "lines": [
    "• oxygen saturation: target ≥ 90%",
    "• follow PEF for improvement"
   ]
  },
  {
   "id": "na_dx_0_0",
   "x": 335,
   "y": 468,
   "w": 250,
   "h": 148,
   "kind": "bad",
   "title": "Red flags",
   "lines": [
    "• symptoms before 6 MONTHS",
    "• daily PRODUCTIVE cough",
    "• NO benefit from medications",
    "• sudden onset with no history",
    "• failure to thrive, clubbing, stridor"
   ]
  },
  {
   "id": "na_dx_1_0",
   "x": 335,
   "y": 638,
   "w": 250,
   "h": 148,
   "kind": "na_t",
   "title": "Flag → what it suggests",
   "lines": [
    "• ASYMMETRIC sounds or imaging → foreign body",
    "• cough while EATING or drinking → aspiration",
    "• family history → cystic fibrosis (CF)"
   ]
  },
  {
   "id": "pr_dx_0_0",
   "x": 625,
   "y": 468,
   "w": 250,
   "h": 98,
   "kind": "pr_t",
   "title": "1 · Documented OBSTRUCTION",
   "lines": [
    "wheeze SEEN by a clinician (preferred) or a convincing parent report"
   ]
  },
  {
   "id": "pr_dx_1_0",
   "x": 625,
   "y": 588,
   "w": 250,
   "h": 134,
   "kind": "pr_t",
   "title": "2 · Documented REVERSIBILITY",
   "lines": [
    "• SABA ± oral steroid given in clinic (preferred)",
    "• or response to a 3-month medium-dose ICS trial"
   ]
  },
  {
   "id": "pr_dx_2_0",
   "x": 625,
   "y": 744,
   "w": 250,
   "h": 42,
   "kind": "pr_w",
   "title": "3 · No alternative diagnosis",
   "lines": []
  },
  {
   "id": "sc_dx_0_0",
   "x": 887,
   "y": 468,
   "w": 250,
   "h": 115,
   "kind": "sc_t",
   "title": "1 · Spirometry",
   "lines": [
    "• FEV1/FVC < 0.8–0.9 (FEV1 = forced expiratory volume in 1 s, FVC = forced vital capacity)",
    "• FEV1 ↑ ≥ 12% after bronchodilator"
   ]
  },
  {
   "id": "sc_dx_1_0",
   "x": 887,
   "y": 605,
   "w": 250,
   "h": 61,
   "kind": "sc_w",
   "title": "2 · Or PEF",
   "lines": [
    "↑ ≥ 20% after bronchodilator"
   ]
  },
  {
   "id": "sc_dx_2_0",
   "x": 887,
   "y": 688,
   "w": 250,
   "h": 97,
   "kind": "sc_w",
   "title": "3 · Or a CHALLENGE",
   "lines": [
    "• methacholine: provocative concentration (PC20) < 4 mg/mL",
    "• exercise: FEV1 ↓ ≥ 10–15%"
   ]
  },
  {
   "id": "ex_tx_0_0",
   "x": 45,
   "y": 826,
   "w": 250,
   "h": 254,
   "kind": "ok",
   "title": "Nebulized short-acting beta-agonist (SABA) + ipratropium",
   "lines": [
    "+ oral steroids"
   ]
  },
  {
   "id": "ex_tx_1_0",
   "x": 45,
   "y": 1102,
   "w": 250,
   "h": 250,
   "kind": "bad",
   "title": "AVOID",
   "lines": [
    "• anti-inflammatories (NSAIDs)",
    "• beta blockers",
    "• sedatives"
   ]
  },
  {
   "id": "na_tx_0_0",
   "x": 335,
   "y": 826,
   "w": 250,
   "h": 315,
   "kind": "na_w",
   "title": "Look for the real cause",
   "lines": [
    "• transient viral wheeze",
    "• bronchiectasis (CF, immunodeficiency, ciliary dyskinesia)",
    "• tracheomalacia, vascular ring, heart disease",
    "• reflux (GERD), vocal cord dysfunction, tuberculosis, bronchopulmonary dysplasia"
   ]
  },
  {
   "id": "na_tx_1_0",
   "x": 335,
   "y": 1163,
   "w": 250,
   "h": 189,
   "kind": "na_w",
   "title": "Foreign body?",
   "lines": [
    "PEDIATRIC AIRWAY chart"
   ]
  },
  {
   "id": "pr_tx_0_0",
   "x": 625,
   "y": 826,
   "w": 250,
   "h": 88,
   "kind": "ok",
   "title": "1 · Avoid triggers + SABA as needed",
   "lines": [
    "salbutamol"
   ]
  },
  {
