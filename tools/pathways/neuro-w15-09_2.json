 "nodes": [
  {
   "id": "root",
   "x": 432,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Hearing loss: is sound BLOCKED before the cochlea, or is the cochlea or nerve DAMAGED?",
   "lines": [
    "ask: loudness or clarity · duration · sudden or insidious · rate · one or both ears · pain (the T's), discharge, fullness, tinnitus, vertigo, facial or trigeminal symptoms",
    "512 Hz tuning forks, ALWAYS both: Weber pushed hard on the midline (forehead, nose, tooth; detects 5 dB) + Rinne (mastoid, then beside the ear; normal air > bone)",
    "e.g. Weber → RIGHT = right conductive OR left sensorineural · Rinne decides: right bone > air → RIGHT conductive",
    "audiogram: dB is logarithmic (+10 dB = 10× intensity, ~2× loudness) · conversation 60 · lawnmower 90 · rock concert 120 · gunshot 140 · newborns: auditory brainstem response · CT: bone, ossicles · MRI: cerebellopontine angle",
    "a SUDDEN conductive loss can wait; a SUDDEN sensorineural loss is an EMERGENCY"
   ]
  },
  {
   "id": "g_c",
   "x": 45,
   "y": 246,
   "w": 639,
   "h": 96,
   "kind": "plain",
   "title": "CONDUCTIVE",
   "lines": [
    "Weber → the AFFECTED ear · Rinne there: bone > air",
    "audiogram: bone normal, air down (an air-bone gap)",
    "often fixable, medically or surgically"
   ]
  },
  {
   "id": "g_s",
   "x": 724,
   "y": 246,
   "w": 856,
   "h": 96,
   "kind": "plain",
   "title": "SENSORINEURAL",
   "lines": [
    "Weber → the NORMAL ear · Rinne: air > bone",
    "audiogram: bone down, air the same as bone",
    "damage to cochlea or nerve cannot be repaired"
   ]
  },
  {
   "id": "t_c",
   "x": 45,
   "y": 382,
   "w": 639,
   "h": 114,
   "kind": "plain",
   "title": "Sound path: canal → drum → ossicles",
   "lines": [
    "• hears 20-20,000 Hz, best 2,000-4,000 Hz (speech)",
    "• the 3 cm canal resonates there",
    "• ossicles: air pressure → force on the oval window → moves fluid"
   ]
  },
  {
   "id": "t_s",
   "x": 724,
   "y": 382,
   "w": 856,
   "h": 114,
   "kind": "plain",
   "title": "Cochlea → nerve → cortex",
   "lines": [
    "• oval window → scala vestibuli → helicotrema → scala tympani → round window",
    "• TONOTOPIC: stiff base = HIGH pitch · floppy apex = low",
    "• inner hair cells transduce, outer amplify",
    "• spiral ganglion → CN VIII → brainstem → medial geniculate → superior temporal gyrus"
   ]
  },
  {
   "id": "eac_head_0_0",
   "x": 45,
   "y": 576,
   "w": 205,
   "h": 114,
   "kind": "eac_h",
   "title": "Ear canal",
   "lines": [
    "wax · foreign body · exostoses · otitis externa"
   ]
  },
  {
   "id": "om_head_0_0",
   "x": 262,
   "y": 576,
   "w": 205,
   "h": 114,
   "kind": "om_h",
   "title": "Otitis media",
   "lines": [
    "the commonest middle ear cause",
    "peak 6-11 months · 2/3 by age 1 · 1/2 have > 3 by age 3"
   ]
  },
  {
   "id": "fix_head_0_0",
   "x": 479,
   "y": 576,
   "w": 205,
   "h": 114,
   "kind": "fix_h",
   "title": "Drum or ossicles",
   "lines": [
    "perforation · otosclerosis · longitudinal fracture",
    "also cholesteatoma, adhesive otitis media"
   ]
  },
  {
   "id": "ssnhl_head_0_0",
   "x": 724,
   "y": 576,
   "w": 205,
   "h": 114,
   "kind": "ssnhl_h",
   "title": "SUDDEN sensorineural",
   "lines": [
    "onset < 3 days · EMERGENCY"
   ]
  },
  {
   "id": "grad_head_0_0",
   "x": 941,
   "y": 576,
   "w": 205,
   "h": 114,
   "kind": "grad_h",
   "title": "Gradual, symmetric",
   "lines": [
    "presbycusis · noise · ototoxic drugs"
   ]
  },
  {
   "id": "vs_head_0_0",
   "x": 1158,
   "y": 576,
   "w": 205,
   "h": 114,
   "kind": "vs_h",
   "title": "ONE-sided, progressive",
   "lines": [
    "vestibular schwannoma (acoustic neuroma)"
   ]
  },
  {
   "id": "oth_head_0_0",
   "x": 1375,
   "y": 576,
   "w": 205,
   "h": 114,
   "kind": "oth_h",
   "title": "Other sensorineural",
   "lines": [
    "congenital · trauma · systemic"
   ]
  },
  {
   "id": "eac_pres_0_0",
   "x": 45,
   "y": 730,
   "w": 205,
   "h": 598,
   "kind": "eac_t",
   "title": "Otitis externa",
   "lines": [
    "• bacterial: itchy, painful, swollen, sore on pulling the pinna",
    "• fungal: severe itch, less pain, after antibiotics",
    "~fungal and recurrent → think diabetes"
   ]
  },
  {
   "id": "om_pres_0_0",
   "x": 262,
   "y": 730,
   "w": 205,
   "h": 323,
   "kind": "om_t",
   "title": "Acute: after a cold",
   "lines": [
    "pain, fever, irritability · bulging drum · discharge",
    "• Strep pneumoniae 30-40% · H. influenzae 20-30% · Moraxella 10-15% · group A strep 2-4%",
    "~overdiagnosed"
   ]
  },
  {
   "id": "om_pres_1_0",
   "x": 262,
   "y": 1075,
   "w": 205,
   "h": 253,
   "kind": "om_w",
   "title": "With effusion: no infection signs",
   "lines": [
    "hearing loss, speech delay",
    "~underdiagnosed"
   ]
  },
  {
   "id": "fix_pres_0_0",
   "x": 479,
   "y": 730,
   "w": 205,
   "h": 598,
   "kind": "fix_t",
   "title": "Which one?",
   "lines": [
    "• perforation: infection, tubes, trauma, barotrauma",
    "• otosclerosis: NORMAL drum, no trauma or infection · bone fixes the STAPES footplate",
    "• longitudinal fracture (80%, side blow): unconscious, bleeding from or behind the drum, hearing loss · canal tear, ossicles disrupted"
   ]
  },
  {
   "id": "ssnhl_pres_0_0",
   "x": 724,
   "y": 730,
   "w": 205,
   "h": 598,
   "kind": "ssnhl_t",
   "title": "Hearing loss, tinnitus, fullness",
   "lines": [
    "± vertigo",
    "~idiopathic: viral, vascular, membrane rupture?"
   ]
  },
  {
   "id": "grad_pres_0_0",
   "x": 941,
   "y": 730,
   "w": 205,
   "h": 598,
   "kind": "grad_t",
   "title": "Which one?",
   "lines": [
    "• presbycusis: commonest, HIGH pitches first (basal hair cells), 30% over 65, 50% over 75, men more",
    "• noise > 85 dB (max for an 8-hour shift): work, recreation, guns (asymmetric)",
    "• aminoglycosides, cisplatin, carboplatin, vincristine, loop diuretics",
    "~ASA and quinine: reversible · macrolides: temporary · gentamicin used on purpose"
   ]
  },
  {
   "id": "vs_pres_0_0",
   "x": 1158,
   "y": 730,
   "w": 205,
   "h": 598,
   "kind": "vs_t",
   "title": "Unilateral loss + tinnitus",
   "lines": [
    "• imbalance (rarely vertigo)",
    "• trigeminal or facial nerve symptoms",
    "~commonest cerebellopontine angle mass · both sides = NF2"
   ]
  },
  {
   "id": "oth_pres_0_0",
   "x": 1375,
   "y": 730,
   "w": 205,
   "h": 116,
   "kind": "oth_t",
   "title": "Congenital, non-syndromic (2/3)",
   "lines": [
    "• 70-80% recessive",
    "• GJB2 (connexin 26): 20% of childhood deafness"
   ]
  },
  {
   "id": "oth_pres_1_0",
   "x": 1375,
   "y": 868,
   "w": 205,
   "h": 150,
   "kind": "oth_w",
   "title": "Syndromic (1/3)",
   "lines": [
    "• Usher: retinitis pigmentosa",
    "• Waardenburg: pigment",
    "• Pendred: thyroid · Alport: kidney",
    "• Jervell and Lange-Nielsen: long QT"
   ]
  },
  {
   "id": "oth_pres_2_0",
   "x": 1375,
   "y": 1040,
   "w": 205,
   "h": 134,
   "kind": "bad",
   "title": "Transverse temporal bone fracture",
   "lines": [
    "• 20%, front-back blow",
    "• through the otic capsule, rarely recovers",
    "• facial nerve in 50%"
   ]
  },
  {
   "id": "oth_pres_3_0",
   "x": 1375,
   "y": 1196,
   "w": 205,
   "h": 132,
   "kind": "oth_w",
   "title": "Also",
   "lines": [
    "• meningioma · labyrinthitis",
    "• migraine, MS",
    "• cryoglobulinemia, sickle cell",
    "• HIV, polyarteritis nodosa",
    "• Paget's, otosclerosis"
   ]
  },
  {
   "id": "eac_inv_0_0",
   "x": 45,
   "y": 1368,
   "w": 205,
   "h": 180,
   "kind": "eac_w",
   "title": "Otoscopy",
   "lines": [
    "• bacterial: Pseudomonas, then Staph aureus, E. coli",
    "• fungal: black spores (Aspergillus), white (Candida)"
   ]
  },
  {
   "id": "om_inv_0_0",
   "x": 262,
   "y": 1368,
   "w": 205,
   "h": 60,
   "kind": "om_w",
   "title": "Pneumatic otoscopy",
   "lines": [
    "drum does not move = fluid"
   ]
  },
  {
   "id": "om_inv_1_0",
   "x": 262,
   "y": 1450,
   "w": 205,
   "h": 98,
   "kind": "om_w",
   "title": "Fluid in BOTH ears for 3 months",
   "lines": [
    "→ hearing test (speech, development)"
   ]
  },
  {
   "id": "fix_inv_0_0",
   "x": 479,
   "y": 1368,
   "w": 205,
   "h": 97,
   "kind": "fix_w",
   "title": "Audiogram",
   "lines": [
    "otosclerosis: conductive or mixed, rising curve, Carhart's notch"
   ]
  },
  {
   "id": "fix_inv_1_0",
   "x": 479,
   "y": 1487,
   "w": 205,
   "h": 61,
   "kind": "fix_w",
   "title": "CT",
   "lines": [
    "bone and ossicles"
   ]
  },
  {
   "id": "ssnhl_inv_0_0",
   "x": 724,
   "y": 1368,
   "w": 205,
   "h": 180,
   "kind": "ssnhl_w",
   "title": "Workup",
   "lines": [
    "1 · tuning forks",
    "2 · ENT referral",
    "3 · audiogram",
    "4 · MRI: 2% are an acoustic neuroma"
   ]
  },
  {
   "id": "grad_inv_0_0",
   "x": 941,
   "y": 1368,
   "w": 205,
   "h": 180,
   "kind": "grad_w",
   "title": "Audiogram",
   "lines": [
    "• presbycusis: high-frequency loss",
    "• noise: a 4,000 Hz NOTCH"
   ]
  },
  {
   "id": "vs_inv_0_0",
   "x": 1158,
   "y": 1368,
   "w": 205,
   "h": 180,
   "kind": "vs_w",
   "title": "MRI ± gadolinium",
   "lines": [
    "soft tissue, cerebellopontine angle tumours"
   ]
  },
  {
   "id": "eac_tx_0_0",
   "x": 45,
   "y": 1588,
   "w": 205,
   "h": 209,
   "kind": "ok",
   "title": "Clean it",
   "lines": [
    "• debride, acidify, stop Q-tips",
    "• antibiotic + steroid drops",
    "• fungal: clean (alcohol, vinegar), antifungal drops"
   ]
  },
  {
   "id": "eac_tx_1_0",
   "x": 45,
   "y": 1819,
   "w": 205,
   "h": 301,
   "kind": "bad",
   "title": "Perforation? NO ototoxic drops",
   "lines": [
    "• ciprofloxacin + dexamethasone (Ciprodex) is non-ototoxic",
    "• ototoxic: Garasone, Sofracort, Cortisporin",
    "• fungal: fluconazole or clotrimazole (intact drum: Locacorten-Vioform)"
   ]
  },
  {
   "id": "eac_tx_2_0",
   "x": 45,
   "y": 2142,
   "w": 205,
   "h": 191,
   "kind": "warn",
   "title": "Chronic otitis externa",
   "lines": [
    "dermatitis (local steroid), Q-tips, fibrosis traps wax · may need excision + graft"
   ]
  },
  {
   "id": "om_tx_0_0",
   "x": 262,
   "y": 1588,
   "w": 205,
   "h": 98,
   "kind": "ok",
   "title": "Acute: high-dose amoxicillin",
   "lines": [
    "or watch 48-72 h in lower-risk children · treat pain"
   ]
  },
  {
   "id": "om_tx_1_0",
   "x": 262,
   "y": 1708,
   "w": 205,
   "h": 222,
   "kind": "warn",
   "title": "Tubes",
   "lines": [
    "• effusion both ears > 3 months + > 20 dB loss in the better ear",
    "• fluid with speech delay",
    "• symptoms despite > 6 weeks of antibiotics",
    "• suppurative complication",
    "• intermittent fluid with a hearing aid · chronic drum atrophy"
   ]
  },
  {
   "id": "om_tx_2_0",
   "x": 262,
   "y": 1952,
   "w": 205,
   "h": 188,
   "kind": "bad",
   "title": "Complications: temporal bone",
   "lines": [
    "• hearing loss · perforation · effusion",
    "• retraction pocket, cholesteatoma",
    "• mastoiditis · labyrinthitis",
    "• ossicular erosion, fixation",
    "• FACIAL paralysis"
   ]
  },
  {
   "id": "om_tx_3_0",
   "x": 262,
   "y": 2162,
   "w": 205,
   "h": 170,
   "kind": "bad",
   "title": "Complications: intracranial",
   "lines": [
    "• MENINGITIS",
    "• extradural abscess · subdural empyema",
    "• brain abscess",
    "• lateral sinus thrombosis",
    "• otitic hydrocephalus"
   ]
  },
  {
   "id": "fix_tx_0_0",
   "x": 479,
   "y": 1588,
   "w": 205,
   "h": 744,
   "kind": "ok",
   "title": "Fix or bypass",
   "lines": [
    "• perforation: keep dry, 80% heal; else tympanoplasty",
    "• ossiculoplasty · stapedectomy",
    "• aids: air (behind or in the ear), or bone-conduction (BAHA, Bonebridge)"
   ]
  },
  {
   "id": "ssnhl_tx_0_0",
   "x": 724,
   "y": 1588,
   "w": 205,
   "h": 744,
   "kind": "ok",
   "title": "Steroids by mouth or into the ear",
   "lines": [
    "START WITHIN 10 DAYS",
    "~60-80% recover"
   ]
  },
  {
   "id": "grad_tx_0_0",
   "x": 941,
   "y": 1588,
   "w": 205,
   "h": 351,
   "kind": "ok",
   "title": "Protect, then amplify",
   "lines": [
    "• hearing protection",
    "• hearing aid: volume, NOT clarity"
   ]
  },
  {
   "id": "grad_tx_1_0",
   "x": 941,
   "y": 1961,
   "w": 205,
   "h": 371,
   "kind": "ok",
   "title": "Severe to profound, aids failing",
   "lines": [
    "cochlear implant: bypasses hair cells, stimulates CN VIII (needs a working nerve)"
   ]
  },
  {
   "id": "vs_tx_0_0",
   "x": 1158,
   "y": 1588,
   "w": 205,
   "h": 744,
   "kind": "ok",
   "title": "Slow, benign",
   "lines": [
    "observe · stereotactic radiation · microsurgery"
   ]
  }
 ],
