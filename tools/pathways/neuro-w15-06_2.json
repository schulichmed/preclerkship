 "nodes": [
  {
   "id": "root",
   "x": 505,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Vision loss in ONE eye: the problem is in FRONT of the optic chiasm",
   "lines": [
    "both eyes → behind the chiasm",
    "ask: pain? transient, persistent or progressive? abrupt or over hours, days, weeks? all or part of the field? baseline acuity? diabetes, vascular, autoimmune, hypertension · retinopathy, glaucoma, eye surgery, contact lenses",
    "examine: acuity · confrontation fields · swinging flashlight: RAPD (Marcus Gunn) = pupil DILATES when light moves to the bad eye → retina or optic nerve · red reflex: dull = media opacity (cornea, lens, vitreous) · pressure",
    "PAINFUL: cornea, uveitis, acute angle closure (see the RED EYE chart)"
   ]
  },
  {
   "id": "g_ac",
   "x": 45,
   "y": 210,
   "w": 1028,
   "h": 60,
   "kind": "plain",
   "title": "SUDDEN + PAINLESS: what do the pupil and the fundus show?",
   "lines": [
    "emergency measures + ophthalmology for CRAO, ischemic optic neuropathy, GCA"
   ]
  },
  {
   "id": "g_ch",
   "x": 1113,
   "y": 210,
   "w": 612,
   "h": 60,
   "kind": "plain",
   "title": "GRADUAL: which part of vision goes?",
   "lines": [
    "refer, but not same-day unless pressure > 30"
   ]
  },
  {
