   "lines": [
    "lens opacity · leading cause of REVERSIBLE blindness"
   ]
  },
  {
   "id": "amd_head_0_0",
   "x": 1529,
   "y": 350,
   "w": 196,
   "h": 116,
   "kind": "amd_h",
   "title": "Age-related macular degeneration",
   "lines": [
    "leading IRREVERSIBLE cause over 50"
   ]
  },
  {
   "id": "crao_pres_0_0",
   "x": 45,
   "y": 506,
   "w": 196,
   "h": 240,
   "kind": "crao_t",
   "title": "Sudden, SEVERE",
   "lines": [
    "• older, hypertension",
    "• acuity: hand motion",
    "case: 72, 1.5 hours, right hand motion, left 20/20"
   ]
  },
  {
   "id": "gca_pres_0_0",
   "x": 253,
   "y": 506,
   "w": 196,
   "h": 240,
   "kind": "gca_t",
   "title": "Older + new headache",
   "lines": [
    "• jaw claudication",
    "• scalp tenderness · thick, tender temporal artery",
    "• weight loss, fever, night sweats, malaise",
    "• polymyalgia rheumatica: neck, shoulders",
    "case: 67, pain chewing, combing hair, shoulder pain 2 months · 20/80, inferior field loss"
   ]
  },
  {
   "id": "on_pres_0_0",
   "x": 461,
   "y": 506,
   "w": 196,
   "h": 240,
   "kind": "on_t",
   "title": "Healthy YOUNG woman",
   "lines": [
    "• sudden, painless",
    "• acuity reduced",
    "case: 30, left 20/100"
   ]
  },
  {
   "id": "rd_pres_0_0",
   "x": 669,
   "y": 506,
   "w": 196,
   "h": 240,
   "kind": "rd_t",
   "title": "Flashes, floaters, curtain",
   "lines": [
    "• flashes: retina tears or detaches",
    "• floaters = blood from a retinal tear",
    "• peripheral field loss",
    "• acuity may be normal",
    "case: 56, 20/20 both eyes, temporal field loss"
   ]
  },
  {
   "id": "vh_pres_0_0",
   "x": 877,
   "y": 506,
   "w": 196,
   "h": 240,
   "kind": "vh_t",
   "title": "Long-standing diabetes",
   "lines": [
    "• acuity: hand motion",
    "• pressure normal",
    "case: 74, type 2 diabetes 30 years, HbA1c 8.0%"
   ]
  },
  {
   "id": "gl_pres_0_0",
   "x": 1113,
   "y": 506,
   "w": 196,
   "h": 240,
   "kind": "gl_t",
   "title": "SILENT until very late",
   "lines": [
    "• peripheral field goes first",
    "• acuity falls LAST"
   ]
  },
  {
   "id": "cat_pres_0_0",
   "x": 1321,
   "y": 506,
   "w": 196,
   "h": 240,
   "kind": "cat_t",
   "title": "Hazy vision, glare",
   "lines": [
    "• halos, starbursts, night driving",
    "• 'second sight': lenticular myopia, better near vision",
    "• varies with where the opacity is"
   ]
  },
  {
   "id": "amd_pres_0_0",
   "x": 1529,
   "y": 506,
   "w": 196,
   "h": 240,
   "kind": "amd_t",
   "title": "Central loss + distortion",
   "lines": [
    "• metamorphopsia: Amsler grid",
    "• wet: choroidal new vessels bleed, leak into the macula → sudden severe drop",
    "• dry: retinal atrophy, drusen"
   ]
  },
  {
   "id": "crao_inv_0_0",
   "x": 45,
   "y": 786,
   "w": 196,
   "h": 186,
   "kind": "crao_w",
   "title": "RAPD + retina",
   "lines": [
    "• WHITE opacified retina",
    "• CHERRY-RED macular spot"
   ]
  },
  {
   "id": "gca_inv_0_0",
   "x": 253,
   "y": 786,
   "w": 196,
   "h": 186,
   "kind": "gca_w",
   "title": "RAPD + SWOLLEN disc",
   "lines": [
    "• flame-shaped hemorrhages",
    "• ESR + CRP NOW (ESR usually > 60)"
   ]
  },
  {
   "id": "on_inv_0_0",
   "x": 461,
   "y": 786,
   "w": 196,
   "h": 186,
   "kind": "on_w",
   "title": "RAPD + SWOLLEN disc",
   "lines": [
    "• clear media, clear red reflex",
    "• normal front of the eye"
   ]
  },
  {
   "id": "rd_inv_0_0",
   "x": 669,
   "y": 786,
   "w": 196,
   "h": 186,
   "kind": "rd_w",
   "title": "Red reflex",
   "lines": [
    "• dark mobile spots",
    "~usually not seen with a direct ophthalmoscope"
   ]
  },
  {
   "id": "vh_inv_0_0",
   "x": 877,
   "y": 786,
   "w": 196,
   "h": 186,
   "kind": "vh_w",
   "title": "Proliferative retinopathy",
   "lines": [
    "fragile new vessels bleed into the vitreous"
   ]
  },
  {
   "id": "gl_inv_0_0",
   "x": 1113,
   "y": 786,
   "w": 196,
   "h": 186,
   "kind": "gl_w",
   "title": "Pressure + disc + field",
   "lines": [
    "• pressure > 21 (normal 10-21; can be normal: normal-tension glaucoma)",
    "• Goldmann applanation, Tono-Pen, air puff",
    "• cup-to-disc ≥ 0.5, or eyes differ > 0.2",
    "• arcuate defect, nasal step"
   ]
  },
  {
   "id": "cat_inv_0_0",
   "x": 1321,
   "y": 786,
   "w": 196,
   "h": 186,
   "kind": "cat_w",
   "title": "Acuity ↓, hazy view",
   "lines": [
    "• dense: dull red reflex or white pupil",
    "• pressure normal"
   ]
  },
  {
   "id": "amd_inv_0_0",
   "x": 1529,
   "y": 786,
   "w": 196,
   "h": 186,
   "kind": "amd_w",
   "title": "Refer if ANY",
   "lines": [
    "• central acuity ↓",
    "• new distortion",
    "• drusen or blood at the macula"
   ]
  },
  {
   "id": "crao_tx_0_0",
   "x": 45,
   "y": 1012,
   "w": 196,
   "h": 132,
   "kind": "bad",
   "title": "Ocular massage NOW",
   "lines": [
    "• heel of hand: 10 s press, 10 s release, for 5 min",
    "• may dislodge the embolus",
    "• EMERGENT referral"
   ]
  },
  {
   "id": "crao_tx_1_0",
   "x": 45,
   "y": 1166,
   "w": 196,
   "h": 96,
   "kind": "warn",
   "title": "Find the source",
   "lines": [
    "carotid atheroma, heart valves"
   ]
  },
  {
   "id": "gca_tx_0_0",
   "x": 253,
   "y": 1012,
   "w": 196,
   "h": 168,
   "kind": "bad",
   "title": "Steroids NOW",
   "lines": [
    "• visual symptoms: IV methylprednisolone 1 g × 3 days",
    "• none: prednisone 40-60 mg daily",
    "~ saves the other eye, prevents stroke, aortic arch syndrome"
   ]
  },
  {
   "id": "gca_tx_1_0",
   "x": 253,
   "y": 1202,
   "w": 196,
   "h": 60,
   "kind": "warn",
   "title": "EMERGENT referral",
   "lines": [
    "temporal artery biopsy"
   ]
  },
  {
   "id": "on_tx_0_0",
   "x": 461,
   "y": 1012,
   "w": 196,
   "h": 250,
   "kind": "ok",
   "title": "Consult",
   "lines": [
    "• neuro-ophthalmology",
    "• MRI, possible IV corticosteroids",
    "• neurology: rule out multiple sclerosis"
   ]
  },
  {
   "id": "rd_tx_0_0",
   "x": 669,
   "y": 1012,
   "w": 196,
   "h": 250,
   "kind": "warn",
   "title": "Refer promptly",
   "lines": [
    "ophthalmology evaluation"
   ]
  },
  {
   "id": "vh_tx_0_0",
   "x": 877,
   "y": 1012,
   "w": 196,
   "h": 250,
   "kind": "ok",
   "title": "Retina specialist",
   "lines": [
    "pan-retinal laser photocoagulation"
   ]
  },
  {
   "id": "gl_tx_0_0",
   "x": 1113,
   "y": 1012,
   "w": 196,
   "h": 250,
   "kind": "ok",
   "title": "Lower the pressure",
   "lines": [
    "• the ONLY treatment",
    "• drops → laser → surgery",
    "• refer: pressure > 21 or suspicious nerve",
    "• same-day referral only if > 30"
   ]
  },
  {
   "id": "cat_tx_0_0",
   "x": 1321,
   "y": 1012,
   "w": 196,
   "h": 250,
   "kind": "ok",
   "title": "Non-urgent referral",
   "lines": [
    "visually significant or blocks the view of the retina → extraction + intraocular lens"
   ]
  },
  {
   "id": "amd_tx_0_0",
   "x": 1529,
   "y": 1012,
   "w": 196,
   "h": 114,
   "kind": "ok",
   "title": "WET ~20%",
   "lines": [
    "• anti-VEGF injected into the eye",
    "• bevacizumab, ranibizumab, aflibercept"
   ]
  },
  {
   "id": "amd_tx_1_0",
   "x": 1529,
   "y": 1148,
   "w": 196,
   "h": 114,
   "kind": "ok",
   "title": "DRY ~80%",
   "lines": [
    "• AREDS2: vitamins C, E, lutein, zeaxanthin, zinc, copper",
    "• stop smoking, nutrition"
   ]
  }
 ],
