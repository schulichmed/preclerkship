 "nodes": [
  {
   "id": "root",
   "x": 186,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Child seizing: ABCDE + time it",
   "lines": [
    "Airway: bag-mask, laryngeal mask or tube if needed · Circulation: early fast pulse, high BP tolerated, LOW BP → fluid bolus",
    "Disability: pupils (dilated or pinpoint → overdose · blown or fixed → raised pressure, bleed) · glucose · Exposure: safe space, skin",
    "EVERY child: bedside GLUCOSE + blood GAS with electrolytes",
    "history: onset, timing, duration · movements, eyes, focal or generalized · consciousness during and after, recovery · fever, trauma, toxins, drugs or withdrawal · milestones, family epilepsy",
    "exam: vitals · pupils, cranial nerves, tone, reflexes, focal deficits · raised pressure (bulging fontanelle, papilledema) · café au lait spots (neurofibromatosis)",
    "subtle in newborns: lip smacking, sucking, chewing, eye deviation or fluttering, bicycling, apnea, vital sign changes · subclinical: EEG only"
   ]
  },
  {
   "id": "g_feb",
   "x": 45,
   "y": 282,
   "w": 672,
   "h": 78,
   "kind": "plain",
   "title": "FEVER, age 6 months-5 years: FEBRILE seizure",
   "lines": [
    "only if NO CNS infection, NO acute electrolyte problem, NO past afebrile seizure",
    "WORRY: not back to baseline · meningeal signs or toxic look · delay or neurologic condition"
   ]
  },
  {
   "id": "g_se",
   "x": 757,
   "y": 282,
   "w": 330,
   "h": 78,
   "kind": "plain",
   "title": "Still seizing at 5 MINUTES",
   "lines": [
    "or no return to baseline between seizures"
   ]
  },
  {
   "id": "sfs_head_0_0",
   "x": 45,
   "y": 440,
   "w": 330,
   "h": 78,
   "kind": "sfs_h",
   "title": "Simple febrile seizure",
   "lines": []
  },
  {
   "id": "cfs_head_0_0",
   "x": 387,
   "y": 440,
   "w": 330,
   "h": 78,
   "kind": "cfs_h",
   "title": "Complex febrile seizure",
   "lines": []
  },
  {
   "id": "cse_head_0_0",
   "x": 757,
   "y": 440,
   "w": 330,
   "h": 78,
   "kind": "cse_h",
   "title": "Convulsive status epilepticus",
   "lines": [
    "> 30 min, or 2+ seizures without recovery",
    "10-73 per 100,000 children a year · most under 2"
   ]
  },
  {
   "id": "sfs_pres_0_0",
   "x": 45,
   "y": 558,
   "w": 330,
   "h": 123,
   "kind": "sfs_t",
   "title": "Typical",
   "lines": [
    "• GENERALIZED",
    "• < 15 minutes",
    "• ONCE in 24 hours",
    "• no neurologic or developmental problem"
   ]
  },
  {
   "id": "sfs_pres_1_0",
   "x": 45,
   "y": 703,
   "w": 330,
   "h": 87,
   "kind": "sfs_w",
   "title": "case: 15 months",
   "lines": [
    "fever · generalized tonic-clonic 3 min · now alert, playful"
   ]
  },
  {
   "id": "cfs_pres_0_0",
   "x": 387,
   "y": 558,
   "w": 330,
   "h": 132,
   "kind": "cfs_t",
   "title": "Any ONE of",
   "lines": [
    "• FOCAL (one limb or side)",
    "• > 15 minutes",
    "• RECURS within 24 hours",
    "• focal signs after the seizure",
    "• known neurologic condition"
   ]
  },
  {
   "id": "cfs_pres_1_0",
   "x": 387,
   "y": 712,
   "w": 330,
   "h": 78,
   "kind": "cfs_w",
   "title": "case: 14 months, 38.8°C, cold",
   "lines": [
    "2 right-sided seizures (4 min) in one day · now normal"
   ]
  },
  {
   "id": "cse_pres_0_0",
   "x": 757,
   "y": 558,
   "w": 330,
   "h": 96,
   "kind": "cse_t",
   "title": "Tonic-clonic, not stopping",
   "lines": [
    "• most seizures stop within 5 minutes",
    "• longer = ↑ brain oxygen demand, cell death: time matters"
   ]
  },
  {
   "id": "cse_pres_1_0",
   "x": 757,
   "y": 676,
   "w": 330,
   "h": 114,
   "kind": "cse_w",
   "title": "cases",
   "lines": [
    "• 3, no past seizures, convulsing 10 min → status",
    "• 2-day newborn: lip smacking, eye deviation, apnea, not stopped by 2 lorazepam, glucose normal → PHENOBARBITAL"
   ]
  },
  {
   "id": "sfs_inv_0_0",
   "x": 45,
   "y": 830,
   "w": 330,
   "h": 150,
   "kind": "sfs_w",
   "title": "Often NO further workup",
   "lines": [
    "if back to baseline, no other concern"
   ]
  },
  {
   "id": "cfs_inv_0_0",
   "x": 387,
   "y": 830,
   "w": 330,
   "h": 150,
   "kind": "cfs_w",
   "title": "Observe or admit",
   "lines": [
    "by time back to baseline, neurologic signs, family comfort"
   ]
  },
  {
   "id": "cse_inv_0_0",
   "x": 757,
   "y": 830,
   "w": 330,
   "h": 150,
   "kind": "cse_w",
   "title": "Stepwise, by the differential",
   "lines": [
    "• calcium, magnesium, drug levels",
    "• infection: blood count, CRP, cultures, CSF if stable",
    "• head CT: head injury, focal signs, raised pressure (pupils, high BP + slow pulse, vomiting, lethargy)",
    "• EEG: subtle or non-convulsive",
    "• MRI once stable: structure"
   ]
  },
  {
   "id": "sfs_tx_0_0",
   "x": 45,
   "y": 1020,
   "w": 330,
   "h": 350,
   "kind": "ok",
   "title": "Discharge + reassure",
   "lines": [
    "• recurrence 30-40%",
    "• epilepsy risk < 2%"
   ]
  },
  {
   "id": "cfs_tx_0_0",
   "x": 387,
   "y": 1020,
   "w": 330,
   "h": 350,
   "kind": "warn",
   "title": "Consider NEUROLOGY referral",
   "lines": [
    "counsel: can recur and become epilepsy"
   ]
  },
  {
   "id": "cse_tx_0_0",
   "x": 757,
   "y": 1020,
   "w": 330,
   "h": 132,
   "kind": "ok",
   "title": "1 · BENZODIAZEPINE",
   "lines": [
    "• IV lorazepam or midazolam",
    "• no IV access: sublingual lorazepam or intranasal midazolam",
    "• repeat every 3-5 min, 2-3 doses",
    "• watch: breathing, airway, low BP"
   ]
  },
  {
   "id": "cse_tx_1_0",
   "x": 757,
   "y": 1174,
   "w": 330,
   "h": 114,
   "kind": "warn",
   "title": "2 · Second-line IV load",
   "lines": [
    "~given over 20-30 minutes",
    "• LEVETIRACETAM (most used)",
    "• PHENOBARBITAL if < 30 days old",
    "• or phenytoin / fosphenytoin"
   ]
  },
  {
   "id": "cse_tx_2_0",
   "x": 757,
   "y": 1310,
   "w": 330,
   "h": 60,
   "kind": "bad",
   "title": "3 · Refractory → ICU",
   "lines": [
    "benzodiazepine infusion · ketamine"
   ]
  },
