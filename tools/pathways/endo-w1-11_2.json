 "nodes": [
  {
   "id": "root",
   "x": 197,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Diabetes in pregnancy: was the glucose high BEFORE organogenesis?",
   "lines": [
    "organogenesis runs weeks 3–16, often before she knows she is pregnant",
    "glucose goals for EVERY one: fasting < 5.3 · 1 h after meals < 7.8 mmol/L"
   ]
  },
  {
   "id": "g_pre",
   "x": 45,
   "y": 138,
   "w": 512,
   "h": 60,
   "kind": "plain",
   "title": "BEFORE conception: type 1 or type 2",
   "lines": [
    "high glucose in organogenesis → MALFORMATIONS"
   ]
  },
  {
   "id": "g_gdm",
   "x": 597,
   "y": 138,
   "w": 512,
   "h": 60,
   "kind": "plain",
   "title": "Found at 24–28 weeks: SCREEN every pregnancy",
   "lines": [
    "starts AFTER organogenesis → NO malformations"
   ]
  },
  {
   "id": "p_screen",
   "x": 597,
   "y": 238,
   "w": 512,
   "h": 96,
   "kind": "info",
   "title": "Screen in order",
   "lines": [
    "1 · 50 g glucose, any time of day, 1 h: < 7.8 normal, stop · ≥ 11.1 = gestational diabetes (GDM)",
    "2 · 7.8–11.0 → FASTING 75 g test: GDM if ANY of fasting ≥ 5.3, 1 h ≥ 10.6, 2 h ≥ 9.0"
   ]
  },
  {
   "id": "plan_head_0_0",
   "x": 45,
   "y": 414,
   "w": 250,
   "h": 78,
   "kind": "plan_h",
   "title": "Before conception",
   "lines": [
    "the glycated hemoglobin (A1c) at conception sets the malformation risk"
   ]
  },
  {
   "id": "preg_head_0_0",
   "x": 307,
   "y": 414,
   "w": 250,
   "h": 78,
   "kind": "preg_h",
   "title": "Pregnant with type 1 or 2",
   "lines": [
    "follow closely: endocrinology + obstetrics (timing of delivery)"
   ]
  },
  {
   "id": "gdm_head_0_0",
   "x": 597,
   "y": 414,
   "w": 250,
   "h": 78,
   "kind": "gdm_h",
   "title": "Gestational diabetes (GDM)",
   "lines": [
    "weight + placental hormones → insulin resistance"
   ]
  },
  {
   "id": "true_head_0_0",
   "x": 859,
   "y": 414,
   "w": 250,
   "h": 78,
   "kind": "true_h",
   "title": "It was TYPE 2 all along",
   "lines": [
    "less often early type 1"
   ]
  },
  {
   "id": "plan_risk_0_0",
   "x": 45,
   "y": 532,
   "w": 250,
   "h": 132,
   "kind": "plan_t",
   "title": "Malformations",
   "lines": [
    "• neural tube, caudal regression",
    "• heart: transposition, coarctation, atrial septal defect",
    "• gut atresias · kidney agenesis, double ureters"
   ]
  },
  {
   "id": "preg_risk_0_0",
   "x": 307,
   "y": 532,
   "w": 250,
   "h": 132,
   "kind": "preg_t",
   "title": "Mother and baby",
   "lines": [
    "• pre-eclampsia ×2",
    "• retinopathy, nephropathy WORSEN",
    "• big baby, newborn LOW glucose"
   ]
  },
  {
   "id": "gdm_risk_0_0",
   "x": 597,
   "y": 532,
   "w": 250,
   "h": 132,
   "kind": "gdm_t",
   "title": "Mother and baby",
   "lines": [
    "• baby > 4 kg: shoulder dystocia, brachial plexus injury",
    "• stillbirth · newborn low glucose, calcium",
    "• hypertension, induction, cesarean"
   ]
  },
  {
   "id": "true_risk_0_0",
   "x": 859,
   "y": 532,
   "w": 250,
   "h": 132,
   "kind": "true_t",
   "title": "Hint in pregnancy",
   "lines": [
    "glucose or insulin doses unusually HIGH"
   ]
  },
  {
   "id": "plan_inv_0_0",
   "x": 45,
   "y": 704,
   "w": 250,
   "h": 70,
   "kind": "plan_t",
   "title": "1 · A1c ≤ 7%",
   "lines": [
    "≤ 6.5% even better"
   ]
  },
  {
   "id": "plan_inv_1_0",
   "x": 45,
   "y": 796,
   "w": 250,
   "h": 70,
   "kind": "plan_w",
   "title": "2 · Screen for retinopathy",
   "lines": [
    "found now → laser before pregnancy"
   ]
  },
  {
   "id": "preg_inv_0_0",
   "x": 307,
   "y": 704,
   "w": 250,
   "h": 60,
   "kind": "preg_t",
   "title": "1 · A1c monthly: < 6.5%",
   "lines": [
    "without serious lows"
   ]
  },
  {
   "id": "preg_inv_1_0",
   "x": 307,
   "y": 786,
   "w": 250,
   "h": 80,
   "kind": "preg_w",
   "title": "2 · Eyes: during + within a year after",
   "lines": [
    "usually settles after delivery"
   ]
  },
  {
   "id": "gdm_inv_0_0",
   "x": 597,
   "y": 704,
   "w": 250,
   "h": 79,
   "kind": "gdm_t",
   "title": "1 · Home glucose",
   "lines": [
    "fasting + 1 h after each meal"
   ]
  },
  {
   "id": "gdm_inv_1_0",
   "x": 597,
   "y": 805,
   "w": 250,
   "h": 61,
   "kind": "gdm_w",
   "title": "A1c: NOT used",
   "lines": []
  },
  {
   "id": "true_inv_0_0",
   "x": 859,
   "y": 704,
   "w": 250,
   "h": 162,
   "kind": "bad",
   "title": "Glucose does NOT return to normal",
   "lines": [
    "on the 75 g test after delivery"
   ]
  },
  {
   "id": "plan_tx_0_0",
   "x": 45,
   "y": 906,
   "w": 250,
   "h": 332,
   "kind": "ok",
   "title": "Conceive only when controlled",
   "lines": [
    "• folic acid",
    "• blood pressure drugs safe for a baby: see the HYPERTENSION IN PREGNANCY chart"
   ]
  },
  {
   "id": "preg_tx_0_0",
   "x": 307,
   "y": 906,
   "w": 250,
   "h": 332,
   "kind": "warn",
   "title": "Insulin needs follow the placenta",
   "lines": [
    "• 1st trimester ↓: LOWS",
    "• 2nd ↑ slowly · 3rd ↑↑ (most in type 2)",
    "• after delivery ↓↓: lows while breastfeeding"
   ]
  },
  {
   "id": "gdm_tx_0_0",
   "x": 597,
   "y": 906,
   "w": 250,
   "h": 96,
   "kind": "ok",
   "title": "1 · Diet + walk",
   "lines": [
    "• 3 meals of 45 g, 3 snacks of 20 g carbohydrate",
    "• 10 min walk after meals"
   ]
  },
  {
   "id": "gdm_tx_1_0",
   "x": 597,
   "y": 1024,
   "w": 250,
   "h": 114,
   "kind": "ok",
   "title": "2 · Above goal → INSULIN",
   "lines": [
    "• the gold standard",
    "• metformin: safe but weak",
    "• glyburide crosses the placenta: newborn lows"
   ]
  },
  {
   "id": "gdm_tx_2_0",
   "x": 597,
   "y": 1160,
   "w": 250,
   "h": 78,
   "kind": "warn",
   "title": "3 · STOP all at delivery",
   "lines": [
    "• 75 g test 6 weeks–6 months after",
    "• up to 60% get type 2 later"
   ]
  },
  {
   "id": "true_tx_0_0",
   "x": 859,
   "y": 906,
   "w": 250,
   "h": 332,
   "kind": "ok",
   "title": "Treat as diabetes",
