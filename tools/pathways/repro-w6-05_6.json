   "y": 260,
   "w": 232,
   "h": 98,
   "kind": "cs_h",
   "title": "Cesarean section",
   "lines": [
    "the big four = 70% of C/S"
   ]
  },
  {
   "id": "tol_head_0_0",
   "x": 1077,
   "y": 260,
   "w": 232,
   "h": 98,
   "kind": "tol_h",
   "title": "Trial of labour after C/S (TOLAC)",
   "lines": [
    "success = vaginal birth after C/S (VBAC), 60–80%"
   ]
  },
  {
   "id": "pph_head_0_0",
   "x": 1349,
   "y": 260,
   "w": 232,
   "h": 98,
   "kind": "pph_h",
   "title": "Postpartum hemorrhage (PPH)",
   "lines": [
    "> 500 mL vaginal, > 1000 mL at C/S",
    "or ANY loss making her unstable"
   ]
  },
  {
   "id": "ind_when_0_0",
   "x": 45,
   "y": 398,
   "w": 232,
   "h": 196,
   "kind": "ind_t",
   "title": "Mother or fetus at ↑ risk",
   "lines": [
    "• post dates",
    "• preeclampsia, diabetes, growth restriction",
    "• low risk at 39 weeks: fewer C/S"
   ]
  },
  {
   "id": "dys_when_0_0",
   "x": 289,
   "y": 398,
   "w": 232,
   "h": 196,
   "kind": "dys_t",
   "title": "Slow progress",
   "lines": [
    "• slow dilatation: failure to progress",
    "• slow descent: failure to descend"
   ]
  },
  {
   "id": "opv_when_0_0",
   "x": 561,
   "y": 398,
   "w": 232,
   "h": 196,
   "kind": "opv_t",
   "title": "Indications",
   "lines": [
    "• atypical or abnormal fetal heart rate (FHR): #1",
    "• prolonged 2nd stage or exhaustion",
    "• must not strain: heart, brain vessels"
   ]
  },
  {
   "id": "cs_when_0_0",
   "x": 805,
   "y": 398,
   "w": 232,
   "h": 78,
   "kind": "cs_t",
   "title": "Labour fails",
   "lines": [
    "• dystocia",
    "• atypical or abnormal FHR"
   ]
  },
  {
   "id": "cs_when_1_0",
   "x": 805,
   "y": 498,
   "w": 232,
   "h": 96,
   "kind": "cs_t",
   "title": "Should not labour",
   "lines": [
    "• previous C/S",
    "• breech or transverse",
    "• previa, herpes, HIV, twins"
   ]
  },
  {
   "id": "tol_when_0_0",
   "x": 1077,
   "y": 398,
   "w": 232,
   "h": 196,
   "kind": "ok",
   "title": "OFFER if ALL of these",
   "lines": [
    "• 1–2 prior low transverse C/S",
    "• > 18 months since",
    "• laparotomy possible within 30 min"
   ]
  },
  {
   "id": "pph_when_0_0",
   "x": 1349,
   "y": 398,
   "w": 232,
   "h": 196,
   "kind": "pph_t",
   "title": "4 T's: TONE (atony) is #1",
   "lines": [
    "• tissue: retained placenta, membranes",
    "• trauma: tears, rupture, inversion",
    "• thrombin: clotting failure"
   ]
  },
  {
   "id": "ind_check_0_0",
   "x": 45,
   "y": 634,
   "w": 232,
   "h": 105,
   "kind": "ind_w",
   "title": "1 · No contraindication to labour",
   "lines": [
    "see the panel ↓"
   ]
  },
  {
   "id": "ind_check_1_0",
   "x": 45,
   "y": 761,
   "w": 232,
   "h": 123,
   "kind": "ind_t",
   "title": "2 · Bishop score of the cervix",
   "lines": [
    "• < 6 unfavourable: RIPEN first",
    "• > 6 favourable: straight to step 2"
   ]
  },
  {
   "id": "dys_check_0_0",
   "x": 289,
   "y": 634,
   "w": 232,
   "h": 250,
   "kind": "dys_w",
   "title": "Which of the 4 P's? Fix what you can",
   "lines": [
    "• Power, Psyche (support): yes",
    "• Passenger: position, presentation",
    "• Passage (bony pelvis): never"
   ]
  },
  {
   "id": "opv_check_0_0",
   "x": 561,
   "y": 634,
   "w": 232,
   "h": 250,
   "kind": "bad",
   "title": "NO instrument if ANY → C/S",
   "lines": [
    "• head not engaged",
    "• cervix not fully dilated",
    "• not vertex, or CPD"
   ]
  },
  {
   "id": "cs_check_0_0",
   "x": 805,
   "y": 634,
   "w": 232,
   "h": 250,
   "kind": "cs_w",
   "title": "Uterine incision",
   "lines": [
    "• low transverse: standard, later labour OK",
    "• classical or T: NO labour ever after"
   ]
  },
  {
   "id": "tol_check_0_0",
   "x": 1077,
   "y": 634,
   "w": 232,
   "h": 114,
   "kind": "bad",
   "title": "Repeat C/S if ANY",
   "lines": [
    "• classical or inverted-T scar",
    "• uterine cavity entered, or past rupture",
    "• she prefers a repeat C/S"
   ]
  },
  {
   "id": "tol_check_1_0",
   "x": 1077,
   "y": 770,
   "w": 232,
   "h": 114,
   "kind": "tol_w",
   "title": "Odds of a VBAC",
   "lines": [
    "• ↑ prior vaginal birth; last C/S for breech",
    "• ↓ last C/S for dystocia; needs induction"
   ]
  },
  {
   "id": "pph_check_0_0",
   "x": 1349,
   "y": 634,
   "w": 232,
   "h": 114,
   "kind": "pph_w",
   "title": "1 · ABCs + get help",
   "lines": [
    "bimanual exam, fundal massage, empty the bladder"
   ]
  },
  {
   "id": "pph_check_1_0",
   "x": 1349,
   "y": 770,
   "w": 232,
   "h": 114,
   "kind": "pph_w",
   "title": "2 · Uterus FIRM?",
   "lines": [
    "→ look for vaginal, cervical TEARS",
    "soft → uterotonics ↓"
   ]
  },
  {
   "id": "ind_do_0_0",
   "x": 45,
   "y": 924,
   "w": 232,
   "h": 133,
   "kind": "ok",
   "title": "1 · Ripen the cervix to ~2 cm",
   "lines": [
    "• prostaglandins: Cervidil, Prostin gel, misoprostol",
    "• mechanical: Foley catheter balloon"
   ]
  },
  {
   "id": "ind_do_1_0",
   "x": 45,
   "y": 1079,
   "w": 232,
   "h": 117,
   "kind": "ok",
   "title": "2 · Artificial rupture of membranes (ARM)",
   "lines": [
    "may start labour on its own"
   ]
  },
  {
   "id": "ind_do_2_0",
   "x": 45,
   "y": 1218,
   "w": 232,
   "h": 97,
   "kind": "ok",
   "title": "3 · IV oxytocin",
   "lines": [
    "if contractions do not start"
   ]
  },
  {
   "id": "dys_do_0_0",
   "x": 289,
   "y": 924,
   "w": 232,
   "h": 147,
   "kind": "ok",
   "title": "Power: 1 · ARM → 2 · IV oxytocin",
   "lines": [
    "titrate to contractions + cervical change",
    "~can't track them? intrauterine pressure catheter"
   ]
  },
  {
   "id": "dys_do_1_0",
   "x": 289,
   "y": 1093,
   "w": 232,
   "h": 127,
   "kind": "ok",
   "title": "Passenger + Psyche",
   "lines": [
    "• rotate to occiput anterior",
    "• breech: external cephalic version, before labour",
    "• continuous support in labour"
   ]
  },
  {
   "id": "dys_do_2_0",
   "x": 289,
   "y": 1242,
   "w": 232,
   "h": 73,
   "kind": "bad",
   "title": "Too big to fit → C/S",
   "lines": [
    "cephalopelvic disproportion (CPD)"
   ]
  },
  {
   "id": "opv_do_0_0",
   "x": 561,
   "y": 924,
   "w": 232,
   "h": 194,
   "kind": "ok",
   "title": "Vacuum: traction only",
   "lines": [
    "• rotation > 45° → NOT vacuum",
    "• stop: 3 contractions, 3 pop-offs, 20 min"
   ]
  },
  {
   "id": "opv_do_1_0",
   "x": 561,
   "y": 1140,
   "w": 232,
   "h": 176,
   "kind": "ok",
   "title": "Forceps: can also ROTATE",
   "lines": [
    "stop: can't apply, no descent, 20 min"
   ]
  },
  {
   "id": "cs_do_0_0",
   "x": 805,
   "y": 924,
   "w": 232,
   "h": 167,
   "kind": "ok",
   "title": "Give antibiotics",
   "lines": [
    "endometritis 4–5%, 35–40% without"
   ]
  },
  {
   "id": "cs_do_1_0",
   "x": 805,
   "y": 1113,
   "w": 232,
   "h": 203,
   "kind": "warn",
   "title": "Risks to plan for",
   "lines": [
    "• clots: 4× a vaginal birth",
    "• next pregnancy: previa 2–3×, accreta 5×"
   ]
  },
  {
   "id": "tol_do_0_0",
   "x": 1077,
   "y": 924,
   "w": 232,
   "h": 392,
   "kind": "bad",
   "title": "Labour, WATCHING for uterine RUPTURE (0.1%)",
   "lines": [
    "• atypical or abnormal FHR comes FIRST",
    "• contractions stop, presenting part lost",
    "• pain, bleeding, mother unstable"
   ]
  },
  {
   "id": "pph_do_0_0",
   "x": 1349,
   "y": 924,
   "w": 232,
   "h": 80,
   "kind": "ok",
   "title": "Stage 1 (500–1000 mL): oxytocin",
   "lines": [
    "first-line uterotonic"
   ]
  },
  {
   "id": "pph_do_1_0",
   "x": 1349,
   "y": 1026,
   "w": 232,
   "h": 134,
   "kind": "warn",
   "title": "Stage 2 (1000–1500 mL, pulse > 110)",
   "lines": [
    "• ergonovine (NOT hypertension) or carboprost (NOT asthma)",
    "• + tranexamic acid 1 g IV",
    "• look for the other T's"
   ]
  },
  {
   "id": "pph_do_2_0",
   "x": 1349,
   "y": 1182,
   "w": 232,
   "h": 134,
   "kind": "bad",
   "title": "Stage 3 (> 1500 mL, systolic < 80)",
   "lines": [
    "• full resuscitation: see HEMORRHAGIC SHOCK chart",
    "• still bleeding: tamponade, embolization, surgery"
   ]
  }
