   "h": 152,
   "kind": "dys_h",
   "title": "Labour dystocia",
   "lines": [
    "abnormally SLOW labour",
    "the #1 reason cited for C/S",
    "NOT shoulder dystocia: shoulder stuck behind the pubic bone, an EMERGENCY"
   ]
  },
  {
   "id": "opv_head_0_0",
   "x": 561,
   "y": 278,
   "w": 232,
   "h": 152,
   "kind": "opv_h",
   "title": "Forceps or vacuum",
   "lines": [
    "speeds up the 2nd stage"
   ]
  },
  {
   "id": "cs_head_0_0",
   "x": 805,
   "y": 278,
   "w": 232,
   "h": 152,
   "kind": "cs_h",
   "title": "Cesarean section",
   "lines": [
    "the big four = 70% of C/S",
    "1 dystocia · 2 FHR · 3 previous C/S · 4 breech, transverse"
   ]
  },
  {
   "id": "tol_head_0_0",
   "x": 1077,
   "y": 278,
   "w": 232,
   "h": 152,
   "kind": "tol_h",
   "title": "Trial of labour after C/S (TOLAC)",
   "lines": [
    "success = vaginal birth after C/S (VBAC), 60–80%"
   ]
  },
  {
   "id": "pph_head_0_0",
   "x": 1349,
   "y": 278,
   "w": 232,
   "h": 152,
   "kind": "pph_h",
   "title": "Postpartum hemorrhage (PPH)",
   "lines": [
    "> 500 mL vaginal, > 1000 mL at C/S",
    "or ANY loss making her unstable",
    "early < 24 h · late 24 h to 12 weeks",
    "Canada 5.6 per 100 · 60% have risk factors beforehand"
   ]
  },
  {
   "id": "ind_when_0_0",
   "x": 45,
   "y": 470,
   "w": 232,
   "h": 150,
   "kind": "ind_t",
   "title": "Mother or fetus at ↑ risk",
   "lines": [
    "• post dates",
    "• preeclampsia, diabetes, growth restriction",
    "• low risk at 39 weeks (ARRIVE): fewer C/S, less preeclampsia, fewer stillbirths"
   ]
  },
  {
   "id": "ind_when_1_0",
   "x": 45,
   "y": 642,
   "w": 232,
   "h": 186,
   "kind": "ind_w",
   "title": "Other indications",
   "lines": [
    "• prelabour rupture of membranes · abruption · twins",
    "• oligohydramnios · cholestasis of pregnancy",
    "• alloimmunization with fetal anemia · fetal demise",
    "• maternal cardiac, respiratory, renal, blood disease"
   ]
  },
  {
   "id": "dys_when_0_0",
   "x": 289,
   "y": 470,
   "w": 232,
   "h": 358,
   "kind": "dys_t",
   "title": "Slow progress",
   "lines": [
    "• slow dilatation: failure to progress",
    "• slow descent: failure to descend"
   ]
  },
  {
   "id": "opv_when_0_0",
   "x": 561,
   "y": 470,
   "w": 232,
   "h": 358,
   "kind": "opv_t",
   "title": "Indications",
   "lines": [
    "• atypical or abnormal fetal heart rate (FHR): #1",
    "• prolonged 2nd stage or exhaustion",
    "• malposition: occiput transverse or posterior",
    "• must not strain: heart, brain vessels"
   ]
  },
  {
   "id": "cs_when_0_0",
   "x": 805,
   "y": 470,
   "w": 232,
   "h": 123,
   "kind": "cs_t",
   "title": "Labour fails",
   "lines": [
    "• dystocia",
    "• atypical or abnormal FHR"
   ]
  },
  {
   "id": "cs_when_1_0",
   "x": 805,
   "y": 615,
   "w": 232,
   "h": 213,
   "kind": "cs_t",
   "title": "Should not labour",
   "lines": [
    "• previous C/S",
    "• breech or transverse",
    "• previa, vasa previa, accreta spectrum",
    "• obstruction: fibroid, mass",
    "• herpes, HIV · twins · cervical cancer · fetal anomalies"
   ]
  },
  {
   "id": "tol_when_0_0",
   "x": 1077,
   "y": 470,
   "w": 232,
   "h": 358,
   "kind": "ok",
   "title": "OFFER if ALL of these",
   "lines": [
    "• 1–2 prior low transverse C/S",
    "• > 18 months since",
    "• laparotomy possible within 30 min",
    "• normal pelvis · no contraindication to labour · she consents"
   ]
  },
  {
   "id": "pph_when_0_0",
   "x": 1349,
   "y": 470,
   "w": 232,
   "h": 358,
   "kind": "pph_t",
   "title": "4 T's: TONE (atony) is #1",
   "lines": [
    "• tone: overdistension (twins, polyhydramnios, macrosomia), long or fast labour, long oxytocin, infection, fibroids, previa",
    "• tissue: retained placenta, membranes, clots",
    "• trauma: tears, hematoma, rupture, inversion (excess cord traction)",
    "• thrombin: von Willebrand, DIC, HELLP, fetal demise, amniotic fluid embolism, anticoagulants"
   ]
  },
  {
   "id": "ind_check_0_0",
   "x": 45,
   "y": 868,
   "w": 232,
   "h": 80,
   "kind": "ind_w",
   "title": "1 · No contraindication to labour",
   "lines": [
    "see the panel ↓"
   ]
  },
  {
   "id": "ind_check_1_0",
   "x": 45,
   "y": 970,
   "w": 232,
   "h": 242,
   "kind": "ind_t",
   "title": "2 · Pre-induction assessment",
   "lines": [
    "• confirm dates · fetal position · estimated weight · consent",
    "• Bishop score: dilation, effacement, position, station",
    "• < 6 unfavourable: RIPEN first",
    "• > 6 favourable: straight to step 2 · shorter, more vaginal births",
    "• also ↑ success: multiparity, ruptured membranes, lower BMI, taller, smaller baby"
   ]
  },
  {
   "id": "dys_check_0_0",
   "x": 289,
   "y": 868,
   "w": 232,
   "h": 344,
   "kind": "dys_w",
   "title": "Which of the 4 P's? Fix what you can",
   "lines": [
    "• Power, Psyche (support): yes",
    "• Passenger: position, presentation",
    "• Passage (bony pelvis): never"
   ]
  },
  {
   "id": "opv_check_0_0",
   "x": 561,
   "y": 868,
   "w": 232,
   "h": 170,
   "kind": "bad",
   "title": "NO instrument if ANY → C/S",
   "lines": [
    "• head not engaged",
    "• cervix not fully dilated",
    "• not vertex (face, brow), or CPD",
    "• fetal clotting or bone-mineral disorder"
   ]
  },
  {
   "id": "opv_check_1_0",
   "x": 561,
   "y": 1060,
   "w": 232,
   "h": 152,
   "kind": "opv_w",
   "title": "Relative: think twice",
   "lines": [
    "• unfavourable head attitude · mid-pelvic station",
    "• prematurity · rotation > 45° (vacuum only)"
   ]
  },
  {
   "id": "cs_check_0_0",
   "x": 805,
   "y": 868,
   "w": 232,
   "h": 152,
   "kind": "cs_w",
   "title": "Uterine incision",
   "lines": [
    "• low transverse: standard, later labour OK",
    "• classical or T: NO labour ever after"
   ]
  },
  {
   "id": "cs_check_1_0",
   "x": 805,
   "y": 1042,
   "w": 232,
   "h": 170,
   "kind": "cs_t",
   "title": "Skin incision",
   "lines": [
    "• Pfannenstiel (low transverse): standard, cosmetic",
    "• vertical midline: crash, old scar, obesity, bleeding disorder"
   ]
  },
  {
   "id": "tol_check_0_0",
   "x": 1077,
   "y": 868,
   "w": 232,
   "h": 134,
   "kind": "bad",
   "title": "Repeat C/S if ANY",
   "lines": [
    "• classical or inverted-T scar",
    "• uterine cavity entered, or past rupture",
    "• she prefers a repeat C/S"
   ]
  },
  {
   "id": "tol_check_1_0",
   "x": 1077,
   "y": 1024,
   "w": 232,
   "h": 188,
   "kind": "tol_w",
   "title": "Odds of a VBAC",
   "lines": [
    "• ↑ prior VBAC or vaginal birth · favourable cervix · spontaneous labour · last C/S for breech · age < 40",
    "• ↓ last C/S for dystocia · induction or augmentation · > 40 weeks · > 4000 g · BMI > 30 · hypertension"
   ]
  },
  {
   "id": "pph_check_0_0",
   "x": 1349,
   "y": 868,
   "w": 232,
   "h": 188,
   "kind": "pph_w",
   "title": "1 · ABCs + get help",
   "lines": [
    "• ORDER: oxygenate, restore volume, drugs, evaluate, remedy the cause",
    "• bimanual exam, fundal massage, empty the bladder (Foley)"
   ]
  },
  {
   "id": "pph_check_1_0",
   "x": 1349,
   "y": 1078,
   "w": 232,
   "h": 134,
   "kind": "pph_w",
   "title": "2 · Uterus FIRM?",
   "lines": [
    "→ look for vaginal, cervical TEARS",
    "soft → uterotonics ↓"
   ]
  },
  {
   "id": "ind_do_0_0",
   "x": 45,
   "y": 1252,
   "w": 232,
   "h": 203,
   "kind": "ok",
   "title": "1 · Ripen the cervix to ~2 cm",
   "lines": [
    "• prostaglandins: Cervidil, Prostin gel, misoprostol",
    "• mechanical: Foley catheter balloon"
   ]
  },
  {
   "id": "ind_do_1_0",
   "x": 45,
   "y": 1477,
   "w": 232,
   "h": 187,
   "kind": "ok",
   "title": "2 · Artificial rupture of membranes (ARM)",
   "lines": [
    "may start labour on its own"
   ]
  },
  {
   "id": "ind_do_2_0",
   "x": 45,
   "y": 1686,
   "w": 232,
   "h": 167,
   "kind": "ok",
   "title": "3 · IV oxytocin",
   "lines": [
    "if contractions do not start"
   ]
  },
  {
   "id": "dys_do_0_0",
   "x": 289,
   "y": 1252,
   "w": 232,
   "h": 217,
   "kind": "ok",
   "title": "Power: 1 · ARM → 2 · IV oxytocin",
   "lines": [
    "titrate to contractions + cervical change",
    "~can't track them? intrauterine pressure catheter",
    "pushing: oxytocin, coaching, analgesia"
   ]
  },
  {
   "id": "dys_do_1_0",
   "x": 289,
   "y": 1491,
   "w": 232,
   "h": 233,
   "kind": "ok",
   "title": "Passenger + Psyche",
   "lines": [
    "• rotate to occiput anterior",
    "• breech: external cephalic version, before labour",
    "• big baby: consider induction",
    "• continuous support: ↑ spontaneous vaginal birth",
    "• pain control as she wishes, not an epidural for all"
   ]
  },
  {
   "id": "dys_do_2_0",
   "x": 289,
   "y": 1746,
   "w": 232,
   "h": 107,
   "kind": "bad",
   "title": "Too big to fit → C/S",
   "lines": [
    "cephalopelvic disproportion (CPD)"
   ]
  },
  {
   "id": "opv_do_0_0",
   "x": 561,
   "y": 1252,
   "w": 232,
   "h": 143,
   "kind": "ok",
   "title": "Vacuum: traction only",
   "lines": [
    "• rotation > 45° → NOT vacuum",
    "• stop: 3 contractions, 3 pop-offs, 20 min"
   ]
  },
  {
   "id": "opv_do_1_0",
   "x": 561,
   "y": 1417,
   "w": 232,
   "h": 125,
   "kind": "ok",
   "title": "Forceps: can also ROTATE",
   "lines": [
    "stop: can't apply, no descent, 20 min"
   ]
  },
  {
   "id": "opv_do_2_0",
   "x": 561,
   "y": 1564,
   "w": 232,
   "h": 287,
   "kind": "warn",
   "title": "Complications",
   "lines": [
    "• vacuum: cephalohematoma, SUBGALEAL bleed, jaundice, retinal + brain bleeds, Erb's palsy",
    "• forceps: MORE maternal tears, facial nerve palsy, eye trauma",
    "• forceps: facial cuts 1%, cephalohematoma 1%, brain bleed 0.1%",
    "• subgaleal spreads · cephalohematoma stops at sutures"
   ]
  },
  {
   "id": "cs_do_0_0",
   "x": 805,
   "y": 1252,
   "w": 232,
   "h": 235,
   "kind": "ok",
   "title": "Give antibiotics",
   "lines": [
    "• endometritis 4–5%, 35–40% without",
    "• wound infection 2.5–16%"
   ]
  },
  {
   "id": "cs_do_1_0",
   "x": 805,
   "y": 1509,
   "w": 232,
   "h": 343,
   "kind": "warn",
   "title": "Risks to plan for",
   "lines": [
    "• clots: 4× a vaginal birth",
    "• blood loss 800–1000 mL · 1–2% transfused",
    "• bladder injury ~1% · bowel, ureter, nerve, vessel injury",
    "• death 0.53 vs 0.04 per 1000 vaginal",
    "• next pregnancy: previa 2–3×, accreta 5×"
   ]
  },
  {
   "id": "tol_do_0_0",
   "x": 1077,
   "y": 1252,
   "w": 232,
   "h": 344,
   "kind": "bad",
   "title": "Labour, WATCHING for uterine RUPTURE (0.1%)",
   "lines": [
    "• scar separation 0.5% · true rupture 0.1%",
    "• atypical or abnormal FHR comes FIRST",
    "• contractions stop, presenting part lost",
    "• pain, bleeding, hematuria, fetal parts palpable, mother unstable",
    "• ↑ risk: more scars, short interval, induction, macrosomia, dystocia"
   ]
  },
  {
   "id": "tol_do_1_0",
   "x": 1077,
   "y": 1618,
   "w": 232,
   "h": 234,
   "kind": "ok",
   "title": "VBAC benefits",
   "lines": [
    "• shorter stay · less pain, blood loss, VTE, infection",
    "• fewer neonatal breathing problems",
    "• less previa, accreta, hysterectomy next time"
   ]
  },
  {
   "id": "pph_do_0_0",
   "x": 1349,
   "y": 1252,
   "w": 232,
   "h": 80,
   "kind": "ok",
   "title": "Stage 1 (500–1000 mL): oxytocin",
   "lines": [
    "first-line uterotonic"
   ]
  },
  {
   "id": "pph_do_1_0",
   "x": 1349,
   "y": 1354,
   "w": 232,
   "h": 134,
   "kind": "warn",
   "title": "Stage 2 (1000–1500 mL, pulse > 110)",
   "lines": [
    "• ergonovine (NOT hypertension) or carboprost (NOT asthma)",
    "• + tranexamic acid 1 g IV",
    "• look for the other T's"
   ]
  },
  {
   "id": "pph_do_2_0",
   "x": 1349,
   "y": 1510,
   "w": 232,
   "h": 170,
   "kind": "bad",
   "title": "Stage 3 (> 1500 mL, systolic < 80)",
   "lines": [
    "• full resuscitation: see HEMORRHAGIC SHOCK chart",
    "• still bleeding: Bakri balloon or packing, compression sutures, artery ligation or embolization, hysterectomy"
   ]
  },
  {
