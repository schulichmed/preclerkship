   "title": "Labour is not going to plan: which fix, in what order?",
   "lines": [
    "reach for them in this order: induce or augment → forceps or vacuum → cesarean section (C/S)",
    "the 4 P's: Power (contractions, pushing) · Passage (bony pelvis) · Passenger (presentation, position, size) · Psyche (support)"
   ]
  },
  {
   "id": "g_go",
   "x": 45,
   "y": 138,
   "w": 476,
   "h": 60,
   "kind": "plain",
   "title": "Labour must START or SPEED UP",
   "lines": [
    "has it begun? is it moving?"
   ]
  },
  {
   "id": "g_out",
   "x": 561,
   "y": 138,
   "w": 476,
   "h": 60,
   "kind": "plain",
   "title": "Baby must come OUT: which route?",
   "lines": [
    "fully dilated + head engaged → instrument; if not → C/S"
   ]
  },
  {
