    "compressed in the intervertebral foramen"
   ]
  },
  {
   "id": "mono_head_0_0",
   "x": 293,
   "y": 296,
   "w": 236,
   "h": 96,
   "kind": "mono_h",
   "title": "Mononeuropathy",
   "lines": [
    "one NAMED nerve",
    "compressed at a typical site"
   ]
  },
  {
   "id": "npx_head_0_0",
   "x": 569,
   "y": 296,
   "w": 236,
   "h": 96,
   "kind": "npx_h",
   "title": "Neurapraxia",
   "lines": [
    "MYELIN only, axon intact",
    "compression"
   ]
  },
  {
   "id": "axo_head_0_0",
   "x": 817,
   "y": 296,
   "w": 236,
   "h": 96,
   "kind": "axo_h",
   "title": "Axonotmesis",
   "lines": [
    "AXON cut, EPINEURIUM intact",
    "crush, stretch"
   ]
  },
  {
   "id": "nts_head_0_0",
   "x": 1065,
   "y": 296,
   "w": 236,
   "h": 96,
