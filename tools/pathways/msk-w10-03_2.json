   "y": 845,
   "w": 236,
   "h": 79,
   "kind": "rad_w",
   "title": "Foot drop → L5",
   "lines": [
    "gluteus medius, tibialis posterior, paraspinals also abnormal"
   ]
  },
  {
   "id": "mono_tx_0_0",
