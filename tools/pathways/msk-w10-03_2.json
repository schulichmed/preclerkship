    "nerve discontinuous"
   ]
  },
  {
   "id": "rad_clue_0_0",
   "x": 45,
   "y": 432,
   "w": 236,
   "h": 134,
   "kind": "rad_t",
   "title": "Neck or back pain radiating down the limb",
   "lines": [
    "• DERMATOME, fuzzy borders",
    "• MYOTOME weakness + reflex loss",
    "• eased by taking tension off (arm overhead)"
   ]
  },
  {
   "id": "mono_clue_0_0",
   "x": 293,
   "y": 432,
   "w": 236,
   "h": 134,
   "kind": "mono_t",
   "title": "Well-circumscribed patch, CLEAR borders",
   "lines": [
    "• weak in THAT nerve's muscles only",
    "• not same-root muscles of other nerves",
    "• worse leaning, driving, typing"
   ]
  },
  {
   "id": "npx_clue_0_0",
   "x": 569,
   "y": 432,
   "w": 236,
   "h": 134,
   "kind": "npx_t",
   "title": "Conduction slowed or BLOCKED",
   "lines": [
    "e.g. Saturday night palsy"
   ]
  },
  {
   "id": "axo_clue_0_0",
   "x": 817,
   "y": 432,
   "w": 236,
   "h": 134,
   "kind": "axo_t",
   "title": "Wallerian degeneration",
   "lines": [
    "axon beyond the injury breaks down",
    "the intact tube guides regrowth"
   ]
  },
  {
   "id": "nts_clue_0_0",
   "x": 1065,
   "y": 432,
   "w": 236,
   "h": 134,
   "kind": "nts_t",
   "title": "No tube to follow",
   "lines": [
    "regrowing fibres go off course"
   ]
  },
  {
   "id": "rad_inv_0_0",
   "x": 45,
   "y": 606,
   "w": 236,
   "h": 98,
   "kind": "rad_w",
   "title": "Electromyography (EMG): one ROOT's muscles",
   "lines": [
    "• across several named nerves",
    "• paraspinals abnormal"
   ]
  },
  {
   "id": "mono_inv_0_0",
   "x": 293,
   "y": 606,
   "w": 236,
   "h": 98,
   "kind": "mono_w",
   "title": "EMG: that nerve's muscles only",
   "lines": [
    "paraspinals normal"
   ]
  },
  {
   "id": "npx_inv_0_0",
   "x": 569,
   "y": 606,
   "w": 236,
   "h": 98,
   "kind": "npx_w",
   "title": "Nerve conduction (NCS): speed ↓ (myelin)",
   "lines": [
    "EMG: no denervation at rest"
   ]
  },
  {
   "id": "axo_inv_0_0",
   "x": 817,
   "y": 606,
   "w": 236,
   "h": 98,
   "kind": "axo_w",
   "title": "NCS: size ↓ (axon)",
   "lines": [
    "EMG: denervation at rest, few or no motor units"
   ]
  },
  {
   "id": "nts_inv_0_0",
   "x": 1065,
   "y": 606,
   "w": 236,
   "h": 98,
   "kind": "nts_w",
   "title": "Looks like axonotmesis at first",
   "lines": [
    "only recovery, or none, tells them apart"
   ]
  },
  {
   "id": "rad_tx_0_0",
   "x": 45,
   "y": 744,
   "w": 236,
   "h": 79,
   "kind": "rad_w",
   "title": "Numb thumb → C6",
   "lines": [
    "C6 dermatome: lateral arm, forearm, thumb"
   ]
  },
  {
   "id": "rad_tx_1_0",
