   "kind": "dark",
   "title": "Numbness, tingling or weakness: is it a NERVE, WHERE is it, HOW BAD is it?",
   "lines": [
    "first exclude a tendon (weakness) or poor blood flow (numbness) · TRUE sensory loss is always neurogenic: central or peripheral?",
    "negative symptoms: numbness, weakness, lost reflexes · positive: pain, paresthesia (tingling)"
   ]
  },
  {
   "id": "g_where",
   "x": 45,
   "y": 156,
   "w": 484,
   "h": 60,
   "kind": "plain",
   "title": "WHERE: root or named nerve?",
   "lines": [
    "the map of the numbness and WHICH muscles are weak decide"
   ]
  },
  {
   "id": "g_bad",
   "x": 569,
   "y": 156,
   "w": 732,
   "h": 60,
   "kind": "plain",
   "title": "HOW BAD: Seddon grade",
   "lines": [
    "which layer is cut decides recovery"
   ]
  },
  {
   "id": "rad_head_0_0",
   "x": 45,
   "y": 296,
   "w": 236,
   "h": 96,
   "kind": "rad_h",
   "title": "Radiculopathy",
   "lines": [
