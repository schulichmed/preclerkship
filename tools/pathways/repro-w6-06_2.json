   "kind": "dark",
   "title": "A bleeding woman: is she in SHOCK, and what do I do first?",
   "lines": [
    "shock = tissue hypoxia; hemorrhagic: blood lost → ↓ preload → ↓ cardiac output",
    "signs: tachycardia, hypotension, oliguria, confusion, tachypnea, cool clammy skin, acidosis, ↑ lactate"
   ]
  },
  {
   "id": "g_rec",
   "x": 45,
   "y": 138,
   "w": 476,
   "h": 60,
   "kind": "plain",
   "title": "How much has she lost? Grade it from the VITALS",
   "lines": [
    "blood pressure is the LAST vital to move"
   ]
  },
  {
   "id": "g_tx",
   "x": 561,
   "y": 138,
   "w": 720,
   "h": 60,
   "kind": "plain",
   "title": "TREAT, in this order",
   "lines": [
    "call for help before anything else"
   ]
  },
  {
