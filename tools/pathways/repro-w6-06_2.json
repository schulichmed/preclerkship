   "lines": [
    "airway, breathing, circulation"
   ]
  },
  {
   "id": "res_head_0_0",
   "x": 805,
   "y": 278,
   "w": 232,
   "h": 78,
   "kind": "res_h",
   "title": "2 · Resuscitate",
   "lines": [
    "replace what she has lost"
   ]
  },
  {
   "id": "cau_head_0_0",
   "x": 1049,
   "y": 278,
   "w": 232,
   "h": 78,
   "kind": "cau_h",
   "title": "3 · Stop the bleeding",
   "lines": [
    "stop it if possible"
   ]
  },
  {
   "id": "tri_head_0_0",
   "x": 1321,
   "y": 278,
   "w": 232,
   "h": 78,
   "kind": "tri_h",
   "title": "Prevent the LETHAL TRIAD",
   "lines": [
    "acidosis, hypothermia, coagulopathy"
   ]
  },
  {
   "id": "cmp_one_0_0",
   "x": 45,
   "y": 396,
   "w": 232,
   "h": 78,
   "kind": "cmp_t",
   "title": "Pulse rises FIRST",
   "lines": [
    "• I: < 100",
    "• II: 100–120, pulse pressure ↓"
   ]
  },
  {
   "id": "cmp_one_1_0",
   "x": 45,
   "y": 496,
   "w": 232,
   "h": 98,
   "kind": "cmp_t",
   "title": "Blood pressure still NORMAL",
   "lines": [
    "• urine: I > 30, II 20–30 mL/h",
    "• slightly to mildly anxious"
   ]
  },
  {
   "id": "dec_one_0_0",
   "x": 289,
   "y": 396,
   "w": 232,
   "h": 98,
   "kind": "dec_t",
   "title": "Pulse > 120, blood pressure FALLS",
   "lines": [
    "• III: 120–140",
    "• IV: > 140"
   ]
  },
  {
   "id": "dec_one_1_0",
   "x": 289,
   "y": 516,
   "w": 232,
   "h": 78,
   "kind": "dec_t",
   "title": "Urine and mind fail",
   "lines": [
    "• III: 5–15 mL/h, anxious, confused",
    "• IV: negligible, lethargic"
   ]
  },
  {
   "id": "abc_one_0_0",
   "x": 561,
   "y": 396,
   "w": 232,
   "h": 198,
   "kind": "abc_w",
   "title": "Monitor",
   "lines": [
    "• heart rate, blood pressure, breathing, oxygen saturation",
    "• arterial or venous blood gas",
    "• Foley catheter to a urometer"
   ]
  },
  {
   "id": "res_one_0_0",
   "x": 805,
   "y": 396,
   "w": 232,
   "h": 198,
   "kind": "ok",
   "title": "2 large-bore IVs + oxygen",
   "lines": [
    "crystalloid or colloid"
   ]
  },
  {
   "id": "cau_one_0_0",
   "x": 1049,
   "y": 396,
   "w": 232,
   "h": 198,
   "kind": "ok",
   "title": "Identify and treat the cause",
   "lines": [
    "• after birth: see ABNORMAL LABOUR chart",
    "• before birth: see ANTEPARTUM HEMORRHAGE chart"
   ]
  },
  {
   "id": "tri_one_0_0",
   "x": 1321,
   "y": 396,
   "w": 232,
   "h": 97,
   "kind": "tri_t",
   "title": "Acidosis",
   "lines": [
    "• pH 7.0: factor VIIa activity ↓ 90%",
    "• keep perfusion: oxygen, fluids, red cells"
   ]
  },
  {
   "id": "tri_one_1_0",
   "x": 1321,
   "y": 515,
   "w": 232,
   "h": 79,
   "kind": "tri_t",
   "title": "Hypothermia (< 35 °C)",
   "lines": [
    "• warmed IV fluids",
    "• Bair Hugger, Level I warmer"
   ]
  },
  {
   "id": "cmp_two_0_0",
   "x": 45,
   "y": 634,
   "w": 232,
   "h": 132,
   "kind": "warn",
   "title": "Young, post-partum: LOOKS WELL",
   "lines": [
    "her pregnancy-expanded blood volume hides a large loss"
   ]
  },
  {
   "id": "dec_two_0_0",
   "x": 289,
   "y": 634,
   "w": 232,
   "h": 132,
   "kind": "bad",
   "title": "A low blood pressure is LATE",
   "lines": [
    "she has already lost 30–40% or more"
   ]
  },
  {
   "id": "abc_two_0_0",
   "x": 561,
   "y": 634,
   "w": 232,
   "h": 132,
   "kind": "abc_w",
   "title": "Send bloods",
   "lines": [
    "• complete blood count, group and screen",
    "• clotting times, fibrinogen",
    "• creatinine"
   ]
  },
  {
   "id": "res_two_0_0",
   "x": 805,
   "y": 634,
   "w": 232,
   "h": 132,
   "kind": "ok",
   "title": "Blood products",
   "lines": [
    "• packed red cells, platelets",
    "• cryoprecipitate, fresh frozen plasma",
    "• consider MASSIVE TRANSFUSION protocol"
   ]
  },
  {
   "id": "cau_two_0_0",
   "x": 1049,
   "y": 634,
   "w": 232,
   "h": 132,
   "kind": "warn",
   "title": "Intensive care if needed",
   "lines": [
    "inotropes, central lines"
   ]
  },
  {
   "id": "tri_two_0_0",
   "x": 1321,
   "y": 634,
   "w": 232,
   "h": 132,
   "kind": "tri_t",
   "title": "Coagulopathy: DILUTION",
   "lines": [
    "• worse at 10, 20, 30 units",
    "• LIMIT the blood loss"
   ]
  }
 ],
