    "workup: HEMATURIA chart"
   ]
  },
  {
   "id": "ath_clue_0_0",
   "x": 1271,
   "y": 490,
   "w": 222,
   "h": 132,
   "kind": "ath_t",
   "title": "Emboli everywhere",
   "lines": [
    "• livedo reticularis",
    "• stroke, gut ischemia"
   ]
  },
  {
   "id": "pre_inv_0_0",
   "x": 45,
   "y": 662,
   "w": 222,
   "h": 170,
   "kind": "pre_w",
   "title": "Indices: the kidney HOLDS Na",
   "lines": [
    "• urea:creatinine ≥ 20:1",
    "• urine Na < 20",
    "• urine osmolality (Osm) ≥ 500",
    "• fractional excretion of Na (FENa) < 1%",
    "• HYALINE casts are normal here"
   ]
  },
  {
   "id": "post_inv_0_0",
   "x": 307,
   "y": 662,
   "w": 222,
   "h": 170,
   "kind": "post_w",
   "title": "RENAL ULTRASOUND: hydronephrosis?",
   "lines": [
    "~a block can exist WITHOUT it"
   ]
  },
  {
   "id": "atn_inv_0_0",
   "x": 569,
   "y": 662,
   "w": 222,
   "h": 170,
   "kind": "atn_w",
   "title": "Urine: MUDDY BROWN granular casts",
   "lines": [
    "~then urine output lowest for days–weeks; recovery brings a DIURESIS"
   ]
  },
  {
   "id": "ain_inv_0_0",
   "x": 803,
   "y": 662,
   "w": 222,
   "h": 170,
   "kind": "ain_w",
