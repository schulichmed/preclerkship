   "y": 490,
   "w": 222,
   "h": 132,
   "kind": "pre_t",
   "title": "Causes",
   "lines": [
    "• volume LOSS: bleeding, vomiting, diarrhea, diuretics",
    "• heart failure, shock, sepsis",
    "• anti-inflammatories (NSAIDs), contrast, hepatorenal"
   ]
  },
  {
   "id": "post_clue_0_0",
   "x": 307,
   "y": 490,
   "w": 222,
   "h": 132,
   "kind": "post_t",
   "title": "Causes",
   "lines": [
    "• prostate: benign hyperplasia, cancer",
    "• cervical cancer, stones",
    "• strictures, retroperitoneal fibrosis"
   ]
  },
  {
   "id": "atn_clue_0_0",
   "x": 569,
   "y": 490,
   "w": 222,
   "h": 132,
   "kind": "atn_t",
   "title": "Two routes",
   "lines": [
    "• ISCHEMIC: a pre-renal cause left too long",
    "• TOXIC: contrast, aminoglycosides, cisplatin; myoglobin, myeloma light chains"
   ]
  },
  {
   "id": "ain_clue_0_0",
   "x": 803,
   "y": 490,
   "w": 222,
   "h": 132,
   "kind": "ain_t",
   "title": "Triggers",
   "lines": [
    "• DRUGS: antibiotics, NSAIDs, allopurinol",
    "• infection: group A strep, Legionella, cytomegalovirus"
   ]
  },
  {
   "id": "gn_clue_0_0",
   "x": 1037,
   "y": 490,
   "w": 222,
   "h": 132,
   "kind": "gn_t",
   "title": "Hematuria + RED CELL CASTS",
