 "nodes": [
  {
   "id": "root",
   "x": 389,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Creatinine rising fast: BEFORE the kidney, AFTER it, or the kidney ITSELF?",
   "lines": [
    "acute kidney injury (AKI) = creatinine ↑ 44 µmol/L, or > 50% over baseline, or clearance ↓ 50%",
    "rule out pre- and post-renal FIRST: the easiest · glomerular filtration rate (GFR) equations are WRONG while creatinine is changing",
    "every patient: urinalysis + renal ultrasound",
    "ANY cause: DIALYSIS NOW for AEIOU = Acidosis, Electrolytes (K ↑), Ingestion of drugs or ischemia, fluid Overload, Uremia"
   ]
  },
  {
   "id": "g_pre",
   "x": 45,
   "y": 192,
   "w": 222,
   "h": 98,
   "kind": "plain",
   "title": "PRE-RENAL: low blood flow",
   "lines": []
  },
  {
   "id": "g_post",
   "x": 307,
   "y": 192,
   "w": 222,
   "h": 98,
   "kind": "plain",
   "title": "POST-RENAL: blocked outflow",
   "lines": [
    "SUDDEN ANURIA · BOTH sides blocked, or a solitary kidney"
   ]
  },
  {
   "id": "g_ren",
   "x": 569,
   "y": 192,
   "w": 924,
   "h": 98,
   "kind": "plain",
   "title": "RENAL (intrinsic): urea:creatinine < 20:1 · urine Na ≥ 40 · urine Osm < 350 · FENa ≥ 2%",
   "lines": [
    "the history, exam and URINALYSIS point to the part of the kidney"
   ]
  },
