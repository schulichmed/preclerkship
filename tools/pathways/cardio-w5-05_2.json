 "nodes": [
  {
   "id": "root",
   "x": 119,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Atrial fibrillation (AF): irregularly irregular, no P waves. Treat EACH of its three harms",
   "lines": [
    "fibrillatory baseline waves, irregular RR intervals · risk rises after 50",
    "look for a reversible cause: hypertension, ischemic or valve disease, alcohol, thyroid, lung disease, sleep apnea",
    "PAROXYSMAL stops on its own · PERSISTENT needs drugs or cardioversion · PERMANENT: rate control only"
   ]
  },
  {
   "id": "g1",
   "x": 45,
   "y": 156,
   "w": 276,
   "h": 78,
   "kind": "plain",
   "title": "1 · STROKE",
   "lines": [
    "blood stagnates in a big left atrium and clots"
   ]
  },
  {
   "id": "g2",
   "x": 361,
   "y": 156,
   "w": 276,
   "h": 78,
   "kind": "plain",
   "title": "2 · FAST, irregular ventricular rate",
   "lines": [
    "130–170 bpm through the atrioventricular (AV) node"
   ]
  },
  {
   "id": "g3",
   "x": 677,
   "y": 156,
   "w": 276,
   "h": 78,
   "kind": "plain",
   "title": "3 · LOST atrial kick",
   "lines": [
    "less left ventricular filling, less cardiac output"
   ]
  },
  {
   "id": "ac_head_0_0",
   "x": 45,
   "y": 314,
   "w": 276,
   "h": 96,
   "kind": "ac_h",
   "title": "ANTICOAGULATE",
   "lines": [
    "for every patient with a risk factor"
   ]
  },
  {
   "id": "rc_head_0_0",
   "x": 361,
   "y": 314,
   "w": 276,
   "h": 96,
   "kind": "rc_h",
   "title": "RATE CONTROL",
   "lines": [
    "the AV node lets the ventricles race"
   ]
  },
  {
   "id": "rh_head_0_0",
   "x": 677,
   "y": 314,
   "w": 276,
   "h": 96,
   "kind": "rh_h",
   "title": "RHYTHM CONTROL",
   "lines": [
    "a judgement call: young, symptomatic, recent onset",
    "never in PERMANENT AF"
   ]
  },
