   "x": 829,
   "y": 174,
   "w": 240,
   "h": 98,
   "kind": "plain",
   "title": "HEADACHE + FEVER",
   "lines": [
    "meningitis-like"
   ]
  },
  {
   "id": "g_cm",
   "x": 1109,
   "y": 174,
   "w": 240,
   "h": 98,
   "kind": "plain",
   "title": "PROLONGED FEVER, low counts",
   "lines": [
    "HIV CD4 < 100 · transplant · chemotherapy, immunosuppressants"
   ]
  },
  {
   "id": "t_lu",
   "x": 45,
   "y": 312,
   "w": 744,
   "h": 96,
   "kind": "plain",
   "title": "What RISK, and how fast?",
   "lines": [
    "• cough > 3 weeks + TB risk, ANY CD4 count → TB",
    "• structural lung disease, or HIV with CD4 < 50 → MAC",
    "• CD4 < 200, steroids, transplant + HYPOXEMIA → PJP"
   ]
  },
  {
