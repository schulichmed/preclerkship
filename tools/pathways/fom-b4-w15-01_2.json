   "title": "Cough > 3 weeks",
   "lines": [
    "• hemoptysis, night sweats, weight loss",
    "• born abroad, contacts, Indigenous, prison, elderly",
    "• REACTIVATION: prior TB, HIV, transplant, steroids"
   ]
  },
  {
   "id": "ma_pres_0_0",
   "x": 297,
   "y": 608,
   "w": 240,
   "h": 150,
   "kind": "ma_t",
   "title": "Two settings",
   "lines": [
    "• cystic fibrosis, COPD, bronchiectasis → LUNG disease",
    "• HIV, CD4 < 50 → DISSEMINATED",
    "• dyspnea, abdominal pain, anemia"
   ]
  },
  {
   "id": "pj_pres_0_0",
   "x": 549,
   "y": 608,
