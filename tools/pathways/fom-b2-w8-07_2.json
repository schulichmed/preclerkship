   "kind": "warn",
   "title": "Dosing is IMPRECISE: guide it by RESPONSE",
   "lines": []
  },
  {
   "id": "int_act_0_0",
   "x": 1061,
   "y": 724,
   "w": 228,
   "h": 372,
   "kind": "bad",
   "title": "AVOID these pairs",
   "lines": [
    "• angiotensin-converting enzyme (ACE) inhibitor + potassium-sparing diuretic → hyperkalemia",
    "• monoamine oxidase inhibitor (MAOI) + cheese or cold medicine → hypertension",
    "• two antithrombotics → gastrointestinal bleed",
    "• warfarin + leafy greens → effect ↓"
   ]
  },
  {
   "id": "gen_act_0_0",
   "x": 1301,
   "y": 724,
   "w": 228,
   "h": 193,
   "kind": "gen_w",
   "title": "Race may be considered",
   "lines": [
    "• rosuvastatin: Asian 2× levels → rhabdomyolysis",
    "• ACE inhibitor alone: less effective in Black patients",
    "• tacrolimus: 2× dose in African Americans"
   ]
  },
  {
   "id": "gen_act_1_0",
   "x": 1301,
   "y": 939,
   "w": 228,
   "h": 157,
   "kind": "gen_w",
   "title": "Women",
   "lines": [
    "• zolpidem: next-day sedation, impaired driving",
    "• more QT prolongation, statin myopathy, ACE-inhibitor cough"
   ]
  }
