 "nodes": [
  {
   "id": "root",
   "x": 407,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Prescribing for THIS patient: what changes the DRUG or the DOSE?",
   "lines": [
    "World Health Organization (WHO) steps: 1 define the problem → 2 the goal, WITH the patient → 3a the standard treatment (number needed to treat low, to harm high) → 3b VERIFY it suits them → 4 start → 5 inform + warn → 6 monitor, stop",
    "verify: every other medication + supplement · allergies (what happened?) · past history · cost, access · does the patient AGREE?"
   ]
  },
  {
   "id": "g_age",
   "x": 45,
   "y": 174,
   "w": 468,
   "h": 60,
   "kind": "plain",
   "title": "AGE: both ends of life",
   "lines": [
    "healthy adults: usually the standard dose"
   ]
  },
  {
   "id": "g_org",
   "x": 553,
   "y": 174,
   "w": 468,
   "h": 60,
   "kind": "plain",
   "title": "ELIMINATION: kidney or liver disease?",
   "lines": [
    "may need a dose change + monitoring"
   ]
  },
  {
   "id": "g_oth",
   "x": 1061,
   "y": 174,
   "w": 468,
   "h": 60,
   "kind": "plain",
   "title": "What ELSE changes the response?",
   "lines": [
    "the same dose, a different effect"
   ]
  },
  {
