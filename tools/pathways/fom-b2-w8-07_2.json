   "lines": []
  },
  {
   "id": "ch_why_0_0",
   "x": 45,
   "y": 432,
   "w": 228,
   "h": 252,
   "kind": "ch_t",
   "title": "Immature at birth",
   "lines": [
    "• kidney: adult GFR by 6–12 months",
    "• liver enzymes: past adult by 3–6 years",
    "• skin absorbs MORE (big surface area)"
   ]
  },
  {
   "id": "old_why_0_0",
   "x": 285,
   "y": 432,
   "w": 228,
   "h": 252,
   "kind": "old_t",
   "title": "Clearance ↓, sensitivity ↑",
   "lines": [
    "• benzodiazepines, anticholinergics: falls, confusion",
    "• alpha-1 blockers: orthostatic drop",
    "• digoxin"
   ]
  },
  {
   "id": "kid_why_0_0",
   "x": 553,
   "y": 432,
   "w": 228,
   "h": 252,
   "kind": "kid_t",
   "title": "Renally cleared drugs",
   "lines": [
    "adjust by CREATININE CLEARANCE, e.g. penicillin:"
   ]
  },
  {
   "id": "liv_why_0_0",
   "x": 793,
   "y": 432,
   "w": 228,
   "h": 252,
   "kind": "liv_t",
   "title": "Hepatic elimination ↓",
   "lines": [
    "• albumin ↓: more drug in tissues",
    "• ascites, edema store some drugs"
   ]
  },
  {
   "id": "int_why_0_0",
   "x": 1061,
   "y": 432,
   "w": 228,
   "h": 134,
   "kind": "int_t",
   "title": "INHIBITOR → level ↑ → TOXIC",
   "lines": [
    "• azoles, macrolides, protease inhibitors",
    "• grapefruit (CYP3A4, 3 days) → statin myopathy"
   ]
  },
  {
   "id": "int_why_1_0",
   "x": 1061,
   "y": 588,
   "w": 228,
   "h": 96,
   "kind": "int_t",
   "title": "INDUCER → level ↓ → FAILS",
   "lines": [
    "• rifampin, phenytoin, carbamazepine, St John's wort",
    "~reversed for a PRODRUG"
   ]
  },
  {
   "id": "gen_why_0_0",
   "x": 1301,
   "y": 432,
   "w": 228,
   "h": 252,
   "kind": "gen_t",
   "title": "Warfarin: 16-fold dose range",
   "lines": [
    "VKORC1 + CYP2C9 variants · narrow window"
   ]
  },
  {
   "id": "ch_act_0_0",
   "x": 45,
   "y": 724,
   "w": 228,
   "h": 120,
   "kind": "ok",
   "title": "Dose by AGE and WEIGHT",
   "lines": []
  },
  {
   "id": "ch_act_1_0",
   "x": 45,
   "y": 866,
   "w": 228,
   "h": 230,
   "kind": "bad",
   "title": "AVOID: child-specific reactions",
   "lines": [
    "• aspirin → Reye syndrome",
    "• chloramphenicol → grey baby",
    "• sulfonamides → kernicterus",
    "• tetracycline → stained teeth",
    "• valproic acid < 4 years → liver"
   ]
  },
  {
   "id": "old_act_0_0",
   "x": 285,
   "y": 724,
   "w": 228,
   "h": 62,
   "kind": "ok",
   "title": "Start LOWER · monitor renal function",
   "lines": []
  },
  {
   "id": "old_act_1_0",
   "x": 285,
   "y": 808,
   "w": 228,
   "h": 134,
   "kind": "ok",
   "title": "Review at least YEARLY + at every transition",
   "lines": [
    "• bring the bottles",
    "• duplicates, prescribing CASCADES",
    "• deprescribe, simplify"
   ]
  },
  {
   "id": "old_act_2_0",
   "x": 285,
   "y": 964,
   "w": 228,
   "h": 132,
   "kind": "warn",
   "title": "Before a NEW drug, ask",
   "lines": [
    "• am I treating another drug's effect?",
    "• does it fit frailty + goals?",
    "• can one drug treat two conditions?"
   ]
  },
  {
