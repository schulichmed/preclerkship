   "kind": "cereb_t",
   "title": "Skilled movement",
   "lines": [
    "• dysmetria: misses the target",
    "• dyssynergia: segments uncoordinated",
    "• INTENTION tremor: near the end or holding a position",
    "• fails finger-to-nose",
    "• often one-sided (stroke)"
   ]
  },
  {
   "id": "pd_sign_0_0",
   "x": 625,
   "y": 450,
   "w": 172,
   "h": 240,
   "kind": "pd_t",
   "title": "Can't START",
   "lines": [
    "• akinesia: needs an outside cue",
    "• slow (bradykinesia), freezing, shuffling",
    "• tremor at REST: pill-rolling, hand first, eases with movement",
    "• RIGIDITY: agonist + antagonist co-contract",
    "• spared: practised or cued acts (rides a bike)"
   ]
  },
