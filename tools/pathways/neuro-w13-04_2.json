  },
  {
   "id": "spin_circuit_0_0",
   "x": 229,
   "y": 730,
   "w": 172,
   "h": 206,
   "kind": "spin_w",
   "title": "Tunes ongoing movement + tone",
   "lines": [
    "in: vision, hearing, skin + muscle afferents",
    "out: fastigial and interposed nuclei → spinal cord"
   ]
  },
  {
   "id": "cereb_circuit_0_0",
   "x": 413,
   "y": 730,
   "w": 172,
   "h": 206,
   "kind": "cereb_w",
   "title": "Adds skill + coordination",
   "lines": [
    "in: copy of the cortical motor command",
    "out: dentate nucleus → motor and premotor cortex",
    "no tremor at rest",
    "tremor: long-loop reflex via cortex over-responds"
   ]
  },
  {
   "id": "pd_circuit_0_0",
   "x": 625,
   "y": 730,
   "w": 172,
   "h": 206,
   "kind": "pd_w",
   "title": "Pars compacta dopamine cells die",
   "lines": [
    "→ too much inhibition of the thalamus",
    "→ too little drive to motor cortex",
    "WORSENS over time",
    "treat: L-dopa (precursor, crosses blood-brain barrier)"
   ]
  },
  {
   "id": "chor_circuit_0_0",
   "x": 809,
   "y": 730,
   "w": 172,
   "h": 206,
   "kind": "chor_w",
   "title": "Either cause",
   "lines": [
    "• Huntington disease: indirect pathway degraded",
    "• too much L-dopa: direct pathway over-driven",
    "→ too little inhibition of the thalamus"
   ]
  }
 ],
