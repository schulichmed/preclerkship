   "title": "Nitrates: nitroglycerin",
   "lines": [
    "IV, sublingual, patch; isosorbide tablets"
   ]
  },
  {
   "id": "dh_head_0_0",
   "x": 1457,
   "y": 260,
   "w": 214,
   "h": 98,
   "kind": "dh_h",
