   "lines": [
    "amlodipine, nifedipine"
   ]
  },
  {
   "id": "ac_how_0_0",
   "x": 45,
   "y": 398,
   "w": 214,
   "h": 132,
   "kind": "ac_w",
   "title": "↓ angiotensin II action",
   "lines": [
    "• ACE inhibitor: bradykinin builds up too → dry cough, angioedema",
    "• ARB: blocks the receptor, NO bradykinin effect"
   ]
  },
  {
   "id": "mr_how_0_0",
   "x": 271,
   "y": 398,
   "w": 214,
   "h": 132,
   "kind": "mr_w",
   "title": "Blocks aldosterone",
   "lines": [
    "less Na+ and water kept, K+ kept"
   ]
  },
  {
   "id": "dg_how_0_0",
   "x": 525,
   "y": 398,
   "w": 214,
   "h": 132,
   "kind": "dg_w",
   "title": "Blocks the Na+/K+ ATPase",
   "lines": [
    "• more Ca2+ inside → ↑ FORCE",
    "• vagal: slows the SA and AV node"
   ]
  },
  {
   "id": "bb_how_0_0",
   "x": 751,
   "y": 398,
   "w": 214,
   "h": 132,
   "kind": "bb_w",
   "title": "β1 block: ↓ rate, force, conduction",
   "lines": [
    "β2 block: bronchospasm"
   ]
  },
  {
   "id": "nd_how_0_0",
   "x": 977,
   "y": 398,
   "w": 214,
   "h": 132,
   "kind": "nd_w",
   "title": "Vessel AND heart Ca2+ channels",
   "lines": [
    "slows SA and AV node: NO reflex tachycardia"
   ]
  },
  {
   "id": "nt_how_0_0",
   "x": 1231,
   "y": 398,
   "w": 214,
   "h": 132,
   "kind": "nt_w",
   "title": "Supplies nitric oxide → cGMP",
   "lines": [
    "dilates: ↓ preload, afterload, O2 demand"
   ]
  },
  {
   "id": "dh_how_0_0",
   "x": 1457,
   "y": 398,
   "w": 214,
   "h": 132,
   "kind": "dh_w",
   "title": "Vessel Ca2+ channels ONLY",
   "lines": [
    "↓ afterload → REFLEX tachycardia"
   ]
  },
  {
   "id": "ac_use_0_0",
   "x": 45,
   "y": 570,
   "w": 214,
   "h": 124,
   "kind": "ok",
   "title": "Both",
   "lines": [
    "• hypertension, systolic HF (HFrEF)",
    "• after an MI",
    "• diabetes with proteinuria"
   ]
  },
  {
   "id": "mr_use_0_0",
   "x": 271,
   "y": 570,
   "w": 214,
   "h": 124,
   "kind": "ok",
   "title": "Use when",
   "lines": [
    "• HFrEF: ↓ mortality",
    "• cirrhotic ascites (+ furosemide)",
    "• hypertension, added on"
   ]
  },
  {
   "id": "dg_use_0_0",
   "x": 525,
   "y": 570,
   "w": 214,
   "h": 124,
   "kind": "ok",
   "title": "Use when",
   "lines": [
    "• HFrEF: fewer admissions, NO mortality benefit",
    "• chronic AF"
   ]
  },
  {
   "id": "bb_use_0_0",
   "x": 751,
   "y": 570,
   "w": 214,
   "h": 124,
   "kind": "ok",
   "title": "Use when",
   "lines": [
    "• angina; after an MI: ↓ mortality",
    "• HFrEF, AF, hypertension"
   ]
  },
  {
   "id": "nd_use_0_0",
   "x": 977,
   "y": 570,
   "w": 214,
   "h": 124,
   "kind": "ok",
   "title": "Use when",
   "lines": [
    "• AF",
    "• supraventricular tachycardias"
   ]
  },
  {
   "id": "nt_use_0_0",
   "x": 1231,
   "y": 570,
   "w": 214,
   "h": 124,
   "kind": "ok",
   "title": "Use when",
   "lines": [
    "• angina, coronary spasm",
    "• MI with pulmonary edema"
   ]
  },
  {
   "id": "dh_use_0_0",
   "x": 1457,
   "y": 570,
   "w": 214,
   "h": 42,
   "kind": "ok",
   "title": "Hypertension",
   "lines": []
  },
