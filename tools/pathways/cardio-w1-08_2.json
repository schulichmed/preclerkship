   "x": 751,
   "y": 260,
   "w": 214,
   "h": 98,
   "kind": "bb_h",
   "title": "Beta blocker",
   "lines": [
    "propranolol (non-selective), metoprolol, bisoprolol"
   ]
  },
  {
   "id": "nd_head_0_0",
   "x": 977,
   "y": 260,
   "w": 214,
   "h": 98,
   "kind": "nd_h",
   "title": "Non-dihydropyridine CCB",
   "lines": [
    "calcium channel blocker: verapamil, diltiazem"
   ]
  },
  {
   "id": "nt_head_0_0",
   "x": 1231,
   "y": 260,
   "w": 214,
   "h": 98,
