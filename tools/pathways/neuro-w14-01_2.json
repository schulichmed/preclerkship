  {
   "id": "conc_tx_0_0",
   "x": 1163,
   "y": 1488,
   "w": 206,
   "h": 224,
   "kind": "ok",
   "title": "RECOGNISE and REMOVE",
   "lines": [
    "when in doubt, remove from play, work, school",
    "1 · mental + physical rest 24-48 h, not longer",
    "2 · return to LEARN once symptom-free: part time, easiest classes, no phys ed",
    "3 · return to PLAY after full-time school + medical clearance"
   ]
  },
  {
   "id": "conc_tx_1_0",
   "x": 1163,
   "y": 1734,
   "w": 206,
   "h": 206,
   "kind": "ok",
   "title": "Graduated return to play (~1 week)",
   "lines": [
    "1 · light aerobic: walk, swim, bike",
    "2 · sport drills, no head impact",
    "3 · non-contact, then harder drills",
    "4 · full contact after MEDICAL CLEARANCE",
    "5 · normal game play"
   ]
  },
