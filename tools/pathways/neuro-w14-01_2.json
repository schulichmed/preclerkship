 "nodes": [
  {
   "id": "root",
   "x": 327,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Head injury: a TRAUMA patient first",
   "lines": [
    "A airway + C-spine precautions · B breathing · C circulation: large-bore IV, bloods for coagulopathy · D disability: neurological exam + Glasgow Coma Scale (GCS) · E expose other injuries",
    "GCS grades it: SEVERE 3-8 · MODERATE 9-12 · MILD 13-14 · MINOR 15",
    "severe death by admission GCS: over 8 → 12% · 5-7 → 27% · under 5 → 78% · coma over 1 day 30-50% · intracranial pressure over 20 (normal under 15) → 50%",
    "20 per 100,000 a year · peak 15-24 · young → car crashes · old → falls"
   ]
  },
  {
   "id": "g_sev",
   "x": 45,
   "y": 210,
   "w": 1078,
   "h": 60,
   "kind": "plain",
   "title": "SEVERE traumatic brain injury",
   "lines": [
    "edema, vasodilation, vascular congestion, hematoma → ↑ intracranial pressure → HERNIATION"
   ]
  },
  {
   "id": "g_mild",
   "x": 1163,
   "y": 210,
   "w": 206,
   "h": 60,
   "kind": "plain",
   "title": "CONCUSSION",
   "lines": [
    "= mild traumatic brain injury"
   ]
  },
  {
   "id": "p_sev",
   "x": 45,
   "y": 310,
   "w": 1078,
   "h": 132,
   "kind": "info",
   "title": "Herniating? Which way?",
   "lines": [
    "• UNCAL: same-side fixed dilated pupil (third nerve palsy) + opposite-side weakness",
    "• TONSILLAR: medulla compressed → Cushing's triad (hypertension, bradycardia, apnea) → fatal cardiorespiratory failure",
    "• subfalcine · CENTRAL: ↓ consciousness · transcalvarial",
    "• descending: nerves III, IV, VI · PCA, ACA stroke · Duret hemorrhage"
   ]
  },
  {
   "id": "p_mild",
   "x": 1163,
   "y": 310,
   "w": 206,
   "h": 132,
   "kind": "info",
   "title": "To the ER if ANY",
   "lines": [
    "• GCS under 15 · worsening mental status",
    "• possible spinal injury",
    "• worse symptoms, new neuro signs"
   ]
  },
  {
   "id": "t_act",
   "x": 45,
   "y": 482,
   "w": 1078,
   "h": 60,
   "kind": "plain",
   "title": "Act, then a STAT CT",
   "lines": [
    "• intubate · head of the bed up · IV mannitol or 3% saline"
   ]
  },
  {
   "id": "edh_head_0_0",
   "x": 45,
   "y": 622,
   "w": 206,
   "h": 150,
   "kind": "edh_h",
   "title": "Epidural hematoma",
   "lines": [
    "skull ↔ dura",
    "middle meningeal ARTERY 50% · vein 33% · diploic vein, sinus 17%"
   ]
  },
  {
   "id": "sdh_head_0_0",
   "x": 263,
   "y": 622,
   "w": 206,
   "h": 150,
   "kind": "sdh_h",
   "title": "Acute subdural hematoma",
   "lines": [
    "dura ↔ arachnoid",
    "torn BRIDGING VEINS"
   ]
  },
  {
   "id": "cont_head_0_0",
   "x": 481,
   "y": 622,
   "w": 206,
   "h": 150,
   "kind": "cont_h",
   "title": "Cerebral contusion",
   "lines": [
    "COUP under the impact: skull bends in, springs back",
    "CONTRECOUP opposite it: acceleration"
   ]
  },
  {
   "id": "ich_head_0_0",
   "x": 699,
   "y": 622,
   "w": 206,
   "h": 150,
   "kind": "ich_h",
   "title": "Intracerebral hemorrhage",
   "lines": [
    "deceleration or contact · 1-3%",
    "frontal, temporal lobes 80-90%"
   ]
  },
  {
   "id": "dai_head_0_0",
   "x": 917,
   "y": 622,
   "w": 206,
   "h": 150,
   "kind": "dai_h",
   "title": "Diffuse axonal injury · traumatic SAH",
   "lines": [
    "ACCELERATION injury",
    "often co-exist"
   ]
  },
  {
   "id": "conc_head_0_0",
   "x": 1163,
   "y": 622,
   "w": 206,
   "h": 150,
   "kind": "conc_h",
   "title": "Concussion",
   "lines": [
    "rotational acceleration · NO impact needed",
    "81-92% no LOC · helmets don't prevent it",
    "a chest blow can whiplash the brain"
   ]
  },
  {
   "id": "edh_clue_0_0",
   "x": 45,
   "y": 812,
   "w": 206,
   "h": 242,
   "kind": "edh_t",
   "title": "CONTACT injury + fracture",
   "lines": [
    "• LOC → LUCID interval → coma",
    "• skull fracture in 75-90%",
    "• NOT head acceleration · 33% another brain lesion",
    "case: 19 y ejected · lucid in the ambulance · 2 h later right pupil fixed 7 mm, left hemiplegia · BP 160/90, pulse 55, apneic → craniotomy, recovered"
   ]
  },
  {
   "id": "edh_clue_1_0",
   "x": 45,
   "y": 1076,
   "w": 206,
   "h": 170,
   "kind": "edh_w",
   "title": "Skull fractures: CONTACT injury",
   "lines": [
    "• linear · depressed · open or closed",
    "• BASILAR: raccoon eyes · Battle sign",
    "• BASILAR: CSF from ear or nose · hemotympanum"
   ]
  },
  {
   "id": "sdh_clue_0_0",
   "x": 263,
   "y": 812,
   "w": 206,
   "h": 434,
   "kind": "sdh_t",
   "title": "Acceleration-deceleration",
   "lines": [
    "• a fall, head strikes a broad surface",
    "• comatose from the scene",
    "• 10-15% of severe injuries · within 3 days · 30% of fatal ones",
    "case: 75 y slipped on ice · comatose · right pupil fixed · decerebrate"
   ]
  },
  {
   "id": "cont_clue_0_0",
   "x": 481,
   "y": 812,
   "w": 206,
   "h": 434,
   "kind": "cont_t",
   "title": "Depends on size and site",
   "lines": [
    "• e.g. confusion, personality change, loss of smell",
    "• mass effect, ↑ pressure",
    "• turns necrotic + patchily hemorrhagic",
    "case: 43 y fell off a bike · confused, personality change, no smell · died of DVT at day 10"
   ]
  },
  {
   "id": "ich_clue_0_0",
   "x": 699,
   "y": 812,
   "w": 206,
   "h": 434,
   "kind": "ich_t",
   "title": "A confluent bleed in the brain",
   "lines": [
    "• blood dissects the brain around it",
    "• the brain around it is normal",
    "• in 25% of closed head injuries"
   ]
  },
  {
   "id": "dai_clue_0_0",
   "x": 917,
   "y": 812,
   "w": 206,
   "h": 434,
   "kind": "dai_t",
   "title": "LOC at the scene → PERSISTENT coma",
   "lines": [
    "• axonal injury is 50% of severe brain injury",
    "• shaken baby syndrome",
    "• co-exist with other injuries",
    "case: 43 y high-speed crash · GCS 4 at scene · persistent coma"
   ]
  },
  {
   "id": "conc_clue_0_0",
   "x": 1163,
   "y": 812,
   "w": 206,
   "h": 434,
   "kind": "conc_t",
   "title": "No focal deficit",
   "lines": [
    "• headache, dizziness, nausea",
    "• imbalance, 'seeing stars'",
    "• 85% of first ones recover in 1-4 weeks",
    "• risk: young brain, FEMALE, a previous concussion",
    "case: 17 y, soccer ball to the occiput · headache, neck pain · no LOC, GCS 15, no focal signs"
   ]
  },
  {
   "id": "edh_inv_0_0",
   "x": 45,
   "y": 1286,
   "w": 206,
   "h": 60,
   "kind": "edh_w",
   "title": "LENS-shaped",
   "lines": [
    "frontal or temporal"
   ]
  },
  {
   "id": "edh_inv_1_0",
   "x": 45,
   "y": 1368,
   "w": 206,
   "h": 80,
   "kind": "bad",
   "title": "Basilar fracture: may be MISSED on CT",
   "lines": [
    "risk of MENINGITIS"
   ]
  },
  {
   "id": "sdh_inv_0_0",
   "x": 263,
   "y": 1286,
   "w": 206,
   "h": 162,
   "kind": "sdh_w",
   "title": "CRESCENT-shaped",
   "lines": [
    "often with diffuse axonal injury"
   ]
  },
  {
   "id": "cont_inv_0_0",
   "x": 481,
   "y": 1286,
   "w": 206,
   "h": 162,
   "kind": "cont_w",
   "title": "MIXED high + low density",
   "lines": [
    "usually several · repeat CT at 24-48 h: 20% bleed later"
   ]
  },
  {
   "id": "ich_inv_0_0",
   "x": 699,
   "y": 1286,
   "w": 206,
   "h": 162,
   "kind": "ich_w",
   "title": "HOMOGENEOUS, well-defined",
   "lines": [
    "hyperdense"
   ]
  },
  {
   "id": "dai_inv_0_0",
   "x": 917,
   "y": 1286,
   "w": 206,
   "h": 162,
   "kind": "dai_w",
   "title": "Axonal: petechiae",
   "lines": [
    "• grey-white junction",
    "• corpus callosum",
    "• dorsolateral pons",
    "• cervicomedullary junction",
    "hard to see on CT",
    "SAH: pial vessels rupture"
   ]
  },
  {
   "id": "conc_inv_0_0",
   "x": 1163,
   "y": 1286,
   "w": 206,
   "h": 162,
   "kind": "conc_w",
   "title": "CLINICAL diagnosis",
   "lines": [
    "no CT, MRI, blood test or EEG · SCAT5: 1 of 22 symptoms"
   ]
  },
  {
   "id": "edh_tx_0_0",
   "x": 45,
   "y": 1488,
   "w": 206,
   "h": 233,
   "kind": "bad",
   "title": "CRANIOTOMY if ANY",
   "lines": [
    "• symptomatic",
    "• asymptomatic over 1 cm",
    "• a child",
    "~ conservative only if very small"
   ]
  },
  {
   "id": "edh_tx_1_0",
   "x": 45,
   "y": 1743,
   "w": 206,
   "h": 197,
   "kind": "warn",
   "title": "Mortality 20-25%",
   "lines": [
    "children 5-10% · over 40: 35-50%"
   ]
  },
  {
   "id": "sdh_tx_0_0",
   "x": 263,
   "y": 1488,
   "w": 206,
   "h": 251,
   "kind": "bad",
   "title": "SURGERY within 4 HOURS",
   "lines": [
    "• within 4 h: 30% mortality",
    "• after 4 h: 90%",
    "• post-op pressure under 20: 40%",
    "• over 65: 82% mortality, 5% recover"
   ]
  },
  {
   "id": "sdh_tx_1_0",
   "x": 263,
   "y": 1761,
   "w": 206,
   "h": 179,
   "kind": "warn",
   "title": "Death from the BRAIN injury beneath",
   "lines": [
    "GCS 3 → 90% · 4 → 76% · 5 → 62% · 6-7 → 51%"
   ]
  },
  {
   "id": "cont_tx_0_0",
   "x": 481,
   "y": 1488,
   "w": 206,
   "h": 452,
   "kind": "warn",
   "title": "Size decides",
   "lines": [
