   "w": 270,
   "h": 98,
   "kind": "oi_h",
   "title": "Osteogenesis imperfecta",
   "lines": [
    "TYPE I COLLAGEN (COL1A1, COL1A2) · type 1 normal lifespan, type 2 lethal at birth"
   ]
  },
  {
   "id": "om_pres_0_0",
   "x": 45,
   "y": 436,
   "w": 270,
   "h": 106,
   "kind": "om_t",
   "title": "OVERT symptoms, unlike osteoporosis",
   "lines": [
    "• weak bones that fracture",
    "• PROXIMAL myopathy: falls"
   ]
  },
  {
   "id": "om_pres_1_0",
   "x": 45,
   "y": 564,
   "w": 270,
   "h": 68,
   "kind": "om_w",
   "title": "Malabsorption, e.g. celiac disease",
   "lines": [
    "other causes: see the CALCIUM chart"
   ]
  },
  {
   "id": "pg_pres_0_0",
   "x": 355,
   "y": 436,
   "w": 270,
   "h": 69,
   "kind": "pg_t",
   "title": "Usually ASYMPTOMATIC",
   "lines": [
    "found on an x-ray or a high ALP"
   ]
  },
  {
   "id": "pg_pres_1_0",
   "x": 355,
   "y": 527,
   "w": 270,
   "h": 105,
   "kind": "pg_w",
   "title": "Or",
   "lines": [
    "• pain + bowing: pelvis, femur, tibia",
    "• skull: headache, ↑ HAT SIZE, deafness",
    "• WARMTH over the bone"
   ]
  },
  {
   "id": "oi_pres_0_0",
   "x": 665,
   "y": 436,
   "w": 270,
   "h": 96,
   "kind": "oi_t",
   "title": "Fragility fractures",
   "lines": [
    "• short stature, bowed long bones",
    "• BLUE sclerae, hearing loss",
    "• dentinogenesis imperfecta"
   ]
  },
  {
   "id": "oi_pres_1_0",
   "x": 665,
   "y": 554,
   "w": 270,
   "h": 78,
   "kind": "oi_w",
   "title": "Also",
   "lines": [
    "• aortic root dilatation, valve leaks",
    "• Wormian bones, pectus"
   ]
  },
  {
   "id": "om_inv_0_0",
   "x": 45,
   "y": 672,
   "w": 270,
   "h": 69,
   "kind": "om_t",
   "title": "X-ray: PSEUDOFRACTURES",
   "lines": [
    "healed microfractures"
   ]
  },
  {
   "id": "om_inv_1_0",
   "x": 45,
   "y": 763,
   "w": 270,
   "h": 69,
   "kind": "om_w",
   "title": "Bone biopsy: the gold standard",
   "lines": [
    "usually not needed"
   ]
  },
  {
   "id": "pg_inv_0_0",
   "x": 355,
   "y": 672,
   "w": 270,
   "h": 78,
   "kind": "pg_t",
   "title": "1 · Bone scan: the extent",
   "lines": [
    "x-ray: expanded, denser bone · early lytic lesion"
   ]
  },
  {
   "id": "pg_inv_1_0",
   "x": 355,
   "y": 772,
   "w": 270,
   "h": 60,
   "kind": "bad",
   "title": "Osteosarcoma (1–3%)",
   "lines": [
    "marked pain, new lytic lesion, rising ALP"
   ]
  },
  {
   "id": "oi_inv_0_0",
   "x": 665,
   "y": 672,
   "w": 270,
   "h": 160,
   "kind": "oi_t",
   "title": "Monitor for life",
   "lines": [
    "• yearly spirometry",
    "• every 2 years: hearing, bone density, electrocardiogram, echocardiogram",
    "• skeletal x-rays every 1–2 years"
   ]
  },
  {
   "id": "om_tx_0_0",
   "x": 45,
   "y": 872,
   "w": 270,
   "h": 153,
   "kind": "ok",
   "title": "Vitamin D by the 25-hydroxyvitamin D level",
   "lines": [
    "• < 30 nmol/L: ergocalciferol 50,000 international units (IU) for 12 weeks, then 800–2,000 IU",
    "• 30–75 nmol/L: 800–2,000 IU daily",
    "• repeat in 3 months"
   ]
  },
  {
   "id": "om_tx_1_0",
   "x": 45,
   "y": 1047,
   "w": 270,
   "h": 61,
   "kind": "ok",
   "title": "Treat the cause",
   "lines": [
    "+ phosphate, calcium if low"
   ]
  },
  {
   "id": "pg_tx_0_0",
   "x": 355,
   "y": 872,
   "w": 270,
   "h": 116,
   "kind": "warn",
   "title": "ACTIVE (high ALP or active scan) + ANY: treat, even if asymptomatic",
   "lines": [
    "• skull, long bone, spine, next to a joint",
    "• surgery planned at the site",
    "• heart failure"
   ]
  },
  {
   "id": "pg_tx_1_0",
   "x": 355,
   "y": 1010,
   "w": 270,
   "h": 98,
   "kind": "ok",
   "title": "Analgesia + intravenous (IV) ZOLEDRONATE",
   "lines": [
    "• calcitonin",
    "• NOT teriparatide, denosumab"
   ]
  },
  {
   "id": "oi_tx_0_0",
   "x": 665,
   "y": 872,
   "w": 270,
   "h": 236,
   "kind": "ok",
   "title": "IV bisphosphonate (zoledronate) if ANY",
   "lines": [
    "• long bone deformity",
    "• vertebral compression fracture",
    "• > 3 fractures a year"
   ]
  }
 ],
