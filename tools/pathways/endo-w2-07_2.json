 "nodes": [
  {
   "id": "root",
   "x": 110,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Bone pain, deformity or fractures: is it NOT osteoporosis?",
   "lines": [
    "first: calcium (Ca) · phosphate (PO4) · alkaline phosphatase (ALP)",
    "osteoporosis: see the OSTEOPOROSIS chart · calcium disorders: see the CALCIUM chart"
   ]
  },
  {
   "id": "g_om",
   "x": 45,
   "y": 138,
   "w": 270,
   "h": 80,
   "kind": "plain",
   "title": "Ca ↓ · PO4 ↓ · ALP ↑",
   "lines": [
    "urine Ca ↓"
   ]
  },
  {
   "id": "g_pg",
   "x": 355,
   "y": 138,
   "w": 270,
   "h": 80,
   "kind": "plain",
   "title": "ALP VERY HIGH · Ca, PO4 normal",
   "lines": [
    "urine hydroxyproline ↑ · Ca ↑ only if immobile"
   ]
  },
  {
   "id": "g_oi",
   "x": 665,
   "y": 138,
   "w": 270,
   "h": 80,
   "kind": "plain",
   "title": "Panel NORMAL · fractures from birth",
   "lines": [
    "minimal trauma"
   ]
  },
  {
   "id": "om_head_0_0",
   "x": 45,
   "y": 298,
   "w": 270,
   "h": 114,
   "kind": "om_h",
   "title": "Osteomalacia (adult) · rickets (child)",
   "lines": [
    "MINERALIZATION defect: vitamin D deficiency"
   ]
  },
  {
   "id": "pg_head_0_0",
   "x": 355,
   "y": 298,
   "w": 270,
   "h": 114,
   "kind": "pg_h",
   "title": "Paget's disease of bone",
   "lines": [
    "localized REMODELLING: ↑ resorption, then abnormal, fragile new bone",
    "5% of people · 10% over 80"
   ]
  },
  {
   "id": "oi_head_0_0",
   "x": 665,
   "y": 298,
   "w": 270,
   "h": 114,
   "kind": "oi_h",
   "title": "Osteogenesis imperfecta",
   "lines": [
    "TYPE I COLLAGEN (COL1A1, COL1A2: 85–90%) · type 1 normal lifespan, type 2 lethal at birth",
    "1 in 15–20,000 births · 16+ subtypes"
   ]
  },
  {
   "id": "om_pres_0_0",
   "x": 45,
   "y": 452,
   "w": 270,
   "h": 116,
   "kind": "om_t",
   "title": "OVERT symptoms, unlike osteoporosis",
   "lines": [
    "• weak bones that fracture",
    "• PROXIMAL myopathy: falls",
    "• often MISTAKEN for osteoporosis"
   ]
  },
  {
   "id": "om_pres_1_0",
   "x": 45,
   "y": 590,
   "w": 270,
   "h": 150,
   "kind": "om_w",
   "title": "Malabsorption, e.g. celiac disease",
   "lines": [
    "• low sun, poor diet, hydroxylation defects, nephrotic syndrome",
    "• liver disease · chronic renal failure · ANTICONVULSANTS",
    "case: 23 F, celiac · falls, weakness · femur pseudofractures"
   ]
  },
  {
   "id": "pg_pres_0_0",
   "x": 355,
   "y": 452,
   "w": 270,
   "h": 106,
   "kind": "pg_t",
   "title": "Usually ASYMPTOMATIC",
   "lines": [
    "found on an x-ray or a high ALP"
   ]
  },
  {
   "id": "pg_pres_1_0",
   "x": 355,
   "y": 580,
   "w": 270,
   "h": 160,
   "kind": "pg_w",
   "title": "Or",
   "lines": [
    "• SEVERE pain: pelvis, femur, tibia",
    "• bowed tibia, kyphosis, frequent fractures",
    "• skull: headache, ↑ HAT SIZE, deafness",
    "• WARMTH over the bone"
   ]
  },
  {
   "id": "oi_pres_0_0",
   "x": 665,
   "y": 452,
   "w": 270,
   "h": 133,
   "kind": "oi_t",
   "title": "Fragility fractures",
   "lines": [
    "• short stature, bowed long bones",
    "• BLUE sclerae, hearing loss",
    "• dentinogenesis imperfecta"
   ]
  },
  {
   "id": "oi_pres_1_0",
   "x": 665,
   "y": 607,
   "w": 270,
   "h": 133,
   "kind": "oi_w",
   "title": "Also",
   "lines": [
    "• aortic root dilatation, valve leaks",
    "• Wormian bones, pectus · basilar skull deformity"
   ]
  },
  {
   "id": "om_inv_0_0",
   "x": 45,
   "y": 780,
   "w": 270,
   "h": 133,
   "kind": "om_t",
   "title": "X-ray: PSEUDOFRACTURES",
   "lines": [
    "healed microfractures",
    "Ca ↓, PO4 ↓, ALP ↑, urine Ca ↓"
   ]
  },
  {
   "id": "om_inv_1_0",
   "x": 45,
   "y": 935,
   "w": 270,
   "h": 115,
   "kind": "om_w",
   "title": "Bone biopsy: the gold standard",
   "lines": [
    "usually not needed"
   ]
  },
  {
   "id": "pg_inv_0_0",
   "x": 355,
   "y": 780,
   "w": 270,
   "h": 78,
   "kind": "pg_t",
   "title": "1 · Bone scan: the extent",
   "lines": [
    "x-ray: expanded, denser bone · early lytic lesion · fissure fractures"
   ]
  },
  {
   "id": "pg_inv_1_0",
   "x": 355,
   "y": 880,
   "w": 270,
   "h": 170,
   "kind": "bad",
   "title": "Complications: OSTEOSARCOMA 1–3%",
   "lines": [
    "sarcoma: marked pain, new lytic lesion, rising ALP",
    "also: fractures · Ca ↑ if immobile · deafness (cranial nerve), cord compression · high-output HEART FAILURE · osteoarthritis"
   ]
  },
  {
   "id": "oi_inv_0_0",
   "x": 665,
   "y": 780,
   "w": 270,
   "h": 270,
   "kind": "oi_t",
   "title": "Monitor for life",
   "lines": [
    "• yearly spirometry",
    "• every 2 years: hearing, bone density, electrocardiogram, echocardiogram",
    "• skeletal x-rays every 1–2 years",
    "• growth, head circumference · neuro exam if symptoms"
   ]
  },
  {
   "id": "om_tx_0_0",
   "x": 45,
   "y": 1090,
   "w": 270,
   "h": 171,
   "kind": "ok",
   "title": "Vitamin D by the 25-hydroxyvitamin D level",
   "lines": [
    "• < 30 nmol/L: ergocalciferol 50,000 international units (IU) for 12 weeks, then 800–2,000 IU",
    "• 30–75 nmol/L: 800–2,000 IU daily",
    "• repeat in 3 months"
   ]
  },
  {
   "id": "om_tx_1_0",
   "x": 45,
   "y": 1283,
   "w": 270,
   "h": 79,
   "kind": "ok",
   "title": "Treat the cause",
   "lines": [
    "+ phosphate, calcium if low"
   ]
  },
  {
   "id": "pg_tx_0_0",
   "x": 355,
   "y": 1090,
   "w": 270,
   "h": 116,
   "kind": "warn",
   "title": "ACTIVE (high ALP or active scan) + ANY: treat, even if asymptomatic",
   "lines": [
    "• skull, long bone, spine, next to a joint",
    "• surgery planned at the site",
    "• heart failure"
   ]
  },
  {
   "id": "pg_tx_1_0",
   "x": 355,
   "y": 1228,
   "w": 270,
   "h": 134,
   "kind": "ok",
   "title": "Analgesia + intravenous (IV) ZOLEDRONATE",
   "lines": [
    "• calcitonin",
    "• NOT teriparatide, denosumab",
    "case: femur, ALP 3× normal → ZOLEDRONATE"
   ]
  },
  {
   "id": "oi_tx_0_0",
   "x": 665,
   "y": 1090,
   "w": 270,
   "h": 272,
   "kind": "ok",
   "title": "IV bisphosphonate (zoledronate) if ANY",
   "lines": [
    "• long bone deformity",
    "• vertebral compression fracture",
    "• > 3 fractures a year",
    "case: 17 F, type 1, 5 fractures in a year → ZOLEDRONATE"
   ]
  }
 ],
