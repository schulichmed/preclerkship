 "panels": [
  {
   "x": 45,
   "y": 1006,
   "w": 763,
   "title": "Normal variants: do not call them disease",
   "items": [
    "limbus vertebra: triangle of bone at the front-top corner (unfused ring apophysis), teens, often L4: NOT a fracture",
    "Schmorl's nodes: endplate dents, usually incidental",
    "cervical rib off C7 (C7 transverse process over ~2–2.5 cm): neck pain, arm pain if it presses the neurovascular bundle",
    "transitional vertebra: lumbarization or sacralization"
   ],
   "cols": 1
  },
  {
   "x": 822,
   "y": 1006,
   "w": 763,
   "title": "Numbers and landmarks",
   "items": [
    "atlantodental interval: under 3 mm adults, under 5 mm children (more = instability)",
    "open-mouth view: C1 lateral masses line up with C2",
    "count: T1 meets the 1st rib · L1 sits below the 12th rib"
   ],
   "cols": 1
  }
 ]
}