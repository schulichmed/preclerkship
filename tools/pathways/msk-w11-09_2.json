   "id": "sep_pres_0_0",
   "x": 45,
   "y": 398,
   "w": 236,
   "h": 196,
   "kind": "sep_t",
   "title": "Kocher criteria",
   "lines": [
    "• temperature > 38.5 °C",
    "• white count > 12 × 10⁹/L · ESR > 40 mm/h",
    "• cannot walk on it"
   ]
  },
  {
   "id": "ts_pres_0_0",
   "x": 321,
   "y": 398,
   "w": 236,
   "h": 96,
   "kind": "ts_t",
   "title": "Age 3-10, boys",
   "lines": [
    "• SUDDEN hip pain 7-10 days after a cold or sore throat",
    "• afebrile or LOW fever, looks well"
   ]
  },
  {
   "id": "ts_pres_1_0",
   "x": 321,
   "y": 516,
   "w": 236,
   "h": 78,
   "kind": "ts_w",
   "title": "Exam",
   "lines": [
    "hip held flexed, abducted, externally rotated"
   ]
  },
  {
   "id": "lcp_pres_0_0",
   "x": 569,
   "y": 398,
   "w": 236,
   "h": 105,
   "kind": "lcp_t",
   "title": "Age 4-8, boys",
   "lines": [
    "• GRADUAL painless limp, then pain",
    "• pain referred to the KNEE, better with rest"
   ]
  },
  {
   "id": "lcp_pres_1_0",
   "x": 569,
   "y": 525,
   "w": 236,
   "h": 69,
   "kind": "lcp_w",
   "title": "Exam",
   "lines": [
    "less abduction and internal rotation"
   ]
  },
  {
   "id": "scfe_pres_0_0",
   "x": 817,
   "y": 398,
   "w": 236,
   "h": 87,
   "kind": "scfe_t",
   "title": "Teenager (11-15), OBESE",
   "lines": [
    "• gradual hip, thigh or KNEE pain",
    "• left more often · 1 in 5 both hips"
   ]
  },
  {
   "id": "scfe_pres_1_0",
   "x": 817,
   "y": 507,
   "w": 236,
   "h": 87,
   "kind": "scfe_w",
   "title": "Exam",
   "lines": [
    "hip rolls into EXTERNAL rotation on flexion (Drehmann sign)"
   ]
  },
  {
   "id": "sep_inv_0_0",
   "x": 45,
   "y": 634,
   "w": 236,
   "h": 98,
   "kind": "sep_w",
   "title": "URGENT workup",
   "lines": [
    "see the MSK INFECTIONS chart"
   ]
  },
  {
   "id": "ts_inv_0_0",
   "x": 321,
   "y": 634,
   "w": 236,
   "h": 98,
   "kind": "ts_w",
   "title": "Bloodwork, x-ray, ultrasound",
   "lines": [
    "• NORMAL (ESR, CRP may be slightly up)",
    "• done to rule out septic arthritis"
   ]
  },
  {
   "id": "lcp_inv_0_0",
   "x": 569,
   "y": 634,
   "w": 236,
   "h": 98,
   "kind": "lcp_w",
   "title": "X-ray: anteroposterior (AP) pelvis + frog-leg",
   "lines": [
    "flattened, fragmented femoral head · bone scan, MRI"
   ]
  },
  {
   "id": "scfe_inv_0_0",
   "x": 817,
   "y": 634,
   "w": 236,
   "h": 98,
   "kind": "scfe_w",
   "title": "X-ray: AP pelvis + frog-leg",
   "lines": [
    "• Klein's line along the neck MISSES the head",
    "• 'melting ice cream cone'"
   ]
  },
  {
   "id": "sep_tx_0_0",
   "x": 45,
   "y": 772,
