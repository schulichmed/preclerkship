   "id": "ts_tx_0_0",
   "x": 321,
   "y": 772,
   "w": 236,
   "h": 216,
   "kind": "ok",
   "title": "Anti-inflammatory (NSAID) + reassure",
   "lines": [
    "self-limiting in 7-10 days"
   ]
  },
  {
   "id": "lcp_tx_0_0",
   "x": 569,
   "y": 772,
   "w": 236,
   "h": 133,
   "kind": "ok",
   "title": "Refer to orthopedics",
   "lines": [
    "• keep the range of motion (physiotherapy)",
    "• off-load: crutches, brace, swim, cycle",
    "• NSAIDs · osteotomy for some"
   ]
  },
