   "title": "The rest of the differential, by age",
   "items": [
    "under 4: transient synovitis · infection · juvenile idiopathic arthritis · non-accidental injury · pain referred from the limb",
    "4-10: transient synovitis · Perthes · infection · 10-16: slipped epiphysis · avulsion fracture · infection",
    "uncommon at any age: leukemia and bone tumours"
   ],
   "cols": 1
  },
  {
   "x": 556,
   "y": 1022,
   "w": 497,
   "title": "Any abnormal gait: warning signs",
   "items": [
    "asymmetry · progression · leg length difference · pain · deformity · a suspected associated condition",
    "also: missed hip dysplasia, clubfoot, overuse, trauma (see the PEDIATRIC ORTHOPEDICS chart)"
   ],
   "cols": 1
  }
