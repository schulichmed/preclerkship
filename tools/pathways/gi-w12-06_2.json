 "nodes": [
  {
   "id": "root",
   "x": 387,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Chronic liver disease: what is the CAUSE, and has cirrhosis DECOMPENSATED?",
   "lines": [
    "failure = synthesis ↓ (albumin, clotting factors) + excretion ↓ (bilirubin, jaundice)",
    "a MASS in chronic liver disease = hepatocellular carcinoma until proven otherwise",
    "PORTAL HYPERTENSION from a block PRE-hepatic (portal vein thrombosis), HEPATIC (cirrhosis commonest) or POST-hepatic (right heart failure, constrictive pericarditis, hepatic vein obstruction)"
   ]
  },
  {
   "id": "g_cause",
   "x": 45,
   "y": 174,
   "w": 702,
   "h": 78,
   "kind": "plain",
   "title": "Find and treat the CAUSE",
   "lines": [
    "also: hepatitis B or C · hemochromatosis · Wilson · alpha-1 antitrypsin · fatty liver · methotrexate, amiodarone · Budd-Chiari, heart failure"
   ]
  },
  {
   "id": "g_dec",
   "x": 787,
   "y": 174,
   "w": 702,
   "h": 78,
   "kind": "plain",
   "title": "DECOMPENSATED: variceal bleed · ascites · encephalopathy · jaundice",
   "lines": [
    "each one raises mortality"
   ]
  },
