 "nodes": [
  {
   "id": "root",
   "x": 293,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "ONE joint aching for over 6 weeks, worse with activity: osteoarthritis (OA) until a red flag says otherwise",
   "lines": [
    "OA is a CLINICAL diagnosis: typical symptoms + NO other cause · the X-ray STAGES it, it does not diagnose it",
    "first set aside mechanical and sports causes of knee pain (no arthritis)"
   ]
  },
  {
   "id": "g_dx",
   "x": 45,
   "y": 158,
   "w": 484,
   "h": 60,
   "kind": "plain",
   "title": "IS IT OA?",
   "lines": [
    "knee >> hip; ankle; shoulder >> big toe"
   ]
  },
  {
   "id": "g_tx",
   "x": 569,
   "y": 158,
   "w": 732,
   "h": 60,
   "kind": "plain",
   "title": "TREAT IT: what stage, what can be fixed?",
   "lines": [
    "no treatment preserves the joint; all improve life WITH it"
   ]
  },
  {
   "id": "red_head_0_0",
   "x": 45,
   "y": 298,
   "w": 236,
   "h": 98,
   "kind": "red_h",
   "title": "Red flag → NOT OA",
   "lines": [
    "think something else"
   ]
  },
  {
   "id": "oa_head_0_0",
   "x": 293,
   "y": 298,
   "w": 236,
   "h": 98,
   "kind": "oa_h",
   "title": "Osteoarthritis",
   "lines": [
    "a 'sick joint': every tissue fails to heal"
   ]
  },
  {
   "id": "bio_head_0_0",
   "x": 569,
   "y": 298,
   "w": 236,
   "h": 98,
   "kind": "bio_h",
   "title": "Every stage: biomechanics + education",
   "lines": [
    "alignment · overuse · weakness · gait"
   ]
  },
  {
   "id": "med_head_0_0",
   "x": 817,
   "y": 298,
   "w": 236,
   "h": 98,
   "kind": "med_h",
   "title": "Medicines: symptoms only",
   "lines": [
    "less pain, better function"
   ]
  },
  {
   "id": "surg_head_0_0",
   "x": 1065,
   "y": 298,
   "w": 236,
   "h": 98,
   "kind": "surg_h",
   "title": "Surgery: END STAGE only",
   "lines": [
    "unacceptable symptoms despite all of the rest"
   ]
  },
  {
   "id": "red_clue_0_0",
   "x": 45,
   "y": 436,
   "w": 236,
   "h": 178,
   "kind": "bad",
   "title": "Any ONE of these",
   "lines": [
    "• warm or hot joint: infection, crystals",
    "• autoimmune (rheumatoid, seronegative)",
    "• malignancy · fracture · avascular necrosis"
   ]
  },
  {
   "id": "red_clue_1_0",
   "x": 45,
   "y": 636,
   "w": 236,
   "h": 106,
   "kind": "red_w",
   "title": "Widespread pain",
   "lines": [
    "not OA: look elsewhere"
   ]
  },
  {
   "id": "oa_clue_0_0",
   "x": 293,
   "y": 436,
   "w": 236,
   "h": 152,
   "kind": "oa_t",
   "title": "Pain or stiffness with ACTIVITY",
   "lines": [
    "• morning stiffness < 30 min (usually < 5)",
    "• cool or barely warm effusion",
    "• joint-line tenderness, crepitus, thickening"
   ]
  },
  {
   "id": "oa_clue_1_0",
   "x": 293,
   "y": 610,
   "w": 236,
   "h": 132,
   "kind": "oa_w",
   "title": "Risk",
   "lines": [
    "• obesity · age · trauma, alignment · genes",
    "• female 1.4× · post-traumatic OA (after an anterior cruciate ligament tear) starts young"
   ]
  },
  {
   "id": "bio_clue_0_0",
   "x": 569,
   "y": 436,
   "w": 236,
   "h": 306,
   "kind": "ok",
   "title": "ACTIVE therapy",
   "lines": [
    "• neuromuscular exercise physiotherapy, ≥ 3 months (Tai-Chi, GLA:D program)",
    "• 150 min of activity a week",
    "• lose 5% of body weight"
   ]
  },
  {
   "id": "med_clue_0_0",
   "x": 817,
   "y": 436,
   "w": 236,
   "h": 306,
   "kind": "ok",
   "title": "Evidence-based",
   "lines": [
    "• topical anti-inflammatory (NSAID): diclofenac 2–3 × a day",
    "• oral NSAID if no contraindication (not in kidney failure)",
    "• refractory: steroid injection (short-term), then a duloxetine trial 2–3 months"
   ]
  },
  {
   "id": "surg_clue_0_0",
   "x": 1065,
   "y": 436,
   "w": 236,
   "h": 306,
   "kind": "ok",
   "title": "Joint replacement (arthroplasty)",
   "lines": [
    "a salvage procedure · strong evidence of benefit",
    "• X-ray bone on bone → refer to orthopedics"
   ]
  },
  {
   "id": "red_tx_0_0",
   "x": 45,
   "y": 782,
   "w": 236,
   "h": 270,
   "kind": "red_w",
   "title": "Work up that cause",
   "lines": [
    "MRI or bone scan only when the diagnosis is in DOUBT"
   ]
  },
  {
   "id": "oa_tx_0_0",
   "x": 293,
   "y": 782,
   "w": 236,
   "h": 270,
   "kind": "oa_t",
   "title": "X-ray: Kellgren-Lawrence (K/L) grade",
   "lines": [
    "• 1–2 = early · 3–4 = late to end stage",
    "• joint space narrowing, osteophytes"
   ]
  },
  {
   "id": "bio_tx_0_0",
   "x": 569,
   "y": 782,
   "w": 236,
   "h": 150,
   "kind": "bio_w",
   "title": "Also",
   "lines": [
    "• walking aids, insoles, unloader brace",
    "• occupational therapy: joint protection",
    "• cognitive behavioural therapy · topical heat"
   ]
  },
  {
   "id": "bio_tx_1_0",
   "x": 569,
   "y": 954,
   "w": 236,
   "h": 98,
   "kind": "bad",
   "title": "PASSIVE therapy not recommended",
   "lines": [
    "ultrasound, nerve stimulation (TENS), laser, acupuncture"
   ]
  },
  {
   "id": "med_tx_0_0",
   "x": 817,
   "y": 782,
   "w": 236,
   "h": 124,
   "kind": "warn",
   "title": "Weak or unproven",
   "lines": [
    "• acetaminophen: meaningful effect?",
    "• glucosamine, herbal remedies",
    "• injected hyaluronic acid, platelet-rich plasma, stem cells"
   ]
  },
  {
   "id": "med_tx_1_0",
   "x": 817,
   "y": 928,
   "w": 236,
   "h": 124,
   "kind": "bad",
   "title": "AVOID",
   "lines": [
    "• opioids: generally avoid (tramadol at most; others: risks > benefit)",
    "• neuropathic pain drugs, capsaicin, chondroitin"
   ]
  },
  {
   "id": "surg_tx_0_0",
   "x": 1065,
   "y": 782,
   "w": 236,
   "h": 270,
   "kind": "bad",
   "title": "NO knee arthroscopy",
   "lines": [
    "± meniscectomy or repair: no meaningful benefit"
   ]
  }
 ],
