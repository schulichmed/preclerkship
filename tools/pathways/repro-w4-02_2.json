   "kind": "ov_w",
   "title": "1 · Days 2–4: prolactin + TSH",
   "lines": [
    "abnormal → PITUITARY / THYROID chart"
   ]
  },
  {
   "id": "ov_inv_1_0",
   "x": 45,
   "y": 624,
   "w": 212,
   "h": 150,
   "kind": "ov_t",
   "title": "2 · DAY 21 progesterone",
   "lines": [
    "~• 7 days before the expected period",
    "• HIGH = she ovulated (corpus luteum)",
    "• LOW = ANOVULATION, even with regular cycles"
   ]
  },
  {
   "id": "ov_inv_2_0",
   "x": 45,
   "y": 796,
   "w": 212,
   "h": 170,
   "kind": "ov_w",
   "title": "Other ways to confirm ovulation",
   "lines": [
    "• urine LH strip: surge = both lines EQUALLY dark",
    "• ultrasound: follicle collapses (daily scans, impractical)",
    "• 2 days clear stretchy mucus · basal temperature rise"
   ]
  },
  {
