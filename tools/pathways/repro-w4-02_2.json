 "nodes": [
  {
   "id": "root",
   "x": 359,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Infertility: no pregnancy after 1 YEAR of regular, unprotected intercourse · investigate BOTH partners",
   "lines": [
    "work up at 12 MONTHS if under 35 · at 6 MONTHS if 35 or over · IMMEDIATELY if a known cause (e.g. irregular cycles)",
    "female alone 41% · male alone 24% · both 24% · unexplained 11% · affects 10–15% of couples · 85% conceive by 1 year, 93% by 2",
    "PRIMARY = she has never been PREGNANT (his children do not count) · secondary = any prior pregnancy, not necessarily a live birth"
   ]
  },
  {
   "id": "g_f",
   "x": 45,
   "y": 192,
   "w": 884,
   "h": 60,
   "kind": "plain",
   "title": "FEMALE: tests timed to her cycle (day 1 = first day of bleeding)",
   "lines": [
    "days 2–4 bloods · days 6–12 sonohysterogram · day 21 progesterone · AMH any day"
   ]
  },
  {
   "id": "g_m",
   "x": 969,
   "y": 192,
   "w": 212,
   "h": 60,
   "kind": "plain",
   "title": "MALE",
   "lines": [
    "too often only she is referred"
   ]
  },
  {
   "id": "g_r",
   "x": 1221,
   "y": 192,
   "w": 212,
   "h": 60,
   "kind": "plain",
   "title": "Conceives but LOSES it",
   "lines": [
    "≥ 2 losses, biochemical included"
   ]
  },
  {
   "id": "ov_head_0_0",
   "x": 45,
   "y": 332,
   "w": 212,
   "h": 132,
   "kind": "ov_h",
   "title": "Ovulation",
   "lines": [
    "cycles < 21, > 35 days, or < 8 a year: suspect anovulation",
    "1st year after menarche: irregular is normal · after 1 year: > 90 days abnormal"
   ]
  },
  {
   "id": "rs_head_0_0",
   "x": 269,
   "y": 332,
   "w": 212,
   "h": 132,
   "kind": "rs_h",
   "title": "Ovarian reserve",
   "lines": [
    "AGE is the main driver",
    "falls from ~30, faster after"
   ]
  },
  {
