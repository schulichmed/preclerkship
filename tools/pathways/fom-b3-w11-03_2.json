  {
   "id": "fn_clue_0_0",
   "x": 45,
   "y": 398,
   "w": 250,
   "h": 268,
   "kind": "fn_t",
   "title": "Fever in a neutropenic patient",
   "lines": [
    "• one oral temperature > 38.3 °C",
    "• or ≥ 38.0 °C sustained over 1 hour"
   ]
  },
  {
   "id": "aq_clue_0_0",
   "x": 335,
   "y": 398,
   "w": 250,
   "h": 150,
   "kind": "aq_t",
   "title": "Toxins: ask first",
   "lines": [
    "• chemotherapy · radiation",
    "• clozapine · antithyroid (propylthiouracil, carbimazole)",
    "• antibiotics (trimethoprim-sulfamethoxazole, dapsone) · antiepileptics"
   ]
  },
  {
   "id": "aq_clue_1_0",
   "x": 335,
   "y": 570,
   "w": 250,
   "h": 96,
   "kind": "aq_w",
   "title": "Infection",
   "lines": [
    "• viral: EBV, CMV, hepatitis, HIV, influenza",
    "• bacterial: sepsis, mycobacteria"
   ]
  },
  {
   "id": "cg_clue_0_0",
   "x": 597,
   "y": 398,
   "w": 250,
   "h": 268,
   "kind": "cg_t",
   "title": "Constitutional neutropenia",
   "lines": [
    "• seen in some ethnic backgrounds",
    "• BENIGN"
   ]
  },
  {
   "id": "fn_inv_0_0",
   "x": 45,
   "y": 706,
   "w": 250,
   "h": 60,
   "kind": "bad",
   "title": "1 · STABILIZE",
   "lines": [
    "• ABCs · IV fluids · oxygen if hypoxic"
   ]
  },
  {
   "id": "fn_inv_1_0",
   "x": 45,
   "y": 788,
   "w": 250,
   "h": 96,
   "kind": "fn_t",
   "title": "2 · Bloods + CULTURES",
   "lines": [
    "• CBC + diff, electrolytes, urea, creatinine, liver tests",
    "• blood + urine cultures · chest X-ray"
   ]
  },
  {
   "id": "fn_inv_2_0",
   "x": 45,
   "y": 906,
   "w": 250,
   "h": 96,
   "kind": "fn_w",
   "title": "3 · Look for the source",
   "lines": [
    "• mouth, sinuses · lungs · GU · skin + IV line sites · neuro",
    "• NO digital rectal exam (DRE)"
   ]
  },
  {
   "id": "aq_inv_0_0",
   "x": 335.0,
   "y": 706,
   "w": 120.0,
   "h": 127,
   "kind": "aq_w",
   "title": "Autoimmune",
   "lines": [
    "• autoimmune neutropenia",
    "• SLE · RA (Felty)"
   ]
  },
  {
   "id": "aq_inv_0_1",
   "x": 465.0,
   "y": 706,
   "w": 120.0,
   "h": 127,
   "kind": "aq_w",
   "title": "Nutritional",
   "lines": [
    "• B12 · folate · copper",
    "• malnutrition"
   ]
  },
  {
   "id": "aq_inv_1_0",
   "x": 335.0,
   "y": 855,
   "w": 120.0,
   "h": 147,
   "kind": "aq_w",
   "title": "Marrow failure",
   "lines": [
    "• MDS · AML",
    "• lymphoma or metastases in marrow"
   ]
  },
  {
   "id": "aq_inv_1_1",
   "x": 465.0,
   "y": 855,
   "w": 120.0,
   "h": 147,
   "kind": "aq_w",
   "title": "Spleen",
   "lines": [
    "• sequestration in splenomegaly"
   ]
  },
  {
   "id": "cg_inv_0_0",
   "x": 597,
   "y": 706,
   "w": 250,
   "h": 296,
   "kind": "cg_w",
   "title": "Rarer congenital causes",
   "lines": [
    "• cyclic neutropenia",
    "• severe congenital (Kostmann)",
    "• Chediak-Higashi · Shwachman-Diamond · Barth"
   ]
  },
  {
   "id": "fn_tx_0_0",
   "x": 45,
   "y": 1042,
   "w": 250,
   "h": 78,
   "kind": "bad",
   "title": "4 · Empiric IV antibiotics NOW",
   "lines": [
    "• imipenem (carbapenem)",
    "• or piperacillin-tazobactam"
   ]
  },
  {
   "id": "fn_tx_1_0",
   "x": 45,
   "y": 1142,
   "w": 250,
   "h": 78,
   "kind": "warn",
   "title": "5 · ADD IV vancomycin if",
   "lines": [
    "• skin or catheter-site infection",
    "• hemodynamically UNSTABLE"
   ]
  },
  {
   "id": "aq_tx_0_0",
   "x": 335,
   "y": 1042,
   "w": 250,
   "h": 178,
   "kind": "warn",
   "title": "SEVERE: watch for infection",
   "lines": [
    "• bacteria: E. coli, Pseudomonas, Klebsiella, S. aureus, strep",
    "• viral reactivation: HSV, CMV, VZV",
    "• fungi: Candida, Aspergillus"
   ]
  },
