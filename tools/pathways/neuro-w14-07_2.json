   "id": "bd_exam_0_0",
   "x": 45,
   "y": 994,
   "w": 200,
   "h": 630,
   "kind": "bd_w",
   "title": "Nothing above the cord",
   "lines": [
    "• deep coma, no motor response (spinal reflexes allowed)",
    "• NO pupil (mid-size or larger), corneal, vestibulo-ocular, gag, cough",
    "• APNEA test: no breathing effort"
   ]
  },
  {
   "id": "coma_exam_0_0",
   "x": 257,
   "y": 994,
   "w": 200,
   "h": 222,
   "kind": "coma_w",
   "title": "Primitive reflexes only",
   "lines": [
    "• decorticate: arms FLEX, legs extend → above the red nucleus",
    "• decerebrate: all EXTEND → below the red nucleus",
    "• triple flexion (hip, knee, ankle): SPINAL, no brainstem needed",
    "• GCS ≤ 8 = severe brain injury"
   ]
  },
  {
   "id": "coma_exam_1_0",
   "x": 257,
   "y": 1238,
   "w": 200,
   "h": 96,
   "kind": "coma_w",
   "title": "Apply pain",
   "lines": [
    "• central: sternum, trapezius",
    "• central: supraorbital, jaw",
    "• + nail bed"
   ]
  },
  {
   "id": "coma_exam_2_0",
   "x": 257,
   "y": 1356,
   "w": 200,
   "h": 132,
   "kind": "coma_w",
   "title": "GCS 3-15",
   "lines": [
    "• eye 4 · verbal 5 · motor 6",
    "• E2V3M4 = 9 · intubated E2VTM4 = 6T",
    "• shortcomings: intubation",
    "• brainstem barely assessed"
   ]
  },
  {
   "id": "coma_exam_3_0",
   "x": 257,
   "y": 1510,
   "w": 200,
   "h": 114,
   "kind": "coma_w",
   "title": "FOUR score",
   "lines": [
    "• eye, motor, brainstem reflexes, respiration",
    "• 0-4 each · NO verbal part",
    "• works when intubated"
   ]
  },
  {
   "id": "vs_exam_0_0",
   "x": 469,
   "y": 994,
   "w": 200,
   "h": 630,
   "kind": "vs_w",
   "title": "Reflexive, never purposeful",
   "lines": [
    "• grimace, yawn, roving eyes, flexion withdrawal",
    "• brief, UNSUSTAINED pursuit only",
    "• sounds but no words, no commands",
    "• incontinent · cranial nerve reflexes variable",
    "case: 26 y, head injury, 2 years on · eyes open, yawns, sleep-wake cycles"
   ]
  },
