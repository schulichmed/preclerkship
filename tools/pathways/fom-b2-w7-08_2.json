   "kind": "ac_h",
   "title": "Acute illness, presenting ATYPICALLY",
   "lines": [
    "frail older adults may not look textbook"
   ]
  },
  {
   "id": "in_head_0_0",
   "x": 333,
   "y": 280,
   "w": 248,
   "h": 80,
   "kind": "in_h",
   "title": "Intrinsic",
   "lines": [
    "from disease or aging"
   ]
  },
  {
   "id": "ex_head_0_0",
   "x": 593,
   "y": 280,
   "w": 248,
   "h": 80,
   "kind": "ex_h",
   "title": "Extrinsic",
   "lines": [
    "outside the body"
   ]
  },
  {
   "id": "fr_head_0_0",
   "x": 881,
   "y": 280,
   "w": 248,
   "h": 80,
   "kind": "fr_h",
   "title": "Frailty",
   "lines": [
    "LOST reserve to stressors · NOT the same as age, comorbidity or disability"
   ]
  },
  {
   "id": "ac_look_0_0",
   "x": 45,
   "y": 400,
   "w": 248,
   "h": 116,
   "kind": "ac_t",
   "title": "A \"geriatric syndrome\" as the first sign",
   "lines": [
    "• falls, weakness, fatigue",
    "• delirium, incontinence",
    "• functional decline, weight loss"
   ]
  },
  {
   "id": "ac_look_1_0",
   "x": 45,
   "y": 538,
   "w": 248,
   "h": 152,
   "kind": "bad",
   "title": "Don't miss: how it shows in the frail",
   "lines": [
    "• sepsis, stroke",
    "• myocardial infarction (MI): abdominal pain, nausea, delirium",
    "• rapid atrial fibrillation: anorexia, fatigue, FALLS"
   ]
  },
  {
   "id": "ac_look_2_0",
   "x": 45,
   "y": 712,
   "w": 248,
   "h": 150,
   "kind": "ac_w",
   "title": "Also atypical",
   "lines": [
    "• hyperthyroid: new atrial fibrillation, apathy",
    "• appendicitis: diffuse pain, dysuria, tachypnea",
    "• depression: NO sadness, appetite + sleep change"
   ]
  },
  {
   "id": "in_look_0_0",
   "x": 333,
   "y": 400,
   "w": 248,
   "h": 462,
   "kind": "in_t",
   "title": "Body",
   "lines": [
    "• poor balance, weakness",
    "• chronic illness",
    "• visual or cognitive impairment"
   ]
  },
  {
   "id": "ex_look_0_0",
   "x": 593,
   "y": 400,
   "w": 248,
   "h": 462,
   "kind": "ex_t",
   "title": "Drugs + surroundings",
   "lines": [
    "• medications, alcohol",
    "• poor lighting, loose carpets, stairs",
    "• uneven ground, pets, weather"
   ]
  },
  {
   "id": "fr_look_0_0",
   "x": 881,
   "y": 400,
   "w": 248,
   "h": 462,
   "kind": "fr_t",
   "title": "Signs + symptoms",
   "lines": [
    "• SLOW gait (< 1 m/s), sarcopenia, deconditioning",
    "• weakness, weight loss, fatigue, poor intake",
    "• risk: stroke, diabetes, chronic lung disease (COPD), cognitive impairment, depression"
   ]
  },
  {
   "id": "ac_ask_0_0",
   "x": 45,
   "y": 902,
   "w": 248,
   "h": 165,
   "kind": "ac_w",
   "title": "Preceding symptoms",
   "lines": [
    "collateral from family or caregivers"
   ]
  },
  {
   "id": "ac_ask_1_0",
   "x": 45,
   "y": 1089,
   "w": 248,
   "h": 167,
   "kind": "ok",
   "title": "Keep an open mind: find and treat the cause",
   "lines": []
  },
  {
   "id": "in_ask_0_0",
   "x": 333,
   "y": 902,
   "w": 248,
   "h": 354,
   "kind": "in_w",
   "title": "History",
   "lines": [
    "• vision, cognition, PREVIOUS FALLS",
    "• function: activities of daily living (ADLs) + instrumental ADLs (IADLs)"
   ]
  },
  {
   "id": "ex_ask_0_0",
   "x": 593,
   "y": 902,
   "w": 248,
   "h": 354,
   "kind": "ex_w",
   "title": "History",
   "lines": [
    "• medication list, alcohol",
    "• gait aid?",
    "• where: inside or outside, a cluttered home?"
   ]
  },
  {
   "id": "fr_ask_0_0",
   "x": 881,
   "y": 902,
   "w": 248,
   "h": 152,
   "kind": "fr_w",
   "title": "Grade it: Clinical Frailty Scale 1–9",
   "lines": [
    "• 4: vulnerable, slowed, not dependent",
    "• 5–6: help outside the home, then with bathing",
    "• 7–8: fully dependent; 8 could not recover from a minor illness"
   ]
  },
  {
   "id": "fr_ask_1_0",
   "x": 881,
   "y": 1076,
   "w": 248,
   "h": 96,
   "kind": "ok",
   "title": "PREVENT it, no drugs",
   "lines": [
    "• exercise, avoid immobility",
    "• Mediterranean diet + PROTEIN",
    "• comprehensive geriatric assessment"
   ]
  },
  {
   "id": "fr_ask_2_0",
   "x": 881,
   "y": 1194,
   "w": 248,
   "h": 62,
   "kind": "warn",
   "title": "Predicts POOR outcomes with surgery",
   "lines": []
  }
 ],
