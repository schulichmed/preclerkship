 "nodes": [
  {
   "id": "root",
   "x": 429,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "A newborn: keep it PINK, WARM and SWEET, and think SEPSIS in any sick baby",
   "lines": [
    "normal: heart rate 120–160 · respiratory rate 40–60 · axillary temperature 36.5–36.8 °C · never ignore tachypnea or tachycardia"
   ]
  },
  {
   "id": "g_pink",
   "x": 45,
