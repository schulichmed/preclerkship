   "title": "Screening and dynamic tests",
   "items": [
    "cortisol ↓: AM cortisol 6–9 am + paired ACTH",
    "cortisol ↑: two of 24-h urine, 1 mg dexamethasone, late-night saliva",
    "aldosterone: aldosterone/renin ratio",
    "catecholamines: plasma free metanephrines",
    "prolactin: serum prolactin · GH: IGF-1",
    "STIMULATION test for too LITTLE: give the push, a healthy gland rises (cosyntropin, insulin tolerance, CRH, glucagon)",
    "SUPPRESSION test for too MUCH: give the brake, a healthy gland falls (1 mg dexamethasone, saline or salt load, 75 g glucose)"
   ]
  },
