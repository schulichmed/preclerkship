 "nodes": [
  {
   "id": "root",
   "x": 351,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "A small fetus: is it GROWTH-RESTRICTED, and is it time to DELIVER?",
   "lines": [
    "suspect: symphysis-fundus height (SFH) more than 2–3 cm behind the weeks (after 20 weeks), or a risk factor",
    "confirm ONLY by ultrasound: estimated fetal weight (EFW) < 10th percentile = small for gestational age (SGA) · < 3rd = real risk of a bad outcome",
    "intrauterine growth restriction (IUGR) is a PROCESS: it can sit above the 10th percentile"
   ]
  },
  {
   "id": "g_cause",
   "x": 45,
   "y": 174,
   "w": 666,
   "h": 60,
   "kind": "plain",
   "title": "1 · Find the CAUSE",
   "lines": [
    "history first, then tests for the cause it points to"
   ]
  },
  {
   "id": "g_ga",
   "x": 751,
   "y": 174,
   "w": 666,
   "h": 60,
   "kind": "plain",
   "title": "2 · Deliver or wait? GESTATION decides",
   "lines": [
    "fetal well-being: umbilical artery (UA) Doppler · amniotic fluid volume · non-stress test (NST)"
   ]
  },
  {
   "id": "mat_head_0_0",
   "x": 45,
   "y": 314,
   "w": 214,
   "h": 78,
   "kind": "mat_h",
   "title": "Maternal",
   "lines": [
    "often known before conception"
   ]
  },
  {
   "id": "fet_head_0_0",
   "x": 271,
   "y": 314,
   "w": 214,
   "h": 78,
   "kind": "fet_h",
   "title": "Fetal",
   "lines": [
    "abnormal genes impair cell replication"
   ]
  },
  {
   "id": "pla_head_0_0",
   "x": 497,
   "y": 314,
   "w": 214,
   "h": 78,
   "kind": "pla_h",
   "title": "Placental",
   "lines": [
    "damaged microvessels or a disrupted implantation"
   ]
  },
  {
   "id": "lt32_head_0_0",
   "x": 751,
   "y": 314,
   "w": 214,
   "h": 78,
   "kind": "lt32_h",
   "title": "Under 32 weeks",
   "lines": [
    "usually best to monitor"
   ]
  },
  {
   "id": "mid_head_0_0",
   "x": 977,
   "y": 314,
   "w": 214,
   "h": 78,
   "kind": "mid_h",
   "title": "32 to 37 weeks",
   "lines": []
  },
  {
   "id": "ge37_head_0_0",
   "x": 1203,
   "y": 314,
   "w": 214,
   "h": 78,
   "kind": "ge37_h",
   "title": "37 weeks or more",
   "lines": []
  },
  {
   "id": "mat_clue_0_0",
   "x": 45,
   "y": 432,
   "w": 214,
   "h": 114,
   "kind": "mat_t",
   "title": "Ask about",
   "lines": [
    "• hypertension, kidney disease",
    "• lupus, autoimmune",
    "• smoking, substances",
    "• a previous IUGR baby"
   ]
  },
  {
   "id": "fet_clue_0_0",
   "x": 271,
   "y": 432,
   "w": 214,
   "h": 114,
   "kind": "fet_t",
   "title": "Think",
   "lines": [
    "• trisomy 21, 18, 13",
    "• single-gene, translocation",
    "• intrauterine infection",
    "• multiple gestation"
   ]
  },
  {
   "id": "pla_clue_0_0",
   "x": 497,
   "y": 432,
   "w": 214,
   "h": 114,
   "kind": "pla_t",
   "title": "Think",
   "lines": [
    "• placental insufficiency",
    "• abruption",
    "• small clots: lupus, smoking"
   ]
  },
  {
   "id": "lt32_clue_0_0",
   "x": 751,
   "y": 432,
   "w": 214,
   "h": 114,
   "kind": "lt32_t",
   "title": "Fetal DISTRESS?",
   "lines": [
    "• abnormal NST",
    "• ABSENT or REVERSED EDF"
   ]
  },
  {
   "id": "mid_clue_0_0",
   "x": 977,
   "y": 432,
   "w": 214,
   "h": 114,
   "kind": "mid_t",
   "title": "Oligohydramnios? Abnormal Doppler?",
   "lines": [
    "persistently, even just a resistive index > 95th percentile"
   ]
  },
  {
   "id": "ge37_clue_0_0",
   "x": 1203,
   "y": 432,
   "w": 214,
   "h": 114,
   "kind": "ge37_t",
   "title": "Little to gain by waiting",
   "lines": [
    "even with no other risk"
   ]
  },
  {
   "id": "mat_inv_0_0",
   "x": 45,
   "y": 586,
   "w": 214,
   "h": 178,
   "kind": "mat_w",
   "title": "1 · Extra growth scans",
   "lines": [
    "• 26–28 weeks",
    "• 34–36 weeks",
    "• more often once IUGR is found"
   ]
  },
  {
   "id": "fet_inv_0_0",
   "x": 271,
   "y": 586,
   "w": 214,
   "h": 96,
   "kind": "fet_w",
   "title": "1 · Chromosomes",
   "lines": [
    "• enhanced first trimester screen",
    "• non-invasive prenatal testing",
    "• amniocentesis"
   ]
  },
  {
   "id": "fet_inv_1_0",
   "x": 271,
   "y": 704,
   "w": 214,
   "h": 60,
   "kind": "fet_w",
   "title": "2 · Infection",
   "lines": [
    "toxoplasmosis, cytomegalovirus"
   ]
  },
  {
   "id": "pla_inv_0_0",
   "x": 497,
   "y": 586,
   "w": 214,
   "h": 178,
   "kind": "pla_w",
   "title": "1 · UA Doppler: it worsens in order",
   "lines": [
