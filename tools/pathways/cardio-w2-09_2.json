 "nodes": [
  {
   "id": "root",
   "x": 112,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Fever + a damaged valve, a device, IV drug use or a new murmur: is it infective endocarditis (IE)?",
   "lines": [
    "search every system for EMBOLI and for HEART FAILURE"
   ]
  },
  {
   "id": "g_all",
   "x": 45,
   "y": 120,
   "w": 894,
   "h": 60,
   "kind": "plain",
   "title": "1 · Three sets of blood cultures  →  2 · Transthoracic echo (TTE)  →  3 · Count the modified DUKE criteria",
   "lines": [
    "cultures from 3 sites, all within the first hour if very sick; echo as soon as IE is suspected"
   ]
  },
  {
   "id": "p_duke",
   "x": 45,
   "y": 220,
   "w": 894,
   "h": 96,
   "kind": "info",
   "title": "DEFINITE: 2 major, 1 major + 3 minor, or 5 minor  |  POSSIBLE: 1 major + 1 minor, or 3 minor  →  treat both",
   "lines": [
    "• MAJOR: typical organism in 2 cultures, cultures persistently positive (> 12 h apart), Coxiella, or echo showing vegetation, abscess or new regurgitation",
    "• MINOR: predisposing heart lesion or IV drug use, fever ≥ 38 °C, emboli (Janeway lesions), immune signs (Osler nodes, Roth spots)"
   ]
  },
  {
   "id": "nv_head_0_0",
   "x": 45,
   "y": 396,
   "w": 290,
   "h": 78,
   "kind": "nv_h",
   "title": "Native valve IE",
   "lines": [
    "rheumatic, prolapsed, bicuspid or congenitally abnormal valve"
   ]
  },
  {
   "id": "pv_head_0_0",
   "x": 347,
   "y": 396,
   "w": 290,
   "h": 78,
   "kind": "pv_h",
   "title": "Prosthetic valve or device IE",
   "lines": [
    "new fever after valve surgery = IE until proven otherwise"
   ]
  },
  {
   "id": "cn_head_0_0",
   "x": 649,
   "y": 396,
   "w": 290,
   "h": 78,
   "kind": "cn_h",
   "title": "Culture-negative IE",
   "lines": [
    "organisms that do not grow in routine bottles"
   ]
  },
  {
   "id": "nv_clue_0_0",
   "x": 45,
   "y": 514,
   "w": 290,
   "h": 96,
   "kind": "nv_t",
   "title": "SUBACUTE: weeks of vague illness",
   "lines": [
    "• fever, night sweats, weight loss",
    "• NEW regurgitant murmur, heart failure",
    "• splinters, Janeway lesions, Osler nodes"
   ]
  },
  {
   "id": "nv_clue_1_0",
   "x": 45,
   "y": 632,
   "w": 290,
   "h": 60,
   "kind": "bad",
   "title": "ACUTE: fulminant sepsis",
   "lines": [
    "emboli, valve destruction, decompensation"
   ]
  },
  {
   "id": "pv_clue_0_0",
   "x": 347,
   "y": 514,
   "w": 290,
   "h": 178,
   "kind": "pv_t",
   "title": "Fever after valve replacement",
   "lines": [
    "• or a device with persistent fever",
    "• even with no new murmur or bacteremia"
   ]
  },
  {
   "id": "cn_clue_0_0",
   "x": 649,
   "y": 514,
   "w": 290,
   "h": 178,
   "kind": "cn_t",
   "title": "IE picture, sterile cultures",
   "lines": [
    "• Coxiella burnetii (Q fever)",
    "• Bartonella, Brucella, Legionella",
    "• Tropheryma whipplei, Chlamydia"
   ]
  },
  {
   "id": "nv_org_0_0",
   "x": 45.0,
   "y": 732,
   "w": 140.0,
   "h": 132,
   "kind": "nv_w",
   "title": "Most",
   "lines": [
    "• streptococci",
    "• Staphylococcus aureus",
    "• enterococci, HACEK"
   ]
  },
  {
   "id": "nv_org_0_1",
   "x": 195.0,
   "y": 732,
   "w": 140.0,
   "h": 132,
   "kind": "nv_w",
   "title": "IV drug use",
   "lines": [
    "• S. aureus",
    "• usually the TRICUSPID valve"
   ]
  },
  {
   "id": "pv_org_0_0",
   "x": 347.0,
   "y": 732,
   "w": 140.0,
   "h": 132,
   "kind": "pv_w",
   "title": "EARLY < 60 days",
   "lines": [
    "• coagulase-negative staph",
    "• then S. aureus"
   ]
  },
  {
   "id": "pv_org_0_1",
   "x": 497.0,
   "y": 732,
   "w": 140.0,
   "h": 132,
   "kind": "pv_w",
   "title": "LATE > 60 days",
   "lines": [
    "• streptococci",
    "• then S. aureus"
   ]
  },
  {
   "id": "cn_org_0_0",
   "x": 649,
   "y": 732,
   "w": 290,
   "h": 132,
   "kind": "cn_w",
   "title": "Coxiella can still be MAJOR",
   "lines": [
    "• one positive culture",
    "• or anti-phase I IgG > 1:800"
   ]
  },
  {
   "id": "nv_inv_0_0",
   "x": 45,
   "y": 904,
   "w": 290,
   "h": 60,
   "kind": "nv_t",
   "title": "1 · TTE first",
   "lines": [
    "small vegetations can be missed"
   ]
  },
  {
   "id": "nv_inv_1_0",
   "x": 45,
   "y": 986,
   "w": 290,
   "h": 60,
   "kind": "nv_w",
   "title": "2 · Negative TTE + high suspicion",
   "lines": [
    "→ transesophageal echo (TEE)"
   ]
  },
  {
   "id": "pv_inv_0_0",
   "x": 347,
   "y": 904,
   "w": 290,
   "h": 142,
   "kind": "pv_t",
   "title": "LOW threshold for TEE",
   "lines": [
    "• cultures + echo BEFORE assuming another cause",
    "• TEE finds abscess, perforation, fistula"
   ]
  },
  {
   "id": "cn_inv_0_0",
   "x": 649,
   "y": 904,
   "w": 290,
   "h": 142,
   "kind": "cn_t",
   "title": "TTE, then TEE as for native valve",
   "lines": []
  },
  {
   "id": "nv_tx_0_0",
   "x": 45,
   "y": 1086,
   "w": 290,
   "h": 96,
   "kind": "ok",
   "title": "IV vancomycin + IV cefepime",
   "lines": [
    "6–12 weeks"
   ]
  },
  {
   "id": "pv_tx_0_0",
   "x": 347,
   "y": 1086,
   "w": 290,
   "h": 96,
   "kind": "ok",
   "title": "IV vancomycin + IV cefepime",
   "lines": [
    "6–12 weeks"
   ]
  },
  {
   "id": "cn_tx_0_0",
   "x": 649,
   "y": 1086,
   "w": 290,
   "h": 96,
   "kind": "ok",
   "title": "Three drugs, 6–12 weeks",
   "lines": [
    "• IV vancomycin",
    "• IV ceftriaxone",
    "• IV gentamicin or doxycycline"
   ]
  },
  {
   "id": "span0_surg_0_0",
   "x": 45,
   "y": 1222,
   "w": 894,
   "h": 60,
   "kind": "warn",
   "title": "1 · Major ischemic stroke or intracranial hemorrhage?",
   "lines": [
    "YES → DELAY surgery at least 4 weeks"
   ]
  },
  {
   "id": "span0_surg_1_0",
   "x": 45.0,
   "y": 1304,
   "w": 442.0,
   "h": 114,
   "kind": "bad",
   "title": "2 · EARLY surgery if ANY",
   "lines": [
    "• heart failure from valve dysfunction or a fistula",
    "• abscess or heart block",
    "• persistent infection, resistant organism (S. aureus, fungi), relapsing prosthetic IE"
   ]
  },
  {
   "id": "span0_surg_1_1",
   "x": 497.0,
   "y": 1304,
   "w": 442.0,
   "h": 114,
   "kind": "warn",
   "title": "3 · CONSIDER early surgery",
   "lines": [
    "• mobile vegetation > 10 mm (anterior mitral leaflet)",
    "• recurrent emboli despite antibiotics"
   ]
  },
  {
   "id": "span0_surg_2_0",
   "x": 45,
   "y": 1440,
   "w": 894,
   "h": 60,
   "kind": "ok",
   "title": "None of these",
   "lines": [
    "continue antibiotics, reassess, re-image"
   ]
  }
 ],
