   "w": 290,
   "h": 114,
   "kind": "cert_h",
   "title": "Death certificate (Form 16)",
   "lines": [
    "doctor or certain nurses sign · NOT for stillbirths",
    "identity · cause · MANNER · autopsy done?"
   ]
  },
  {
   "id": "ml_who_0_0",
   "x": 45,
   "y": 486,
   "w": 290,
   "h": 322,
   "kind": "bad",
   "title": "The CORONER'S ACT",
   "lines": [
    "the family does NOT authorize it"
   ]
  },
  {
   "id": "hosp_who_0_0",
   "x": 375,
   "y": 486,
   "w": 290,
   "h": 205,
   "kind": "hosp_t",
   "title": "INFORMED authorization, in this ORDER",
   "lines": [
    "1 · estate trustee",
    "2 · spouse and adult children",
    "3 · parents",
    "4 · siblings",
    "5 · any other capable next of kin",
    "~same duties as with a patient: consent, professionalism, confidentiality"
   ]
  },
  {
   "id": "hosp_who_1_0",
   "x": 375,
   "y": 713,
   "w": 290,
   "h": 95,
   "kind": "hosp_w",
   "title": "They may RESTRICT it",
   "lines": [
    "• limited internal exam",
    "• no organ retention (brain, heart)"
   ]
  },
  {
   "id": "cert_who_0_0",
   "x": 677,
   "y": 486,
   "w": 290,
   "h": 222,
   "kind": "cert_t",
   "title": "Part I: the causal chain, backwards",
   "lines": [
    "(a) immediate ← (b) intermediate ← (c) underlying",
    "each line causes the one above it",
    "~hemopericardium ← ruptured myocardial infarct ← coronary atherosclerosis + thrombosis · II: diabetes",
    "~upper GI bleed ← ruptured esophageal varix ← alcoholic cirrhosis · II: hemophilia",
    "~right lung squamous cell carcinoma · II: tobacco smoking"
   ]
  },
  {
   "id": "cert_who_1_0",
   "x": 677,
   "y": 730,
   "w": 290,
   "h": 78,
   "kind": "cert_w",
   "title": "Part II: contributed, outside the chain",
   "lines": [
    "often risk factors, e.g. diabetes, tobacco smoking"
   ]
  },
  {
   "id": "ml_do_0_0",
   "x": 45,
   "y": 848,
   "w": 290,
   "h": 286,
   "kind": "ml_w",
   "title": "Coroner or medical examiner",
   "lines": [
    "signs the death certificate"
   ]
  },
  {
   "id": "hosp_do_0_0",
   "x": 375,
   "y": 848,
   "w": 290,
   "h": 286,
   "kind": "ok",
   "title": "Why do it",
   "lines": [
    "• diagnosis, extent, effect of treatment",
    "• accuracy of clinical tests and imaging · unresolved questions",
    "• SUSPECTED GENETIC disease: tell living relatives",
    "• grief · teaching · research · the death certificate"
   ]
  },
  {
   "id": "cert_do_0_0",
   "x": 677,
   "y": 848,
   "w": 290,
   "h": 132,
   "kind": "ok",
   "title": "Be SPECIFIC",
   "lines": [
    "• infection: disease or organism + site (COVID-19 pneumonia, H. influenzae meningoencephalitis)",
    "• cancer: origin + spread + type (pulmonary metastasis of colonic adenocarcinoma)"
   ]
  },
  {
   "id": "cert_do_1_0",
   "x": 677,
   "y": 1002,
   "w": 290,
   "h": 132,
   "kind": "bad",
   "title": "NEVER a mechanism",
   "lines": [
    "the physiological process of dying adds nothing:",
    "cardiac arrest · arrhythmia · exsanguination · respiratory arrest · multisystem organ failure · sepsis"
   ]
  },
  {
   "id": "cert_how_0_0",
   "x": 677,
   "y": 1174,
   "w": 290,
   "h": 84,
   "kind": "cert_w",
   "title": "What the certificate is for",
   "lines": [
    "• permanent legal record",
    "• proof of death: family, legal, insurance"
   ]
  },
  {
   "id": "cert_how_1_0",
   "x": 677,
   "y": 1280,
   "w": 290,
   "h": 102,
   "kind": "cert_w",
   "title": "Statistics (ICD)",
   "lines": [
    "• the UNDERLYING cause is what gets coded",
    "• research · surveillance",
    "• public health planning · research funding"
   ]
  },
  {
   "id": "cert_how_2_0",
   "x": 677,
   "y": 1404,
   "w": 290,
   "h": 102,
   "kind": "info",
   "title": "Causation (Hume)",
   "lines": [
    "• a time-ordered, linked chain A → B → C → death",
    "• the initiating event sets the manner"
   ]
  },
  {
   "id": "span0_how_0_0",
   "x": 45.0,
