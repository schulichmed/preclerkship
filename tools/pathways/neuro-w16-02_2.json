   "w": 305.0,
   "h": 114,
   "kind": "plain",
   "title": "2 · External",
   "lines": [
    "• nutrition · identifying marks",
    "• all surfaces",
    "• disease, anomalies, injuries",
    "• resuscitation"
   ]
  },
  {
   "id": "span0_how_1_0",
   "x": 45.0,
   "y": 1310,
   "w": 305.0,
   "h": 96,
   "kind": "plain",
   "title": "3 · Internal",
   "lines": [
    "• Y-shaped incision",
    "• organ block, weighed",
    "• brain removed · special dissections"
   ]
  },
  {
   "id": "span0_how_1_1",
