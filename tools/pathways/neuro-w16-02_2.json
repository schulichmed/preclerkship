   "id": "root",
   "x": 126,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "A patient has died: does the coroner need to know?",
   "lines": [
    "call the coroner if ANY: family concerned about care · sudden and unexpected (no potentially fatal illness) · unnatural (accident, suicide, homicide) · death on a psychiatry ward · maternal death · seizure disorder · Children's Aid involved in a child's death",
    "autopsy (necropsy, postmortem): same procedure either way, different focus · always by a pathologist"
   ]
  },
  {
   "id": "g_yes",
   "x": 45,
   "y": 174,
   "w": 290,
   "h": 78,
   "kind": "plain",
   "title": "YES: coroner's case",
   "lines": [
    "sudden and unexpected, or any indication above"
   ]
  },
  {
   "id": "g_no",
   "x": 375,
   "y": 174,
   "w": 592,
   "h": 78,
   "kind": "plain",
   "title": "NO: expected natural death",
   "lines": []
