  {
   "x": 45,
   "y": 1340,
   "w": 483,
   "title": "Inflammatory vs mechanical back pain",
   "items": [
    "inflammatory: under 40 · insidious · > 3 months · stiffness > 60 min · night pain · BETTER with activity · sacroiliac tender · chest expansion ↓ · neuro deficit unlikely",
    "mechanical: any age · acute · < 4 weeks · stiffness < 30 min · WORSE with activity · neuro deficit possible"
   ],
   "cols": 1
  },
  {
   "x": 542,
   "y": 1340,
   "w": 483,
   "title": "Also in the family",
   "items": [
