   "x": 725,
   "y": 158,
   "w": 300,
   "h": 62,
   "kind": "plain",
   "title": "Gut or genital infection 1-3 weeks before",
   "lines": []
  },
  {
   "id": "as_head_0_0",
   "x": 45,
   "y": 300,
   "w": 300,
   "h": 96,
   "kind": "as_h",
   "title": "Ankylosing spondylitis",
   "lines": [
    "the prototype · HLA-B27 in > 90% (white patients)",
    "but 8% of everyone carries HLA-B27"
   ]
  },
  {
   "id": "psa_head_0_0",
   "x": 385,
   "y": 300,
   "w": 300,
   "h": 96,
   "kind": "psa_h",
   "title": "Psoriatic arthritis",
   "lines": [
    "5-7% of people with psoriasis",
    "HLA-B27, B38, B39, DR4"
   ]
  },
  {
   "id": "rea_head_0_0",
   "x": 725,
   "y": 300,
   "w": 300,
   "h": 96,
   "kind": "rea_h",
   "title": "Reactive arthritis",
   "lines": [
    "young men, 20-40 · HLA-B27 linked",
    "NOT 'Reiter's syndrome'"
   ]
  },
  {
   "id": "as_pres_0_0",
   "x": 45,
   "y": 436,
   "w": 300,
   "h": 105,
   "kind": "as_t",
   "title": "Starts at the sacroiliac joints, climbs",
   "lines": [
    "• onset < 40, insidious, > 3 months",
    "• stiffness > 60 min, night pain",
    "• BETTER with activity"
   ]
  },
  {
   "id": "as_pres_1_0",
   "x": 45,
   "y": 563,
   "w": 300,
   "h": 105,
   "kind": "as_w",
   "title": "Beyond the spine",
   "lines": [
    "• anterior uveitis (25-30%)",
    "• aortitis, aortic regurgitation, conduction block",
    "• upper-lobe fibrosis · lower-limb oligoarthritis"
   ]
  },
  {
   "id": "psa_pres_0_0",
   "x": 385,
   "y": 436,
   "w": 300,
   "h": 96,
   "kind": "psa_t",
   "title": "Psoriasis comes first in ⅔",
   "lines": [
    "• arthritis first or together in ⅓",
    "• hidden: scalp, navel, behind ears, perianal, nails"
   ]
  },
  {
   "id": "psa_pres_1_0",
   "x": 385,
   "y": 554,
   "w": 300,
   "h": 114,
   "kind": "psa_w",
   "title": "Patterns",
   "lines": [
    "• asymmetric oligoarthritis (> 50%)",
    "• axial 20-40% · rheumatoid-like 15-25%",
    "• mostly distal finger joints 5-10% · arthritis mutilans 5%"
   ]
  },
  {
   "id": "rea_pres_0_0",
   "x": 725,
   "y": 436,
   "w": 300,
   "h": 105,
   "kind": "rea_t",
   "title": "Trigger 1-3 weeks earlier",
   "lines": [
    "• gut: Salmonella, Shigella, Campylobacter",
    "• genitourinary: Chlamydia, other sexual infections"
   ]
  },
  {
   "id": "rea_pres_1_0",
   "x": 725,
   "y": 563,
   "w": 300,
   "h": 105,
   "kind": "rea_w",
   "title": "Can't see, can't pee, can't climb a tree",
   "lines": [
    "• conjunctivitis or uveitis",
    "• urethritis or cervicitis",
    "• large-joint oligoarthritis, sacroiliitis, enthesitis"
   ]
  },
  {
   "id": "as_inv_0_0",
   "x": 45,
   "y": 708,
   "w": 300,
   "h": 78,
   "kind": "as_t",
   "title": "1 · Spinal mobility",
   "lines": [
    "• modified Schober · chest expansion",
    "• occiput-to-wall, tragus-to-wall"
   ]
  },
  {
   "id": "as_inv_1_0",
   "x": 45,
   "y": 808,
   "w": 300,
   "h": 96,
   "kind": "as_t",
   "title": "2 · Sacroiliac X-ray",
   "lines": [
    "bilateral, symmetric: iliac-side erosion → sclerosis → fusion",
    "late: 'bamboo spine'"
   ]
  },
  {
   "id": "as_inv_2_0",
   "x": 45,
   "y": 926,
   "w": 300,
   "h": 78,
   "kind": "as_w",
   "title": "X-ray normal → MRI",
   "lines": [
    "bone marrow edema = non-radiographic axial SpA"
   ]
  },
  {
   "id": "psa_inv_0_0",
   "x": 385,
   "y": 708,
   "w": 300,
   "h": 146,
   "kind": "psa_t",
   "title": "Nails in 80% · dactylitis",
   "lines": [
    "• pitting, onycholysis, oil spots",
    "• conjunctivitis 20% · uveitis 7%"
   ]
  },
  {
   "id": "psa_inv_1_0",
   "x": 385,
   "y": 876,
   "w": 300,
   "h": 128,
   "kind": "psa_w",
   "title": "Axial: ASYMMETRIC sacroiliitis",
   "lines": [
    "big non-marginal 'jug-handle' syndesmophytes"
   ]
  },
  {
   "id": "rea_inv_0_0",
   "x": 725,
   "y": 708,
   "w": 300,
   "h": 146,
   "kind": "rea_t",
   "title": "Psoriasis-like skin",
   "lines": [
    "• keratoderma blennorrhagicum",
    "• circinate balanitis"
   ]
  },
  {
   "id": "rea_inv_1_0",
   "x": 725,
   "y": 876,
   "w": 300,
   "h": 128,
   "kind": "bad",
   "title": "NOT an infection of the joint",
   "lines": [
    "that is septic arthritis"
   ]
  },
  {
   "id": "as_tx_0_0",
   "x": 45,
   "y": 1044,
   "w": 300,
   "h": 60,
   "kind": "ok",
   "title": "1 · Physiotherapy for ALL",
   "lines": [
    "posture, chest expansion"
   ]
  },
  {
   "id": "as_tx_1_0",
   "x": 45,
   "y": 1126,
   "w": 300,
   "h": 60,
   "kind": "ok",
   "title": "2 · NSAIDs (indomethacin best)",
   "lines": [
    "mild-moderate · watch the gut"
   ]
  },
  {
   "id": "as_tx_2_0",
   "x": 45,
   "y": 1208,
   "w": 300,
   "h": 98,
   "kind": "ok",
   "title": "3 · Tumour necrosis factor (TNF) or interleukin-17 (IL-17) inhibitor",
   "lines": [
    "conventional disease-modifying drugs do NOT work in the spine"
   ]
  },
  {
   "id": "psa_tx_0_0",
   "x": 385,
   "y": 1044,
   "w": 300,
   "h": 67,
   "kind": "ok",
   "title": "1 · Methotrexate (skin + joints)",
   "lines": [
    "or sulfasalazine, leflunomide"
   ]
  },
  {
   "id": "psa_tx_1_0",
   "x": 385,
   "y": 1133,
   "w": 300,
   "h": 67,
   "kind": "bad",
   "title": "AVOID hydroxychloroquine",
   "lines": [
    "severe psoriasis flares"
   ]
  },
  {
   "id": "psa_tx_2_0",
   "x": 385,
   "y": 1222,
   "w": 300,
   "h": 85,
   "kind": "ok",
   "title": "2 · Apremilast or a biologic",
   "lines": [
    "• TNF inhibitor: skin, joints, spine, nails",
    "• IL-17: skin + spine · IL-12/23: NOT the spine"
   ]
  },
  {
   "id": "rea_tx_0_0",
   "x": 725,
   "y": 1044,
   "w": 300,
   "h": 120,
   "kind": "ok",
   "title": "Treat by symptoms",
   "lines": [
    "self-limiting, chronic or progressive"
   ]
  },
  {
   "id": "rea_tx_1_0",
   "x": 725,
   "y": 1186,
   "w": 300,
   "h": 120,
   "kind": "warn",
   "title": "Chronic arthritis or sacroiliitis",
   "lines": [
    "in 15-30%"
   ]
  }
 ],
