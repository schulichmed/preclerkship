 "nodes": [
  {
   "id": "root",
   "x": 66,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Heartburn or regurgitation: treat it as GERD, or does it need a SCOPE?",
   "lines": [
    "gastroesophageal reflux disease (GERD) is a CLINICAL diagnosis: classic symptoms + NO alarm features ± response to a proton pump inhibitor (PPI) trial",
    "endoscopy does NOT diagnose GERD: it looks for complications and other diagnoses"
   ]
  },
  {
   "id": "g_tx",
   "x": 45,
   "y": 156,
   "w": 250,
   "h": 96,
   "kind": "plain",
   "title": "Classic, NO alarm features: TREAT",
   "lines": [
    "no test needed"
   ]
  },
  {
   "id": "g_sc",
   "x": 335,
   "y": 156,
   "w": 512,
   "h": 96,
   "kind": "plain",
   "title": "ENDOSCOPY if ANY of these",
   "lines": [
    "• alarm features or Barrett's risk factors",
    "• refractory symptoms or diagnostic uncertainty",
    "• abnormal upper GI imaging"
   ]
  },
  {
   "id": "ty_head_0_0",
   "x": 45,
   "y": 332,
   "w": 250,
   "h": 78,
   "kind": "ty_h",
   "title": "Typical GERD",
   "lines": [
    "erosive esophagitis or non-erosive reflux disease (NERD)"
   ]
  },
  {
   "id": "al_head_0_0",
   "x": 335,
   "y": 332,
   "w": 250,
   "h": 78,
   "kind": "al_h",
   "title": "Cancer or Barrett's?",
   "lines": [
    "look for complications"
   ]
  },
  {
   "id": "rf_head_0_0",
   "x": 597,
   "y": 332,
   "w": 250,
   "h": 78,
   "kind": "rf_h",
   "title": "Refractory or uncertain",
   "lines": [
    "no response to a standard-dose PPI"
   ]
  },
  {
   "id": "ty_pres_0_0",
   "x": 45,
   "y": 450,
   "w": 250,
   "h": 133,
   "kind": "ty_t",
   "title": "HEARTBURN or REGURGITATION",
   "lines": [
    "worse lying down, bending, lifting"
   ]
  },
  {
   "id": "ty_pres_1_0",
   "x": 45,
   "y": 605,
   "w": 250,
   "h": 149,
   "kind": "ty_w",
   "title": "Atypical",
   "lines": [
    "• chest pain: ECG FIRST, always",
    "• globus, chronic cough, hoarseness",
    "• dental caries"
   ]
  },
  {
   "id": "al_pres_0_0",
   "x": 335,
   "y": 450,
   "w": 250,
   "h": 132,
   "kind": "bad",
   "title": "Alarm features",
   "lines": [
    "• new dyspepsia at ≥ 60",
    "• GI bleeding, iron deficiency anemia",
    "• weight loss, dysphagia, odynophagia",
    "• persistent vomiting",
    "• GI cancer in a first-degree relative"
   ]
  },
  {
   "id": "al_pres_1_0",
   "x": 335,
   "y": 604,
   "w": 250,
   "h": 150,
   "kind": "al_w",
   "title": "Barrett's risk factors",
   "lines": [
    "• GERD ≥ 5–10 years, age ≥ 50, male, Caucasian",
    "• obesity, hiatal hernia, nocturnal reflux, smoking",
    "• relative with Barrett's or adenocarcinoma"
   ]
  },
  {
   "id": "rf_pres_0_0",
   "x": 597,
   "y": 450,
   "w": 250,
   "h": 304,
   "kind": "rf_t",
   "title": "Why the PPI failed",
   "lines": [
    "• timing or adherence",
    "• fast PPI metabolism (CYP2C19)",
    "• non-acid reflux (bile)",
    "• reflux hypersensitivity",
    "• functional heartburn",
    "• another diagnosis"
   ]
  },
  {
