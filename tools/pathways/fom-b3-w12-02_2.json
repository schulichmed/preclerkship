   "w": 222,
   "h": 332,
   "kind": "ai_t",
   "title": "Specific testing",
   "lines": [
    "• serology: HIV, hepatitis B + C"
   ]
  },
  {
   "id": "ma_inv_0_0",
   "x": 569,
   "y": 794,
   "w": 222,
   "h": 78,
   "kind": "ma_t",
   "title": "1 · Bloods",
   "lines": [
    "CBC + diff, LDH, calcium, albumin, liver + kidney function"
   ]
  },
  {
   "id": "ma_inv_1_0",
   "x": 569,
   "y": 894,
   "w": 222,
   "h": 96,
   "kind": "ma_w",
   "title": "2 · Imaging",
   "lines": [
    "• ultrasound (first choice < 14 years)",
    "• CT, chest X-ray"
   ]
  },
  {
   "id": "ma_inv_2_0",
   "x": 569,
   "y": 1012,
   "w": 222,
   "h": 114,
   "kind": "ma_t",
   "title": "3 · EXCISIONAL biopsy",
   "lines": [
    "• histology, flow cytometry",
    "• Gram stain, AFB, cultures",
    "• FNA if adenocarcinoma suspected"
   ]
  },
  {
