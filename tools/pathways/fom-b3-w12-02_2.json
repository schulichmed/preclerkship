   ]
  },
  {
   "id": "be_clue_0_0",
   "x": 45,
   "y": 414,
   "w": 222,
   "h": 340,
   "kind": "be_t",
   "title": "Clues",
   "lines": [
    "• tender, infection in the area it drains",
    "• ear, nose or throat symptoms",
    "• e.g. upper respiratory infection, mononucleosis, dental, skin"
   ]
  },
  {
   "id": "ai_clue_0_0",
   "x": 307,
   "y": 414,
   "w": 222,
   "h": 340,
   "kind": "ai_t",
   "title": "Clues",
   "lines": [
    "• rash, arthralgia, myalgia, mouth ulcers",
    "• cat scratch, tick bite, travel, sexual history",
    "• drugs: phenytoin, carbamazepine, allopurinol"
   ]
  },
  {
   "id": "ma_clue_0_0",
   "x": 569,
   "y": 414,
   "w": 222,
   "h": 150,
   "kind": "ma_t",
   "title": "The node",
   "lines": [
    "• SUPRACLAVICULAR: abdominal or chest cancer",
    "• generalized, FIXED, non-tender, MATTED",
    "• ≥ 2 cm and growing, or no better after 2 weeks of antibiotics"
   ]
  },
  {
   "id": "ma_clue_1_0",
   "x": 569,
   "y": 586,
   "w": 222,
   "h": 168,
   "kind": "ma_w",
   "title": "The patient",
   "lines": [
    "• B symptoms: fever > 1 wk, night sweats, weight loss > 10%",
    "• abnormal CBC (blasts, cytopenias) or chest X-ray (mediastinal mass)",
    "• NO ENT symptoms, ESR/CRP rising"
   ]
  },
  {
   "id": "ge_clue_0_0",
   "x": 831,
   "y": 414,
   "w": 222,
   "h": 340,
   "kind": "ge_t",
   "title": "Common causes",
   "lines": [
    "• leukemia, lymphoma, solid tumour",
    "• sarcoid, SLE, RA",
    "• HIV, EBV, TB, syphilis, fungi"
   ]
  },
  {
   "id": "re_clue_0_0",
   "x": 1065,
   "y": 414,
   "w": 222,
   "h": 186,
   "kind": "re_t",
   "title": "The site points to the cause",
   "lines": [
    "• NECK: EBV, pharyngitis, mycobacteria · head + neck cancer, lymphoma",
    "• ARMPIT: breast cancer, melanoma · skin infection",
    "• GROIN (normally palpable): STI, leg infection · penile, vulvar, anal cancer"
   ]
  },
  {
   "id": "re_clue_1_0",
   "x": 1065,
   "y": 622,
   "w": 222,
   "h": 132,
   "kind": "re_w",
   "title": "Less common sites",
   "lines": [
    "• ELBOW (epitrochlear): secondary syphilis, local infection",
    "• MEDIASTINUM (on imaging): TB, sarcoidosis, cancer"
   ]
  },
  {
   "id": "be_inv_0_0",
   "x": 45,
   "y": 794,
   "w": 222,
   "h": 332,
   "kind": "be_t",
   "title": "No specific testing",
   "lines": [
    "history + exam made the diagnosis"
   ]
  },
  {
   "id": "ai_inv_0_0",
   "x": 307,
