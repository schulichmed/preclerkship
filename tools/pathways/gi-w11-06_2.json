  {
   "id": "root",
   "x": 297,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Constipation: a CAUSE to find, or FUNCTIONAL?",
   "lines": [
    "history matters more than exam: fibre, water, time for the toilet, medications · PAIN → think irritable bowel syndrome",
    "digital rectal exam (DRE): fissure, hemorrhoids, tone at rest and squeeze, rectal mass, impaction"
   ]
  },
  {
   "id": "g_rf",
   "x": 45,
   "y": 138,
   "w": 232,
   "h": 116,
   "kind": "plain",
   "title": "RED FLAGS? → COLONOSCOPY",
   "lines": [
    "colorectal cancer until proven otherwise"
   ]
  },
  {
   "id": "g_sec",
   "x": 317,
   "y": 138,
   "w": 232,
   "h": 116,
   "kind": "plain",
   "title": "SECONDARY: drug or disease?",
   "lines": [
    "complete blood count, calcium, thyroid-stimulating hormone (TSH) for everyone"
   ]
  },
  {
   "id": "g_pri",
   "x": 589,
   "y": 138,
   "w": 720,
   "h": 116,
   "kind": "plain",
   "title": "PRIMARY (most common): Rome IV",
   "lines": [
    "≥ 2 of: < 3 bowel movements a week, straining, hard or lumpy stools, incomplete emptying, blockage, manual help",
    "for 3 months · loose stools rare without laxatives · not irritable bowel syndrome"
   ]
  },
  {
   "id": "t_ref",
   "x": 833,
   "y": 294,
   "w": 476,
   "h": 60,
   "kind": "plain",
   "title": "Fails fibre + laxatives: TEST transit and the pelvic floor",
   "lines": [
    "referral to a motility specialist first"
   ]
  },
