   "id": "alk_how_0_0",
   "x": 45,
   "y": 468,
   "w": 214,
   "h": 290,
   "kind": "alk_t",
   "title": "Cross-link guanine",
   "lines": [
    "DNA strands cannot separate → arrest → apoptosis"
   ]
  },
  {
   "id": "ame_how_0_0",
   "x": 271,
   "y": 468,
   "w": 214,
   "h": 290,
   "kind": "ame_t",
   "title": "Block nucleic-acid synthesis",
   "lines": [
    "DNA and RNA cannot be made"
   ]
  },
  {
   "id": "top_how_0_0",
   "x": 497,
   "y": 468,
   "w": 214,
   "h": 290,
   "kind": "top_t",
   "title": "Block topoisomerase",
   "lines": [
    "DNA cannot uncoil or stays broken → apoptosis"
   ]
  },
  {
   "id": "mic_how_0_0",
   "x": 723,
   "y": 468,
   "w": 214,
   "h": 290,
   "kind": "mic_t",
   "title": "Stop mitosis (M phase)",
   "lines": [
    "• vinca alkaloids: block microtubule assembly",
    "• taxanes: freeze microtubules"
   ]
  },
  {
   "id": "mab_how_0_0",
   "x": 977,
   "y": 468,
   "w": 214,
   "h": 132,
   "kind": "mab_t",
   "title": "NAKED: bind a CD marker",
   "lines": [
    "• rituximab (CD20): B-cell cancers",
    "• daratumumab (CD38): myeloma",
    "• brentuximab (CD30): Hodgkin"
   ]
  },
  {
   "id": "mab_how_1_0",
   "x": 977,
   "y": 622,
   "w": 214,
   "h": 136,
   "kind": "mab_w",
   "title": "CHECKPOINT: block programmed death-1 (PD-1) or its ligand PD-L1",
   "lines": [
    "pembrolizumab, nivolumab release the T-cell brakes: myeloma, Hodgkin, lung cancer"
   ]
  },
  {
   "id": "sm_how_0_0",
   "x": 1203,
   "y": 468,
   "w": 214,
   "h": 290,
   "kind": "sm_t",
   "title": "Block the driver",
   "lines": [
    "• imatinib: BCR-ABL tyrosine kinase · ibrutinib: Bruton kinase",
    "• bortezomib (proteasome), lenalidomide: myeloma",
    "• all-trans retinoic acid: see the LEUKEMIA chart"
   ]
  },
