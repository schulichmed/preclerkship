 "panels": [
  {
   "x": 45,
   "y": 820,
   "w": 471,
   "title": "MRI: choose the sequence",
   "items": [
    "T1, 'anatomic': fluid DARK · structural abnormality · enhancement with contrast",
    "T2, 'pathologic': fluid WHITE ('water is white on T2') · edema",
    "FLAIR: fluid white EXCEPT CSF (inversion recovery suppresses it) · edema stands out",
    "DWI / ADC map: RESTRICTED water diffusion · a measure of cellularity · T2-weighted",
    "SWI: BLOOD products (hemoglobin in its oxidation states, hemosiderin)",
    "advanced: MR angiography · MR perfusion · MR spectroscopy · functional MRI"
   ],
   "cols": 1
  },
  {
   "x": 530,
   "y": 820,
   "w": 471,
   "title": "Putting it to work: a suspected stroke, in order",
   "items": [
    "1 · non-contrast CT",
    "2 · CT angiography (CTA) + CT perfusion (CTP)",
    "3 · catheter angiography (fluoroscopy, digital subtraction) + thrombectomy to pull the clot",
    "4 · DWI afterwards"
   ],
   "cols": 1
  }
 ]
