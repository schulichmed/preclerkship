   "lines": []
  },
  {
   "id": "aps_tx_2_0",
   "x": 293,
   "y": 1094,
   "w": 236,
   "h": 42,
   "kind": "ok",
   "title": "Fetal loss → ASA + heparin",
   "lines": []
  },
  {
   "id": "aps_tx_3_0",
   "x": 293,
   "y": 1158,
   "w": 236,
   "h": 98,
   "kind": "bad",
   "title": "Catastrophic → IV heparin + IV steroids",
   "lines": [
    "± plasmapheresis or IV immunoglobulin"
   ]
  },
  {
   "id": "sjo_tx_0_0",
   "x": 569,
   "y": 928,
   "w": 236,
   "h": 328,
   "kind": "bad",
   "title": "Watch: B-cell lymphoma (MALT)",
   "lines": [
    "the higher risk"
   ]
  },
  {
   "id": "myo_tx_0_0",
   "x": 845,
   "y": 928,
   "w": 236,
   "h": 144,
   "kind": "ok",
   "title": "High-dose steroids",
   "lines": [
    "then steroid-sparing: azathioprine, methotrexate"
   ]
  },
  {
   "id": "myo_tx_1_0",
   "x": 845,
   "y": 1094,
   "w": 236,
   "h": 162,
   "kind": "bad",
   "title": "Danger",
   "lines": [
    "• swallowing, heart, lung",
