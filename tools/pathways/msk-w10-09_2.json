   "id": "sle_pres_0_0",
   "x": 45,
   "y": 380,
   "w": 236,
   "h": 134,
   "kind": "sle_t",
   "title": "Classify: ≥ 4 of 11, over 6 weeks",
   "lines": [
    "• malar rash (spares the nasolabial folds), discoid, photosensitive",
    "• mouth or nose ulcers · non-erosive arthritis"
   ]
  },
  {
   "id": "sle_pres_1_0",
   "x": 45,
   "y": 536,
   "w": 236,
   "h": 78,
   "kind": "sle_w",
   "title": "Organs",
   "lines": [
    "• pleurisy, pericarditis · nephritis",
    "• seizure, psychosis · counts ↓"
   ]
  },
  {
   "id": "aps_pres_0_0",
   "x": 293,
   "y": 380,
   "w": 236,
   "h": 234,
   "kind": "aps_t",
   "title": "RECURRENT clots or pregnancy loss",
   "lines": [
    "• venous (deep vein thrombosis) or arterial",
    "• livedo reticularis · platelets ↓"
   ]
  },
  {
   "id": "sjo_pres_0_0",
   "x": 569,
   "y": 380,
   "w": 236,
   "h": 106,
   "kind": "sjo_t",
   "title": "Dry eyes + dry mouth (sicca)",
   "lines": [
    "• gritty eyes, worse through the day",
    "• dental caries · parotid swelling"
   ]
  },
  {
   "id": "sjo_pres_1_0",
   "x": 569,
   "y": 508,
   "w": 236,
   "h": 106,
   "kind": "sjo_w",
   "title": "Beyond the glands",
   "lines": [
    "• Raynaud's · purpura on the shins",
    "• arthritis · neuropathy"
   ]
  },
  {
   "id": "myo_pres_0_0",
   "x": 845,
   "y": 380,
   "w": 236,
   "h": 115,
   "kind": "myo_t",
   "title": "Dermatomyositis",
   "lines": [
    "• children, older adults · may be cancer",
    "• heliotrope rash, Gottron's papules"
   ]
  },
  {
   "id": "myo_pres_1_0",
   "x": 845,
   "y": 517,
   "w": 236,
   "h": 97,
   "kind": "myo_w",
   "title": "Polymyositis",
   "lines": [
    "any age · NO rash · not cancer-linked"
   ]
  },
  {
   "id": "ssc_pres_0_0",
   "x": 1121,
   "y": 380,
   "w": 236,
   "h": 107,
   "kind": "ssc_t",
   "title": "Fibrosis + vessels + autoimmunity",
   "lines": [
    "• Raynaud's, reflux in nearly all",
    "• tight fingers · dysphagia · ulcers"
   ]
  },
  {
   "id": "ssc_pres_1_0",
   "x": 1121.0,
   "y": 509,
   "w": 113.0,
   "h": 105,
   "kind": "ssc_w",
   "title": "Limited",
   "lines": [
    "• below elbows, knees",
    "• anticentromere"
   ]
  },
  {
   "id": "ssc_pres_1_1",
   "x": 1244.0,
   "y": 509,
   "w": 113.0,
   "h": 105,
   "kind": "ssc_w",
   "title": "Diffuse",
   "lines": [
    "• + arms, thighs, trunk",
    "• Scl-70"
   ]
  },
  {
   "id": "sle_inv_0_0",
   "x": 45,
   "y": 654,
   "w": 236,
   "h": 97,
   "kind": "sle_t",
   "title": "1 · ANA: positive in > 95%",
   "lines": [
    "+ blood count, creatinine, urinalysis"
   ]
  },
  {
   "id": "sle_inv_1_0",
   "x": 45,
   "y": 773,
   "w": 236,
   "h": 115,
   "kind": "sle_w",
   "title": "2 · ONLY if ANA + → anti-DNA",
   "lines": [
    "• anti-Smith (extractable antigens)",
    "• complement C3, C4 low"
   ]
  },
  {
   "id": "aps_inv_0_0",
   "x": 293,
   "y": 654,
   "w": 236,
   "h": 234,
   "kind": "aps_t",
   "title": "Antibodies, PERSISTENT",
   "lines": [
    "• anticardiolipin",
    "• lupus anticoagulant (clotting time falsely ↑)",
    "• false-positive syphilis test (VDRL)"
   ]
  },
  {
   "id": "sjo_inv_0_0",
   "x": 569,
   "y": 654,
   "w": 236,
   "h": 234,
   "kind": "sjo_t",
   "title": "ANA 80-90% · rheumatoid factor 90%",
   "lines": [
    "• anti-Ro, anti-La",
    "• sedimentation rate (ESR) very high"
   ]
  },
  {
   "id": "myo_inv_0_0",
   "x": 845,
   "y": 654,
   "w": 236,
   "h": 114,
   "kind": "myo_t",
   "title": "1 · Rule out mimics FIRST",
   "lines": [
    "• drugs: statins, steroids, colchicine, hydroxychloroquine",
    "• alcohol · thyroid · potassium, phosphate, magnesium"
   ]
  },
  {
   "id": "myo_inv_1_0",
   "x": 845,
   "y": 790,
   "w": 236,
   "h": 98,
   "kind": "myo_w",
   "title": "2 · Creatine kinase ↑ · ANA 80%",
   "lines": [
    "anti-Jo-1 → lung disease, bad prognosis"
   ]
  },
  {
   "id": "ssc_inv_0_0",
   "x": 1121,
   "y": 654,
   "w": 236,
   "h": 234,
   "kind": "ssc_t",
   "title": "ANA > 95%",
   "lines": [
    "• Scl-70 → lung fibrosis",
    "• RNA polymerase → renal crisis",
    "• limited: pulmonary hypertension late"
   ]
  },
  {
   "id": "sle_tx_0_0",
   "x": 45,
   "y": 928,
   "w": 236,
   "h": 83,
   "kind": "ok",
   "title": "Hydroxychloroquine for EVERY patient",
   "lines": [
    "the anchor: skin, joints, fewer flares"
   ]
  },
  {
   "id": "sle_tx_1_0",
   "x": 45,
   "y": 1033,
   "w": 236,
   "h": 81,
   "kind": "ok",
   "title": "Minor organ (skin, joints)",
   "lines": [
    "• topical or low-dose steroid",
    "• anti-inflammatories (NSAIDs)"
   ]
  },
  {
   "id": "sle_tx_2_0",
   "x": 45,
   "y": 1136,
   "w": 236,
   "h": 121,
   "kind": "bad",
   "title": "Major organ → high-dose steroid + immune suppressant",
   "lines": [
    "mycophenolate, azathioprine, cyclophosphamide"
   ]
  },
  {
   "id": "aps_tx_0_0",
   "x": 293,
   "y": 928,
   "w": 236,
   "h": 60,
   "kind": "ok",
   "title": "Antibody, no event",
   "lines": [
    "nothing or aspirin (ASA) 81 mg"
   ]
  },
  {
   "id": "aps_tx_1_0",
   "x": 293,
   "y": 1010,
   "w": 236,
