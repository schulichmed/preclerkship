  {
   "id": "root",
   "x": 324,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Ending a pregnancy: the ULTRASOUND GESTATIONAL AGE decides which methods are open",
   "lines": [
    "before ANY method: ultrasound (INTRAUTERINE? + dating) · Rh status · history · consent · CONTRACEPTION plan",
    "no referral needed · 1st trimester: medical OR surgical, her choice · 2nd trimester: D&E or induction"
   ]
  },
  {
   "id": "g1",
   "x": 45,
   "y": 138,
   "w": 856,
   "h": 60,
   "kind": "plain",
   "title": "1st TRIMESTER (< 12 weeks): MEDICAL or SURGICAL",
   "lines": [
    "both open: she chooses home + days, or clinic + one visit"
   ]
  },
  {
   "id": "g2",
   "x": 941,
   "y": 138,
   "w": 422,
   "h": 60,
   "kind": "plain",
   "title": "2nd TRIMESTER (to ~24–25 weeks)",
   "lines": [
    "D&E preferred: fewest complications"
   ]
  },
  {
   "id": "t_med",
   "x": 45,
   "y": 238,
   "w": 422,
   "h": 78,
   "kind": "plain",
   "title": "MEDICAL: patient-controlled, at home",
   "lines": [
    "95–99% success · days–weeks · NEEDS follow-up",
    "she must accept SURGERY if it fails"
   ]
  },
  {
   "id": "t_sur",
   "x": 479,
   "y": 238,
   "w": 422,
   "h": 78,
   "kind": "plain",
   "title": "SURGICAL: provider-performed",
