   ]
  },
  {
   "id": "mtx_cand_0_0",
   "x": 262,
   "y": 552,
   "w": 205,
   "h": 134,
   "kind": "mtx_t",
   "title": "Up to 49 DAYS only",
   "lines": [
    "same follow-up commitment",
    "~†less effective + slower than mifepristone"
   ]
  },
  {
   "id": "mva_cand_0_0",
   "x": 479,
   "y": 552,
   "w": 205,
   "h": 134,
   "kind": "mva_t",
   "title": "Up to 10 WEEKS, and",
   "lines": [
    "she can tolerate a local anaesthetic + exam",
    "~cannot cope → conscious sedation"
   ]
  },
  {
   "id": "dc_cand_0_0",
   "x": 696,
   "y": 552,
   "w": 205,
   "h": 134,
   "kind": "dc_t",
   "title": "Under 14 WEEKS",
   "lines": [
    "wants sedation, not just a local",
    "faster recovery + discharge"
   ]
  },
  {
   "id": "de_cand_0_0",
   "x": 941,
   "y": 552,
   "w": 205,
   "h": 134,
   "kind": "ok",
   "title": "Most 2nd-trimester abortions",
   "lines": [
    "FEWEST complications vs induction",
    "shorter · fewer retained products"
   ]
  },
  {
   "id": "ind_cand_0_0",
   "x": 1158,
   "y": 552,
   "w": 205,
   "h": 134,
   "kind": "ind_t",
   "title": "GENETIC terminations",
   "lines": [
    "available for them",
    "~the alternative to D&E"
   ]
  },
  {
   "id": "mife_how_0_0",
   "x": 45,
   "y": 726,
   "w": 205,
   "h": 168,
   "kind": "mife_t",
   "title": "Regimen",
   "lines": [
    "1 · mifepristone 200 oral or buccal",
    "~the deck prints mcg; the product is mg",
    "2 · misoprostol 800 mcg 24–48 h later",
    "~90% abort within 24 h of it"
   ]
  },
  {
   "id": "mtx_how_0_0",
   "x": 262,
   "y": 726,
   "w": 205,
   "h": 168,
   "kind": "mtx_t",
   "title": "Regimen",
   "lines": [
    "1 · day 1: methotrexate 50 mg/m² IM",
    "2 · days 5–7: misoprostol 600 µg vaginally",
    "no bleeding in 24 h → 800 µg more"
   ]
  },
  {
   "id": "mva_how_0_0",
   "x": 479,
   "y": 726,
   "w": 205,
   "h": 168,
   "kind": "mva_t",
   "title": "Procedure",
   "lines": [
    "1 · paracervical block, 1% lidocaine",
    "2 · dilate (most nulliparas)",
    "3 · cannula + manual vacuum aspirator"
   ]
  },
  {
   "id": "dc_how_0_0",
   "x": 696,
   "y": 726,
   "w": 205,
   "h": 168,
   "kind": "dc_t",
   "title": "Procedure",
   "lines": [
    "1 · cervical preparation",
    "2 · Hegar dilators",
    "3 · suction curettage",
    "~detail: ABNORMAL BLEEDING chart"
   ]
  },
  {
   "id": "de_how_0_0",
   "x": 941,
   "y": 726,
   "w": 205,
   "h": 168,
   "kind": "de_t",
   "title": "Procedure",
   "lines": [
    "1 · ripen the cervix: osmotic, mechanical or medical (> 18 wk: serial)",
    "2 · ± feticide: intracardiac digoxin or KCl",
    "3 · evacuate under general anaesthetic"
   ]
  },
  {
   "id": "ind_how_0_0",
   "x": 1158,
   "y": 726,
   "w": 205,
   "h": 168,
   "kind": "ind_t",
   "title": "Procedure",
   "lines": [
    "1 · feticide: intracardiac KCl or digoxin",
    "2 · misoprostol induces labour"
   ]
  },
  {
   "id": "mife_fu_0_0",
   "x": 45,
   "y": 934,
   "w": 205,
   "h": 98,
   "kind": "mife_w",
   "title": "Visit within 11 DAYS: β-hCG",
   "lines": [
    "↓ 50% by day 3 or ↓ 80% by days 7–14 = complete"
   ]
  },
  {
   "id": "mife_fu_1_0",
   "x": 45,
