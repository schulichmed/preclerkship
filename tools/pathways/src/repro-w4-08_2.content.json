 "panels": [
  {
   "title": "One test per STI",
   "items": [
    "chlamydia + gonorrhea: cervical or vaginal swab, or first-catch urine",
    "herpes: unroof → PCR · syphilis: darkfield, VDRL screen, FTA confirm",
    "hepatitis B, HIV: serology · warts: clinical",
    "PID: cultures + imaging, laparoscopy if unsure"
   ]
  },
  {
   "title": "After treatment",
   "items": [
    "test of cure (chlamydia): only if pregnant, poor compliance, symptoms persist or re-exposed · at 4 weeks",
    "reportable → public health traces contacts; treat partners before sex resumes"
   ]
  }
 ]
