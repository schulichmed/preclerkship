 "panels": [
  {
   "title": "Which lichen? three questions",
   "items": [
    "SCARS? no → lichen simplex chronicus · yes → sclerosus or planus",
    "IN THE VAGINA (or mouth)? yes → planus · no → sclerosus",
    "ITCH ++++ with no scar → simplex chronicus · PAIN > itch → planus",
    "all three: biopsy to confirm, ultrapotent steroid ointment"
   ]
  },
  {
   "title": "When to biopsy",
   "items": [
    "every lichen, to confirm before treating",
    "any DARK lesion: melanoma is in the differential",
    "firm, ulcerated, colour change, groin nodes",
    "LS, LP or warts that do not resolve or are refractory (VIN mimics)",
    "≥ 4 mm punch · several if areas look different"
   ]
  }
 ]
