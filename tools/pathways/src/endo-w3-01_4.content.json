  {
   "title": "Adrenal incidentaloma: screen ALL THREE",
   "items": [
    "cortisol: 1 mg dexamethasone, 24-h urine",
    "aldosterone: BP + potassium, then aldosterone/renin if indicated",
    "catecholamines: urine or plasma metanephrines",
    "2–3% over 50, 7% over 70 · if known cancer, 75% metastasis",
    "only absolute sign of malignancy: distant metastasis",
    "NEVER biopsy until pheochromocytoma excluded (70% complications)"
   ]
  },
  {
   "title": "Stimulation vs suppression",
   "items": [
    "STIMULATION for too LITTLE: give the push, a healthy gland rises (cosyntropin)",
    "SUPPRESSION for too MUCH: give the brake, a healthy gland falls (1 mg dexamethasone, saline or salt load)"
   ]
  }
