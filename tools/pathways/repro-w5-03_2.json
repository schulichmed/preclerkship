   "title": "Cycles SHORTEN, LENGTHEN, then CEASE",
   "lines": [
    "symptoms can start MANY YEARS before the last period"
   ]
  },
  {
   "id": "me_clue_0_0",
   "x": 279,
   "y": 490,
   "w": 222,
   "h": 116,
   "kind": "me_t",
   "title": "AMENORRHEA × 12 MONTHS",
   "lines": []
  },
  {
   "id": "ea_clue_0_0",
   "x": 513,
   "y": 490,
   "w": 222,
   "h": 116,
   "kind": "ea_t",
   "title": "Menopause before 45 = ↑ RISK",
   "lines": [
    "coronary heart disease · stroke · cardiovascular + all-cause death",
    "cognition · quality of life · bone"
   ]
  },
  {
   "id": "po_clue_0_0",
   "x": 747,
   "y": 490,
   "w": 222,
   "h": 116,
   "kind": "po_t",
   "title": "BOTH",
   "lines": [
    "disordered menses ≥ 4 months",
    "FSH > 25 IU/L"
   ]
  },
  {
   "id": "my_clue_0_0",
   "x": 1009,
   "y": 490,
   "w": 222,
   "h": 116,
   "kind": "my_t",
   "title": "Has she a UTERUS?",
   "lines": [
    "yes → add PROGESTERONE · no → estrogen alone"
   ]
  },
  {
   "id": "mn_clue_0_0",
   "x": 1243,
   "y": 490,
   "w": 222,
   "h": 116,
   "kind": "mn_t",
   "title": "Not safe to start MHT",
   "lines": [
    "a contraindication · or ≥ 60 · or ≥ 10 years post menopause"
   ]
  },
  {
   "id": "gs_clue_0_0",
   "x": 1505,
   "y": 490,
   "w": 222,
   "h": 116,
   "kind": "gs_t",
   "title": "Symptoms, any mix",
   "lines": [
    "dryness, burning · dyspareunia, ↓ libido · urgency, dysuria, recurrent urinary tract infection"
   ]
  },
  {
   "id": "pe_inv_0_0",
   "x": 45,
   "y": 646,
   "w": 222,
   "h": 129,
   "kind": "pe_w",
   "title": "1 · Early transition",
   "lines": [
    "cycle lengths differ by ≥ 7 days, persistently"
   ]
  },
  {
   "id": "pe_inv_1_0",
   "x": 45,
   "y": 797,
   "w": 222,
   "h": 167,
   "kind": "pe_w",
   "title": "2 · Late transition: 1–3 years",
   "lines": [
    "no period for ≥ 60 days · follicle-stimulating hormone (FSH) > 25 IU/L"
   ]
  },
  {
   "id": "me_inv_0_0",
   "x": 279,
   "y": 646,
   "w": 222,
   "h": 148,
   "kind": "me_w",
   "title": "Early postmenopause",
   "lines": [
    "hot flashes most likely"
   ]
  },
  {
   "id": "me_inv_1_0",
   "x": 279,
   "y": 816,
   "w": 222,
   "h": 148,
   "kind": "me_w",
   "title": "Late postmenopause",
   "lines": [
    "genitourinary atrophy increases"
   ]
  },
  {
   "id": "ea_inv_0_0",
   "x": 513,
   "y": 646,
   "w": 222,
   "h": 318,
   "kind": "ea_w",
   "title": "Same cut-off, earlier",
   "lines": [
    "amenorrhea × 12 months, at 40–45"
   ]
  },
  {
   "id": "po_inv_0_0",
   "x": 747,
   "y": 646,
   "w": 222,
   "h": 80,
   "kind": "po_w",
   "title": "1 · Chemotherapy, pelvic radiation or surgery?",
   "lines": [
    "yes → iatrogenic"
   ]
  },
  {
   "id": "po_inv_1_0",
   "x": 747,
   "y": 748,
   "w": 222,
   "h": 80,
   "kind": "po_w",
   "title": "2 · Karyotype + FMR1 (fragile X) in ALL",
   "lines": [
    "after counselling + consent"
   ]
  },
  {
   "id": "po_inv_2_0",
   "x": 747,
   "y": 850,
   "w": 222,
   "h": 114,
   "kind": "po_w",
   "title": "3 · Autoimmune screen",
   "lines": [
    "21-hydroxylase antibodies · thyroid-stimulating hormone (TSH)",
    "abnormal → autoimmune · all normal → idiopathic"
   ]
  },
  {
   "id": "my_inv_0_0",
   "x": 1009,
   "y": 646,
   "w": 222,
   "h": 318,
   "kind": "my_w",
   "title": "Pick the route",
   "lines": [
    "estrogen: pill · patch or gel",
    "progesterone: pill · intrauterine device (IUD), 5 years",
    "combined: pill · patch"
   ]
  },
  {
   "id": "mn_inv_0_0",
   "x": 1243,
   "y": 646,
   "w": 222,
   "h": 140,
   "kind": "mn_w",
   "title": "No estrogen OR progestogen",
   "lines": [
    "undiagnosed vaginal bleeding · breast cancer, ever"
   ]
  },
  {
   "id": "mn_inv_1_0",
   "x": 1243,
   "y": 808,
   "w": 222,
   "h": 156,
   "kind": "mn_w",
   "title": "No estrogen",
   "lines": [
    "estrogen-dependent cancer · heart disease · clot or stroke, EVER · thrombophilia · liver disease · pregnancy"
   ]
  },
  {
   "id": "gs_inv_0_0",
   "x": 1505,
   "y": 646,
   "w": 222,
   "h": 318,
   "kind": "gs_w",
   "title": "Examine the VULVA",
   "lines": [
    "rule out skin conditions · pale, thin · vaginal pH > 5.0"
   ]
  },
  {
