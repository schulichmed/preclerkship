   "x": 1009,
   "y": 158,
   "w": 456,
   "h": 114,
   "kind": "plain",
   "title": "HOT FLASHES: can she safely start MHT?",
   "lines": [
    "everyone first: cognitive behavioural therapy (CBT) · hypnosis · weight loss · cooling, avoid triggers",
    "YES only if: NO contraindication AND < 60 AND < 10 years post menopause"
   ]
  },
