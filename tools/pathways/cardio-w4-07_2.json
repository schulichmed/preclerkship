 "nodes": [
  {
   "id": "root",
   "x": 464,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Suspected congenital heart disease (CHD): is the child PINK or BLUE? Then how much PULMONARY BLOOD FLOW (PBF)?",
   "lines": [
    "infant in heart failure: poor feeding, sweating with feeds, failure to thrive, tachypnea, big liver",
    "ECG + chest X-ray: lung markings show the flow  →  ECHO is usually definitive"
   ]
  },
  {
   "id": "g_pink",
   "x": 45,
   "y": 158,
   "w": 892,
   "h": 78,
   "kind": "plain",
   "title": "PINK: acyanotic",
   "lines": [
    "ALWAYS feel the femoral pulses"
   ]
  },
  {
   "id": "g_blue",
   "x": 977,
   "y": 158,
   "w": 666,
   "h": 78,
   "kind": "plain",
   "title": "BLUE: is it the HEART? Hyperoxia test",
   "lines": [
    "PaO2 stays < 100–150 on 100% oxygen → cardiac (lungs: rises to ~600)",
    "every cyanotic lesion needs SURGERY to survive"
   ]
  },
  {
   "id": "t_lr",
   "x": 45,
   "y": 276,
   "w": 666,
   "h": 80,
   "kind": "plain",
   "title": "↑ PBF: LEFT-TO-RIGHT shunt",
   "lines": [
    "the SIZE of the hole decides the symptoms"
   ]
  },
  {
   "id": "t_ob",
   "x": 723,
   "y": 276,
   "w": 214,
   "h": 80,
   "kind": "plain",
   "title": "NORMAL PBF: OBSTRUCTION",
   "lines": [
    "no shunt"
   ]
  },
  {
   "id": "t_lo",
   "x": 977,
   "y": 276,
   "w": 214,
   "h": 80,
   "kind": "plain",
   "title": "↓ PBF: RIGHT-TO-LEFT",
   "lines": [
    "also tricuspid atresia: staged single-ventricle palliation"
   ]
  },
  {
   "id": "t_hi",
   "x": 1203,
   "y": 276,
   "w": 440,
   "h": 80,
   "kind": "plain",
   "title": "Normal or ↑ PBF",
   "lines": [
    "separate circuits, or mixing"
   ]
  },
  {
   "id": "asd_head_0_0",
   "x": 45,
   "y": 436,
   "w": 214,
   "h": 132,
   "kind": "asd_h",
   "title": "Atrial septal defect (ASD)",
   "lines": [
    "often first found in ADULTS"
   ]
  },
  {
   "id": "vsd_head_0_0",
   "x": 271,
   "y": 436,
   "w": 214,
   "h": 132,
   "kind": "vsd_h",
   "title": "Ventricular septal defect (VSD)",
   "lines": [
    "atrioventricular septal defect (AVSD) in Down syndrome: septal holes + an abnormal valve"
   ]
  },
  {
   "id": "pda_head_0_0",
   "x": 497,
   "y": 436,
   "w": 214,
   "h": 132,
   "kind": "pda_h",
   "title": "Patent ductus arteriosus (PDA)",
   "lines": [
    "common in very PREMATURE babies"
   ]
  },
  {
   "id": "coa_head_0_0",
   "x": 723,
   "y": 436,
   "w": 214,
   "h": 132,
   "kind": "coa_h",
   "title": "Coarctation of the aorta",
   "lines": [
    "narrowing where the ductus inserts"
   ]
  },
  {
   "id": "tof_head_0_0",
   "x": 977,
   "y": 436,
   "w": 214,
   "h": 132,
   "kind": "tof_h",
   "title": "Tetralogy of Fallot (ToF)",
   "lines": [
    "most common cyanotic CHD overall",
    "right ventricular (RV) outflow block + VSD + overriding aorta + RV hypertrophy"
   ]
  },
  {
   "id": "tga_head_0_0",
   "x": 1203,
   "y": 436,
   "w": 214,
   "h": 132,
   "kind": "tga_h",
   "title": "Transposition of the great arteries (TGA)",
   "lines": [
    "most common cyanotic CHD in a NEWBORN"
   ]
  },
  {
   "id": "mix_head_0_0",
   "x": 1429,
   "y": 436,
   "w": 214,
   "h": 132,
   "kind": "mix_h",
   "title": "Mixing lesions",
   "lines": [
    "truncus arteriosus, and total anomalous pulmonary venous return (TAPVR)"
   ]
  },
  {
   "id": "asd_clue_0_0",
   "x": 45,
   "y": 608,
   "w": 214,
   "h": 126,
   "kind": "asd_t",
   "title": "Children: usually NO symptoms",
   "lines": [
    "adults: arrhythmia, pulmonary hypertension, heart failure"
   ]
  },
  {
   "id": "asd_clue_1_0",
   "x": 45,
   "y": 756,
   "w": 214,
   "h": 124,
   "kind": "asd_w",
   "title": "WIDE, FIXED split S2",
   "lines": [
    "• right ventricular heave",
    "• soft ejection murmur, left upper sternal border"
   ]
  },
  {
   "id": "vsd_clue_0_0",
   "x": 271,
   "y": 608,
   "w": 214,
   "h": 108,
   "kind": "vsd_t",
   "title": "Heart failure at 6–12 WEEKS",
   "lines": [
    "if the defect is large"
   ]
  },
  {
   "id": "vsd_clue_1_0",
   "x": 271,
   "y": 738,
   "w": 214,
   "h": 142,
   "kind": "vsd_w",
   "title": "PANSYSTOLIC murmur",
   "lines": [
    "• small: normal S2, no heart failure",
    "• large: SINGLE S2, almost always heart failure"
   ]
  },
  {
   "id": "pda_clue_0_0",
   "x": 497,
   "y": 608,
   "w": 214,
   "h": 125,
   "kind": "pda_t",
   "title": "CONTINUOUS murmur",
   "lines": [
    "• left infraclavicular, to the back",
    "• shunts in systole AND diastole"
   ]
  },
  {
   "id": "pda_clue_1_0",
   "x": 497,
   "y": 755,
   "w": 214,
   "h": 125,
   "kind": "pda_w",
   "title": "Lungs steal perfusion",
   "lines": [
    "• BOUNDING pulses",
    "• WIDE pulse pressure"
   ]
  },
  {
   "id": "coa_clue_0_0",
   "x": 723,
   "y": 608,
   "w": 214,
   "h": 89,
   "kind": "bad",
   "title": "↓ FEMORAL pulses, low leg BP",
   "lines": [
    "less flow to the lower body"
   ]
  },
  {
   "id": "coa_clue_1_0",
   "x": 723,
   "y": 719,
   "w": 214,
   "h": 69,
   "kind": "coa_t",
   "title": "Critical: a sick NEONATE",
   "lines": [
    "poor gut perfusion, heart failure"
   ]
  },
  {
   "id": "coa_clue_2_0",
   "x": 723,
   "y": 810,
   "w": 214,
   "h": 69,
   "kind": "coa_w",
   "title": "Milder: an older child",
   "lines": [
    "murmur, HYPERTENSION"
   ]
  },
  {
   "id": "tof_clue_0_0",
   "x": 977,
   "y": 608,
   "w": 214,
   "h": 162,
   "kind": "tof_t",
   "title": "Cyanosis tracks the RV OUTFLOW block",
   "lines": [
    "• mild: harsh ejection murmur, late cyanosis",
    "• severe: blue newborn",
    "• X-ray: 'boot-shaped' heart, ↓ PBF"
   ]
  },
  {
   "id": "tof_clue_1_0",
   "x": 977,
   "y": 792,
   "w": 214,
   "h": 88,
   "kind": "bad",
   "title": "TET SPELLS",
   "lines": [
    "sudden deep cyanosis: life-threatening"
   ]
  },
  {
   "id": "tga_clue_0_0",
   "x": 1203,
   "y": 608,
   "w": 214,
   "h": 143,
   "kind": "bad",
   "title": "PROFOUND cyanosis at birth",
   "lines": [
    "• little respiratory distress for the saturation",
    "• little or NO murmur"
   ]
  },
  {
   "id": "tga_clue_1_0",
   "x": 1203,
   "y": 773,
   "w": 214,
   "h": 107,
   "kind": "tga_w",
   "title": "Alive only through fetal shunts",
   "lines": [
    "they let red blood reach the body"
   ]
  },
  {
   "id": "mix_clue_0_0",
   "x": 1429,
   "y": 608,
   "w": 214,
   "h": 116,
   "kind": "mix_t",
   "title": "Truncus: ONE artery leaves the heart",
   "lines": [
    "• high lung flow: congestion",
    "• end-organ failure (gut, coronary)"
   ]
  },
  {
   "id": "mix_clue_1_0",
   "x": 1429,
   "y": 746,
   "w": 214,
   "h": 134,
   "kind": "mix_w",
   "title": "TAPVR: lung veins drain to the right",
   "lines": [
    "• unobstructed: like a big ASD, mild cyanosis",
    "• OBSTRUCTED: deep cyanosis, lung edema, small heart"
   ]
  },
