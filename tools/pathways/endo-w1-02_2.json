 "panels": [
  {
   "x": 45,
   "y": 1850,
   "w": 1064,
   "title": "Type 2: the ominous octet (each a drug target)",
   "items": [
    "beta cell: insulin ↓, 80% of function lost by PREDIABETES → sulfonylureas, incretins",
    "alpha cell: glucagon ↑ · liver: glucose output ↑ → metformin",
    "kidney: SGLT2 ↑ reabsorption → SGLT2 inhibitors · brain: satiety ↓ → GLP-1 agonists",
    "muscle: uptake ↓ → thiazolidinediones · fat: lipolysis ↑, free fatty acids ↑",
    "gut: GIP ↑ but response ↓, GLP-1 ↓ → GLP-1 agonists, DPP-4 inhibitors"
   ],
   "cols": 1
  }
 ]
}