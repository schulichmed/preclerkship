  {
   "id": "acl_head_0_0",
   "x": 45,
   "y": 372,
   "w": 236,
   "h": 170,
   "kind": "acl_h",
   "title": "Anterior cruciate ligament (ACL) tear",
   "lines": [
    "non-contact in 60–80% · contact 30%: blow → hyperextension or valgus",
    "case: 27, football pivot, knee 'moves', can't weight bear",
    "female 4.5 : 1 · pivoting sports"
   ]
  },
  {
   "id": "men_head_0_0",
   "x": 293,
   "y": 372,
   "w": 236,
   "h": 170,
   "kind": "men_h",
   "title": "Meniscal tear",
   "lines": [
    "twisting with the foot planted",
    "or degenerative with age",
    "case: 23, hockey, knee rotates: medial pain, swells that NIGHT"
   ]
  },
  {
   "id": "pcl_head_0_0",
   "x": 569,
   "y": 372,
   "w": 236,
   "h": 170,
   "kind": "pcl_h",
   "title": "Posterior cruciate ligament (PCL) tear",
   "lines": [
    "blow to the front of the tibia, knee FLEXED (dashboard)",
    "• or hyperextension"
   ]
  },
  {
   "id": "mcl_head_0_0",
   "x": 817,
   "y": 372,
   "w": 236,
   "h": 170,
   "kind": "mcl_h",
   "title": "Medial collateral ligament (MCL) injury",
   "lines": [
    "VALGUS force, a collision",
    "very common"
   ]
  },
  {
   "id": "lcl_head_0_0",
   "x": 1065,
   "y": 372,
   "w": 236,
   "h": 170,
   "kind": "lcl_h",
   "title": "Lateral collateral ligament (LCL) injury",
   "lines": [
    "high-energy VARUS force",
    "uncommon on its own · collisions"
   ]
  },
  {
   "id": "pfps_head_0_0",
   "x": 1341,
   "y": 372,
   "w": 236,
   "h": 170,
   "kind": "pfps_h",
   "title": "Patellofemoral pain syndrome",
   "lines": [
    "females, adolescents · 30% lifetime",
    "repetitive loading of the extensor mechanism",
    "↑ tibiofemoral angle and Q-angle"
   ]
  },
  {
   "id": "bur_head_0_0",
   "x": 1589,
   "y": 372,
   "w": 236,
   "h": 170,
   "kind": "bur_h",
   "title": "Knee bursitis",
   "lines": [
    "prepatellar · infrapatellar · suprapatellar",
    "chronic friction · common"
   ]
  },
  {
   "id": "itb_head_0_0",
   "x": 1865,
   "y": 372,
   "w": 236,
   "h": 170,
   "kind": "itb_h",
   "title": "Iliotibial band friction syndrome",
   "lines": [
    "band rubs the lateral femoral epicondyle below 30° of flexion"
   ]
  },
  {
   "id": "bak_head_0_0",
   "x": 2141,
   "y": 372,
   "w": 236,
   "h": 170,
   "kind": "bak_h",
   "title": "Popliteal (Baker's) cyst",
   "lines": [
    "synovial fluid through a defect in the back of the capsule",
    "from the gastrocnemius-semimembranosus bursa · adults"
   ]
  },
  {
   "id": "acl_pres_0_0",
   "x": 45,
   "y": 582,
   "w": 236,
   "h": 150,
   "kind": "acl_t",
   "title": "\"Pop\" + IMMEDIATE swelling",
   "lines": [
    "• blood in the joint (hemarthrosis)",
    "• knee \"gives out\"",
    "• lateral pain (bone bruise)"
   ]
  },
  {
   "id": "men_pres_0_0",
   "x": 293,
   "y": 582,
   "w": 236,
   "h": 150,
   "kind": "men_t",
   "title": "Joint-line pain · DELAYED or on-and-off swelling",
   "lines": [
    "• ± locking and catching"
   ]
  },
  {
   "id": "pcl_pres_0_0",
   "x": 569,
   "y": 582,
   "w": 236,
   "h": 150,
   "kind": "pcl_t",
   "title": "Vague pain, sometimes posterior",
   "lines": [
    "• MINIMAL swelling",
    "• less common than ACL",
    "• with meniscal, chondral injury"
   ]
  },
  {
   "id": "mcl_pres_0_0",
   "x": 817,
   "y": 582,
   "w": 236,
   "h": 150,
   "kind": "mcl_t",
   "title": "Medial pain · minimal to no swelling",
   "lines": [
