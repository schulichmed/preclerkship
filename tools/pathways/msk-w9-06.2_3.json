  },
  {
   "id": "pfps_pres_0_0",
   "x": 1341,
   "y": 582,
   "w": 236,
   "h": 150,
   "kind": "pfps_t",
   "title": "Gradual deep anterior ache",
   "lines": [
    "• worse after activity and with prolonged sitting, stairs",
    "• NO joint swelling · or after a patellar contusion",
    "case: 18, new runner, 3 months bilateral, now sitting + stairs"
   ]
  },
