 "nodes": [
  {
   "id": "root",
   "x": 369,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Tachycardia (> 100 bpm): is the patient UNSTABLE? Then: is the QRS NARROW or WIDE?",
   "lines": [
    "UNSTABLE, deteriorating or UNSURE what it is → synchronized CARDIOVERSION: always appropriate"
   ]
  },
  {
   "id": "g_n",
   "x": 45,
   "y": 120,
   "w": 684,
   "h": 60,
   "kind": "plain",
   "title": "NARROW QRS (< 120 ms): supraventricular tachycardia (SVT)",
   "lines": [
    "recurrent symptoms but NO sudden death: an excellent prognosis"
   ]
  },
  {
   "id": "g_w",
   "x": 769,
   "y": 120,
   "w": 684,
   "h": 60,
   "kind": "plain",
   "title": "WIDE QRS (> 120 ms): ventricular tachycardia (VT) until proven otherwise",
   "lines": [
    "can cause collapse and SUDDEN DEATH"
   ]
  },
  {
   "id": "t_n",
   "x": 45,
   "y": 220,
   "w": 684,
   "h": 60,
   "kind": "plain",
   "title": "Block the atrioventricular (AV) node: vagal manoeuvre or IV adenosine. Does it STOP?",
   "lines": [
    "carotid sinus massage; adenosine lasts about 10 seconds"
   ]
  },
  {
   "id": "t_w",
   "x": 769,
   "y": 220,
   "w": 684,
   "h": 60,
   "kind": "plain",
   "title": "Stable but unsure: give IV ADENOSINE. Does it stop or slow?",
   "lines": [
    "then cardiovert whenever in doubt"
   ]
  },
  {
   "id": "at_head_0_0",
   "x": 45,
   "y": 360,
   "w": 220,
   "h": 114,
   "kind": "at_h",
   "title": "AV-node INDEPENDENT",
   "lines": [
    "sinus, ectopic atrial tachycardia, atrial flutter",
    "atrial fibrillation: see the ATRIAL FIBRILLATION chart"
   ]
  },
  {
   "id": "nr_head_0_0",
   "x": 277,
   "y": 360,
   "w": 220,
   "h": 114,
   "kind": "nr_h",
   "title": "AV nodal re-entry (AVNRT)",
   "lines": [
    "the circuit is INSIDE the AV node"
   ]
  },
  {
   "id": "rt_head_0_0",
   "x": 509,
   "y": 360,
   "w": 220,
   "h": 114,
   "kind": "rt_h",
   "title": "AV re-entry (AVRT)",
   "lines": [
    "uses an ACCESSORY pathway (Wolff-Parkinson-White, WPW)"
   ]
  },
  {
   "id": "ab_head_0_0",
   "x": 769,
   "y": 360,
   "w": 220,
   "h": 114,
   "kind": "ab_h",
   "title": "SVT with aberrancy",
   "lines": [
    "SVT + bundle branch block, or over an accessory pathway"
   ]
  },
  {
   "id": "mv_head_0_0",
   "x": 1001,
   "y": 360,
   "w": 220,
   "h": 114,
   "kind": "mv_h",
   "title": "Monomorphic VT",
   "lines": [
    "every QRS looks the SAME",
    "scar (coronary disease, cardiomyopathy) or idiopathic"
   ]
  },
  {
   "id": "pv_head_0_0",
   "x": 1233,
   "y": 360,
   "w": 220,
   "h": 114,
   "kind": "pv_h",
   "title": "Polymorphic VT, VF",
   "lines": [
    "QRS changes beat to beat",
    "ACUTE ISCHEMIA most often; long QT"
   ]
  },
  {
   "id": "at_ecg_0_0",
   "x": 45.0,
   "y": 514,
   "w": 105.0,
   "h": 96,
   "kind": "at_w",
   "title": "Sinus",
   "lines": [
    "P UPRIGHT in I, II, III"
   ]
  },
  {
   "id": "at_ecg_0_1",
   "x": 160.0,
   "y": 514,
   "w": 105.0,
   "h": 96,
   "kind": "at_t",
   "title": "Atrial",
   "lines": [
    "P INVERTED in I, II, III"
   ]
  },
  {
   "id": "at_ecg_1_0",
   "x": 45,
   "y": 632,
   "w": 220,
   "h": 96,
   "kind": "at_w",
   "title": "Flutter",
   "lines": [
    "flutter waves keep circling while the AV node is blocked"
   ]
  },
  {
   "id": "nr_ecg_0_0",
   "x": 277,
   "y": 514,
   "w": 220,
   "h": 214,
   "kind": "nr_t",
   "title": "Regular, narrow, 100–200+ bpm",
   "lines": [
    "sudden racing episodes"
   ]
  },
  {
   "id": "rt_ecg_0_0",
   "x": 509,
   "y": 514,
   "w": 220,
   "h": 60,
   "kind": "rt_t",
   "title": "WPW in sinus rhythm",
   "lines": [
    "DELTA wave + fused QRS"
   ]
  },
  {
   "id": "rt_ecg_1_0",
   "x": 509,
   "y": 596,
   "w": 220,
   "h": 132,
   "kind": "rt_w",
   "title": "In tachycardia",
   "lines": [
    "• down the normal path: NARROW",
    "• down the accessory path: WIDE",
    "• with atrial fibrillation: irregularly irregular"
   ]
  },
  {
   "id": "ab_ecg_0_0",
   "x": 769,
   "y": 514,
   "w": 220,
   "h": 214,
   "kind": "ab_t",
   "title": "Wide, but AV-node DEPENDENT",
   "lines": [
    "e.g. SVT with a left bundle branch block pattern at 200 bpm"
   ]
  },
  {
   "id": "mv_ecg_0_0",
   "x": 1001,
   "y": 514,
   "w": 220,
   "h": 214,
   "kind": "mv_t",
   "title": "Wide, regular, identical QRS",
   "lines": [
    "• very abnormal axis",
    "• adenosine does NOT stop it"
   ]
  },
  {
   "id": "pv_ecg_0_0",
   "x": 1233,
   "y": 514,
   "w": 220,
   "h": 214,
   "kind": "bad",
   "title": "SYNCOPE or ARREST, not palpitations",
   "lines": [
    "• torsades de pointes: long QT",
    "• VF: chaotic, the shockable arrest"
   ]
  },
  {
   "id": "at_tx_0_0",
   "x": 45,
   "y": 768,
   "w": 220,
   "h": 138,
   "kind": "at_w",
   "title": "Sinus: driven by something",
   "lines": [
    "hyperthyroidism, fever, anemia, exercise"
   ]
  },
  {
   "id": "at_tx_1_0",
   "x": 45,
   "y": 928,
   "w": 220,
   "h": 138,
   "kind": "warn",
   "title": "Atrial or flutter: restore sinus",
   "lines": [
    "• cardioversion",
    "• procainamide or ibutilide"
   ]
  },
  {
   "id": "nr_tx_0_0",
   "x": 277,
   "y": 768,
   "w": 220,
   "h": 130,
   "kind": "ok",
   "title": "Acute: adenosine or vagal STOPS it",
   "lines": [
    "IV verapamil or diltiazem last longer"
   ]
  },
  {
   "id": "nr_tx_1_0",
   "x": 277,
   "y": 920,
   "w": 220,
   "h": 146,
   "kind": "ok",
   "title": "Long term",
   "lines": [
    "• rare, mild spells: nothing",
    "• beta blocker or calcium channel blocker",
    "• catheter ABLATION"
   ]
  },
  {
   "id": "rt_tx_0_0",
   "x": 509,
   "y": 768,
   "w": 220,
   "h": 298,
   "kind": "ok",
   "title": "As for AVNRT",
   "lines": [
    "• acute: adenosine or vagal",
    "• long term: catheter ABLATION"
   ]
  },
  {
   "id": "ab_tx_0_0",
   "x": 769,
   "y": 768,
   "w": 220,
   "h": 298,
   "kind": "ok",
   "title": "Treat as the SVT it is",
   "lines": []
  },
  {
   "id": "mv_tx_0_0",
   "x": 1001,
   "y": 768,
   "w": 220,
   "h": 147,
   "kind": "bad",
   "title": "Acute",
   "lines": [
    "• IV procainamide: any monomorphic VT",
    "• IV lidocaine: ischemic VT",
    "• cardiovert if unsure"
   ]
  },
  {
   "id": "mv_tx_1_0",
   "x": 1001,
   "y": 937,
   "w": 220,
   "h": 129,
   "kind": "warn",
   "title": "Long term",
   "lines": [
    "• sotalol, propafenone, amiodarone",
    "• defibrillator (ICD) or ablation"
   ]
  },
  {
   "id": "pv_tx_0_0",
   "x": 1233,
   "y": 768,
   "w": 220,
   "h": 78,
   "kind": "bad",
   "title": "Shock + IV AMIODARONE",
   "lines": [
    "refractory VT not from long QT, or VF"
   ]
  },
  {
   "id": "pv_tx_1_0",
   "x": 1233,
   "y": 868,
   "w": 220,
   "h": 98,
   "kind": "bad",
   "title": "Ischemia → treat as an ST-elevation MI",
   "lines": [
    "cath lab for primary angioplasty (PCI)"
   ]
  },
  {
   "id": "pv_tx_2_0",
   "x": 1233,
   "y": 988,
   "w": 220,
   "h": 78,
   "kind": "warn",
   "title": "Long term: ICD",
   "lines": [
    "~long QT syndromes need their own plan"
   ]
  }
 ],
