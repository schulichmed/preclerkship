 "panels": [
  {
   "x": 45,
   "y": 938,
   "w": 621,
   "title": "Tests for everyone (safety + inflammation)",
   "items": [
    "blood count: anemia of chronic disease, platelets ↑ (inflammation), low counts (autoimmune)",
    "creatinine and liver enzymes (drug clearance) · C-reactive protein (sedimentation rate not routine)"
   ],
   "cols": 1
  },
  {
   "x": 680,
   "y": 938,
   "w": 621,
   "title": "Antinuclear antibody (ANA)",
   "items": [
    "positive in up to 30% of healthy people: a positive ANA does NOT rule in connective tissue disease",
    "a negative ANA rules it out · don't order ANA and RF reflexively"
   ],
   "cols": 1
  }
 ]
