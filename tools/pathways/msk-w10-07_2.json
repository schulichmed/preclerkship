   "kind": "ra_t",
   "title": "Wrists, knuckles, finger joints, ankles, feet",
   "lines": [
    "• knuckles (MCPs) + middle finger joints (PIPs)",
    "• distal finger joints (DIPs) SPARED",
    "• ulnar deviation, knuckle subluxation"
   ]
  },
  {
   "id": "ra_clue_1_0",
   "x": 321,
   "y": 552,
   "w": 236,
   "h": 78,
   "kind": "ra_w",
   "title": "Extra-articular",
   "lines": [
