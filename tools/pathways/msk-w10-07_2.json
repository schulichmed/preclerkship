   "y": 396,
   "w": 236,
   "h": 115,
   "kind": "acu_t",
   "title": "Causes",
   "lines": [
    "• viral or post-infectious (see the MSK INFECTIONS chart)",
    "• polyarticular gout · rheumatic fever",
    "• drug reaction (serum sickness)"
   ]
  },
  {
   "id": "acu_clue_1_0",
   "x": 45,
   "y": 533,
   "w": 236,
   "h": 97,
   "kind": "acu_w",
   "title": "Course",
   "lines": [
    "• episodic: crystals",
    "• migratory: palindromic, rheumatic fever, early gonococcal"
   ]
  },
  {
   "id": "ra_clue_0_0",
   "x": 321,
   "y": 396,
   "w": 236,
