 "nodes": [
  {
   "id": "root",
   "x": 297,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "\"Dizzy\": is it TRUE VERTIGO, an illusion of rotary movement?",
   "lines": [
    "history is 80% of the workup · exam: nystagmus (named by its FAST phase) and ataxia · CT, MRI",
    "balance: vestibular + vision + position sense → brainstem, cerebellum → eye and limb muscles",
    "one ear fails → imbalance read as rotation: eye muscles = NYSTAGMUS · higher centres = VERTIGO · limbs = ataxia · vagal nucleus = nausea, vomiting",
    "anxiety: often the cause OR the effect · vestibular schwannoma: one-sided hearing loss + tinnitus, rarely vertigo"
   ]
  },
  {
   "id": "g_not",
   "x": 45,
   "y": 192,
   "w": 196,
   "h": 168,
   "kind": "plain",
   "title": "NO: dizziness",
   "lines": [
    "lightheaded, unsteady, disoriented · chronic"
   ]
  },
  {
   "id": "g_v",
   "x": 281,
   "y": 192,
   "w": 1028,
   "h": 168,
   "kind": "plain",
   "title": "YES: vestibular",
   "lines": [
    "episodic, limited duration · hearing symptoms · nausea, vomiting, sweating, bowels · worse with head movement",
    "• hair cells (CN VIII): bending toward the kinocilium opens K+ channels → depolarizes",
    "• resting firing ~100/s, so each afferent signals BOTH directions",
    "• otoliths (utricle, saccule): linear movement, tilt vs gravity · posture",
    "• canals: rotation · endolymph lags, pushes the cupula · gaze stabilization",
    "• canals work in PAIRS: the brain reads the difference, so one dead ear = false rotation",
    "• VOR: 3 neurons, eyes compensate in 10-15 ms"
   ]
  },
  {
   "id": "p_nys",
   "x": 281,
   "y": 400,
   "w": 1028,
   "h": 132,
   "kind": "info",
   "title": "Exam: read the NYSTAGMUS",
   "lines": [
    "• slow phase = vestibulo-ocular reflex · fast phase = saccade that resets the eye",
    "• PERIPHERAL (spontaneous vestibular): direction FIXED, mostly horizontal, SUPPRESSED by fixation",
    "• physiologic: rotation · caloric · optokinetic · end-point",
    "• caloric COWS: Cold → fast phase Opposite, Warm → Same · tests the brainstem in coma (needs the MLF for conjugate eyes)",
    "• other pathologic: positional · gaze-paretic · rebound · fixation · congenital · dissociated"
   ]
  },
  {
   "id": "t1",
   "x": 281,
   "y": 572,
   "w": 1028,
   "h": 78,
   "kind": "plain",
   "title": "How long does an attack last, and is hearing lost?",
   "lines": [
    "seconds: BPPV, dehiscence · minutes to hours: Ménière's (hearing lost) or migrainous (hearing kept) · days: labyrinthitis (hearing lost) or neuronitis (kept) · forever: uncompensated vestibular loss"
   ]
  },
  {
   "id": "diz_head_0_0",
   "x": 45,
   "y": 730,
   "w": 196,
   "h": 150,
   "kind": "diz_h",
   "title": "Not vestibular",
   "lines": []
  },
  {
   "id": "bppv_head_0_0",
   "x": 281,
   "y": 730,
   "w": 196,
   "h": 150,
   "kind": "bppv_h",
   "title": "BPPV",
   "lines": [
    "benign paroxysmal positional vertigo · commonest end-organ disorder"
   ]
  },
  {
   "id": "scd_head_0_0",
   "x": 489,
   "y": 730,
   "w": 196,
   "h": 150,
   "kind": "scd_h",
   "title": "Superior canal dehiscence",
   "lines": [
    "a third mobile window into the inner ear"
   ]
  },
  {
   "id": "men_head_0_0",
   "x": 697,
   "y": 730,
   "w": 196,
   "h": 150,
   "kind": "men_h",
   "title": "Ménière's disease",
   "lines": [
    "endolymphatic hydrops · 2nd commonest",
    "50-100 per 100,000 · 10% of dizzy clinic visits",
    "onset 40s, then 50s, 30s · familial < 10%"
   ]
  },
  {
   "id": "neu_head_0_0",
   "x": 905,
   "y": 730,
   "w": 196,
   "h": 150,
   "kind": "neu_h",
   "title": "Vestibular neuronitis / labyrinthitis",
   "lines": [
    "viral, often after a cold"
   ]
  },
  {
   "id": "ami_head_0_0",
   "x": 1113,
   "y": 730,
   "w": 196,
   "h": 150,
   "kind": "ami_h",
   "title": "Aminoglycoside toxicity",
   "lines": [
    "ear drops or injections"
   ]
  },
  {
   "id": "diz_sx_0_0",
   "x": 45,
   "y": 920,
   "w": 196,
   "h": 177,
   "kind": "diz_t",
   "title": "Organic",
   "lines": [
    "• presyncope, vasodepressor syncope",
    "• arrhythmia",
    "• orthostatic hypotension",
    "• hyperventilation · anemia",
    "• neuropathy · poor vision",
    "• musculoskeletal · drugs"
   ]
  },
  {
   "id": "diz_sx_1_0",
   "x": 45,
   "y": 1119,
   "w": 196,
   "h": 123,
   "kind": "diz_w",
   "title": "Psychiatric",
   "lines": [
    "• depression · anxiety",
    "• panic disorder",
    "• phobic dizziness · somatization"
   ]
  },
  {
   "id": "bppv_sx_0_0",
   "x": 281,
   "y": 920,
   "w": 196,
   "h": 114,
   "kind": "bppv_t",
   "title": "10-30 s of spinning",
   "lines": [
    "• set off by specific head movements",
    "• severe: motion sensitivity",
    "• hearing NORMAL"
   ]
  },
  {
   "id": "bppv_sx_1_0",
   "x": 281,
   "y": 1056,
   "w": 196,
   "h": 186,
   "kind": "bppv_w",
   "title": "Cause",
   "lines": [
    "• otoconia loose from the utricle float in the POSTERIOR canal (canalithiasis)",
    "• idiopathic (degenerative) or head trauma (commonest cause of bilateral)",
    "~rare: lateral or superior canal"
   ]
  },
  {
   "id": "scd_sx_0_0",
   "x": 489,
   "y": 920,
   "w": 196,
   "h": 322,
   "kind": "scd_t",
   "title": "Vertigo with LOUD SOUND or PRESSURE",
   "lines": [
    "• oscillopsia too",
    "• hears own voice (autophony), footsteps, eye movements",
    "• conductive loss, acoustic reflexes PRESERVED",
    "• sound evokes vertical-torsional eye movements in the superior canal's plane"
   ]
  },
  {
   "id": "men_sx_0_0",
   "x": 697,
   "y": 920,
   "w": 196,
   "h": 196,
   "kind": "men_t",
   "title": "Episodic vertigo, 24 min to 24 h",
   "lines": [
    "• FLUCTUATING LOW-frequency sensorineural loss",
    "• tinnitus · aural fullness",
    "~both ears in 25-30%, usually within 5 years"
   ]
  },
  {
   "id": "men_sx_1_0",
   "x": 697,
   "y": 1138,
   "w": 196,
   "h": 104,
   "kind": "men_w",
   "title": "Unpredictable",
   "lines": [
    "exacerbations, remissions · hard to judge treatment"
   ]
  },
  {
   "id": "neu_sx_0_0",
   "x": 905,
   "y": 920,
   "w": 196,
   "h": 322,
   "kind": "neu_t",
   "title": "Vertigo for DAYS",
   "lines": [
    "• nausea, vomiting",
    "• nystagmus beats AWAY from the bad ear"
   ]
  },
  {
   "id": "ami_sx_0_0",
   "x": 1113,
   "y": 920,
   "w": 196,
   "h": 150,
   "kind": "ami_t",
   "title": "One ear (drops)",
   "lines": [
    "vertigo, nystagmus beating away from it"
   ]
  },
  {
   "id": "ami_sx_1_0",
   "x": 1113,
   "y": 1092,
   "w": 196,
   "h": 150,
   "kind": "ami_w",
   "title": "Systemic (both ears)",
   "lines": [
    "severe disequilibrium, motion sensitivity, oscillopsia"
   ]
  },
  {
   "id": "diz_inv_0_0",
   "x": 45,
   "y": 1282,
   "w": 196,
   "h": 214,
   "kind": "diz_w",
   "title": "Look for",
   "lines": [
    "cardiac or neurological symptoms, loss of consciousness"
   ]
  },
  {
   "id": "bppv_inv_0_0",
   "x": 281,
   "y": 1282,
   "w": 196,
   "h": 214,
   "kind": "bppv_w",
   "title": "Dix-Hallpike",
   "lines": [
    "• torsional nystagmus after a LATENCY",
    "• left ear clockwise, right counterclockwise",
    "• brief, fades, reverses on sitting up"
   ]
  },
  {
   "id": "scd_inv_0_0",
   "x": 489,
   "y": 1282,
   "w": 196,
   "h": 214,
   "kind": "scd_w",
   "title": "Audiometry + temporal bone CT",
   "lines": []
  },
  {
   "id": "men_inv_0_0",
   "x": 697,
   "y": 1282,
   "w": 196,
   "h": 78,
   "kind": "men_w",
   "title": "Ménière's syndrome?",
   "lines": [
    "secondary: syphilis, trauma, labyrinthitis"
   ]
  },
  {
   "id": "men_inv_1_0",
   "x": 697,
   "y": 1382,
   "w": 196,
   "h": 114,
   "kind": "men_w",
   "title": "Why",
   "lines": [
    "↓ endolymph resorption or ↑ production (stria vascularis, dark cells) · hydrops ≠ always Ménière's"
   ]
  },
  {
   "id": "neu_inv_0_0",
   "x": 905,
   "y": 1282,
   "w": 196,
   "h": 96,
   "kind": "neu_w",
   "title": "Hearing kept → NEURONITIS",
   "lines": []
  },
  {
   "id": "neu_inv_1_0",
   "x": 905,
   "y": 1400,
   "w": 196,
   "h": 96,
   "kind": "neu_w",
   "title": "Hearing loss + tinnitus → LABYRINTHITIS",
   "lines": []
  },
  {
   "id": "ami_inv_0_0",
   "x": 1113,
   "y": 1282,
   "w": 196,
   "h": 214,
   "kind": "ami_w",
   "title": "Usually diagnosed 'after the fact'",
   "lines": []
  },
  {
   "id": "diz_tx_0_0",
   "x": 45,
   "y": 1536,
   "w": 196,
   "h": 542,
   "kind": "diz_w",
   "title": "Not a vestibular problem",
   "lines": [
    "~chronic disequilibrium, lightheadedness"
   ]
  },
  {
   "id": "bppv_tx_0_0",
   "x": 281,
   "y": 1536,
   "w": 196,
   "h": 542,
   "kind": "ok",
   "title": "Particle repositioning (Epley, Semont)",
   "lines": [
    "80% after 1 session · 95% after 3",
    "• cure: same-direction nystagmus 80% · reversed 10% · none 50%",
    "~intractable: posterior canal occlusion"
   ]
  },
  {
   "id": "scd_tx_0_0",
   "x": 489,
   "y": 1536,
   "w": 196,
   "h": 542,
   "kind": "ok",
   "title": "Avoid triggers, or surgery",
   "lines": []
  },
  {
   "id": "men_tx_0_0",
   "x": 697,
   "y": 1536,
   "w": 196,
   "h": 98,
   "kind": "ok",
   "title": "1 · Everyone, 3-6 months",
   "lines": [
    "low salt · no caffeine, chocolate, alcohol, tobacco"
   ]
  },
  {
   "id": "men_tx_1_0",
   "x": 697,
   "y": 1656,
   "w": 196,
   "h": 114,
   "kind": "ok",
   "title": "2 · Attacks",
   "lines": [
    "vestibular suppressant · diuretic · betahistine (Serc)",
    "~conservative care controls vertigo in 80%"
   ]
  },
  {
   "id": "men_tx_2_0",
   "x": 697,
   "y": 1792,
   "w": 196,
   "h": 150,
   "kind": "warn",
   "title": "3 · Failing: into the ear",
   "lines": [
    "steroids → pressure pulse → gentamicin",
    "• or endolymphatic sac surgery",
    "~intratympanic has largely replaced surgery"
   ]
  },
  {
   "id": "men_tx_3_0",
   "x": 697,
   "y": 1964,
   "w": 196,
   "h": 114,
   "kind": "bad",
   "title": "4 · Last: surgery",
   "lines": [
    "vestibular neurectomy → labyrinthectomy",
    "~ablation does NOT cure the disease"
   ]
  },
  {
   "id": "neu_tx_0_0",
   "x": 905,
   "y": 1536,
   "w": 196,
   "h": 542,
   "kind": "ok",
   "title": "Symptoms, short-term",
   "lines": [
    "• antiemetics, vestibular sedatives",
    "• oral steroids if within 72 h",
    "~antivirals: no evidence"
   ]
  },
  {
   "id": "ami_tx_0_0",
   "x": 1113,
   "y": 1536,
   "w": 196,
   "h": 542,
   "kind": "bad",
   "title": "STOP the aminoglycoside",
   "lines": [
    "~usually permanent, some partial recovery"
   ]
  }
 ],
