   "x": 815,
   "y": 472,
   "w": 226,
   "h": 150,
   "kind": "rl_t",
   "title": "Viral picture",
   "lines": [
    "• flu-like illness, sick contacts",
    "• Epstein-Barr virus (EBV) mononucleosis in the young",
    "• reactive lymphocytes wrap around red cells"
   ]
  },
  {
   "id": "rl_clue_1_0",
   "x": 815,
   "y": 644,
   "w": 226,
