   "title": "Blasts in the blood",
   "lines": [
    "• acute myeloid (AML) or lymphoblastic (ALL)",
    "• YOUNG patient → suspect ALL"
   ]
  },
  {
   "id": "rn_clue_0_0",
   "x": 311,
   "y": 472,
   "w": 226,
   "h": 114,
   "kind": "rn_t",
   "title": "Film: REACTIVE",
   "lines": [
    "• NO blasts or promyelocytes",
    "• toxic granules, toxic vacuoles, Döhle bodies",
    "• left shift (infection)"
   ]
  },
  {
   "id": "rn_clue_1_0",
   "x": 311,
   "y": 608,
   "w": 226,
   "h": 132,
   "kind": "rn_w",
   "title": "Causes",
   "lines": [
    "• infection, burns, heart attack, trauma, autoimmune",
    "• steroids, lithium, smoking",
    "• stress, exercise (demargination), hyposplenism"
   ]
  },
  {
   "id": "mp_clue_0_0",
   "x": 549,
   "y": 472,
   "w": 226,
   "h": 132,
   "kind": "mp_t",
   "title": "Film: favours NEOPLASM",
   "lines": [
    "• immature myeloid cells",
    "• WBC > 30 × 10⁹/L",
    "• ↑ eosinophils and/or basophils"
   ]
  },
  {
   "id": "mp_clue_1_0",
   "x": 549,
   "y": 626,
   "w": 226,
   "h": 114,
   "kind": "mp_w",
   "title": "History + exam",
   "lines": [
    "• pruritus, early satiety (PV)",
    "• splenomegaly"
   ]
  },
  {
