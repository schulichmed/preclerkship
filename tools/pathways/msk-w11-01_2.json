   "id": "cel_clue_0_0",
   "x": 45,
   "y": 560,
   "w": 232,
   "h": 342,
   "kind": "cel_t",
   "title": "DORSAL hand, wrist to knuckles",
   "lines": [
    "IRREGULAR margins · superficial"
   ]
  },
  {
   "id": "deep_clue_0_0",
   "x": 289,
   "y": 560,
   "w": 232,
   "h": 169,
   "kind": "deep_t",
   "title": "Where is the pus?",
   "lines": [
    "• nail fold: PARONYCHIA, F > M (S. aureus · mixed in diabetes · fungus if immunocompromised)",
    "• fingertip pulp: FELON",
    "• flexor tendon sheath: TENOSYNOVITIS"
   ]
  },
  {
   "id": "deep_clue_1_0",
   "x": 289,
   "y": 751,
   "w": 232,
   "h": 151,
   "kind": "deep_w",
   "title": "Bite over a joint",
   "lines": [
    "• cat, finger PIP or DIP joints: Pasteurella multocida, mixed",
    "• human, young men, fist fight, knuckle (MCP): Eikenella corrodens, mixed"
   ]
  },
  {
   "id": "oth_clue_0_0",
   "x": 561,
   "y": 560,
   "w": 232,
   "h": 214,
   "kind": "oth_t",
   "title": "Ask: partners, ticks, travel",
   "lines": [
    "• young, multiple partners, MSM, F > M: GONOCOCCAL (knee, wrist, ankle)",
    "• disseminated: tenosynovitis + pustular rash + polyarthralgia",
    "• endemic country: TUBERCULOSIS"
   ]
  },
  {
   "id": "oth_clue_1_0",
   "x": 561,
   "y": 796,
   "w": 232,
   "h": 106,
   "kind": "bad",
   "title": "SEVERAL joints, bacterial",
   "lines": [
    "THINK ENDOCARDITIS"
   ]
  },
  {
   "id": "om_clue_0_0",
   "x": 833,
   "y": 560,
   "w": 232,
   "h": 232,
   "kind": "om_t",
   "title": "Vertebral: severe back pain",
   "lines": [
    "• often afebrile · people who inject drugs, middle-aged men",
    "• check strength, reflexes, anal tone",
    "• TB (Pott's), Brucella: exposure history · M. bovis after BCG for bladder cancer",
    "case: 55 M, 5 days of 9/10 back pain, afebrile, neuro normal → MRI L3-L4 spondylodiscitis: look for paravertebral, epidural abscess"
   ]
  },
  {
   "id": "om_clue_1_0",
   "x": 833,
   "y": 814,
   "w": 232,
   "h": 88,
   "kind": "om_w",
   "title": "Child under 12: metaphysis",
   "lines": [
    "S. aureus always · Salmonella in sickle cell · Kingella"
   ]
  },
  {
   "id": "dfi_clue_0_0",
   "x": 1077,
   "y": 560,
   "w": 232,
   "h": 206,
   "kind": "dfi_t",
   "title": "A wound is NOT always infected",
   "lines": [
    "• swab any wound and bacteria grow",
    "• smelly? probe to bone? blood supply?",
    "• why? new shoes, injury, not wearing the boot, can't afford meds, vascular disease, Charcot, old ulcer"
   ]
  },
  {
   "id": "dfi_clue_1_0",
   "x": 1077,
   "y": 788,
   "w": 232,
   "h": 114,
   "kind": "dfi_w",
   "title": "Grade",
   "lines": [
    "• mild: skin only",
    "• moderate: over 2 cm or deeper",
    "• severe: + systemic inflammatory response"
   ]
  },
  {
   "id": "cel_inv_0_0",
   "x": 45,
   "y": 942,
   "w": 232,
   "h": 196,
   "kind": "cel_w",
   "title": "Clinical",
   "lines": [
    "no pus, no closed space"
   ]
  },
  {
   "id": "deep_inv_0_0",
   "x": 289,
   "y": 942,
   "w": 232,
   "h": 196,
   "kind": "deep_t",
   "title": "Kanavel's 4 signs = tenosynovitis",
   "lines": [
    "• whole finger swollen",
    "• held flexed · tender along the sheath",
    "• intense pain on extension"
   ]
  },
  {
   "id": "oth_inv_0_0",
   "x": 561,
   "y": 942,
   "w": 232,
   "h": 196,
   "kind": "oth_w",
   "title": "Match the test to the bug",
   "lines": [
    "• gonococcus: urine, rectal, throat nucleic acid test or culture + blood culture (joint fluid + in only 50%)",
    "• Lyme: serology (joint fluid PCR lower yield) · tuberculosis: joint fluid for acid-fast bacilli"
   ]
  },
  {
   "id": "om_inv_0_0",
   "x": 833,
   "y": 942,
   "w": 232,
   "h": 60,
   "kind": "om_t",
   "title": "1 · Blood cultures",
   "lines": [
    "~± spinal biopsy"
   ]
  },
  {
   "id": "om_inv_1_0",
   "x": 833,
   "y": 1024,
   "w": 232,
   "h": 114,
   "kind": "om_t",
   "title": "2 · MRI = most sensitive",
   "lines": [
    "• X-ray, CT not sensitive enough",
    "• tagged white cell scan takes 2 days",
    "• don't repeat if improving"
   ]
  },
  {
   "id": "dfi_inv_0_0",
   "x": 1077,
   "y": 942,
   "w": 232,
   "h": 106,
   "kind": "dfi_w",
   "title": "1 · Bloods; swab only a good deep specimen",
   "lines": [
    "blood count, electrolytes, creatinine, C-reactive protein"
   ]
  },
  {
   "id": "dfi_inv_1_0",
   "x": 1077,
   "y": 1070,
   "w": 232,
   "h": 68,
   "kind": "dfi_w",
   "title": "2 · X-ray first → MRI",
   "lines": [
    "for osteomyelitis under the ulcer"
   ]
  },
  {
   "id": "cel_tx_0_0",
   "x": 45,
   "y": 1178,
   "w": 232,
   "h": 404,
   "kind": "ok",
   "title": "Antibiotics",
   "lines": [
    "+ rest, elevation"
   ]
  },
  {
   "id": "deep_tx_0_0",
   "x": 289,
   "y": 1178,
   "w": 232,
   "h": 404,
   "kind": "bad",
   "title": "Incision and drainage",
   "lines": [
    "+ wound care + antibiotics (bites: broad-spectrum)"
   ]
  },
  {
   "id": "oth_tx_0_0",
   "x": 561,
   "y": 1178,
   "w": 232,
   "h": 404,
   "kind": "ok",
   "title": "Bug-specific",
   "lines": [
    "• gonococcal: ceftriaxone 10–14 days",
    "• Lyme: IV ceftriaxone 28 days",
    "• tuberculosis: RIPE four-drug therapy, 9 months–1 year"
   ]
  },
  {
   "id": "om_tx_0_0",
   "x": 833,
   "y": 1178,
   "w": 232,
   "h": 120,
   "kind": "bad",
   "title": "Cord compressed or epidural abscess",
   "lines": [
    "→ neurosurgery"
   ]
  },
  {
   "id": "om_tx_1_0",
   "x": 833,
   "y": 1320,
   "w": 232,
   "h": 262,
   "kind": "ok",
   "title": "IV vancomycin + ceftriaxone",
   "lines": [
    "• HIGH doses (ceftriaxone 2 g IV q24h) · 6 weeks (vertebral)",
    "• debride dead bone if needed · sacral ulcer: offload, debride, plastics",
    "• cure depends on blood supply, chronicity, debridement, patient engagement",
    "~ OVIVA trial: oral as good as IV for many (quinolones)"
   ]
  },
  {
   "id": "dfi_tx_0_0",
   "x": 1077,
   "y": 1178,
   "w": 232,
   "h": 78,
   "kind": "ok",
   "title": "Mild, one bug (staph, strep)",
   "lines": [
    "cefazolin (or cephalexin, doxycycline, amoxicillin-clavulanate)"
   ]
  },
  {
   "id": "dfi_tx_1_0",
   "x": 1077,
   "y": 1278,
   "w": 232,
   "h": 114,
   "kind": "warn",
   "title": "Chronic: polymicrobial",
   "lines": [
    "amoxicillin-clavulanate · severe: IV ceftriaxone + metronidazole",
    "Pseudomonas → piperacillin-tazobactam"
   ]
  },
  {
   "id": "dfi_tx_2_0",
   "x": 1077,
   "y": 1414,
   "w": 232,
   "h": 168,
   "kind": "bad",
   "title": "Severe",
   "lines": [
    "• exclude necrotizing fasciitis",
    "• piperacillin-tazobactam ± vancomycin",
    "• blood cultures · offload, debride, call ortho or vascular",
    "• vancomycin if MRSA history or risk · revascularize?"
   ]
  }
