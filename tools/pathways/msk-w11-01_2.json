   "title": "Painful purpura on the legs",
   "lines": []
  },
  {
   "id": "g_sec",
   "x": 915,
   "y": 156,
   "w": 250,
   "h": 42,
   "kind": "plain",
   "title": "A cause is found",
   "lines": []
  },
  {
   "id": "gca_head_0_0",
   "x": 45,
   "y": 278,
   "w": 250,
   "h": 132,
   "kind": "gca_h",
   "title": "Giant cell arteritis (GCA)",
   "lines": [
    "large vessel · the most common vasculitis",
    "only over 50 (most over 70)"
   ]
  },
  {
   "id": "anca_head_0_0",
   "x": 335,
   "y": 278,
   "w": 250,
   "h": 132,
   "kind": "anca_h",
   "title": "ANCA-associated vasculitis",
   "lines": [
    "anti-neutrophil cytoplasmic antibody · small vessel",
    "granulomatosis with polyangiitis (GPA)",
    "microscopic (MPA) · eosinophilic (EGPA)"
   ]
  },
  {
   "id": "lcv_head_0_0",
   "x": 625,
   "y": 278,
   "w": 250,
   "h": 132,
   "kind": "lcv_h",
   "title": "Cutaneous leukocytoclastic vasculitis",
   "lines": [
    "small vessel · alone or part of another type"
   ]
  },
  {
   "id": "sec_head_0_0",
   "x": 915,
   "y": 278,
   "w": 250,
   "h": 132,
   "kind": "sec_h",
   "title": "Secondary vasculitis",
   "lines": [
    "an identifiable underlying cause"
   ]
  },
  {
   "id": "gca_pres_0_0",
   "x": 45,
   "y": 450,
   "w": 250,
   "h": 96,
   "kind": "gca_t",
   "title": "Cranial",
   "lines": [
    "• temporal headache, scalp tender",
    "• jaw claudication",
    "• diplopia, vision loss (15-20%)"
   ]
  },
  {
   "id": "gca_pres_1_0",
   "x": 45,
   "y": 568,
   "w": 250,
   "h": 96,
   "kind": "gca_w",
   "title": "Systemic",
   "lines": [
    "• polymyalgia symptoms: see BODY PAIN",
    "• fatigue, fever, weight loss"
   ]
  },
  {
   "id": "anca_pres_0_0",
   "x": 335,
   "y": 450,
   "w": 250,
   "h": 105,
   "kind": "anca_t",
   "title": "Sinonasal · lung · kidney",
   "lines": [
    "• bloody crusty nose, sinus pain",
    "• dyspnea, nodules, lung hemorrhage",
    "• creatinine ↑, blood + protein in urine"
   ]
  },
  {
   "id": "anca_pres_1_0",
   "x": 335,
   "y": 577,
   "w": 250,
   "h": 87,
   "kind": "anca_w",
   "title": "Also",
   "lines": [
    "• eye mass (diplopia) · arthritis",
    "• mononeuritis multiplex · purpura"
   ]
  },
  {
   "id": "lcv_pres_0_0",
   "x": 625,
   "y": 450,
   "w": 250,
   "h": 105,
   "kind": "lcv_t",
   "title": "Painful NON-blanching purpura",
   "lines": [
    "• legs · ankles painful, swollen",
    "• ± urticarial vasculitis, ulcers"
   ]
  },
  {
   "id": "lcv_pres_1_0",
   "x": 625,
   "y": 577,
   "w": 250,
   "h": 87,
   "kind": "lcv_w",
   "title": "Other cause of purpura?",
   "lines": [
    "coagulopathy"
   ]
  },
  {
   "id": "sec_pres_0_0",
   "x": 915,
   "y": 450,
   "w": 250,
   "h": 214,
   "kind": "sec_t",
   "title": "Look for",
   "lines": [
    "• infection: hepatitis B or C, HIV, other",
    "• drugs, toxins: allergy, cocaine",
    "• cancer · lupus, rheumatoid arthritis, Sjögren's"
   ]
  },
  {
   "id": "gca_inv_0_0",
   "x": 45,
   "y": 704,
   "w": 250,
   "h": 110,
   "kind": "gca_t",
   "title": "1 · ESR + CRP immediately",
   "lines": [
    "both normal → GCA highly unlikely (< 2%)"
   ]
  },
  {
   "id": "gca_inv_1_0",
   "x": 45,
   "y": 836,
   "w": 250,
   "h": 166,
   "kind": "gca_w",
   "title": "2 · Temporal artery biopsy in 1-2 weeks",
   "lines": [
    "• 100% specific",
    "• negative in 50-70% (skip lesions)",
    "• or Doppler 'halo sign' in specialty centres"
   ]
  },
  {
   "id": "anca_inv_0_0",
   "x": 335,
   "y": 704,
   "w": 250,
   "h": 60,
   "kind": "anca_t",
   "title": "1 · Rule out infection",
   "lines": [
    "cultures, hepatitis, HIV"
   ]
  },
  {
   "id": "anca_inv_1_0",
   "x": 335,
   "y": 786,
   "w": 250,
   "h": 134,
   "kind": "anca_w",
   "title": "2 · ANCA ONLY if small vessel suspected",
   "lines": [
    "• cytoplasmic (anti-PR3) → GPA",
    "• perinuclear (anti-MPO) → MPA, EGPA",
    "• negative does NOT rule it out"
   ]
  },
  {
   "id": "anca_inv_2_0",
   "x": 335,
   "y": 942,
   "w": 250,
   "h": 60,
   "kind": "anca_w",
   "title": "3 · Biopsy the involved organ",
   "lines": [
    "first-line in single-organ disease"
   ]
  },
  {
   "id": "lcv_inv_0_0",
   "x": 625,
   "y": 704,
   "w": 250,
   "h": 139,
   "kind": "lcv_t",
   "title": "1 · Platelets + clotting times (INR, PTT)",
   "lines": [
    "rule out a coagulopathy"
   ]
  },
  {
   "id": "lcv_inv_1_0",
   "x": 625,
   "y": 865,
   "w": 250,
   "h": 137,
   "kind": "lcv_w",
   "title": "2 · Skin biopsy",
   "lines": [
    "• purpura: punch biopsy in primary care",
    "• ulcer: deep excision by a surgeon"
   ]
  },
  {
   "id": "sec_inv_0_0",
   "x": 915,
   "y": 704,
   "w": 250,
   "h": 156,
   "kind": "sec_t",
   "title": "Rule out infection",
   "lines": [
    "• blood, urine, sputum cultures (fungal, acid-fast)",
    "• hepatitis B + C, HIV, syphilis",
    "• cryoglobulins ↑, complement ↓"
   ]
  },
  {
   "id": "sec_inv_1_0",
   "x": 915,
   "y": 882,
   "w": 250,
   "h": 120,
   "kind": "sec_w",
   "title": "Rule out cancer",
   "lines": [
    "• age-appropriate screening",
    "• serum protein electrophoresis"
   ]
  },
  {
   "id": "gca_tx_0_0",
   "x": 45,
   "y": 1042,
   "w": 250,
   "h": 98,
   "kind": "bad",
   "title": "1 · Prednisone 1 mg/kg (max 60 mg) TODAY",
   "lines": [
    "after blood is drawn · NEVER wait for results"
   ]
  },
  {
   "id": "gca_tx_1_0",
   "x": 45,
   "y": 1162,
   "w": 250,
   "h": 80,
   "kind": "bad",
   "title": "Vision loss or stroke → emergency",
   "lines": [
    "urgent ophthalmology or neurology"
   ]
  },
  {
   "id": "gca_tx_2_0",
   "x": 45,
   "y": 1264,
   "w": 250,
   "h": 96,
   "kind": "ok",
   "title": "2 · Protect + refer",
   "lines": [
    "• proton pump inhibitor",
    "• calcium, vitamin D, bisphosphonate",
    "• rheumatology"
   ]
  },
  {
   "id": "anca_tx_0_0",
   "x": 335,
   "y": 1042,
   "w": 250,
   "h": 85,
   "kind": "bad",
   "title": "Unstable, lung bleed, renal failure → ADMIT",
   "lines": []
  },
  {
   "id": "anca_tx_1_0",
   "x": 335,
   "y": 1149,
   "w": 250,
   "h": 103,
   "kind": "warn",
   "title": "Active urine sediment, normal creatinine",
   "lines": [
    "→ urgent nephrology"
   ]
  },
  {
   "id": "anca_tx_2_0",
   "x": 335,
   "y": 1274,
   "w": 250,
   "h": 85,
   "kind": "ok",
   "title": "All others → urgent rheumatology",
   "lines": []
  },
  {
   "id": "lcv_tx_0_0",
   "x": 625,
   "y": 1042,
   "w": 250,
   "h": 85,
   "kind": "ok",
   "title": "1 · Topical corticosteroid",
   "lines": [
    "non-severe skin disease"
   ]
  },
  {
   "id": "lcv_tx_1_0",
   "x": 625,
   "y": 1149,
   "w": 250,
   "h": 87,
   "kind": "ok",
   "title": "2 · Anti-inflammatory (NSAID) or colchicine",
   "lines": []
  },
  {
   "id": "lcv_tx_2_0",
   "x": 625,
   "y": 1258,
   "w": 250,
   "h": 103,
   "kind": "warn",
   "title": "3 · Oral prednisone",
   "lines": [
    "only if severe, other agents failed, infection excluded"
   ]
  },
  {
   "id": "sec_tx_0_0",
   "x": 915,
   "y": 1042,
   "w": 250,
   "h": 147,
   "kind": "ok",
   "title": "Treat the cause",
   "lines": [
    "hepatitis C → antivirals first"
   ]
  },
  {
   "id": "sec_tx_1_0",
   "x": 915,
   "y": 1211,
   "w": 250,
   "h": 149,
   "kind": "bad",
   "title": "Steroids can WORSEN an infection",
   "lines": []
  }
 ],
