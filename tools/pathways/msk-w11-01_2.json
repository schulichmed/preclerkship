 "panels": [
  {
   "x": 45,
   "y": 1394,
   "w": 553,
   "title": "Suspect primary vasculitis when",
   "items": [
    "chronically unwell: fevers, chills, weight loss",
    "several organ systems · purpura",
    "multi-organ failure: lung hemorrhage + renal dysfunction",
    "AND no infection or cancer found"
   ],
   "cols": 1
  },
  {
   "x": 612,
   "y": 1394,
   "w": 553,
   "title": "Classify by vessel size",
   "items": [
    "large: giant cell, Takayasu",
    "medium: polyarteritis nodosa, Kawasaki, Behçet's",
    "small: ANCA trio, cryoglobulinemia, cutaneous leukocytoclastic, Henoch-Schönlein",
    "children: Kawasaki, Henoch-Schönlein"
   ],
   "cols": 1
  }
 ]
}