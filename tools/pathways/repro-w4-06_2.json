 "panels": [
  {
   "x": 45,
   "y": 1054,
   "w": 409,
   "title": "Taking the sample",
   "items": [
    "ThinPrep: do NOT leave the broom in the vial · SurePath: may be left",
    "label: full name, date of birth, collection date · expired vial = rejected",
    "self-collected: for UNDER- + NEVER-screened; HPV test sensitive enough on vaginal cells",
    "not for symptomatic people · include the transformation zone"
   ],
   "cols": 1
  },
  {
   "x": 468,
   "y": 1054,
   "w": 409,
   "title": "Reading the reflex cytology",
   "items": [
    "LOW grade → repeat in 1 year: NILM (95% of results) · ASC-US · LSIL",
    "HIGH grade → colposcopy: HSIL · ASC-H · squamous cell carcinoma",
    "GLANDULAR → colposcopy: AGC · AIS"
   ],
   "cols": 1
  },
  {
   "x": 892,
   "y": 1054,
   "w": 409,
   "title": "Why HPV first, cytology second",
   "items": [
    "HPV more SENSITIVE: finds high-grade lesions earlier → 5-year interval",
    "BUT lower positive predictive value: HPV + ≠ a lesion, so cytology triages",
    "low-risk HPV 6, 11 = warts + LSIL, NOT cancer"
   ],
   "cols": 1
  }
 ]
