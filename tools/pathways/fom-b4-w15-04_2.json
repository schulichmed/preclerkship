   "id": "en_first_0_0",
   "x": 1137,
   "y": 380,
   "w": 240,
   "h": 132,
   "kind": "ok",
   "title": "MILD-moderate: ITRACONAZOLE",
   "lines": [
    "• blasto: 200 mg po TID × 3 days, then BID × 6–12 months",
    "• cocci: itraconazole or fluconazole"
   ]
  },
