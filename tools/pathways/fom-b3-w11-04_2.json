   ]
  },
  {
   "id": "apl_clue_0_0",
   "x": 287,
   "y": 534,
   "w": 230,
   "h": 214,
   "kind": "apl_t",
   "title": "Bleeding + DIC",
   "lines": [
    "• often fatal INTRACEREBRAL hemorrhage",
    "• cytopenias, tumour lysis, leukostasis"
   ]
  },
  {
   "id": "all_clue_0_0",
   "x": 529,
   "y": 534,
   "w": 230,
   "h": 214,
   "kind": "all_t",
   "title": "Child: the classic signs",
   "lines": [
    "• bruising, bleeding, PALLOR, fever",
    "• lymphadenopathy, splenomegaly",
    "• testicular mass"
   ]
  },
  {
   "id": "cml_clue_0_0",
   "x": 799,
