   "h": 324,
   "kind": "warn",
   "title": "DISCUSS options with the patient",
   "lines": [
    "a second unprovoked seizure > 24 h apart = epilepsy"
   ]
  },
  {
   "id": "epi_tx_0_0",
   "x": 1007,
   "y": 794,
   "w": 290,
   "h": 150,
   "kind": "ok",
   "title": "RECOMMEND an antiseizure drug",
   "lines": [
    "• 1st drug → 2nd drug (switch or combine)",
    "• monitor side effects, interactions, levels",
    "• choose by: mono vs poly, comorbidities (headache, mood), dose range, adherence, titration, cost, age, PREGNANCY (teratogenic)"
   ]
  },
  {
   "id": "epi_tx_1_0",
   "x": 1007,
   "y": 966,
   "w": 290,
   "h": 152,
   "kind": "bad",
   "title": "2 tolerated, appropriate drugs FAILED = drug-resistant",
   "lines": [
    "→ REFER to a comprehensive EPILEPSY CENTRE (a 3rd drug alongside)",
    "→ rule out pseudoresistance → presurgical workup → surgery, neurostimulation (vagus nerve, responsive)"
   ]
  },
