 "nodes": [
  {
   "id": "root",
   "x": 456,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "A first seizure: HISTORY is the key",
   "lines": [
    "details of the event · witnesses · ambulance records · risk factors: febrile seizures, head trauma, meningitis or encephalitis, family history",
    "seizure = transient signs or symptoms from abnormal EXCESSIVE or SYNCHRONOUS neuronal activity",
    "exam often normal · look for tongue biting, musculoskeletal injuries",
    "URGENT evaluation if fever, trauma, enduring confusion or low consciousness, or a persistent focal deficit"
   ]
  },
  {
   "id": "g_ne",
   "x": 45,
   "y": 192,
   "w": 290,
   "h": 60,
   "kind": "plain",
   "title": "Was it a seizure?",
   "lines": [
    "NO"
   ]
  },
  {
   "id": "g_prov",
   "x": 375,
   "y": 192,
   "w": 290,
   "h": 60,
   "kind": "plain",
   "title": "Was it PROVOKED?",
   "lines": [
    "YES"
   ]
  },
  {
   "id": "g_unprov",
   "x": 705,
   "y": 192,
   "w": 592,
   "h": 60,
   "kind": "plain",
   "title": "UNPROVOKED: how likely is ANOTHER?",
   "lines": [
    "an enduring abnormality: genetic, old stroke, old trauma, tumour"
   ]
  },
  {
   "id": "g_se",
   "x": 1337,
   "y": 192,
   "w": 290,
   "h": 60,
   "kind": "plain",
   "title": "Still seizing?",
   "lines": [
    "YES"
   ]
  },
  {
   "id": "p_unprov",
   "x": 705,
   "y": 292,
   "w": 592,
   "h": 96,
   "kind": "info",
   "title": "Work up to estimate the RECURRENCE RISK",
   "lines": [
    "1 · electrolytes (extended) · CT in the emergency department: bleed, tumour?",
    "2 · MRI, epilepsy protocol (dedicated temporal lobes): a STRUCTURAL lesion ↑ risk",
    "3 · EEG: EPILEPTIFORM discharges ↑ risk"
   ]
  },
  {
