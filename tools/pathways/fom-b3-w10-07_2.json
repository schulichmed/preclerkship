 "nodes": [
  {
   "id": "root",
   "x": 478,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Anticoagulant: which one, how do I MONITOR it, and how do I REVERSE it?",
   "lines": [
    "none of them with active bleeding, recent brain or spinal (CNS) surgery, or thrombocytopenia"
   ]
  },
  {
   "id": "g_ind",
   "x": 45,
   "y": 120,
   "w": 666,
   "h": 80,
   "kind": "plain",
   "title": "INDIRECT: need ANTITHROMBIN · injected",
   "lines": [
    "the renal ones last longer in renal failure"
   ]
  },
  {
   "id": "g_or",
   "x": 751,
   "y": 120,
   "w": 666,
   "h": 80,
   "kind": "plain",
   "title": "ORAL",
   "lines": [
    "direct oral anticoagulants (Xa inhibitors, dabigatran): no monitoring, but P-glycoprotein and CYP3A4 drugs raise or lower levels"
   ]
  },
  {
   "id": "g_iv",
   "x": 1457,
   "y": 120,
   "w": 214,
   "h": 80,
   "kind": "plain",
   "title": "IV DIRECT thrombin inhibitors",
   "lines": [
    "no antithrombin needed"
   ]
  },
  {
   "id": "ufh_head_0_0",
   "x": 45,
   "y": 280,
   "w": 214,
   "h": 116,
   "kind": "ufh_h",
   "title": "Unfractionated heparin (UFH)",
   "lines": [
    "IIa + Xa · IV or subcutaneous (SC), hospital",
    "half-life 60–90 min"
   ]
  },
  {
   "id": "lmwh_head_0_0",
   "x": 271,
   "y": 280,
   "w": 214,
   "h": 116,
   "kind": "lmwh_h",
   "title": "Low molecular weight heparin (LMWH)",
   "lines": [
    "Xa > IIa · SC, at home",
    "half-life 3–6 h"
   ]
  },
  {
   "id": "fon_head_0_0",
   "x": 497,
   "y": 280,
   "w": 214,
   "h": 116,
   "kind": "fon_h",
   "title": "Fondaparinux",
   "lines": [
    "synthetic · Xa ONLY · SC",
    "half-life 17–21 h"
   ]
  },
  {
   "id": "war_head_0_0",
   "x": 751,
   "y": 280,
   "w": 214,
   "h": 116,
   "kind": "war_h",
   "title": "Warfarin",
   "lines": [
    "vitamin K antagonist: no active II, VII, IX, X, protein C, S",
    "half-life 36–42 h"
   ]
  },
  {
   "id": "xa_head_0_0",
   "x": 977,
   "y": 280,
   "w": 214,
   "h": 116,
   "kind": "xa_h",
   "title": "Direct Xa inhibitors",
   "lines": [
    "rivaroxaban, apixaban, edoxaban",
    "half-life 7–14 h"
   ]
  },
  {
   "id": "dab_head_0_0",
   "x": 1203,
   "y": 280,
   "w": 214,
   "h": 116,
   "kind": "dab_h",
   "title": "Dabigatran",
   "lines": [
