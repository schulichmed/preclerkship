    "half-life 12–18 h"
   ]
  },
  {
   "id": "ivd_head_0_0",
   "x": 1457,
   "y": 280,
   "w": 214,
   "h": 116,
   "kind": "ivd_h",
   "title": "Bivalirudin · argatroban",
   "lines": [
    "IV"
   ]
  },
  {
   "id": "ufh_use_0_0",
   "x": 45,
   "y": 436,
   "w": 214,
   "h": 150,
   "kind": "ok",
   "title": "Choose",
   "lines": [
    "• RENAL FAILURE (liver clears it)",
    "• coats dialysis, bypass, ECMO circuits",
    "• after myocardial infarction, unstable angina"
   ]
  },
