   "kind": "add_t",
   "title": "Presents as",
   "lines": [
    "• weight loss, weakness, nausea, vomiting, abdominal pain",
    "• recurrent infection",
    "~• female predominance",
    "~• peaks 30–50 y"
   ]
  },
  {
   "id": "add_pres_1_0",
