  {
   "id": "root",
   "x": 499,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Ovarian mass: how OLD is she, and is it benign or malignant?",
   "lines": [
    "MOST are NOT malignant · cancer is more likely POST-MENOPAUSAL",
    "pain (rupture, torsion) · distension (ascites, mass) · bladder or bowel change · weight loss · estrogen or androgen signs · or nothing until late"
   ]
  },
  {
   "id": "g_young",
   "x": 45,
   "y": 156,
   "w": 444,
   "h": 116,
   "kind": "plain",
   "title": "YOUNG: GERM CELL commonest",
   "lines": [
    "from the oocyte"
   ]
  },
  {
   "id": "g_epi",
   "x": 529,
   "y": 156,
   "w": 672,
   "h": 116,
   "kind": "plain",
   "title": "ADULT: EPITHELIAL commonest",
   "lines": [
    "serous the commonest subtype, then mucinous",
    "STROMAL INVASION separates carcinoma from borderline"
   ]
  },
  {
   "id": "g_sc",
   "x": 1241,
   "y": 156,
   "w": 216,
   "h": 116,
   "kind": "plain",
   "title": "ANY AGE: SEX CORD / STROMAL",
   "lines": [
    "FIBROMA: common, BENIGN, firm white nodular mass, often found at surgery"
   ]
  },
  {
   "id": "g_met",
   "x": 1497,
   "y": 156,
   "w": 216,
   "h": 116,
   "kind": "plain",
   "title": "METASTASIS",
   "lines": [
    "from the GI tract, pancreas, biliary tract, breast, endometrium"
   ]
  },
