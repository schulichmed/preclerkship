 "nodes": [
  {
   "id": "root",
   "x": 405,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Healthy adult at a periodic health encounter (PHE): WHAT do I screen for, WHEN, and with WHAT?",
   "lines": [
    "stable (airway, breathing, circulation + vitals) → history: risk factors → exam: body mass index (BMI), blood pressure (BP), heart rate",
    "tests chosen by RISK, not a fixed panel: will the result CHANGE MANAGEMENT? (Choosing Wisely)",
    "screen with a very SENSITIVE test (negative rules OUT), confirm with a very SPECIFIC one (positive rules IN)"
   ]
  },
  {
   "id": "g_r",
   "x": 45,
   "y": 174,
   "w": 720,
   "h": 78,
   "kind": "plain",
   "title": "RISK FACTORS + CHRONIC DISEASE",
   "lines": [
    "by age, earlier if at higher risk",
    "from 65: bone density, aortic aneurysm → see the OLDER ADULT chart"
   ]
  },
  {
   "id": "g_c",
   "x": 805,
   "y": 174,
   "w": 720,
   "h": 78,
   "kind": "plain",
   "title": "CANCER: AVERAGE risk and NO symptoms?",
   "lines": [
    "yes → the program below · symptoms or HIGH risk → out of it (red / amber boxes)"
   ]
  },
  {
   "id": "p_r",
   "x": 45,
   "y": 292,
   "w": 720,
   "h": 96,
   "kind": "info",
   "title": "Ask at every PHE",
   "lines": [
    "• poverty: \"trouble making ends meet at the end of the month?\"",
    "• alcohol + drugs · mood + stressors: see the ANXIETY AND STRESS chart",
    "• exercise + diet: SEDENTARISM is always a risk; BMI alone is not"
   ]
  },
  {
   "id": "p_c",
   "x": 805,
   "y": 292,
   "w": 720,
   "h": 96,
   "kind": "info",
   "title": "Programs for the ASYMPTOMATIC only",
   "lines": [
    "• symptoms → investigate them, don't screen",
    "• high risk → its own route, earlier or more often",
    "• prostate: NO routine prostate-specific antigen (PSA) · shared decision from 40 if Black or family history"
   ]
  },
